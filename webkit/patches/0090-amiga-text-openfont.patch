+bool FontPlatformData::platformIsEqual(const FontPlatformData& other) const
+{
+    return m_openFontFace == other.m_openFontFace
+        && m_scaledFont == other.m_scaledFont
+        && m_fontFaceFeatures == other.m_fontFaceFeatures;
+}
