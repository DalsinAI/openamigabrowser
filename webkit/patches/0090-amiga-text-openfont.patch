+
+void FontPlatformData::buildScaledFont()
+{
+    ASSERT(m_openFontFace);
+    CairoUniquePtr<cairo_font_options_t> options(cairo_font_options_copy(getDefaultCairoFontOptions()));
+    // Grey-scale anti-aliasing without hinting, as OpenBrowser's fontconfig
+    // settings asked of FreeType: OpenFont's outlines are not hinted.
+    cairo_font_options_set_antialias(options.get(), CAIRO_ANTIALIAS_GRAY);
+    cairo_font_options_set_subpixel_order(options.get(), CAIRO_SUBPIXEL_ORDER_DEFAULT);
+    cairo_font_options_set_hint_style(options.get(), CAIRO_HINT_STYLE_NONE);
+
+    cairo_matrix_t ctm;
+    cairo_matrix_init_identity(&ctm);
+
+    // A zero size fails to make a scaled font: scale to a tiny size and
+    // leave the drawing to stop later on, as the FreeType ports do.
+    cairo_matrix_t fontMatrix;
+    float realSize = m_metadata.pointSize ? m_metadata.pointSize : 1;
+    cairo_matrix_init_scale(&fontMatrix, realSize, realSize);
+
+    if (syntheticOblique()) {
+        static const float syntheticObliqueSkew = -tanf(14 * acosf(0) / 90);
+        static const cairo_matrix_t skew = { 1, 0, syntheticObliqueSkew, 1, 0, 0 };
+        static const cairo_matrix_t verticalSkew = { 1, -syntheticObliqueSkew, 0, 1, 0, 0 };
+        cairo_matrix_multiply(&fontMatrix, m_metadata.orientation == FontOrientation::Vertical ? &verticalSkew : &skew, &fontMatrix);
+    }
+
+    if (m_metadata.orientation == FontOrientation::Vertical) {
+        // V = H . R . T: R rotates by -90 degrees and T moves the glyph down
+        // by the font size.
+        cairo_matrix_rotate(&fontMatrix, -piOverTwoDouble);
+        cairo_matrix_translate(&fontMatrix, 0.0, 1.0);
+    }
+
+    m_scaledFont = adoptRef(cairo_scaled_font_create(m_openFontFace->cairoFontFace(), &fontMatrix, &ctm, options.get()));
+}
+
+RefPtr<SharedBuffer> FontPlatformData::openTypeTable(uint32_t table) const
+{
+    if (!m_openFontFace)
+        return nullptr;
+    // OpenTypeTypes' tags are little-endian; the library's are as written.
+    uint32_t tag = OpenFontFace::tag(table & 0xff, (table >> 8) & 0xff, (table >> 16) & 0xff, table >> 24);
+    auto data = m_openFontFace->table(tag);
+    if (data.empty())
+        return nullptr;
+    return SharedBuffer::create(data);
+}
+
+FontPlatformData FontPlatformData::create(const Attributes& data, const FontCustomPlatformData* custom)
+{
+    RefPtr<OpenFontFace> face;
+    if (custom)
+        face = custom->m_openFontFace.ptr();
+    else
+        face = OpenFontFace::defaultFace(400, false);
+    RELEASE_ASSERT(face);
+    return FontPlatformData(face.releaseNonNull(), data.m_metadata.pointSize, data.m_metadata.isSyntheticBold, data.m_metadata.isSyntheticOblique, data.m_metadata.orientation, data.m_metadata.metricsOverrides, custom);
+}
