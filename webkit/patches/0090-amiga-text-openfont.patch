+void FontCache::platformInit()
+{
+}
+
+static unsigned openFontWeight(FontSelectionValue weight)
+{
+    return std::clamp(static_cast<int>(static_cast<float>(weight)), 100, 900);
+}
+
+// Synthetic bold and oblique as the fontconfig ports decide them: bold when
+// bold was asked for and the face is lighter than semibold, oblique when
+// italic was asked for and the face is upright.
+static void syntheticStyleForFace(const OpenFontFace& face, const FontDescription& fontDescription, OptionSet<FontLookupOptions> options, bool& syntheticBold, bool& syntheticOblique)
+{
+    bool allowSyntheticBold = fontDescription.hasAutoFontSynthesisWeight()
+        && !options.contains(FontLookupOptions::DisallowBoldSynthesis);
+    syntheticBold = allowSyntheticBold && isFontWeightBold(fontDescription.weight()) && face.weight() < 600;
+
+    bool allowSyntheticOblique = fontDescription.allowsItalicOrObliqueFontSynthesisStyle()
+        && !options.contains(FontLookupOptions::DisallowObliqueSynthesis);
+    syntheticOblique = allowSyntheticOblique && fontDescription.fontStyleSlope() && !face.isItalic();
+}
+
+RefPtr<Font> FontCache::systemFallbackForCharacterCluster(const FontDescription& description, const Font&, IsForPlatformFont, PreferColoredFont, StringView stringView)
+{
+    auto codePoints = stringView.codePoints();
+    auto it = codePoints.begin();
+    if (it == codePoints.end())
+        return nullptr;
+
+    RefPtr face = OpenFontFace::forCharacter(*it, openFontWeight(description.weight()), !!description.fontStyleSlope());
+    if (!face)
+        return nullptr;
+
+    bool syntheticBold, syntheticOblique;
+    syntheticStyleForFace(*face, description, { }, syntheticBold, syntheticOblique);
+    FontPlatformData alternateFontData(face.releaseNonNull(), description.usedSize(), syntheticBold, syntheticOblique, description.orientation());
+    return fontForPlatformData(alternateFontData);
+}
+
+Vector<String> FontCache::systemFontFamilies()
+{
+    // The font index lists no families to programs.
+    return { };
+}
+
+bool FontCache::isSystemFontForbiddenForEditing(const String&)
+{
+    return false;
+}
+
+Ref<Font> FontCache::lastResortFallbackFont(const FontDescription& fontDescription)
+{
+    if (RefPtr<Font> font = fontForFamily(fontDescription, "serif"_s))
+        return font.releaseNonNull();
+
+    // No serif face and no alias of it: any face at all.
+    RefPtr face = OpenFontFace::defaultFace(openFontWeight(fontDescription.weight()), !!fontDescription.fontStyleSlope());
+    // This could be reached due to no fonts installed, or no openfont.library.
+    RELEASE_ASSERT(face);
+    return fontForPlatformData(FontPlatformData(face.releaseNonNull(), fontDescription.usedSize(), false, false, fontDescription.orientation()));
+}
+
+Vector<FontSelectionCapabilities> FontCache::getFontSelectionCapabilitiesInFamily(const AtomString&, AllowUserInstalledFonts)
+{
+    return { };
+}
+
+static String familyNameStringFromFamily(const String& family)
+{
+    // A generic family of WebKit's settings ("-webkit-standard") as the
+    // generic family (serif) OpenFont's aliases know.
+    if (family.length() && !family.startsWith("-webkit-"_s))
+        return family;
+
+    if (family == *familyNamesData->at(FamilyNamesIndex::StandardFamily) || family == *familyNamesData->at(FamilyNamesIndex::SerifFamily))
+        return "serif"_s;
+    if (family == *familyNamesData->at(FamilyNamesIndex::SansSerifFamily))
+        return "sans-serif"_s;
+    if (family == *familyNamesData->at(FamilyNamesIndex::MonospaceFamily))
+        return "monospace"_s;
+    if (family == *familyNamesData->at(FamilyNamesIndex::CursiveFamily))
+        return "cursive"_s;
+    if (family == *familyNamesData->at(FamilyNamesIndex::FantasyFamily))
+        return "fantasy"_s;
+    if (family == *familyNamesData->at(FamilyNamesIndex::MathFamily))
+        return "math"_s;
+
+    return emptyString();
+}
+
+// OpenBrowser's families, which its fontconfig settings (fonts.conf) gave
+// before: the generic families to the Liberation faces first, and faces
+// pages ask for by name to the faces that share their metrics, so text
+// lays out at the size the page expects. Tried before OpenFont's own
+// aliases and the user's (ENVARC:OpenFont/Aliases).
+struct FamilyAlias {
+    ASCIILiteral name;
+    std::array<ASCIILiteral, 2> families;
+};
+
+static constexpr std::array familyAliases {
+    FamilyAlias { "sans-serif"_s, { "Liberation Sans"_s, "DejaVu Sans"_s } },
+    FamilyAlias { "serif"_s, { "Liberation Serif"_s, "DejaVu Serif"_s } },
+    FamilyAlias { "monospace"_s, { "Liberation Mono"_s, "DejaVu Sans Mono"_s } },
+    FamilyAlias { "system-ui"_s, { "Liberation Sans"_s, "DejaVu Sans"_s } },
+    FamilyAlias { "cursive"_s, { "Liberation Serif"_s, { } } },
+    FamilyAlias { "fantasy"_s, { "Liberation Sans"_s, { } } },
+    FamilyAlias { "Arial"_s, { "Liberation Sans"_s, { } } },
+    FamilyAlias { "Helvetica"_s, { "Liberation Sans"_s, { } } },
+    FamilyAlias { "Helvetica Neue"_s, { "Liberation Sans"_s, { } } },
+    FamilyAlias { "Segoe UI"_s, { "Liberation Sans"_s, { } } },
+    FamilyAlias { "Roboto"_s, { "Liberation Sans"_s, { } } },
+    FamilyAlias { "Verdana"_s, { "DejaVu Sans"_s, { } } },
+    FamilyAlias { "Tahoma"_s, { "DejaVu Sans"_s, { } } },
+    FamilyAlias { "Times New Roman"_s, { "Liberation Serif"_s, { } } },
+    FamilyAlias { "Times"_s, { "Liberation Serif"_s, { } } },
+    FamilyAlias { "Georgia"_s, { "Liberation Serif"_s, { } } },
+    FamilyAlias { "Courier New"_s, { "Liberation Mono"_s, { } } },
+    FamilyAlias { "Courier"_s, { "Liberation Mono"_s, { } } },
+    FamilyAlias { "Consolas"_s, { "Liberation Mono"_s, { } } },
+};
+
+static RefPtr<OpenFontFace> faceForFamily(const String& family, unsigned weight, bool italic)
+{
+    for (auto& alias : familyAliases) {
+        if (!equalIgnoringASCIICase(family, alias.name))
+            continue;
+        for (auto& aliasFamily : alias.families) {
+            if (aliasFamily.isNull())
+                break;
+            if (RefPtr face = OpenFontFace::forFamily(aliasFamily, weight, italic))
+                return face;
+        }
+        break;
+    }
+    return OpenFontFace::forFamily(family, weight, italic);
+}
+
+std::unique_ptr<FontPlatformData> FontCache::createFontPlatformData(const FontDescription& fontDescription, const AtomString& family, const FontCreationContext& fontCreationContext, OptionSet<FontLookupOptions> options)
+{
+    // The CSS font matching algorithm wants the family itself (or a generic
+    // family, or an alias the user or OpenFont set up), never a stand-in:
+    // the page's font-family list decides what comes next.
+    String familyNameString = familyNameStringFromFamily(family);
+    if (familyNameString.isEmpty())
+        return nullptr;
+
+    RefPtr face = faceForFamily(familyNameString, openFontWeight(fontDescription.weight()), !!fontDescription.fontStyleSlope());
+    if (!face)
+        return nullptr;
+
+    bool syntheticBold, syntheticOblique;
+    syntheticStyleForFace(*face, fontDescription, options, syntheticBold, syntheticOblique);
+
+    Vector<uint32_t> features;
+    if (fontCreationContext.fontFaceFeatures()) {
+        for (auto& fontFaceFeature : *fontCreationContext.fontFaceFeatures()) {
+            if (fontFaceFeature.enabled()) {
+                const auto& tag = fontFaceFeature.tag();
+                features.append(OpenFontFace::tag(tag[0], tag[1], tag[2], tag[3]));
+            }
+        }
+    }
+
+    auto size = fontDescription.adjustedSizeForFontFace(fontCreationContext.sizeAdjust());
+    FontPlatformData platformData(face.releaseNonNull(), size, syntheticBold, syntheticOblique, fontDescription.orientation(), fontCreationContext.metricsOverrides(), nullptr, WTF::move(features));
+
+    platformData.updateSizeWithFontSizeAdjust(fontDescription.fontSizeAdjust(), fontDescription.usedSize());
+    return makeUnique<FontPlatformData>(platformData);
+}
