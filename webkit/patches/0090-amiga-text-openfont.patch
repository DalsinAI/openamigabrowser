+ */
+
+#include "config.h"
+#include "Font.h"
+
+#if USE(OPENFONT) && USE(CAIRO)
+
+#include "FloatRect.h"
+#include "FontDescription.h"
+#include "NotImplemented.h"
+#include "OpenFontFace.h"
+#include <cairo.h>
+#include <wtf/MathExtras.h>
+
+namespace WebCore {
+
+static inline unsigned readUInt16(std::span<const uint8_t> data, size_t offset)
+{
+    return offset + 2 <= data.size() ? (data[offset] << 8) | data[offset + 1] : 0;
+}
+
+static inline int readInt16(std::span<const uint8_t> data, size_t offset)
+{
+    return static_cast<int16_t>(readUInt16(data, offset));
+}
+
+// The glyph's ink height (width for vertical text) at the font's size.
+static std::optional<float> heightOfCharacter(const OpenFontFace& face, char32_t character, float scale, FontOrientation orientation)
+{
+    FloatRect bounds;
+    if (!face.glyphBounds(face.glyphForCharacter(character), bounds))
+        return std::nullopt;
+    return (orientation == FontOrientation::Horizontal ? bounds.height() : bounds.width()) * scale;
+}
+
+void FontBase::platformInit()
+{
+    if (!m_platformData.size())
+        return;
+
+    RefPtr face = m_platformData.openFontFace();
+    ASSERT(face);
+    float size = m_platformData.size();
+    unsigned unitsPerEm = face->unitsPerEm();
+    float scale = size / unitsPerEm;
+
+    // The line metrics as FreeType gives them to cairo, unhinted: hhea's,
+    // or OS/2's when hhea has none (FreeType's sfobjs.c).
+    auto horizontalHeader = face->table(OpenFontFace::tag('h', 'h', 'e', 'a'));
+    auto os2 = face->table(OpenFontFace::tag('O', 'S', '/', '2'));
+    auto postScript = face->table(OpenFontFace::tag('p', 'o', 's', 't'));
+    int ascender = readInt16(horizontalHeader, 4);
+    int descender = readInt16(horizontalHeader, 6);
+    int height = ascender - descender + readInt16(horizontalHeader, 8);
+    if (!ascender && !descender && os2.size() >= 78) {
+        int typoAscender = readInt16(os2, 68);
+        int typoDescender = readInt16(os2, 70);
+        if (typoAscender || typoDescender) {
+            ascender = typoAscender;
+            descender = typoDescender;
+            height = ascender - descender + readInt16(os2, 72);
+        } else {
+            ascender = readUInt16(os2, 74);
+            descender = -static_cast<int>(readUInt16(os2, 76));
+            height = ascender - descender;
+        }
+    }
+    float ascent = ascender * scale;
+    float descent = -descender * scale;
+    float lineGap = (height - ascender + descender) * scale;
+    std::optional<float> capHeight;
+    std::optional<float> xHeight;
+
+    if (os2.size() >= 78) {
+        // With OS/2's USE_TYPO_METRICS flag, its typographic metrics.
+        const unsigned useTypoMetricsMask = 1 << 7;
+        if (readUInt16(os2, 62) & useTypoMetricsMask) {
+            ascent = readInt16(os2, 68) * scale;
+            descent = -readInt16(os2, 70) * scale;
+            lineGap = readInt16(os2, 72) * scale;
+        }
+        // sxHeight and sCapHeight are in version 2 and later.
+        if (readUInt16(os2, 0) >= 2 && os2.size() >= 90) {
+            xHeight = readInt16(os2, 86) * scale;
+            capHeight = readInt16(os2, 88) * scale;
+        }
+    }
+
+    // Otherwise, measured from the glyphs.
+    if (!capHeight.value_or(0))
+        capHeight = heightOfCharacter(*face, 'T', scale, platformData().orientation());
+    if (!xHeight.value_or(0))
+        xHeight = heightOfCharacter(*face, 'x', scale, platformData().orientation());
+
+    m_fontMetrics.setAscent(ascent);
+    m_fontMetrics.setDescent(descent);
+    m_fontMetrics.setCapHeight(capHeight.value_or(0));
+    m_fontMetrics.setLineSpacing(lroundf(ascent) + lroundf(descent) + lroundf(lineGap));
+    m_fontMetrics.setLineGap(lineGap);
+    m_fontMetrics.setXHeight(xHeight.value_or(0));
+    m_fontMetrics.setUnitsPerEm(unitsPerEm);
+
+    if (postScript.size() >= 12) {
+        // FreeType keeps the top of the underline: post's position less half
+        // its thickness, in whole font units.
+        int thickness = readInt16(postScript, 10);
+        int position = static_cast<int16_t>(readInt16(postScript, 8) - thickness / 2);
+        m_fontMetrics.setUnderlinePosition(-((position + thickness / 2.) / unitsPerEm) * size);
+        m_fontMetrics.setUnderlineThickness((thickness / static_cast<float>(unitsPerEm)) * size);
+    }
+
+    cairo_glyph_t spaceGlyph = { face->glyphForCharacter(' '), 0, 0 };
+    cairo_text_extents_t textExtents;
+    cairo_scaled_font_glyph_extents(m_platformData.scaledFont(), &spaceGlyph, 1, &textExtents);
+    m_spaceWidth = narrowPrecisionToFloat((platformData().orientation() == FontOrientation::Horizontal) ? textExtents.x_advance : -textExtents.y_advance);
+    m_syntheticBoldOffset = m_platformData.syntheticBold() ? 1.0f : 0.f;
+
+    // Disable antialiasing for the Ahem font because many tests require this.
+    if (equalLettersIgnoringASCIICase(face->familyName(), "ahem"_s))
+        m_allowsAntialiasing = false;
+}
+
+void Font::platformCharWidthInit()
+{
+    m_avgCharWidth = 0.f;
+    m_maxCharWidth = 0.f;
+    initCharWidths();
+}
+
+RefPtr<Font> Font::platformCreateScaledFont(const FontDescription& fontDescription, float scaleFactor) const
+{
+    RefPtr face = m_platformData.openFontFace();
+    ASSERT(face);
+    auto features = m_platformData.fontFaceFeatures();
+    return Font::create(FontPlatformData(face.releaseNonNull(),
+        scaleFactor * m_platformData.size(),
+        m_platformData.syntheticBold(),
+        m_platformData.syntheticOblique(),
+        fontDescription.orientation(),
+        m_platformData.metricsOverrides(),
+        m_platformData.customPlatformData(),
+        WTF::move(features)),
+        origin(), IsInterstitial::No);
+}
+
+RefPtr<Font> Font::platformCreateHalfWidthFont() const
+{
+    // FIXME: https://bugs.webkit.org/show_bug.cgi?id=281333 : implement half width font for this platform.
+    notImplemented();
+    return nullptr;
+}
+
+void Font::determinePitch()
+{
+    m_treatAsFixedPitch = m_platformData.isFixedPitch();
+}
+
+bool Font::platformSupportsCodePoint(char32_t character, std::optional<char32_t> variation) const
+{
+    RefPtr face = m_platformData.openFontFace();
+    if (!face)
+        return false;
+    // OpenFont reads no variation sequences (cmap format 14).
+    if (variation)
+        return false;
+    return !!face->glyphForCharacter(character);
+}
+
+} // namespace WebCore
+
+#endif // USE(OPENFONT) && USE(CAIRO)
