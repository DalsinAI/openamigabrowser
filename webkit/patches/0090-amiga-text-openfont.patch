+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT HOLDERS OR
+ * CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,
+ * EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
+ * PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
+ * OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
+ * WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
+ * OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
+ * ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "OpenFontLibrary.h"
+
+#include <exec/types.h>
+#include <exec/libraries.h>
+#include <utility/tagitem.h>
+#include <libraries/openfont.h>
+#include <dos/dos.h>
+#include <proto/dos.h>
+#include <proto/exec.h>
+#include <proto/openfont.h>
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* One base for every thread: the library takes its calls one at a time. */
+struct Library* OpenFontBase;
+static pthread_once_t s_openOnce = PTHREAD_ONCE_INIT;
+static int s_available;
+static int s_hasColorBitmaps;
+
+/* The structures below are the library's own, passed straight through. */
+typedef char obofGlyphMatchesLibrary[sizeof(OBOFGlyph) == sizeof(struct OFGlyph) ? 1 : -1];
+typedef char obofFeatureMatchesLibrary[sizeof(OBOFFeature) == sizeof(struct OFFeature) ? 1 : -1];
+typedef char obofColorMatchesLibrary[sizeof(OBOFColorBitmap) == sizeof(struct OFColorBitmap) ? 1 : -1];
+
+static void closeOpenFont(void)
+{
+    if (OpenFontBase) {
+        CloseLibrary(OpenFontBase);
+        OpenFontBase = NULL;
+    }
+}
+
+static void openOpenFont(void)
+{
+    /* Version 1 is a preview whose structures may change in version 2, so
+     * version 1 exactly, with revision 3's layout calls: LIBS:'s, or the
+     * one in the program's drawer when LIBS: has none or an older one. */
+    static const char* const names[] = { OPENFONTNAME, "PROGDIR:Libs/" OPENFONTNAME };
+    unsigned i;
+    for (i = 0; i < sizeof names / sizeof names[0] && !OpenFontBase; ++i) {
+        OpenFontBase = OpenLibrary((CONST_STRPTR)names[i], OPENFONT_VERSION);
+        if (OpenFontBase && (OpenFontBase->lib_Version != OPENFONT_VERSION || OpenFontBase->lib_Revision < OPENFONT_REVISION_LAYOUT))
+            closeOpenFont();
+    }
+    if (!OpenFontBase)
+        return;
+    atexit(closeOpenFont);
+    s_available = 1;
+    s_hasColorBitmaps = OpenFontBase->lib_Revision >= OPENFONT_REVISION_COLOR;
+
+    /* The fonts in the program's drawer (Fonts/), by their full path, as
+     * the font index keeps every folder's; the installed browser's
+     * (LIBS:WebBrowser/Fonts) and FONTS: are in the index already. */
+    {
+        BPTR lock = Lock((CONST_STRPTR)"PROGDIR:Fonts", SHARED_LOCK);
+        if (lock) {
+            char path[256];
+            if (NameFromLock(lock, (STRPTR)path, sizeof path))
+                OF_AddFontDir((CONST_STRPTR)path);
+            UnLock(lock);
+        }
+    }
+}
+
+int obof_available(void)
+{
+    pthread_once(&s_openOnce, openOpenFont);
+    return s_available;
+}
+
+struct OFFace* obof_find_face(const char* family, unsigned weight, int italic)
+{
+    struct TagItem tags[] = {
+        { OFA_Weight, weight },
+        { OFA_Italic, italic ? TRUE : FALSE },
+        { OFA_Fallbacks, FALSE },
+        { OFA_Exact, family ? TRUE : FALSE },
+        { OFA_Size, 0 },
+        { TAG_END, 0 }
+    };
+    if (!obof_available())
+        return NULL;
+    return OF_FindFaceA((CONST_STRPTR)family, tags);
+}
+
+struct OFFace* obof_find_face_for_char(uint32_t codepoint, unsigned weight, int italic)
+{
+    struct TagItem tags[] = {
+        { OFA_Weight, weight },
+        { OFA_Italic, italic ? TRUE : FALSE },
+        { TAG_END, 0 }
+    };
+    if (!obof_available())
+        return NULL;
+    return OF_FindFaceForCharA(codepoint, tags);
+}
+
+struct OFFace* obof_open_face_memory(const void* data, size_t size)
+{
+    if (!obof_available() || !data || !size)
+        return NULL;
+    return OF_OpenFaceMemoryA((CONST_APTR)data, (ULONG)size, NULL);
+}
+
+void obof_close_face(struct OFFace* face)
+{
+    if (face && OpenFontBase)
+        OF_CloseFace(face);
+}
+
+int obof_set_size(struct OFFace* face, unsigned pixels)
+{
+    return OF_SetSize(face, pixels) == OFERR_OK;
+}
+
+int obof_face_info(struct OFFace* face, OBOFFaceInfo* out)
+{
+    struct OFFaceInfo info;
+    unsigned i;
+    if (OF_GetFaceInfo(face, &info) != OFERR_OK)
+        return 0;
+    for (i = 0; i < sizeof out->family; ++i)
+        out->family[i] = info.fi_Family[i];
+    out->family[sizeof out->family - 1] = 0;
+    for (i = 0; i < sizeof out->style; ++i)
+        out->style[i] = info.fi_Style[i];
+    out->style[sizeof out->style - 1] = 0;
+    out->weight = info.fi_Weight;
+    out->flags = info.fi_Flags;
+    out->unitsPerEm = info.fi_UnitsPerEm;
+    out->numGlyphs = info.fi_NumGlyphs;
+    return 1;
+}
+
+uint32_t obof_char_index(struct OFFace* face, uint32_t codepoint)
+{
+    return OF_CharIndex(face, codepoint);
+}
+
+const uint8_t* obof_table(struct OFFace* face, uint32_t tag, uint32_t* length)
+{
+    ULONG size = 0;
+    const uint8_t* table = (const uint8_t*)OF_GetFontTable(face, tag, &size);
+    if (length)
+        *length = table ? size : 0;
+    return table;
+}
+
+int obof_glyph_extents(struct OFFace* face, uint32_t glyph, int32_t box[4])
+{
+    struct OFGlyphExtents extents;
+    if (OF_GlyphExtents(face, glyph, &extents) != OFERR_OK)
+        return 0;
+    box[0] = extents.ge_XBearing;
+    box[1] = extents.ge_YBearing;
+    box[2] = extents.ge_Width;
+    box[3] = extents.ge_Height;
+    return 1;
+}
+
+int obof_glyph_color_bitmap(struct OFFace* face, uint32_t glyph, unsigned ppem, OBOFColorBitmap* bitmap)
+{
+    struct OFColorBitmap color;
+    memset(bitmap, 0, sizeof *bitmap);
+    if (!s_hasColorBitmaps || OF_GlyphColorBitmap(face, glyph, ppem, &color) != OFERR_OK)
+        return 0;
+    bitmap->pixels = (uint32_t*)color.cb_Pixels;
+    bitmap->width = color.cb_Width;
+    bitmap->height = color.cb_Height;
+    bitmap->left = color.cb_Left;
+    bitmap->top = color.cb_Top;
+    bitmap->ppem = color.cb_PPEM;
+    return 1;
+}
+
+void obof_free_color_bitmap(OBOFColorBitmap* bitmap)
+{
+    struct OFColorBitmap color;
+    if (!bitmap->pixels)
+        return;
+    color.cb_Pixels = (ULONG*)bitmap->pixels;
+    color.cb_Width = bitmap->width;
+    color.cb_Height = bitmap->height;
+    color.cb_Left = bitmap->left;
+    color.cb_Top = bitmap->top;
+    color.cb_PPEM = bitmap->ppem;
+    OF_FreeColorBitmap(&color);
+    memset(bitmap, 0, sizeof *bitmap);
+}
+
+int obof_glyph_outline(struct OFFace* face, uint32_t glyph, uint8_t* verbs, uint32_t maxVerbs,
+    int32_t* points, uint32_t maxPoints, uint32_t* verbCount, uint32_t* pointCount)
+{
+    struct OFOutline outline;
+    LONG error;
+    outline.ol_Verbs = verbs;
+    outline.ol_Points = (LONG*)points;
+    outline.ol_MaxVerbs = maxVerbs;
+    outline.ol_MaxPoints = maxPoints;
+    outline.ol_NumVerbs = 0;
+    outline.ol_NumPoints = 0;
+    error = OF_GlyphOutline(face, glyph, &outline);
+    *verbCount = outline.ol_NumVerbs;
+    *pointCount = outline.ol_NumPoints;
+    return error == OFERR_OK;
+}
+
+uint32_t obof_shape_utf16(struct OFFace* face, const uint16_t* text, uint32_t length, uint32_t offset,
+    uint32_t runLength, uint32_t script, uint32_t language, unsigned direction,
+    const OBOFFeature* features, unsigned featureCount, OBOFGlyph* glyphs, uint32_t capacity)
+{
+    struct TagItem tags[] = {
+        { OFA_UTF16, TRUE },
+        { OFA_Offset, offset },
+        { OFA_Length, runLength },
+        { OFA_Script, script },
+        { OFA_Language, language },
+        { OFA_Direction, direction },
+        { OFA_Features, (ULONG)features },
+        { OFA_NumFeatures, featureCount > OBOF_MAX_FEATURES ? OBOF_MAX_FEATURES : featureCount },
+        { TAG_END, 0 }
+    };
+    return OF_ShapeA(face, (CONST_APTR)text, length, (struct OFGlyph*)glyphs, capacity, tags);
+}
