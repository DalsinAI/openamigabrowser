+#[=======================================================================[.rst:
+FindOpenFont
+------------
+
+Find the SDK of openfont.library (DalsinAI/openamigafont, ``sdk/Include_H``):
+``libraries/openfont.h``, ``proto/openfont.h`` and the inline calls. The
+library itself is opened at run time, so there is nothing to link.
+
+Imported Targets
+^^^^^^^^^^^^^^^^
+
+``OpenFont::OpenFont``
+  The SDK's headers, if found.
+
+Result Variables
+^^^^^^^^^^^^^^^^
+
+``OpenFont_FOUND``
+  true if (the requested version of) the SDK is available.
+``OpenFont_VERSION``
+  the version and revision its headers describe (1.3 for the layout calls).
+``OpenFont_INCLUDE_DIRS``
+  where to find ``libraries/openfont.h``.
+
+#]=======================================================================]
+
+find_path(OpenFont_INCLUDE_DIR NAMES libraries/openfont.h proto/openfont.h)
+
+if (OpenFont_INCLUDE_DIR AND EXISTS "${OpenFont_INCLUDE_DIR}/libraries/openfont.h")
+    file(READ "${OpenFont_INCLUDE_DIR}/libraries/openfont.h" _OpenFont_HEADER)
+    string(REGEX MATCH "#define +OPENFONT_VERSION +([0-9]+)" _dummy "${_OpenFont_HEADER}")
+    set(_OpenFont_MAJOR "${CMAKE_MATCH_1}")
+    # The newest revision the header names a define for.
+    set(_OpenFont_MINOR 0)
+    string(REGEX MATCHALL "#define +OPENFONT_REVISION_[A-Z]+ +([0-9]+)" _OpenFont_REVISIONS "${_OpenFont_HEADER}")
+    foreach (_OpenFont_REVISION IN LISTS _OpenFont_REVISIONS)
+        string(REGEX REPLACE ".* ([0-9]+)$" "\\1" _OpenFont_NUMBER "${_OpenFont_REVISION}")
+        if (_OpenFont_NUMBER GREATER _OpenFont_MINOR)
+            set(_OpenFont_MINOR "${_OpenFont_NUMBER}")
+        endif ()
+    endforeach ()
+    set(OpenFont_VERSION "${_OpenFont_MAJOR}.${_OpenFont_MINOR}")
+    unset(_OpenFont_HEADER)
+    unset(_OpenFont_REVISIONS)
+endif ()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(OpenFont
+    FOUND_VAR OpenFont_FOUND
+    REQUIRED_VARS OpenFont_INCLUDE_DIR
+    VERSION_VAR OpenFont_VERSION
+)
+
+if (OpenFont_INCLUDE_DIR AND NOT TARGET OpenFont::OpenFont)
+    add_library(OpenFont::OpenFont INTERFACE IMPORTED GLOBAL)
+    set_target_properties(OpenFont::OpenFont PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${OpenFont_INCLUDE_DIR}"
+    )
+endif ()
+
+if (OpenFont_FOUND)
+    set(OpenFont_INCLUDE_DIRS ${OpenFont_INCLUDE_DIR})
+endif ()
+
+mark_as_advanced(OpenFont_INCLUDE_DIR)
