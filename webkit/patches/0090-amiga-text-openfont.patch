+ * WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
+ * OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
+ * ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/* openfont.library for WebCore's fonts (USE(OPENFONT)): finding faces,
+ * their tables and outlines, and shaping. Plain C, so that AmigaOS headers
+ * and their macros stay out of WebCore's C++. Each call takes the library's
+ * lock; calls that read files (finding a face) need a process. */
+
+#ifndef OpenFontLibrary_h
+#define OpenFontLibrary_h
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A face of openfont.library: opaque. */
+struct OFFace;
+
+/* 1 when openfont.library 1.3 (revision 3, the layout calls) or newer is
+ * open; the first call opens it. */
+int obof_available(void);
+
+/* A face for a family (or one of its aliases) at a weight (100-900) and
+ * slant, with no fallbacks of its own, or NULL when the family is not
+ * installed. NULL family: the default face (sans-serif), never NULL while
+ * any font is installed. */
+struct OFFace* obof_find_face(const char* family, unsigned weight, int italic);
+/* A face with a glyph for codepoint, or NULL. */
+struct OFFace* obof_find_face_for_char(uint32_t codepoint, unsigned weight, int italic);
+/* A face from a font file in memory; the face keeps its own copy. */
+struct OFFace* obof_open_face_memory(const void* data, size_t size);
+void obof_close_face(struct OFFace*);
+
+/* Sets the size every later value of the face is measured at. */
+int obof_set_size(struct OFFace*, unsigned pixels);
+
+#define OBOF_FACE_ITALIC   0x0001
+#define OBOF_FACE_FIXED    0x0002
+#define OBOF_FACE_SCALABLE 0x0004
+#define OBOF_FACE_COLOR    0x0008
+
+typedef struct {
+    char family[64];
+    char style[64];
+    unsigned weight;        /* 100-900 */
+    unsigned flags;         /* OBOF_FACE_ above */
+    unsigned unitsPerEm;
+    unsigned numGlyphs;
+} OBOFFaceInfo;
+
+int obof_face_info(struct OFFace*, OBOFFaceInfo*);
+
+/* The glyph for a character, 0 when the face has none. */
+uint32_t obof_char_index(struct OFFace*, uint32_t codepoint);
+
+/* A table of the font ('hhea', 'OS/2'), as long as the face lives, or NULL. */
+const uint8_t* obof_table(struct OFFace*, uint32_t tag, uint32_t* length);
+
+/* A glyph's ink box at the face's size, 26.6 and y up: x bearing, y
+ * bearing (the top), width, height. 0 when the glyph has none. */
+int obof_glyph_extents(struct OFFace*, uint32_t glyph, int32_t box[4]);
+
+/* A colour glyph (an emoji) from a font with PNG images (CBDT or sbix),
+ * decoded by openfont.library 1.4 through the PNG datatype: pixels are
+ * 0xAARRGGBB, not premultiplied; left and top place the image's top-left
+ * corner from the pen, y up, in the strike's pixels (ppem). 0 when the
+ * glyph has none, or the library is older than 1.4. */
+typedef struct {
+    uint32_t* pixels;
+    uint32_t width;
+    uint32_t height;
+    int32_t left;
+    int32_t top;
+    uint32_t ppem;
+} OBOFColorBitmap;
+
+int obof_glyph_color_bitmap(struct OFFace*, uint32_t glyph, unsigned ppem, OBOFColorBitmap*);
+void obof_free_color_bitmap(OBOFColorBitmap*);
+
+#define OBOF_PATH_MOVE  0
+#define OBOF_PATH_LINE  1
+#define OBOF_PATH_QUAD  2
+#define OBOF_PATH_CUBIC 3
+#define OBOF_PATH_CLOSE 4
+
+/* A glyph's outline at the face's size: verbs (OBOF_PATH_ above) and
+ * points (x, y pairs, 26.6, y up). Fills what fits, sets *verbCount and
+ * *pointCount to the whole outline's, and returns 0 when it did not fit. */
+int obof_glyph_outline(struct OFFace*, uint32_t glyph, uint8_t* verbs, uint32_t maxVerbs,
+    int32_t* points, uint32_t maxPoints, uint32_t* verbCount, uint32_t* pointCount);
+
+#define OBOF_DIR_AUTO 0
+#define OBOF_DIR_LTR  1
+#define OBOF_DIR_RTL  2
+
+#define OBOF_FEATURE_END 0xFFFFFFFFu
+#define OBOF_MAX_FEATURES 32
+
+typedef struct {
+    uint32_t tag;
+    uint32_t value;
+    uint32_t start;
+    uint32_t end;
+} OBOFFeature;
+
+#define OBOF_GLYPH_MISSING 0x0001
+
+/* One shaped glyph: 26.6 at the face's size, in visual order. */
+typedef struct {
+    uint32_t glyph;
+    uint32_t cluster;       /* in UTF-16 units from the start of the text */
+    int32_t xAdvance;
+    int32_t yAdvance;
+    int32_t xOffset;
+    int32_t yOffset;
+    uint16_t face;
+    uint16_t flags;         /* OBOF_GLYPH_ above */
+} OBOFGlyph;
+
+/* Shapes [offset, offset + runLength) of UTF-16 text with all of it as
+ * context. script is the ISO 15924 code as a tag ('Arab'), 0 from the
+ * text; language an OpenType language system tag, 0 the default. Returns
+ * the run's glyph count, writing up to capacity of them (none with glyphs
+ * NULL), or 0 on failure. */
+uint32_t obof_shape_utf16(struct OFFace*, const uint16_t* text, uint32_t length, uint32_t offset,
+    uint32_t runLength, uint32_t script, uint32_t language, unsigned direction,
+    const OBOFFeature* features, unsigned featureCount, OBOFGlyph* glyphs, uint32_t capacity);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* OpenFontLibrary_h */
