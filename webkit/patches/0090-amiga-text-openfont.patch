+namespace WebCore {
+
+// What the cairo user font face's callbacks need. It belongs to the cairo
+// face and closes the OFFace when cairo destroys the face, which can be
+// after the OpenFontFace has gone (scaled fonts in cairo's own cache).
+struct OpenFontCairoFace {
+    WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(OpenFontCairoFace);
+
+    OFFace* face { nullptr };
+    unsigned unitsPerEm { 1000 };
+    std::span<const uint8_t> horizontalMetrics;
+    unsigned horizontalMetricCount { 0 };
+    bool hasColorBitmaps { false };
+    cairo_font_extents_t extents { };
+};
+
+static cairo_user_data_key_t openFontCairoFaceKey;
+
+static inline unsigned readUInt16(std::span<const uint8_t> data, size_t offset)
+{
+    return offset + 2 <= data.size() ? (data[offset] << 8) | data[offset + 1] : 0;
+}
+
+static inline int readInt16(std::span<const uint8_t> data, size_t offset)
+{
+    return static_cast<int16_t>(readUInt16(data, offset));
+}
+
+static unsigned advanceFromHorizontalMetrics(std::span<const uint8_t> metrics, unsigned count, Glyph glyph)
+{
+    if (!count)
+        return 0;
+    // Glyphs past the last longHorMetric share its advance.
+    return readUInt16(metrics, std::min<unsigned>(glyph, count - 1) * 4);
+}
+
+static OpenFontCairoFace* cairoFaceData(cairo_scaled_font_t* scaledFont)
+{
+    return static_cast<OpenFontCairoFace*>(cairo_font_face_get_user_data(cairo_scaled_font_get_font_face(scaledFont), &openFontCairoFaceKey));
+}
+
+static cairo_status_t initScaledFont(cairo_scaled_font_t* scaledFont, cairo_t*, cairo_font_extents_t* extents)
+{
+    auto* data = cairoFaceData(scaledFont);
+    if (!data)
+        return CAIRO_STATUS_USER_FONT_ERROR;
+    *extents = data->extents;
+    return CAIRO_STATUS_SUCCESS;
+}
+
+// Fills the glyph's outline in font space, where the em is 1.0 and y runs
+// down; cairo scales it to the size and caches the coverage it draws.
+static cairo_status_t renderGlyph(cairo_scaled_font_t* scaledFont, unsigned long glyph, cairo_t* cr, cairo_text_extents_t* extents)
+{
+    auto* data = cairoFaceData(scaledFont);
+    if (!data)
+        return CAIRO_STATUS_USER_FONT_ERROR;
+
+    Locker locker { OpenFontFace::lock() };
+    double unitsPerEm = data->unitsPerEm;
+    double scale = 1 / (64 * unitsPerEm);
+    extents->x_advance = advanceFromHorizontalMetrics(data->horizontalMetrics, data->horizontalMetricCount, glyph) / unitsPerEm;
+    extents->y_advance = 0;
+
+    int32_t box[4];
+    if (!obof_glyph_extents(data->face, glyph, box) || box[2] <= 0 || box[3] <= 0)
+        return CAIRO_STATUS_SUCCESS; // Nothing to draw: a space.
+    extents->x_bearing = box[0] * scale;
+    extents->y_bearing = -box[1] * scale;
+    extents->width = box[2] * scale;
+    extents->height = box[3] * scale;
+
+    std::array<uint8_t, 256> verbBuffer;
+    std::array<int32_t, 1024> pointBuffer;
+    std::span<uint8_t> verbs { verbBuffer };
+    std::span<int32_t> points { pointBuffer };
+    Vector<uint8_t> largeVerbs;
+    Vector<int32_t> largePoints;
+    uint32_t verbCount = 0;
+    uint32_t pointCount = 0;
+    if (!obof_glyph_outline(data->face, glyph, verbs.data(), verbs.size(), points.data(), points.size() / 2, &verbCount, &pointCount)) {
+        if (verbCount <= verbs.size() && pointCount <= points.size() / 2)
+            return CAIRO_STATUS_SUCCESS; // No outline (a bitmap glyph): cairo keeps the box.
+        largeVerbs.grow(verbCount);
+        largePoints.grow(pointCount * 2);
+        verbs = largeVerbs.mutableSpan();
+        points = largePoints.mutableSpan();
+        if (!obof_glyph_outline(data->face, glyph, verbs.data(), verbCount, points.data(), pointCount, &verbCount, &pointCount))
+            return CAIRO_STATUS_SUCCESS;
+    }
+
+    double currentX = 0;
+    double currentY = 0;
+    size_t point = 0;
+    auto nextPoint = [&](double& x, double& y) -> bool {
+        if (point >= pointCount)
+            return false;
+        x = points[point * 2] * scale;
+        y = -points[point * 2 + 1] * scale;
+        ++point;
+        return true;
+    };
+    for (uint32_t i = 0; i < verbCount; ++i) {
+        double x1, y1, x2, y2, x3, y3;
+        switch (verbs[i]) {
+        case OBOF_PATH_MOVE:
+            if (!nextPoint(x1, y1))
+                return CAIRO_STATUS_SUCCESS;
+            cairo_move_to(cr, x1, y1);
+            currentX = x1;
+            currentY = y1;
+            break;
+        case OBOF_PATH_LINE:
+            if (!nextPoint(x1, y1))
+                return CAIRO_STATUS_SUCCESS;
+            cairo_line_to(cr, x1, y1);
+            currentX = x1;
+            currentY = y1;
+            break;
+        case OBOF_PATH_QUAD:
+            if (!nextPoint(x1, y1) || !nextPoint(x2, y2))
+                return CAIRO_STATUS_SUCCESS;
+            // The quadratic as the cubic with the same curve.
+            cairo_curve_to(cr, currentX + 2 * (x1 - currentX) / 3, currentY + 2 * (y1 - currentY) / 3,
+                x2 + 2 * (x1 - x2) / 3, y2 + 2 * (y1 - y2) / 3, x2, y2);
+            currentX = x2;
+            currentY = y2;
+            break;
+        case OBOF_PATH_CUBIC:
+            if (!nextPoint(x1, y1) || !nextPoint(x2, y2) || !nextPoint(x3, y3))
+                return CAIRO_STATUS_SUCCESS;
+            cairo_curve_to(cr, x1, y1, x2, y2, x3, y3);
+            currentX = x3;
+            currentY = y3;
+            break;
+        case OBOF_PATH_CLOSE:
+            cairo_close_path(cr);
+            break;
+        }
+    }
+    cairo_fill(cr);
+    return CAIRO_STATUS_SUCCESS;
+}
+
+// Emoji in fonts that keep them as PNG images (CBDT, sbix): openfont.library
+// decodes the strike nearest the scaled font's size through the PNG
+// datatype, and the image is painted in em units, as the outline would be.
+// Other glyphs (and every glyph of other fonts) go to renderGlyph.
+static cairo_status_t renderColorGlyph(cairo_scaled_font_t* scaledFont, unsigned long glyph, cairo_t* cr, cairo_text_extents_t* extents)
+{
+    auto* data = cairoFaceData(scaledFont);
+    if (!data || !data->hasColorBitmaps)
+        return CAIRO_STATUS_USER_FONT_NOT_IMPLEMENTED;
+
+    cairo_matrix_t scale;
+    cairo_scaled_font_get_scale_matrix(scaledFont, &scale);
+    unsigned pixelSize = std::lround(std::hypot(scale.xy, scale.yy));
+
+    OBOFColorBitmap bitmap;
+    {
+        Locker locker { OpenFontFace::lock() };
+        if (!obof_glyph_color_bitmap(data->face, glyph, pixelSize, &bitmap))
+            return CAIRO_STATUS_USER_FONT_NOT_IMPLEMENTED;
+    }
+
+    // cairo's ARGB32 is premultiplied, in native byte order.
+    RefPtr<cairo_surface_t> image = adoptRef(cairo_image_surface_create(CAIRO_FORMAT_ARGB32, bitmap.width, bitmap.height));
+    if (cairo_surface_status(image.get()) != CAIRO_STATUS_SUCCESS) {
+        obof_free_color_bitmap(&bitmap);
+        return CAIRO_STATUS_SUCCESS;
+    }
+    cairo_surface_flush(image.get());
+    auto* rows = cairo_image_surface_get_data(image.get());
+    int stride = cairo_image_surface_get_stride(image.get());
+    for (uint32_t y = 0; y < bitmap.height; ++y) {
+        auto* row = reinterpret_cast<uint32_t*>(rows + y * stride);
+        for (uint32_t x = 0; x < bitmap.width; ++x) {
+            uint32_t pixel = bitmap.pixels[y * bitmap.width + x];
+            uint32_t alpha = pixel >> 24;
+            if (alpha == 255) {
+                row[x] = pixel;
+                continue;
+            }
+            auto premultiply = [alpha](uint32_t channel) { return (channel * alpha + 127) / 255; };
+            row[x] = (alpha << 24) | (premultiply((pixel >> 16) & 0xFF) << 16) | (premultiply((pixel >> 8) & 0xFF) << 8) | premultiply(pixel & 0xFF);
+        }
+    }
+    cairo_surface_mark_dirty(image.get());
+
+    double em = bitmap.ppem ? bitmap.ppem : 1;
+    extents->x_advance = advanceFromHorizontalMetrics(data->horizontalMetrics, data->horizontalMetricCount, glyph) / static_cast<double>(data->unitsPerEm);
+    extents->y_advance = 0;
+    extents->x_bearing = bitmap.left / em;
+    extents->y_bearing = -bitmap.top / em;
+    extents->width = bitmap.width / em;
+    extents->height = bitmap.height / em;
+    obof_free_color_bitmap(&bitmap);
+
+    cairo_save(cr);
+    cairo_translate(cr, extents->x_bearing, extents->y_bearing);
+    cairo_scale(cr, 1 / em, 1 / em);
+    cairo_set_source_surface(cr, image.get(), 0, 0);
+    cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_GOOD);
+    cairo_paint(cr);
+    cairo_restore(cr);
+    return CAIRO_STATUS_SUCCESS;
+}
+
+static void destroyCairoFaceData(void* pointer)
+{
+    auto* data = static_cast<OpenFontCairoFace*>(pointer);
+    {
+        Locker locker { OpenFontFace::lock() };
+        obof_close_face(data->face);
+    }
+    delete data;
+}
+
+OpenFontFace::OpenFontFace(OFFace* face, const String& familyName, unsigned unitsPerEm, unsigned weight, unsigned flags, unsigned glyphCount)
+    : m_face(face)
+    , m_familyName(familyName)
+    , m_unitsPerEm(unitsPerEm)
+    , m_weight(weight)
+    , m_glyphCount(glyphCount)
+    , m_isItalic(flags & OBOF_FACE_ITALIC)
+    , m_isFixedPitch(flags & OBOF_FACE_FIXED)
+    , m_hasColor(flags & OBOF_FACE_COLOR)
+{
+    auto horizontalHeader = table(tag('h', 'h', 'e', 'a'));
+    m_horizontalMetrics = table(tag('h', 'm', 't', 'x'));
+    m_horizontalMetricCount = std::min<unsigned>(readUInt16(horizontalHeader, 34), m_horizontalMetrics.size() / 4);
+
+    auto* data = new OpenFontCairoFace;
+    data->face = face;
+    data->unitsPerEm = unitsPerEm;
+    data->horizontalMetrics = m_horizontalMetrics;
+    data->horizontalMetricCount = m_horizontalMetricCount;
+    data->hasColorBitmaps = !table(tag('C', 'B', 'D', 'T')).empty() || !table(tag('s', 'b', 'i', 'x')).empty();
+    double em = unitsPerEm;
+    int ascender = readInt16(horizontalHeader, 4);
+    int descender = readInt16(horizontalHeader, 6);
+    data->extents.ascent = ascender / em;
+    data->extents.descent = -descender / em;
+    data->extents.height = (ascender - descender + readInt16(horizontalHeader, 8)) / em;
+    data->extents.max_x_advance = readUInt16(horizontalHeader, 10) / em;
+    data->extents.max_y_advance = 0;
+
+    m_cairoFontFace = adoptRef(cairo_user_font_face_create());
+    cairo_user_font_face_set_init_func(m_cairoFontFace.get(), initScaledFont);
+    cairo_user_font_face_set_render_glyph_func(m_cairoFontFace.get(), renderGlyph);
+    if (data->hasColorBitmaps)
+        cairo_user_font_face_set_render_color_glyph_func(m_cairoFontFace.get(), renderColorGlyph);
+    if (cairo_font_face_set_user_data(m_cairoFontFace.get(), &openFontCairoFaceKey, data, destroyCairoFaceData) != CAIRO_STATUS_SUCCESS)
+        destroyCairoFaceData(data);
+}
+
+// The cairo face closes the OFFace when it goes.
+OpenFontFace::~OpenFontFace() = default;
+
+RefPtr<OpenFontFace> OpenFontFace::adopt(OFFace* face, bool shareInstalled)
+{
+    if (!face)
+        return nullptr;
+
+    OBOFFaceInfo info;
+    if (!obof_face_info(face, &info) || !info.unitsPerEm || !obof_set_size(face, info.unitsPerEm)) {
+        obof_close_face(face);
+        return nullptr;
+    }
+    String familyName = String::fromUTF8(info.family);
+
+    // Two lookups (an alias and its family, two weights that come to one
+    // face) give one OpenFontFace, so the font's data is in memory once
+    // and FontPlatformData compares equal.
+    static Lock lock;
+    static NeverDestroyed<HashMap<String, RefPtr<OpenFontFace>>> installedFaces;
+    String key;
+    if (shareInstalled) {
+        key = makeString(familyName, '|', String::fromUTF8(info.style), '|', info.weight, '|', info.flags, '|', info.numGlyphs);
+        Locker locker { lock };
+        if (auto existing = installedFaces->get(key)) {
+            obof_close_face(face);
+            return existing;
+        }
+    }
+
+    RefPtr openFontFace = adoptRef(*new OpenFontFace(face, familyName, info.unitsPerEm, info.weight, info.flags, info.numGlyphs));
+    if (shareInstalled) {
+        Locker locker { lock };
+        installedFaces->add(key, openFontFace);
+    }
+    return openFontFace;
+}
+
+static Lock lookupLock;
+
+RefPtr<OpenFontFace> OpenFontFace::forFamily(const String& family, unsigned weight, bool italic)
+{
+    // Finding a face reads the font index and opens a file, slow on a 68k,
+    // and pages ask for the same few families in many sizes: remember each
+    // answer, found or not.
+    static NeverDestroyed<HashMap<String, RefPtr<OpenFontFace>>> answers;
+    String key = makeString(family.convertToASCIILowercase(), '|', weight, '|', italic ? 1 : 0);
+    {
+        Locker locker { lookupLock };
+        auto it = answers->find(key);
+        if (it != answers->end())
+            return it->value;
+    }
+
+    RefPtr face = adopt(obof_find_face(family.utf8().legacyCStringPointer(), weight, italic), true);
+    Locker locker { lookupLock };
+    answers->set(key, face);
+    return face;
+}
+
+RefPtr<OpenFontFace> OpenFontFace::defaultFace(unsigned weight, bool italic)
+{
+    static NeverDestroyed<HashMap<unsigned, RefPtr<OpenFontFace>>> answers;
+    unsigned key = weight * 2 + (italic ? 1 : 0);
+    {
+        Locker locker { lookupLock };
+        auto it = answers->find(key);
+        if (it != answers->end())
+            return it->value;
+    }
+
+    RefPtr face = adopt(obof_find_face(nullptr, weight, italic), true);
+    Locker locker { lookupLock };
+    answers->set(key, face);
+    return face;
+}
+
+RefPtr<OpenFontFace> OpenFontFace::forCharacter(char32_t character, unsigned weight, bool italic)
+{
+    static NeverDestroyed<HashMap<String, RefPtr<OpenFontFace>>> answers;
+    String key = makeString(static_cast<unsigned>(character), '|', weight, '|', italic ? 1 : 0);
+    {
+        Locker locker { lookupLock };
+        auto it = answers->find(key);
+        if (it != answers->end())
+            return it->value;
+    }
+
+    RefPtr face = adopt(obof_find_face_for_char(character, weight, italic), true);
+    Locker locker { lookupLock };
+    answers->set(key, face);
+    return face;
+}
+
+RefPtr<OpenFontFace> OpenFontFace::createFromMemory(std::span<const uint8_t> data)
+{
+    return adopt(obof_open_face_memory(data.data(), data.size()), false);
+}
+
+RecursiveLock& OpenFontFace::lock()
+{
+    static RecursiveLock s_lock;
+    return s_lock;
+}
+
+Glyph OpenFontFace::glyphForCharacter(char32_t character) const
+{
+    Locker locker { lock() };
+    uint32_t glyph = obof_char_index(m_face, character);
+    return glyph <= std::numeric_limits<Glyph>::max() ? glyph : 0;
+}
+
+unsigned OpenFontFace::advance(Glyph glyph) const
+{
+    return advanceFromHorizontalMetrics(m_horizontalMetrics, m_horizontalMetricCount, glyph);
+}
+
+std::span<const uint8_t> OpenFontFace::table(uint32_t tableTag) const
+{
+    Locker locker { lock() };
+    uint32_t length = 0;
+    const uint8_t* data = obof_table(m_face, tableTag, &length);
+    if (!data)
+        return { };
+    return unsafeMakeSpan(data, length);
+}
+
+bool OpenFontFace::glyphBounds(Glyph glyph, FloatRect& bounds) const
+{
+    Locker locker { lock() };
+    int32_t box[4];
+    if (!obof_glyph_extents(m_face, glyph, box) || box[2] <= 0 || box[3] <= 0)
+        return false;
+    bounds = FloatRect(box[0] / 64.f, -box[1] / 64.f, box[2] / 64.f, box[3] / 64.f);
+    return true;
+}
+
+} // namespace WebCore
+
+#endif // USE(OPENFONT)
