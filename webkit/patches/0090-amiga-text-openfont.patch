+}
+
+FontPlatformData::IPCData FontPlatformData::toIPCData() const
+{
+    ASSERT_NOT_REACHED();
+    return FontPlatformSerializedData { };
+}
+
+} // namespace WebCore
+
+#endif // USE(OPENFONT) && USE(CAIRO)
