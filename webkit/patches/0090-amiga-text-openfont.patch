+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/text/WTFString.h>
+
+struct OFFace;
+
+namespace WebCore {
+
+class FloatRect;
+
+// One face of openfont.library, as WebCore's fonts use it: opened once and
+// kept at a pixel size equal to its units per em, so the library's 26.6
+// values are font units times 64 and every CSS size is a scale of them.
+// Glyphs are drawn through a cairo user font face whose callbacks fill the
+// face's outlines; that cairo face owns the OFFace and closes it when the
+// last scaled font made from it goes.
+class OpenFontFace : public ThreadSafeRefCounted<OpenFontFace> {
+public:
+    // The face for an installed family (or an alias of it, such as Arial
+    // for Liberation Sans), weight and slant, or null when the family is
+    // not installed. The answers, found or not, are remembered.
+    static RefPtr<OpenFontFace> forFamily(const String& family, unsigned weight, bool italic);
+    // The default face (sans-serif), null only with no fonts at all.
+    static RefPtr<OpenFontFace> defaultFace(unsigned weight, bool italic);
+    // An installed face that has a glyph for character, or null.
+    static RefPtr<OpenFontFace> forCharacter(char32_t, unsigned weight, bool italic);
+    // A web font's face, from its file in memory.
+    static RefPtr<OpenFontFace> createFromMemory(std::span<const uint8_t>);
+
+    ~OpenFontFace();
+
+    // An OFFace keeps glyph and shaping state, so calls on faces are made
+    // one at a time, as the FreeType ports do with cairoFontLock(); painting
+    // and OffscreenCanvas text can run on other threads.
+    static RecursiveLock& lock();
+
+    OFFace* face() const { return m_face; }
+    cairo_font_face_t* cairoFontFace() const { return m_cairoFontFace.get(); }
+
+    const String& familyName() const LIFETIME_BOUND { return m_familyName; }
+    unsigned unitsPerEm() const { return m_unitsPerEm; }
+    unsigned weight() const { return m_weight; }
+    bool isItalic() const { return m_isItalic; }
+    bool isFixedPitch() const { return m_isFixedPitch; }
+    bool hasColor() const { return m_hasColor; }
+    unsigned glyphCount() const { return m_glyphCount; }
+
+    Glyph glyphForCharacter(char32_t) const;
+    // Font units, from hmtx: the advance before shaping.
+    unsigned advance(Glyph) const;
+    // A table of the font as it is in the file, or an empty span.
+    std::span<const uint8_t> table(uint32_t tag) const;
+    // The glyph's ink box in font units, y down; false when it has none.
+    bool glyphBounds(Glyph, FloatRect&) const;
+
+    static constexpr uint32_t tag(char a, char b, char c, char d)
+    {
+        return (static_cast<uint32_t>(static_cast<uint8_t>(a)) << 24) | (static_cast<uint32_t>(static_cast<uint8_t>(b)) << 16)
+            | (static_cast<uint32_t>(static_cast<uint8_t>(c)) << 8) | static_cast<uint32_t>(static_cast<uint8_t>(d));
+    }
+
+private:
+    static RefPtr<OpenFontFace> adopt(OFFace*, bool shareInstalled);
+    OpenFontFace(OFFace*, const String& familyName, unsigned unitsPerEm, unsigned weight, unsigned flags, unsigned glyphCount);
+
+    OFFace* m_face { nullptr };
+    RefPtr<cairo_font_face_t> m_cairoFontFace;
+    String m_familyName;
+    unsigned m_unitsPerEm { 1000 };
+    unsigned m_weight { 400 };
+    unsigned m_glyphCount { 0 };
+    bool m_isItalic { false };
+    bool m_isFixedPitch { false };
+    bool m_hasColor { false };
+    // hmtx's longHorMetric array, and how many entries it has (hhea).
+    std::span<const uint8_t> m_horizontalMetrics;
+    unsigned m_horizontalMetricCount { 0 };
+};
+
+} // namespace WebCore
+
+#endif // USE(OPENFONT)
