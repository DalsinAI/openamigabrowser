+# Text on openfont.library (USE_OPENFONT): faces, metrics, glyph pages,
+# web fonts and shaping, in place of FreeType, fontconfig and HarfBuzz.
+# Glyphs are drawn through cairo user fonts that fill OpenFont's outlines.
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    "${WEBCORE_DIR}/platform/graphics/openfont"
+)
+
+list(APPEND WebCore_SOURCES
+    platform/graphics/openfont/ComplexTextControllerOpenFont.cpp
+    platform/graphics/openfont/FontCacheOpenFont.cpp
+    platform/graphics/openfont/FontCustomPlatformDataOpenFont.cpp
+    platform/graphics/openfont/FontPlatformDataOpenFont.cpp
+    platform/graphics/openfont/GlyphPageTreeNodeOpenFont.cpp
+    platform/graphics/openfont/OpenFontFace.cpp
+    platform/graphics/openfont/OpenFontLibrary.c
+    platform/graphics/openfont/SimpleFontDataOpenFont.cpp
+
+    # Shared with the FreeType ports; neither file uses FreeType or HarfBuzz.
+    platform/graphics/harfbuzz/FontDescriptionHarfBuzz.cpp
+)
+
+list(APPEND WebCore_PRIVATE_FRAMEWORK_HEADERS
+    platform/graphics/openfont/OpenFontFace.h
+    platform/graphics/openfont/OpenFontLibrary.h
+)
+
+if (USE_CAIRO)
+    list(APPEND WebCore_SOURCES
+        platform/graphics/cairo/FontCairoHarfbuzzNG.cpp
+    )
+endif ()
+
+list(APPEND WebCore_LIBRARIES
+    OpenFont::OpenFont
+)
