+static inline void setAttributes(Element* element, Vector<Attribute>& attributeVector, OptionSet<ParserContentPolicy> parserContentPolicy)
+{
+    if (!scriptingContentIsAllowed(parserContentPolicy))
+        element->stripScriptingAttributes(attributeVector);
+    element->parserSetAttributes(attributeVector.span());
+}
+
+// The pieces WebKit feeds are UTF-16 in the CPU's byte order, whatever the
+// document's XML declaration says (the declaration has been read already, by
+// the text decoder).
+static oxp_encoding nativeUTF16()
+{
+    const unsigned char byteOrderMarkHighByte = *reinterpret_cast<const unsigned char*>(&byteOrderMark);
+    return byteOrderMarkHighByte == 0xFF ? OXP_ENC_UTF16LE : OXP_ENC_UTF16BE;
+}
+
+struct XMLDocumentParserProtector {
+    explicit XMLDocumentParserProtector(XMLDocumentParser& parser)
+        : protectedParser(parser)
+    {
+    }
+    Ref<XMLDocumentParser> protectedParser;
+};
+
+using OXPParserBridge = OXPBridge::Bridge<XMLDocumentParser, XMLDocumentParserProtector>;
+
+XMLParserContext::XMLParserContext(XMLDocumentParser& parser, unsigned options, oxp_encoding encoding)
+    : m_bridge(std::make_unique<OXPParserBridge>(parser))
+{
+    m_parser = oxp_new(&OXPParserBridge::handler(), m_bridge.get(), nullptr);
+    RELEASE_ASSERT(m_parser);
+    // An undeclared prefix is an error the parse goes on from, with no
+    // namespace, as with libxml2; startElementNs fills it in for a fragment.
+    oxp_set_options(m_parser, options | OXP_OPT_UNBOUND_PREFIX);
+    if (encoding != OXP_ENC_AUTO)
+        oxp_set_encoding(m_parser, encoding);
+    // WebKit's entity limit (maximumXMLParserEntityExpansionCount): the
+    // references expanded inside one entity reference's text.
+    oxp_limits limits { };
+    limits.max_entity_refs = static_cast<unsigned long>(std::clamp<uint64_t>(parser.maxEntityExpansionCount(), 1, std::numeric_limits<unsigned long>::max()));
+    oxp_set_limits(m_parser, &limits);
+}
