+
+#[=======================================================================[.rst:
+FindOXP
+-------
+
+Find OXP, the Open XML Parser (DalsinAI/openamigaxml, ``oxp/``): ``oxp.h``
+and ``liboxp.a`` (its ``build-amiga.sh`` writes both).
+
+Imported Targets
+^^^^^^^^^^^^^^^^
+
+``OXP::OXP``
+  The OXP library, if found.
+
+Result Variables
+^^^^^^^^^^^^^^^^
+
+``OXP_FOUND``
+  true if (the requested version of) OXP is available.
+``OXP_VERSION``
+  the version of OXP (major.minor, from ``oxp.h``).
+``OXP_LIBRARIES``
+  the libraries to link against to use OXP.
+``OXP_INCLUDE_DIRS``
+  where to find ``oxp.h``.
+
+#]=======================================================================]
+
+find_path(OXP_INCLUDE_DIR NAMES oxp.h)
+find_library(OXP_LIBRARY NAMES oxp)
+
+if (OXP_INCLUDE_DIR AND EXISTS "${OXP_INCLUDE_DIR}/oxp.h")
+    file(READ "${OXP_INCLUDE_DIR}/oxp.h" _OXP_HEADER)
+    string(REGEX MATCH "#define +OXP_VERSION_MAJOR +([0-9]+)" _dummy "${_OXP_HEADER}")
+    set(_OXP_MAJOR "${CMAKE_MATCH_1}")
+    string(REGEX MATCH "#define +OXP_VERSION_MINOR +([0-9]+)" _dummy "${_OXP_HEADER}")
+    set(_OXP_MINOR "${CMAKE_MATCH_1}")
+    set(OXP_VERSION "${_OXP_MAJOR}.${_OXP_MINOR}")
+    unset(_OXP_HEADER)
+endif ()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(OXP
+    FOUND_VAR OXP_FOUND
+    REQUIRED_VARS OXP_LIBRARY OXP_INCLUDE_DIR
+    VERSION_VAR OXP_VERSION
+)
+
+if (OXP_LIBRARY AND NOT TARGET OXP::OXP)
+    add_library(OXP::OXP UNKNOWN IMPORTED GLOBAL)
+    set_target_properties(OXP::OXP PROPERTIES
+        IMPORTED_LOCATION "${OXP_LIBRARY}"
+        INTERFACE_INCLUDE_DIRECTORIES "${OXP_INCLUDE_DIR}"
+    )
+endif ()
+
+mark_as_advanced(OXP_INCLUDE_DIR OXP_LIBRARY)
+
+if (OXP_FOUND)
+    set(OXP_LIBRARIES ${OXP_LIBRARY})
+    set(OXP_INCLUDE_DIRS ${OXP_INCLUDE_DIR})
+endif ()
