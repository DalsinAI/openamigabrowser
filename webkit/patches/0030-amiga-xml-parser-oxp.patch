+void XMLDocumentParser::internalSubset(const xmlChar* name, const xmlChar* externalID, const xmlChar* systemID)
+{
+    if (isStopped())
+        return;
+
+    if (m_parserPaused) {
+        m_pendingCallbacks->appendInternalSubsetCallback(name, externalID, systemID);
+        return;
+    }
+
+    if (RefPtr document = this->document())
+        document->parserAppendChild(DocumentType::create(*document, toString(name), toString(externalID), toString(systemID)));
+}
+
+// An entity no declaration gives: in a document with one of the XHTML (or
+// MathML) DTDs, the HTML named character references. OXP parses the text it
+// is given as content, so '&' and '<' go back as character references.
+const char* XMLDocumentParser::resolveEntity(const char* name)
+{
+    if (!isXHTMLDocument())
+        return nullptr;
+
+    auto decodedEntity = decodeNamedHTMLEntityForXMLParser(name);
+    if (decodedEntity.failed())
+        return nullptr;
+
+    auto utf16DecodedEntity = decodedEntity.span();
+    auto& result = m_xhtmlEntityText;
+    auto set = [&](std::initializer_list<char> bytes) {
+        size_t i = 0;
+        for (char byte : bytes)
+            result[i++] = byte;
+        result[i] = 0;
+    };
+    // Unlike the HTML parser, the XML parser parses an entity's text, so '&'
+    // and '<' are given as character references.
+    if (utf16DecodedEntity.size() == 1 && utf16DecodedEntity[0] == '&')
+        set({ '&', '#', '3', '8', ';' });
+    else if (utf16DecodedEntity.size() == 1 && utf16DecodedEntity[0] == '<')
+        set({ '&', '#', 'x', '3', 'C', ';' });
+    else if (utf16DecodedEntity.size() == 2 && utf16DecodedEntity[0] == '<' && utf16DecodedEntity[1] == 0x20D2)
+        set({ '&', '#', '6', '0', ';', static_cast<char>(0xE2), static_cast<char>(0x83), static_cast<char>(0x92) });
+    else {
+        ASSERT(utf16DecodedEntity.size() <= 4);
+        auto converted = WTF::Unicode::convert(utf16DecodedEntity, byteCast<char8_t>(std::span { result }).first(result.size() - 1));
+        if (converted.code != WTF::Unicode::ConversionResultCode::Success)
+            return nullptr;
+        result[converted.buffer.size()] = 0;
+    }
+    return result.data();
+}
+
+void XMLDocumentParser::initializeParserContext(const UTF8CString&)
+{
+    DocumentParser::startParsing();
+    m_sawError = false;
+    m_sawCSS = false;
+    m_sawXSLTransform = false;
+    m_sawFirstElement = false;
+
+    if (m_parsingFragment)
+        m_context = XMLParserContext::createMemoryParser(*this);
+    else
+        m_context = XMLParserContext::createStringParser(*this);
+}
+
+void XMLDocumentParser::doEnd()
+{
+    if (!isStopped()) {
+        if (m_context) {
+            // Tell OXP we're done.
+            oxp_parse(context(), nullptr, 0, 1);
+            m_context = nullptr;
+        }
+    }
+}
