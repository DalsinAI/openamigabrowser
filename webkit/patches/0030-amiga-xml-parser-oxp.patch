+ * ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+// OXP's events, turned into the calls XMLDocumentParser has always taken
+// from libxml2's SAX2 interface: the same arguments, in the same shapes
+// (namespaces as prefix/URI pairs, attributes as localname/prefix/URI/value/
+// end quintuples, the defaulted attributes last, libxml2's standalone values).
+// So XMLDocumentParser's own logic stays as it is, and this file can be
+// tested on its own against libxml2 (it uses only the C++ standard library).
+
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+#include <oxp.h>
+#include <span>
+#include <vector>
+
+namespace WebCore {
+namespace OXPBridge {
+
+using Char = unsigned char;
+
+// XMLErrors::Type's order: Warning, NonFatal, Fatal.
+enum class ErrorType { Warning, NonFatal, Fatal };
+
+// libxml2's values for the standalone argument of startDocument.
+constexpr int StandaloneUnspecified = -2;
+constexpr int NoXMLDeclaration = -1;
+
+// The public identifiers of the DTDs whose documents may use the HTML named
+// character references (the same list WebKit checked in libxml2's
+// externalSubset callback).
+inline bool isXHTMLPublicIdentifier(const char* id)
+{
+    if (!id)
+        return false;
+    static const char* const ids[] = {
+        "-//W3C//DTD XHTML 1.0 Transitional//EN",
+        "-//W3C//DTD XHTML 1.1//EN",
+        "-//W3C//DTD XHTML 1.0 Strict//EN",
+        "-//W3C//DTD XHTML 1.0 Frameset//EN",
+        "-//W3C//DTD XHTML Basic 1.0//EN",
+        "-//W3C//DTD XHTML 1.1 plus MathML 2.0//EN",
+        "-//W3C//DTD XHTML 1.1 plus MathML 2.0 plus SVG 1.1//EN",
+        "-//W3C//DTD MathML 2.0//EN",
+        "-//WAPFORUM//DTD XHTML Mobile 1.0//EN",
+        "-//WAPFORUM//DTD XHTML Mobile 1.1//EN",
+        "-//WAPFORUM//DTD XHTML Mobile 1.2//EN",
+    };
+    for (auto* candidate : ids) {
+        if (!std::strcmp(id, candidate))
+            return true;
+    }
+    return false;
+}
+
+// Receiver: anything with XMLDocumentParser's SAX methods:
+//   startElementNs(localName, prefix, uri, numNamespaces, namespaces, numAttributes, numDefaulted, attributes)
+//   endElementNs(), characters(span), cdataBlock(span), comment(text), processingInstruction(target, data)
+//   startDocument(version, encoding, standalone), endDocument()
+//   internalSubset(name, externalID, systemID), setIsXHTMLDocument(bool)
+//   const char* resolveEntity(const char* name)
+//   reportError(ErrorType, const char* message, unsigned long line, unsigned long column)
+// Guard: made from the receiver for the length of each call, so a receiver
+// that counts its references can keep itself alive while JavaScript run by a
+// callback detaches it (XMLDocumentParser's protect(), as with libxml2).
+struct NoGuard {
+    template<typename Receiver> explicit NoGuard(Receiver&) { }
+};
+
+template<typename Receiver, typename Guard = NoGuard>
+class Bridge {
+public:
+    explicit Bridge(Receiver& receiver)
+        : m_receiver(receiver)
+    {
+    }
+
+    static const oxp_handler& handler()
+    {
+        static const oxp_handler h = {
+            startDocument, endDocument, doctype, nullptr, nullptr, startElement, endElement,
+            characters, cdata, comment, processingInstruction, nullptr, resolveEntity, error
+        };
+        return h;
+    }
+
+private:
+    static Bridge& self(void* ud) { return *static_cast<Bridge*>(ud); }
+#define OXP_BRIDGE_GUARD(ud) Guard guard(self(ud).m_receiver)
+    static const Char* chars(const char* s) { return reinterpret_cast<const Char*>(s); }
+
+    static void startDocument(void* ud, const char* version, const char* encoding, int standalone)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        int libxmlStandalone = !version ? NoXMLDeclaration : standalone < 0 ? StandaloneUnspecified : standalone;
+        self(ud).m_receiver.startDocument(chars(version), chars(encoding), libxmlStandalone);
+    }
+
+    static void endDocument(void* ud)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        self(ud).m_receiver.endDocument();
+    }
+
+    static void doctype(void* ud, const char* name, const char* publicId, const char* systemId, int)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        auto& receiver = self(ud).m_receiver;
+        receiver.internalSubset(chars(name), chars(publicId), chars(systemId));
+        if (isXHTMLPublicIdentifier(publicId))
+            receiver.setIsXHTMLDocument(true);
+    }
+
+    static void startElement(void* ud, const char* local, const char* prefix, const char* uri, int numNamespaces, const oxp_ns* ns, int numAttributes, const oxp_attr* attrs)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        auto& bridge = self(ud);
+        bridge.m_namespaces.resize(static_cast<size_t>(numNamespaces) * 2);
+        for (int i = 0; i < numNamespaces; ++i) {
+            bridge.m_namespaces[2 * i] = chars(ns[i].prefix);
+            bridge.m_namespaces[2 * i + 1] = chars(ns[i].uri);
+        }
+        // libxml2 gives the attributes from the tag first and the defaulted ones last; so does OXP.
+        int numDefaulted = 0;
+        bridge.m_attributes.resize(static_cast<size_t>(numAttributes) * 5);
+        for (int i = 0; i < numAttributes; ++i) {
+            bridge.m_attributes[5 * i] = chars(attrs[i].local);
+            bridge.m_attributes[5 * i + 1] = chars(attrs[i].prefix);
+            bridge.m_attributes[5 * i + 2] = chars(attrs[i].uri);
+            bridge.m_attributes[5 * i + 3] = chars(attrs[i].value);
+            bridge.m_attributes[5 * i + 4] = chars(attrs[i].value) + attrs[i].value_len;
+            numDefaulted += attrs[i].defaulted ? 1 : 0;
+        }
+        bridge.m_receiver.startElementNs(chars(local), chars(prefix), chars(uri), numNamespaces, bridge.m_namespaces.data(),
+            numAttributes, numDefaulted, bridge.m_attributes.data());
+    }
+
+    static void endElement(void* ud, const char*, const char*, const char*)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        self(ud).m_receiver.endElementNs();
+    }
+
+    static void characters(void* ud, const char* text, size_t length)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        self(ud).m_receiver.characters(std::span<const Char>(chars(text), length));
+    }
+
+    static void cdata(void* ud, const char* text, size_t length)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        self(ud).m_receiver.cdataBlock(std::span<const Char>(chars(text), length));
+    }
+
+    static void comment(void* ud, const char* text)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        self(ud).m_receiver.comment(chars(text));
+    }
+
+    static void processingInstruction(void* ud, const char* target, const char* data)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        self(ud).m_receiver.processingInstruction(chars(target), chars(data));
+    }
+
+    static const char* resolveEntity(void* ud, const char* name)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        return self(ud).m_receiver.resolveEntity(name);
+    }
+
+    static void error(void* ud, oxp_level level, oxp_code, const char* message, unsigned long line, unsigned long column)
+    {
+        OXP_BRIDGE_GUARD(ud);
+        ErrorType type = level == OXP_FATAL ? ErrorType::Fatal : level == OXP_ERROR ? ErrorType::NonFatal : ErrorType::Warning;
+        self(ud).m_receiver.reportError(type, message, line, column);
+    }
+
+#undef OXP_BRIDGE_GUARD
+
+    Receiver& m_receiver;
+    std::vector<const Char*> m_namespaces;
+    std::vector<const Char*> m_attributes;
+};
+
+} // namespace OXPBridge
+} // namespace WebCore
