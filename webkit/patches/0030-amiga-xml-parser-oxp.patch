+TextPosition XMLDocumentParser::textPosition() const
+{
+    oxp_parser* context = this->context();
+    if (!context)
+        return TextPosition();
+    return TextPosition(OrdinalNumber::fromOneBasedInt(static_cast<int>(oxp_line(context))),
+                        OrdinalNumber::fromOneBasedInt(static_cast<int>(oxp_column(context))));
+}
