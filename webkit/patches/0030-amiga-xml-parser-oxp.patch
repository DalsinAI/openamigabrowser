+bool XMLDocumentParser::shouldAssociateConsoleMessagesWithTextPosition() const
+{
+    return !m_parserPaused && !m_requestingScript;
+}
+
+void XMLDocumentParser::stopParsing()
+{
+    if (m_sawError)
+        insertErrorMessageBlock();
+
+    DocumentParser::stopParsing();
+    if (context())
+        oxp_stop(context());
+}
+
+void XMLDocumentParser::resumeParsing()
+{
+    ASSERT(!isDetached());
+    ASSERT(m_parserPaused);
+
+    m_parserPaused = false;
+
+    // First, execute any pending callbacks
+    while (!m_pendingCallbacks->isEmpty()) {
+        m_pendingCallbacks->callAndRemoveFirstCallback(this);
+
+        // A callback paused the parser
+        if (m_parserPaused)
+            return;
+    }
+
+    // There is normally only one string left, so toString() shouldn't copy.
+    // In any case, the XML parser runs on the main thread and it's OK if
+    // the passed string has more than one reference.
+    auto rest = m_pendingSrc.toString();
+    m_pendingSrc.clear();
+    append(rest.impl());
+
+    // Finally, if finish() has been called and write() didn't result
+    // in any further callbacks being queued, call end()
+    if (m_finishCalled && m_pendingCallbacks->isEmpty())
+        end();
+}
+
+bool XMLDocumentParser::appendFragmentSource(const String& chunk)
+{
+    ASSERT(!m_context);
+    ASSERT(m_parsingFragment);
+
+    m_fragmentSource = chunk.utf8();
+
+    initializeParserContext();
+    oxp_parse(context(), m_fragmentSource.legacyCStringPointer(), m_fragmentSource.length(), 1);
+    endDocument(); // Close any open text nodes.
+
+    // No error if the chunk is well formed, or if what is wrong is only an
+    // undeclared prefix (which libxml2 did not count against well-formedness).
+    return oxp_error(context(), nullptr, nullptr, nullptr) == OXP_OK;
+}
+
+// --------------------------------
+
+using AttributeParseState = std::optional<HashMap<String, String>>;
+
+static void attributesStartElement(void* closure, const char* localName, const char*, const char*, int, const oxp_ns*, int numAttributes, const oxp_attr* attributes)
+{
+    if (!equalSpans(unsafeSpan(localName), "attrs"_span))
+        return;
+
+    auto& state = *static_cast<AttributeParseState*>(closure);
+    state = HashMap<String, String> { };
+
+    for (auto& attribute : unsafeMakeSpan(attributes, numAttributes)) {
+        String attrLocalName = String::fromUTF8(attribute.local);
+        String attrValue = String::fromUTF8(unsafeMakeSpan(attribute.value, attribute.value_len));
+        String attrPrefix = String::fromUTF8(attribute.prefix);
+        String attrQName = attrPrefix.isEmpty() ? attrLocalName : makeString(attrPrefix, ':', attrLocalName);
+        state->set(attrQName, attrValue);
+    }
+}
+
+std::optional<HashMap<String, String>> parseAttributes(CachedResourceLoader&, const String& string)
+{
+    auto parseString = makeString("<attrs "_s, string, " />"_s).utf8();
+
+    AttributeParseState attributes;
+
+    oxp_handler handler { };
+    handler.start_element = attributesStartElement;
+    oxp_parse_memory(&handler, &attributes, parseString.legacyCStringPointer(), parseString.length(), OXP_OPT_UNBOUND_PREFIX);
+    return attributes;
+}
+
+} // namespace WebCore
+
+#endif // USE(OXP)
