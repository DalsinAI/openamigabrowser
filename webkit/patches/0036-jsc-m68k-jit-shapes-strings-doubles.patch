+    // get_by_id for one cache mode, a0 the object and a1 the cache.
+    void getByIdMode(GetByIdMode mode, const Operand& dst)
+    {
+        auto load = [&](int d8) {
+            m_hot.copyIndexedToFrame(0, 1, d8, dst.hi);
+            m_hot.copyIndexedToFrame(0, 1, d8 + 4, dst.lo);
+        };
+        m_hot.loadDisp(0, JSCell::structureIDOffset(), 1);
+        m_hot.cmpDisp(1, OBJECT_OFFSETOF(GetByIdModeMetadata, defaultMode), 1);
+        m_tableMiss->append(m_hot.branch(Builder::NotEqual));
+        switch (mode) {
+        case GetByIdMode::Default:
+            m_hot.loadDisp(1, OBJECT_OFFSETOF(GetByIdModeMetadata, defaultMode) + OBJECT_OFFSETOF(GetByIdModeMetadataDefault, cachedOffset), 1);
+            withProperty(load);
+            break;
+        case GetByIdMode::ProtoLoad:
+            // The property of the object the cache holds (the slot's first
+            // word, on a big-endian CPU with 32-bit pointers).
+            m_hot.loadDisp(1, OBJECT_OFFSETOF(GetByIdModeMetadata, protoLoadMode) + OBJECT_OFFSETOF(GetByIdModeMetadataProtoLoad, cachedOffset), 1);
+            m_hot.moveaDisp(1, OBJECT_OFFSETOF(GetByIdModeMetadata, protoLoadMode) + OBJECT_OFFSETOF(GetByIdModeMetadataProtoLoad, cachedSlot), 0);
+            withProperty(load);
+            break;
+        default: {
+            uint64_t undefined = JSValue::encode(jsUndefined());
+            m_hot.storeFrameImm(static_cast<uint32_t>(undefined >> 32), dst.hi);
+            m_hot.storeFrameImm(static_cast<uint32_t>(undefined), dst.lo);
+            break;
+        }
+        }
+    }
+    // The out-of-line part: the other modes, a0 and a1 as the hot code left
+    // them; then on to the next instruction (emitFloatPath).
+    void getByIdOtherModes(const FloatPath& floatPath)
+    {
+        Vector<size_t> tableMiss = floatPath.tableBranches;
+        m_tableMiss = &tableMiss;
+        Vector<size_t, 3> done;
+        for (GetByIdMode mode : { GetByIdMode::Default, GetByIdMode::ProtoLoad, GetByIdMode::Unset }) {
+            if (mode == floatPath.getByIdMode)
+                continue;
+            m_hot.cmpByteImmDisp(static_cast<uint8_t>(mode), 1, GetByIdModeMetadata::offsetOfMode());
+            size_t next = m_hot.branch(Builder::NotEqual);
+            getByIdMode(mode, floatPath.dst);
+            done.append(m_hot.branch(Builder::Always));
+            m_hot.bindBranch(next);
+        }
+        slowUnless(Builder::Always);
+        // Another structure: the table (d1 the structure ID, a0 the object).
+        for (size_t i : tableMiss)
+            m_hot.bindBranch(i);
+        m_tableFixups.append({ m_hot.moveaCodeAddress(1), floatPath.getByIdTable, OBJECT_OFFSETOF(GetByIdTable, entries) });
+        Vector<size_t, getByIdTableEntries> hits;
+        for (unsigned i = 0; i < getByIdTableEntries; ++i) {
+            m_hot.word(0xb299); // cmp.l (a1)+,d1
+            hits.append(m_hot.branchShort(Builder::Equal));
+            if (i + 1 < getByIdTableEntries) {
+                m_hot.word(0x43e9); m_hot.word(sizeof(GetByIdTable::Entry) - 4); // lea 12(a1),a1
+            }
+        }
+        slowUnless(Builder::Always);
+        for (size_t i : hits)
+            m_hot.bindShort(i);
+        // a1 at the entry's offset: a value, or a getter to call.
+        m_hot.word(0x4aa9); m_hot.word(OBJECT_OFFSETOF(GetByIdTable::Entry, holder) - 4); // tst.l holder(a1)
+        size_t getter = m_hot.branch(Builder::NotEqual);
+        m_hot.word(0x2211); // move.l (a1),d1: the offset
+        withProperty([&](int d8) {
+            m_hot.copyIndexedToFrame(0, 1, d8, floatPath.dst.hi);
+            m_hot.copyIndexedToFrame(0, 1, d8 + 4, floatPath.dst.lo);
+        });
+        done.append(m_hot.branch(Builder::Always));
+        m_hot.bindBranch(getter);
+        done.append(getterCall(floatPath));
+        for (size_t i : done)
+            m_hot.bindBranch(i);
+    }
+
+    // A getter from the table (a0 the object, a1 at the entry's offset):
+    // called as op_call calls (call), when it is a function with compiled
+    // code, with a frame below this one's; anything else is the slow path.
+    // Returns a branch to the end, for a missing property.
+    size_t getterCall(const FloatPath& floatPath)
+    {
+        constexpr int slot = sizeof(Register);
+        int frameSize = static_cast<int>(m_codeBlock->numCalleeLocals()) * slot + static_cast<int>(maxFrameExtentForSlowPathCall);
+        int frame = -frameSize - static_cast<int>(roundUpToMultipleOf(stackAlignmentBytes(), (static_cast<unsigned>(CallFrameSlot::thisArgument) + 1) * slot));
+        // A frame too far down for a displacement: the slow path.
+        if (frame < -32768) {
+            slowUnless(Builder::Always);
+            return m_hot.branch(Builder::Always);
+        }
+        uint32_t* lr = reinterpret_cast<uint32_t*>(&jsc_m68k_vrf[m68kSlotLR]);
+        uint32_t* sp = reinterpret_cast<uint32_t*>(&jsc_m68k_vrf[m68kSlotSP]);
+        uint32_t* t0High = reinterpret_cast<uint32_t*>(&jsc_m68k_vrf[m68kSlotT0]);
+        constexpr int holder = OBJECT_OFFSETOF(GetByIdTable::Entry, holder) - 4;
+        constexpr int holderStructureID = OBJECT_OFFSETOF(GetByIdTable::Entry, holderStructureID) - 4;
+        // The object with the getter: this one, or the prototype, while its
+        // structure is the one the table saw.
+        m_hot.loadDisp(1, holder, 0);
+        // Or no property at all, while the prototype (the last object on
+        // the chain) has the structure the table saw: undefined.
+        static_assert(getByIdTableMissing == 2);
+        m_hot.btstImm(1, 0);
+        size_t present = m_hot.branchShort(Builder::Equal);
+        m_hot.moveaFromData(0, 0);
+        m_hot.loadDisp(1, holderStructureID, 0);
+        m_hot.cmpDisp(0, JSCell::structureIDOffset() - static_cast<int>(getByIdTableMissing), 0);
+        slowUnless(Builder::NotEqual);
+        uint64_t undefined = JSValue::encode(jsUndefined());
+        m_hot.storeFrameImm(static_cast<uint32_t>(undefined >> 32), floatPath.dst.hi);
+        m_hot.storeFrameImm(static_cast<uint32_t>(undefined), floatPath.dst.lo);
+        size_t missing = m_hot.branch(Builder::Always);
+        m_hot.bindShort(present);
+        m_hot.cmpImm(getByIdTableOwnGetter, 0);
+        size_t own = m_hot.branchShort(Builder::Equal);
+        m_hot.moveaFromData(0, 0);
+        m_hot.loadDisp(1, holderStructureID, 0);
+        m_hot.cmpDisp(0, JSCell::structureIDOffset(), 0);
+        slowUnless(Builder::NotEqual);
+        m_hot.bindShort(own);
+        // Its GetterSetter, then the getter function.
+        m_hot.word(0x2211); // move.l (a1),d1: the offset
+        withProperty([&](int d8) { m_hot.loadIndexed(0, 1, d8 + 4, 0); });
+        m_hot.moveaFromData(0, 0);
+        m_hot.moveaDisp(0, GetterSetter::offsetOfGetter(), 0);
+        m_hot.cmpByteImmDisp(JSFunctionType, 0, JSCell::typeInfoTypeOffset());
+        slowUnless(Builder::NotEqual);
+        m_hot.loadDisp(0, JSFunction::offsetOfExecutableOrRareData(), 1);
+        m_hot.btstImm(0, 1);
+        size_t executable = m_hot.branchShort(Builder::Equal);
+        m_hot.moveaFromData(1, 6);
+        m_hot.loadDisp(6, FunctionRareData::offsetOfExecutable() - static_cast<int>(JSFunction::rareDataTag), 1);
+        m_hot.bindShort(executable);
+        m_hot.moveaFromData(1, 6);
+        m_hot.cmpByteImmDisp(FunctionExecutableType, 6, JSCell::typeInfoTypeOffset());
+        slowUnless(Builder::NotEqual);
+        m_hot.loadDisp(6, FunctionExecutable::offsetOfCodeBlockForCall(), 1);
+        slowUnless(Builder::Equal);
+        m_hot.moveaFromData(1, 6);
+        m_hot.word(0x4aae); m_hot.word(OBJECT_OFFSETOF(CodeBlock, m_m68kTemplateCode)); // tst.l code(a6)
+        slowUnless(Builder::Equal);
+        // The frame: one argument (this, the object), the getter, its
+        // CodeBlock (d1); this frame's call site; sp and lr as call sets them.
+        m_hot.storeFrameImm(1, frame + static_cast<int>(CallFrameSlot::argumentCountIncludingThis) * slot + 4);
+        m_hot.storeFrameImm(floatPath.site, static_cast<int>(CallFrameSlot::argumentCountIncludingThis) * slot);
+        m_hot.clrFrame(frame + static_cast<int>(CallFrameSlot::callee) * slot);
+        m_hot.storeAddressFrame(0, frame + static_cast<int>(CallFrameSlot::callee) * slot + 4);
+        m_hot.storeFrame(1, frame + static_cast<int>(CallFrameSlot::codeBlock) * slot + 4);
+        m_hot.copyFrame(floatPath.lhs.hi, frame + static_cast<int>(CallFrameSlot::thisArgument) * slot);
+        m_hot.copyFrame(floatPath.lhs.lo, frame + static_cast<int>(CallFrameSlot::thisArgument) * slot + 4);
+        m_hot.leaFrame(frame + static_cast<int>(sizeof(CallerFrameAndPC)), 1);
+        m_hot.storeAddressAbs(1, sp + 1);
+        m_hot.clrAbs(sp);
+        size_t returnPoint = m_hot.storeCodeAddressAbs(lr + 1);
+        m_hot.clrAbs(lr);
+        m_hot.moveaDisp(6, OBJECT_OFFSETOF(CodeBlock, m_m68kTemplateCode), 0);
+        m_hot.jumpA0();
+        // Back, as from call.
+        m_hot.bindAbsolute(returnPoint);
+        m_hot.leaFrame(-frameSize, 0);
+        m_hot.storeAddressAbs(0, sp + 1);
+        m_hot.moveaImm(static_cast<uint32_t>(reinterpret_cast<uintptr_t>(m_codeBlock->instructionsRawPointer())), 3);
+        m_hot.copyAbsToFrame(t0High, floatPath.dst.hi);
+        m_hot.storeFrame(4, floatPath.dst.lo);
+        return missing;
+    }
