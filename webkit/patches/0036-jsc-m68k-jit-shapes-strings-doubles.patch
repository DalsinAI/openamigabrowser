+// get_by_id's structure tables, after the code: for a site that sees more
+// than one structure, the last few structures it saw and where the property
+// is for each, which the interpreter's cache (one structure, and no
+// getters) would otherwise keep looking up. Each table is the index of the
+// entry to fill next, then its entries; the garbage collector clears the
+// entries of structures that die (reconcileCaches).
+static constexpr unsigned getByIdTableEntries = 4;
+struct GetByIdTable {
+    uint32_t next; // byte offset of the entry to fill next
+    struct Entry {
+        uint32_t structureID;
+        int32_t offset;
+        // Where the property is: 0, the object's own value; 1, the
+        // object's own getter; else the getter of this object (the
+        // prototype), while it has the structure holderStructureID; or,
+        // with getByIdTableMissing added, nowhere: the object is the
+        // prototype, the last on the chain.
+        uintptr_t holder;
+        uint32_t holderStructureID;
+    } entries[getByIdTableEntries];
+};
+static_assert(sizeof(GetByIdTable::Entry) == 16);
+static constexpr uintptr_t getByIdTableOwnGetter = 1;
+static constexpr uintptr_t getByIdTableMissing = 2;
+// The region after the code: the number of tables, then the tables.
+struct GetByIdTables {
+    uint32_t count;
+    GetByIdTable tables[1];
+};
+
+// Called after get_by_id's slow path, from its code: the object's structure
+// and where the property is for it go into the site's table, when that can
+// be cached: an own value the interpreter's cache now holds, or a getter of
+// the object's own or of its prototype (which the interpreter never caches).
+static void fillGetByIdTable(CallFrame* callFrame, CodeBlock* codeBlock, const JSInstruction* instruction, GetByIdTable* table)
+{
+    auto bytecode = instruction->as<OpGetById>();
+    JSValue base = callFrame->uncheckedR(bytecode.m_base).jsValue();
+    if (!base.isObject())
+        return;
+    JSObject* object = asObject(base);
+    Structure* structure = object->structure();
+    StructureID structureID = object->structureID();
+    // An entry for this structure that sent the code here is out of date
+    // (its prototype changed structure, or its getter is no longer one): it
+    // is filled again, in place.
+    GetByIdTable::Entry* existing = nullptr;
+    for (auto& entry : table->entries) {
+        if (entry.structureID == structureID.bits())
+            existing = &entry;
+    }
+    auto cacheable = [](Structure* structure) {
+        return structure->propertyAccessesAreCacheable() && !structure->isDictionary() && !structure->hasPolyProto()
+            && !structure->typeInfo().overridesGetOwnPropertySlot() && !structure->needImpurePropertyWatchpoint()
+            && !structure->hasNonReifiedStaticProperties();
+    };
+    GetByIdTable::Entry newEntry { structureID.bits(), 0, 0, 0 };
+    auto insert = [&] {
+        if (existing) {
+            *existing = newEntry;
+            return;
+        }
+        table->entries[table->next / sizeof(GetByIdTable::Entry)] = newEntry;
+        table->next = (table->next + sizeof(GetByIdTable::Entry)) % sizeof(table->entries);
+    };
+    auto& modeMetadata = bytecode.metadata(codeBlock).m_modeMetadata;
+    if (modeMetadata.mode == GetByIdMode::Default && modeMetadata.defaultMode.structureID == structureID)
+        newEntry.offset = modeMetadata.defaultMode.cachedOffset;
+    else {
+        if (!cacheable(structure))
+            return;
+        UniquedStringImpl* uid = codeBlock->identifier(bytecode.m_property).impl();
+        unsigned attributes = 0;
+        PropertyOffset offset = structure->getConcurrently(uid, attributes);
+        JSObject* holder = object;
+        if (!isValidOffset(offset)) {
+            JSValue prototype = structure->storedPrototype(object);
+            if (!prototype.isObject())
+                return;
+            holder = asObject(prototype);
+            Structure* holderStructure = holder->structure();
+            if (!cacheable(holderStructure))
+                return;
+            offset = holderStructure->getConcurrently(uid, attributes);
+            newEntry.holder = reinterpret_cast<uintptr_t>(holder);
+            newEntry.holderStructureID = holder->structureID().bits();
+            if (!isValidOffset(offset)) {
+                if (!holderStructure->storedPrototype(holder).isNull())
+                    return;
+                newEntry.holder += getByIdTableMissing;
+                insert();
+                return;
+            }
+        } else
+            newEntry.holder = getByIdTableOwnGetter;
+        if (!(attributes & PropertyAttribute::Accessor) || (attributes & PropertyAttribute::CustomAccessorOrValue))
+            return;
+        JSValue accessor = holder->getDirect(offset);
+        if (!accessor.isCell() || accessor.asCell()->type() != GetterSetterType)
+            return;
+        newEntry.offset = offset;
+    }
+    insert();
+}
