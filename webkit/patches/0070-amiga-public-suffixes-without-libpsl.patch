 )
 
+# Public suffixes (cookies, sites, document.domain) come from Mozilla's list
+# in PROGDIR:Network/public-suffixes, read by our own lookup
+# (PublicSuffixAmiga.c), not from libpsl.
+list(REMOVE_ITEM WebCore_SOURCES
+    platform/network/curl/PublicSuffixStoreCurl.cpp
+)
+list(REMOVE_ITEM WebCore_LIBRARIES
