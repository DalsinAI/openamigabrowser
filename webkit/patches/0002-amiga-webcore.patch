--- a/Source/WebCore/WebCorePrefix.h
+++ b/Source/WebCore/WebCorePrefix.h
@@ -45,6 +45,32 @@
 
 #if !OS(WINDOWS)
 #include <pthread.h>
+#if OS(AMIGA)
+// After pthread.h, so libpthread's cancellation wrappers (read(), close()...
+// as macros) stay off: they break members such as Document::close().
+#include <unistd.h>
+#endif
+
+#if OS(AMIGA)
+// AmiSSL's and curl's headers bring in the NDK's exec/types.h, whose macros
+// (IMPORT, STATIC...) break WebCore and JSC names such as the parser's IMPORT
+// token. Include it first, once, and drop those macros; its include guard
+// keeps them from coming back. VOID and CONST stay: later NDK headers use them.
+#include <exec/types.h>
+#undef GLOBAL
+#undef IMPORT
+#undef STATIC
+#undef REGISTER
+// ntohs() and friends, which Linux declares through other system headers;
+// the NDK has only the __ntohs() forms (no-ops on big-endian 68k).
+#include <machine/endian.h>
+#ifndef ntohs
+#define ntohs(x) __ntohs(x)
+#define htons(x) __htons(x)
+#define ntohl(x) __ntohl(x)
+#define htonl(x) __htonl(x)
+#endif
+#endif
 #endif // !OS(WINDOWS)
 
 #include <sys/types.h>
