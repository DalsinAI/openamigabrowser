+ResourceHandle::~ResourceHandle() = default;
+
+static void appendCookieHeader(ResourceRequest& request)
+{
+    if (!cookieHooks().cookieHeader)
+        return;
+    auto cookies = cookieHooks().cookieHeader(request.firstPartyForCookies(), request.url());
+    if (!cookies.isEmpty())
+        request.setHTTPHeaderField(HTTPHeaderName::Cookie, cookies);
+}
+
+void ResourceHandle::amigaStartCurlRequest(ResourceRequest&& request)
+{
+    appendCookieHeader(request);
+    if (!d->m_curlDelegate)
+        d->m_curlDelegate = ResourceHandleCurlDelegate::create(*this);
+    d->m_curlRequest = CurlRequest::create(request, *d->m_curlDelegate);
+    if (!d->m_user.isEmpty() || !d->m_password.isEmpty()) {
+        d->m_curlRequest->setUserPass(d->m_user, d->m_password);
+        d->m_curlRequest->setAuthenticationScheme(ProtectionSpace::AuthenticationScheme::HTTPBasic);
+    }
+    d->m_curlRequest->resume();
+}
+
+// file: URLs: curl is built for http and https only, so files are read here
+// and handed over from the run loop, as a network load would be.
+void ResourceHandle::amigaLoadFile()
+{
+    auto url = d->m_firstRequest.url();
+    RunLoop::mainSingleton().dispatch([protectedThis = Ref { *this }, url = WTF::move(url)] {
+        auto& handle = protectedThis.get();
+        auto* client = handle.client();
+        if (!client)
+            return;
+        auto contents = FileSystem::readEntireFile(url.fileSystemPath());
+        if (!contents) {
+            client->didFail(&handle, ResourceError("NSURLErrorDomain"_s, -1100, url, "The file does not exist."_s));
+            return;
+        }
+        auto mimeType = MIMETypeRegistry::mimeTypeForPath(url.fileSystemPath());
+        if (mimeType.isEmpty())
+            mimeType = "application/octet-stream"_s;
+        ResourceResponse response(URL { url }, String { mimeType }, contents->size(), String());
+        response.setHTTPStatusCode(200);
+        client->didReceiveResponseAsync(&handle, WTF::move(response), [protectedThis = Ref { handle }, data = WTF::move(*contents)]() mutable {
+            auto& handle = protectedThis.get();
+            if (!handle.client())
+                return;
+            if (!data.isEmpty()) {
+                auto size = data.size();
+                handle.client()->didReceiveBuffer(&handle, SharedBuffer::create(WTF::move(data)), size);
+            }
+            if (handle.client())
+                handle.client()->didFinishLoading(&handle, NetworkLoadMetrics { });
+        });
+    });
+}
+
+bool ResourceHandle::start()
+{
+    if (d->m_context && !d->m_context->isValid())
+        return false;
+
+    ResourceRequest request = d->m_firstRequest;
+    if (request.url().protocolIsFile()) {
+        amigaLoadFile();
+        return true;
+    }
+    amigaStartCurlRequest(WTF::move(request));
+    return true;
+}
+
+void ResourceHandle::cancel()
+{
+    if (d->m_curlRequest)
+        d->m_curlRequest->cancel();
+}
+
+void ResourceHandle::platformSetDefersLoading(bool)
+{
+}
+
+static bool shouldStartHTTPRedirection(const ResourceResponse& response)
+{
+    auto statusCode = response.httpStatusCode();
+    if (statusCode < 300 || statusCode >= 400)
+        return false;
+    if (statusCode == 300 || statusCode == 304 || statusCode == 305 || statusCode == 306)
+        return false;
+    return !response.httpHeaderField(HTTPHeaderName::Location).isEmpty();
+}
+
+static bool shouldRedirectAsGET(const ResourceRequest& request, const ResourceResponse& response, bool crossOrigin)
+{
+    if (request.httpMethod() == "GET"_s || request.httpMethod() == "HEAD"_s)
+        return false;
+    if (!request.url().protocolIsInHTTPFamily())
+        return true;
+    if (response.isSeeOther())
+        return true;
+    if ((response.isMovedPermanently() || response.isFound()) && request.httpMethod() == "POST"_s)
+        return true;
+    if (crossOrigin && request.httpMethod() == "DELETE"_s)
+        return true;
+    return false;
+}
+
+void ResourceHandle::amigaDidReceiveResponse(CurlRequest& curlRequest, CurlResponse&& curlResponse)
+{
+    if (!client())
+        return;
+
+    // Cookies first, so a redirect's request already carries them.
+    static constexpr auto setCookieHeader = "set-cookie: "_s;
+    if (cookieHooks().storeFromResponse) {
+        for (auto& header : curlResponse.headers) {
+            if (header.startsWithIgnoringASCIICase(setCookieHeader))
+                cookieHooks().storeFromResponse(curlRequest.resourceRequest().firstPartyForCookies(), curlResponse.url, header.substring(setCookieHeader.length()));
+        }
+    }
+
+    ResourceResponse response(curlResponse);
+
+    if (shouldStartHTTPRedirection(response)) {
+        static constexpr unsigned maxRedirects = 20;
+        if (d->m_redirectCount++ > maxRedirects) {
+            client()->didFail(this, ResourceError(CURLE_TOO_MANY_REDIRECTS, response.url()));
+            return;
+        }
+
+        URL redirectedURL { response.url(), response.httpHeaderField(HTTPHeaderName::Location) };
+        if (redirectedURL.protocolIsFile()) {
+            client()->didFail(this, ResourceError(CURLE_FILE_COULDNT_READ_FILE, response.url()));
+            return;
+        }
+
+        ResourceRequest request = curlRequest.resourceRequest();
+        if (!redirectedURL.hasFragmentIdentifier() && request.url().hasFragmentIdentifier())
+            redirectedURL.setFragmentIdentifier(request.url().fragmentIdentifier());
+        bool crossOrigin = !protocolHostAndPortAreEqual(request.url(), redirectedURL);
+        request.setURL(WTF::move(redirectedURL));
+        request.removeHTTPHeaderField(HTTPHeaderName::Cookie);
+        if (!equalLettersIgnoringASCIICase(request.httpMethod(), "get"_s) && shouldRedirectAsGET(request, response, crossOrigin)) {
+            request.setHTTPMethod("GET"_s);
+            request.setHTTPBody(nullptr);
+            request.clearHTTPContentType();
+        }
+        if (crossOrigin) {
+            request.clearHTTPAuthorization();
+            request.clearHTTPOrigin();
+            if (!SecurityOrigin::create(response.url())->canRequest(request.url(), EmptyOriginAccessPatterns::singleton()))
+                markAsHavingCrossOriginRedirect();
+        }
+        incrementRedirectCount();
+
+        d->m_curlRequest->cancel();
+        client()->willSendRequestAsync(this, WTF::move(request), WTF::move(response), [protectedThis = Ref { *this }](ResourceRequest&& newRequest) mutable {
+            if (newRequest.isNull() || !protectedThis->client())
+                return;
+            protectedThis->amigaStartCurlRequest(WTF::move(newRequest));
+        });
+        return;
+    }
+
+    client()->didReceiveResponseAsync(this, WTF::move(response), [protectedThis = Ref { *this }] {
+        if (auto& curlRequest = protectedThis->d->m_curlRequest)
+            curlRequest->completeDidReceiveResponse();
+    });
+}
+
+// Synchronous loads (synchronous XMLHttpRequest): run the request and spin the
+// run loop until it ends. CurlRequest calls back through the main run loop.
+namespace {
+class SynchronousClient final : public ResourceHandleClient {
+public:
+    void willSendRequestAsync(ResourceHandle*, ResourceRequest&& request, ResourceResponse&&, CompletionHandler<void(ResourceRequest&&)>&& completionHandler) final
+    {
+        completionHandler(WTF::move(request));
+    }
+    void didReceiveResponseAsync(ResourceHandle*, ResourceResponse&& response, CompletionHandler<void()>&& completionHandler) final
+    {
+        m_response = WTF::move(response);
+        completionHandler();
+    }
+    void didReceiveData(ResourceHandle*, const SharedBuffer& buffer, int) final { m_data.append(buffer.span()); }
+    void didFinishLoading(ResourceHandle*, const NetworkLoadMetrics&) final { m_done = true; }
+    void didFail(ResourceHandle*, const ResourceError& error) final
+    {
+        m_error = error;
+        m_done = true;
+    }
+
+    bool m_done { false };
+    ResourceResponse m_response;
+    ResourceError m_error;
+    Vector<uint8_t> m_data;
+};
+}
+
+void ResourceHandle::platformLoadResourceSynchronously(NetworkingContext* context, const ResourceRequest& request, StoredCredentialsPolicy, SecurityOrigin*, ResourceError& error, ResourceResponse& response, Vector<uint8_t>& data)
+{
+    SynchronousClient client;
+    auto handle = adoptRef(*new ResourceHandle(context, request, &client, false, false, ContentEncodingSniffingPolicy::Default, nullptr, false));
+    handle->start();
+    while (!client.m_done)
+        RunLoop::cycle();
+    error = client.m_error;
+    response = client.m_response;
+    data = WTF::move(client.m_data);
+}
