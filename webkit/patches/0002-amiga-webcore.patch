diff --git a/Source/WebCore/platform/image-decoders/amiga/DatatypesDecode.c b/Source/WebCore/platform/image-decoders/amiga/DatatypesDecode.c
new file mode 100644
index 0000000000..6dc4b99184
--- /dev/null
+++ b/Source/WebCore/platform/image-decoders/amiga/DatatypesDecode.c
@@ -0,0 +1,210 @@
+/*
+ * Copyright (C) 2026 Dalsin Limited.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
