+ * ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+// SHA-1 (WTF's) and SHA-256/384/512 (FIPS 180-4) without a crypto library, so
+// that digests work on any task: AmiSSL wants InitAmiSSL() in every caller.
+
+#include "config.h"
+#include "CryptoDigest.h"
+
+#include <array>
+#include <wtf/SHA1.h>
+
+namespace PAL::Crypto {
+
+struct CryptoDigestContext {
+    virtual ~CryptoDigestContext() = default;
+    virtual void addBytes(std::span<const uint8_t>) = 0;
+    virtual Vector<uint8_t> computeHash() = 0;
+};
+
+namespace {
+
+struct SHA1Context final : CryptoDigestContext {
+    WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(SHA1Context);
+    void addBytes(std::span<const uint8_t> input) final { m_sha1.addBytes(input); }
+    Vector<uint8_t> computeHash() final
+    {
+        SHA1::Digest digest;
+        m_sha1.computeHash(digest);
+        return Vector<uint8_t>(std::span<const uint8_t>(digest));
+    }
+    SHA1 m_sha1;
+};
+
+static inline uint32_t rotr32(uint32_t x, unsigned n) { return (x >> n) | (x << (32 - n)); }
+static inline uint64_t rotr64(uint64_t x, unsigned n) { return (x >> n) | (x << (64 - n)); }
+
+struct SHA256Context final : CryptoDigestContext {
+    WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(SHA256Context);
+
+    SHA256Context()
+    {
+        static constexpr uint32_t initial[8] = {
+            0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
+        };
+        std::copy(std::begin(initial), std::end(initial), m_state.begin());
+    }
+
+    void addBytes(std::span<const uint8_t> input) final
+    {
+        for (uint8_t byte : input) {
+            m_block[m_used++] = byte;
+            if (m_used == 64) {
+                transform();
+                m_used = 0;
+            }
+        }
+        m_length += input.size();
+    }
+
+    Vector<uint8_t> computeHash() final
+    {
+        uint64_t bits = m_length * 8;
+        m_block[m_used++] = 0x80;
+        if (m_used > 56) {
+            while (m_used < 64)
+                m_block[m_used++] = 0;
+            transform();
+            m_used = 0;
+        }
+        while (m_used < 56)
+            m_block[m_used++] = 0;
+        for (int i = 7; i >= 0; --i)
+            m_block[m_used++] = static_cast<uint8_t>(bits >> (i * 8));
+        transform();
+        Vector<uint8_t> result;
+        result.reserveInitialCapacity(32);
+        for (uint32_t word : m_state) {
+            for (int i = 3; i >= 0; --i)
+                result.append(static_cast<uint8_t>(word >> (i * 8)));
+        }
+        return result;
+    }
+
+private:
+    void transform()
+    {
+        static constexpr uint32_t k[64] = {
+            0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+            0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+            0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+            0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+            0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+            0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+            0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+            0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+        };
+        uint32_t w[64];
+        for (unsigned i = 0; i < 16; ++i)
+            w[i] = (uint32_t(m_block[i * 4]) << 24) | (uint32_t(m_block[i * 4 + 1]) << 16) | (uint32_t(m_block[i * 4 + 2]) << 8) | m_block[i * 4 + 3];
+        for (unsigned i = 16; i < 64; ++i) {
+            uint32_t s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+            uint32_t s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+        uint32_t a = m_state[0], b = m_state[1], c = m_state[2], d = m_state[3];
+        uint32_t e = m_state[4], f = m_state[5], g = m_state[6], h = m_state[7];
+        for (unsigned i = 0; i < 64; ++i) {
+            uint32_t t1 = h + (rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)) + ((e & f) ^ (~e & g)) + k[i] + w[i];
+            uint32_t t2 = (rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+            h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+        }
+        m_state[0] += a; m_state[1] += b; m_state[2] += c; m_state[3] += d;
+        m_state[4] += e; m_state[5] += f; m_state[6] += g; m_state[7] += h;
+    }
+
+    std::array<uint32_t, 8> m_state;
+    std::array<uint8_t, 64> m_block { };
+    unsigned m_used { 0 };
+    uint64_t m_length { 0 };
+};
+
+struct SHA512Context final : CryptoDigestContext {
+    WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(SHA512Context);
+
+    explicit SHA512Context(bool is384)
+        : m_digestLength(is384 ? 48 : 64)
+    {
+        static constexpr uint64_t initial512[8] = {
+            0x6a09e667f3bcc908ULL, 0xbb67ae8584caa73bULL, 0x3c6ef372fe94f82bULL, 0xa54ff53a5f1d36f1ULL,
+            0x510e527fade682d1ULL, 0x9b05688c2b3e6c1fULL, 0x1f83d9abfb41bd6bULL, 0x5be0cd19137e2179ULL
+        };
+        static constexpr uint64_t initial384[8] = {
+            0xcbbb9d5dc1059ed8ULL, 0x629a292a367cd507ULL, 0x9159015a3070dd17ULL, 0x152fecd8f70e5939ULL,
+            0x67332667ffc00b31ULL, 0x8eb44a8768581511ULL, 0xdb0c2e0d64f98fa7ULL, 0x47b5481dbefa4fa4ULL
+        };
+        const uint64_t* initial = is384 ? initial384 : initial512;
+        std::copy(initial, initial + 8, m_state.begin());
+    }
+
+    void addBytes(std::span<const uint8_t> input) final
+    {
+        for (uint8_t byte : input) {
+            m_block[m_used++] = byte;
+            if (m_used == 128) {
+                transform();
+                m_used = 0;
+            }
+        }
+        m_length += input.size();
+    }
+
+    Vector<uint8_t> computeHash() final
+    {
+        uint64_t bits = m_length * 8;
+        m_block[m_used++] = 0x80;
+        if (m_used > 112) {
+            while (m_used < 128)
+                m_block[m_used++] = 0;
+            transform();
+            m_used = 0;
+        }
+        while (m_used < 120)
+            m_block[m_used++] = 0;
+        for (int i = 7; i >= 0; --i)
+            m_block[m_used++] = static_cast<uint8_t>(bits >> (i * 8));
+        transform();
+        Vector<uint8_t> result;
+        result.reserveInitialCapacity(m_digestLength);
+        for (uint64_t word : m_state) {
+            for (int i = 7; i >= 0 && result.size() < m_digestLength; --i)
+                result.append(static_cast<uint8_t>(word >> (i * 8)));
+        }
+        return result;
+    }
+
+private:
+    void transform()
+    {
+        static constexpr uint64_t k[80] = {
+            0x428a2f98d728ae22ULL, 0x7137449123ef65cdULL, 0xb5c0fbcfec4d3b2fULL, 0xe9b5dba58189dbbcULL,
+            0x3956c25bf348b538ULL, 0x59f111f1b605d019ULL, 0x923f82a4af194f9bULL, 0xab1c5ed5da6d8118ULL,
+            0xd807aa98a3030242ULL, 0x12835b0145706fbeULL, 0x243185be4ee4b28cULL, 0x550c7dc3d5ffb4e2ULL,
+            0x72be5d74f27b896fULL, 0x80deb1fe3b1696b1ULL, 0x9bdc06a725c71235ULL, 0xc19bf174cf692694ULL,
+            0xe49b69c19ef14ad2ULL, 0xefbe4786384f25e3ULL, 0x0fc19dc68b8cd5b5ULL, 0x240ca1cc77ac9c65ULL,
+            0x2de92c6f592b0275ULL, 0x4a7484aa6ea6e483ULL, 0x5cb0a9dcbd41fbd4ULL, 0x76f988da831153b5ULL,
+            0x983e5152ee66dfabULL, 0xa831c66d2db43210ULL, 0xb00327c898fb213fULL, 0xbf597fc7beef0ee4ULL,
+            0xc6e00bf33da88fc2ULL, 0xd5a79147930aa725ULL, 0x06ca6351e003826fULL, 0x142929670a0e6e70ULL,
+            0x27b70a8546d22ffcULL, 0x2e1b21385c26c926ULL, 0x4d2c6dfc5ac42aedULL, 0x53380d139d95b3dfULL,
+            0x650a73548baf63deULL, 0x766a0abb3c77b2a8ULL, 0x81c2c92e47edaee6ULL, 0x92722c851482353bULL,
+            0xa2bfe8a14cf10364ULL, 0xa81a664bbc423001ULL, 0xc24b8b70d0f89791ULL, 0xc76c51a30654be30ULL,
+            0xd192e819d6ef5218ULL, 0xd69906245565a910ULL, 0xf40e35855771202aULL, 0x106aa07032bbd1b8ULL,
+            0x19a4c116b8d2d0c8ULL, 0x1e376c085141ab53ULL, 0x2748774cdf8eeb99ULL, 0x34b0bcb5e19b48a8ULL,
+            0x391c0cb3c5c95a63ULL, 0x4ed8aa4ae3418acbULL, 0x5b9cca4f7763e373ULL, 0x682e6ff3d6b2b8a3ULL,
+            0x748f82ee5defb2fcULL, 0x78a5636f43172f60ULL, 0x84c87814a1f0ab72ULL, 0x8cc702081a6439ecULL,
+            0x90befffa23631e28ULL, 0xa4506cebde82bde9ULL, 0xbef9a3f7b2c67915ULL, 0xc67178f2e372532bULL,
+            0xca273eceea26619cULL, 0xd186b8c721c0c207ULL, 0xeada7dd6cde0eb1eULL, 0xf57d4f7fee6ed178ULL,
+            0x06f067aa72176fbaULL, 0x0a637dc5a2c898a6ULL, 0x113f9804bef90daeULL, 0x1b710b35131c471bULL,
+            0x28db77f523047d84ULL, 0x32caab7b40c72493ULL, 0x3c9ebe0a15c9bebcULL, 0x431d67c49c100d4cULL,
+            0x4cc5d4becb3e42b6ULL, 0x597f299cfc657e2aULL, 0x5fcb6fab3ad6faecULL, 0x6c44198c4a475817ULL
+        };
+        uint64_t w[80];
+        for (unsigned i = 0; i < 16; ++i) {
+            uint64_t word = 0;
+            for (unsigned j = 0; j < 8; ++j)
+                word = (word << 8) | m_block[i * 8 + j];
+            w[i] = word;
+        }
+        for (unsigned i = 16; i < 80; ++i) {
+            uint64_t s0 = rotr64(w[i - 15], 1) ^ rotr64(w[i - 15], 8) ^ (w[i - 15] >> 7);
+            uint64_t s1 = rotr64(w[i - 2], 19) ^ rotr64(w[i - 2], 61) ^ (w[i - 2] >> 6);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+        uint64_t a = m_state[0], b = m_state[1], c = m_state[2], d = m_state[3];
+        uint64_t e = m_state[4], f = m_state[5], g = m_state[6], h = m_state[7];
+        for (unsigned i = 0; i < 80; ++i) {
+            uint64_t t1 = h + (rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)) + ((e & f) ^ (~e & g)) + k[i] + w[i];
+            uint64_t t2 = (rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)) + ((a & b) ^ (a & c) ^ (b & c));
+            h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+        }
+        m_state[0] += a; m_state[1] += b; m_state[2] += c; m_state[3] += d;
+        m_state[4] += e; m_state[5] += f; m_state[6] += g; m_state[7] += h;
+    }
+
+    std::array<uint64_t, 8> m_state;
+    std::array<uint8_t, 128> m_block { };
+    unsigned m_used { 0 };
+    uint64_t m_length { 0 };
+    size_t m_digestLength;
+};
+
+} // namespace
+
+CryptoDigest::CryptoDigest() = default;
+
+CryptoDigest::~CryptoDigest() = default;
+
+std::unique_ptr<CryptoDigest> CryptoDigest::create(CryptoDigest::Algorithm algorithm)
+{
+    auto digest = WTF::makeUnique<CryptoDigest>();
+    switch (algorithm) {
+    case CryptoDigest::Algorithm::SHA_1:
+        digest->m_context = makeUnique<SHA1Context>();
+        break;
+    case CryptoDigest::Algorithm::DEPRECATED_SHA_224:
+        RELEASE_ASSERT_NOT_REACHED_WITH_MESSAGE("SHA224 is not supported.");
+        break;
+    case CryptoDigest::Algorithm::SHA_256:
+        digest->m_context = makeUnique<SHA256Context>();
+        break;
+    case CryptoDigest::Algorithm::SHA_384:
+        digest->m_context = makeUnique<SHA512Context>(true);
+        break;
+    case CryptoDigest::Algorithm::SHA_512:
+        digest->m_context = makeUnique<SHA512Context>(false);
+        break;
+    }
+    return digest;
+}
+
+void CryptoDigest::addBytes(std::span<const uint8_t> input)
+{
+    ASSERT(m_context);
+    m_context->addBytes(input);
+}
+
+Vector<uint8_t> CryptoDigest::computeHash()
+{
+    ASSERT(m_context);
+    return m_context->computeHash();
+}
+
+} // namespace PAL::Crypto
