+ * CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,
+ * EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
+ * PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
+ * OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
+ * WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
+ * OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
+ * ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "DatatypesDecode.h"
+
+#include <exec/types.h>
+#include <datatypes/datatypes.h>
+#include <datatypes/datatypesclass.h>
+#include <datatypes/pictureclass.h>
+#include <intuition/classusr.h>
+#include <dos/dos.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/datatypes.h>
+#include <clib/alib_protos.h>
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Every thread decodes through the one library base; datatypes.library is
+ * a shared library, safe to call from any process. */
+struct Library* DataTypesBase;
+static pthread_once_t s_openOnce = PTHREAD_ONCE_INIT;
+
+/* ROM mathieeesingbas.library puts the FPU in single precision (FPCR $40) in
+ * the task that opens it, and a datatype may open it while it loads; WebKit's
+ * doubles (and cairo's fixed-point maths) need FPCR 0. */
+static void resetFPCR(void)
+{
+    __asm__ volatile ("fmove.l %0,%%fpcr" : : "d" (0));
+}
+
+static void closeDataTypes(void)
+{
+    if (DataTypesBase) {
+        CloseLibrary(DataTypesBase);
+        DataTypesBase = NULL;
+    }
+}
+
+static void openDataTypes(void)
+{
+    /* V43: the picture class's V43 mode and pixel arrays; OS 3.2 has V47. */
+    DataTypesBase = OpenLibrary((CONST_STRPTR)"datatypes.library", 43);
+    if (DataTypesBase)
+        atexit(closeDataTypes);
+    resetFPCR();
+}
+
+static void disposePicture(Object* object, const char* fileName)
+{
+    DisposeDTObject(object);
+    DeleteFile((CONST_STRPTR)fileName);
+    resetFPCR();
+}
+
+/* OS 3.2's picture datatypes read files, not memory (DTST_MEMORY gives
+ * ERROR_OBJECT_WRONG_TYPE), so the picture goes through a file in T:. */
+static int writeTemporaryFile(const void* data, unsigned long size, char* name, size_t nameSize)
+{
+    static unsigned long s_counter;
+    static pthread_mutex_t s_counterLock = PTHREAD_MUTEX_INITIALIZER;
+    unsigned long serial;
+    BPTR file;
+    LONG written;
+
+    pthread_mutex_lock(&s_counterLock);
+    serial = ++s_counter;
+    pthread_mutex_unlock(&s_counterLock);
+    snprintf(name, nameSize, "T:OpenBrowser-%08lx-%lu.img", (unsigned long)FindTask(NULL), serial);
+    file = Open((CONST_STRPTR)name, MODE_NEWFILE);
+    if (!file)
+        return 0;
+    written = Write(file, (APTR)data, (LONG)size);
+    Close(file);
+    if (written != (LONG)size) {
+        DeleteFile((CONST_STRPTR)name);
+        return 0;
+    }
+    return 1;
+}
+
+int obdt_decode(const void* data, unsigned long size, OBDTImage* out)
+{
+    char fileName[64];
+    Object* object;
+    struct BitMapHeader* header = NULL;
+    ULONG alphaChannel = FALSE;
+    ULONG width, height, count, i;
+    unsigned char* pixels;
+
+    memset(out, 0, sizeof *out);
+    pthread_once(&s_openOnce, openDataTypes);
+    if (!DataTypesBase || !data || !size)
+        return 0;
+
+    if (!writeTemporaryFile(data, size, fileName, sizeof fileName))
+        return 0;
+    object = NewDTObject((APTR)fileName,
+        DTA_GroupID, GID_PICTURE,
+        PDTA_DestMode, PMODE_V43,
+        PDTA_Remap, FALSE,
+        TAG_DONE);
+    if (!object) {
+        DeleteFile((CONST_STRPTR)fileName);
+        resetFPCR();
+        return 0;
+    }
+
+    GetDTAttrs(object, PDTA_BitMapHeader, (ULONG)&header, TAG_DONE);
+    GetDTAttrs(object, PDTA_AlphaChannel, (ULONG)&alphaChannel, TAG_DONE);
+    if (!header || !header->bmh_Width || !header->bmh_Height) {
+        disposePicture(object, fileName);
+        return 0;
+    }
+    width = header->bmh_Width;
+    height = header->bmh_Height;
+    count = width * height;
+
+    /* The subclass finishes reading the picture in the layout method. */
+    DoDTMethod(object, NULL, NULL, DTM_PROCLAYOUT, NULL, TRUE);
+
+    pixels = (unsigned char*)malloc(count * 4);
+    if (!pixels) {
+        disposePicture(object, fileName);
+        return 0;
+    }
+
+    if (header->bmh_Masking == mskHasTransparentColor && header->bmh_Depth <= 8) {
+        /* A palette picture with a transparent colour (GIF): read the colour
+         * indices so that colour can become alpha 0. */
+        struct ColorRegister* colors = NULL;
+        ULONG numColors = 0;
+        unsigned char* indices = (unsigned char*)malloc(count);
+        if (!indices) {
+            free(pixels);
+            disposePicture(object, fileName);
+            return 0;
+        }
+        GetDTAttrs(object, PDTA_ColorRegisters, (ULONG)&colors, PDTA_NumColors, (ULONG)&numColors, TAG_DONE);
+        if (!colors || !DoMethod(object, PDTM_READPIXELARRAY, (ULONG)indices, PBPAFMT_LUT8, width, 0, 0, width, height)) {
+            free(indices);
+            free(pixels);
+            disposePicture(object, fileName);
+            return 0;
+        }
+        for (i = 0; i < count; i++) {
+            unsigned index = indices[i];
+            unsigned char* pixel = pixels + i * 4;
+            if (index == header->bmh_Transparent || index >= numColors) {
+                pixel[0] = pixel[1] = pixel[2] = pixel[3] = 0;
+                continue;
+            }
+            pixel[0] = 0xff;
+            pixel[1] = colors[index].red;
+            pixel[2] = colors[index].green;
+            pixel[3] = colors[index].blue;
+        }
+        free(indices);
+        out->hasAlpha = 1;
+    } else {
+        if (!DoMethod(object, PDTM_READPIXELARRAY, (ULONG)pixels, PBPAFMT_ARGB, width * 4, 0, 0, width, height)) {
+            free(pixels);
+            disposePicture(object, fileName);
+            return 0;
+        }
+        out->hasAlpha = alphaChannel || header->bmh_Masking == mskHasAlpha;
+        if (!out->hasAlpha) {
+            /* Without an alpha channel the alpha bytes are not defined. */
+            for (i = 0; i < count; i++)
+                pixels[i * 4] = 0xff;
+        }
+    }
+
+    disposePicture(object, fileName);
+    out->width = width;
+    out->height = height;
+    out->pixels = pixels;
+    return 1;
+}
+
+void obdt_free(OBDTImage* image)
+{
+    free(image->pixels);
+    image->pixels = NULL;
+}
