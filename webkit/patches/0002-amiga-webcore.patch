+#include "config.h"
+#include <wtf/ProcessID.h>
+
+#include <exec/tasks.h>
+#include <proto/exec.h>
+
+namespace WTF {
+
+ProcessID amigaCurrentProcessID()
+{
+#if OS(AROS)
+    auto* task = FindTask(nullptr);
+    return task ? static_cast<ProcessID>(GetETaskID(task)) : 0;
+#else
+    // Exec has no process IDs; the Task address is unique while it lives.
+    return static_cast<ProcessID>(reinterpret_cast<uintptr_t>(FindTask(nullptr)));
+#endif
+}
