+
+#include <wtf/FastMalloc.h>
+
+namespace WebCore {
+
+RefPtr<SharedMemory> SharedMemory::allocate(size_t size)
+{
+    void* data = nullptr;
+    if (!tryFastZeroedMalloc(size).getValue(data) || !data)
+        return nullptr;
+    auto memory = adoptRef(*new SharedMemory);
+    memory->m_size = size;
+    memory->m_data = data;
+    return memory;
+}
+
+RefPtr<SharedMemory> SharedMemory::map(Handle&&, Protection, CopyOnWrite)
+{
+    return nullptr;
+}
+
+SharedMemory::~SharedMemory()
+{
+    fastFree(m_data);
+}
