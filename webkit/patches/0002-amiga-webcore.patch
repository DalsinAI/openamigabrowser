+// The browser's cookie jar, as the network layer sees it: the Cookie header
+// for a request, and each Set-Cookie header of a response.
+struct AmigaCookieHooks {
+    Function<String(const URL& firstParty, const URL&)> cookieHeader;
+    Function<void(const URL& firstParty, const URL&, const String& setCookie)> storeFromResponse;
+};
+
+WEBCORE_EXPORT void setAmigaCookieHooks(AmigaCookieHooks&&);
+
+// The network thread's start and end. On AmigaOS each task opens its own
+// bsdsocket.library and joins AmiSSL itself, so the browser does that in
+// these two functions, which run on the network thread.
+struct AmigaNetworkThreadHooks {
+    void (*started)() { nullptr };
+    void (*finished)() { nullptr };
+};
+
+WEBCORE_EXPORT void setAmigaNetworkThreadHooks(const AmigaNetworkThreadHooks&);
+void amigaNetworkThreadStarted();
+void amigaNetworkThreadFinished();
