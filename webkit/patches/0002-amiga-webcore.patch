+namespace WebCore {
+
+// AmiSSL keeps its trusted root certificates in AmiSSL:Certs, OpenSSL's
+// default verify paths, which curl uses when no CA file is given. The cipher
+// list prefers ciphers that are cheap on a 68k without AES instructions.
+void CurlSSLHandle::platformInitialize()
+{
+    constexpr auto cipherList =
+        "TLS_CHACHA20_POLY1305_SHA256:"
+        "TLS_AES_128_GCM_SHA256:"
+        "TLS_AES_256_GCM_SHA384:"
+        "ECDHE-ECDSA-CHACHA20-POLY1305:"
+        "ECDHE-RSA-CHACHA20-POLY1305:"
+        "ECDHE-ECDSA-AES128-GCM-SHA256:"
+        "ECDHE-RSA-AES128-GCM-SHA256:"
+        "ECDHE-ECDSA-AES256-GCM-SHA384:"
+        "ECDHE-RSA-AES256-GCM-SHA384:"
+        "ECDHE-ECDSA-AES128-SHA:"
+        "ECDHE-RSA-AES128-SHA:"
+        "AES128-GCM-SHA256:"
+        "AES128-SHA"_s;
+    constexpr auto ecCurves =
+        "X25519:"
+        "P-256:"
+        "P-384"_s;
+    setCipherList(cipherList);
+    setECCurves(ecCurves);
+}
+
+} // namespace WebCore
