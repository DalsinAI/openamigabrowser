+static AmigaCookieHooks& cookieHooks()
+{
+    static NeverDestroyed<AmigaCookieHooks> hooks;
+    return hooks;
+}
+
+void setAmigaCookieHooks(AmigaCookieHooks&& hooks)
+{
+    cookieHooks() = WTF::move(hooks);
+}
+
+static AmigaNetworkThreadHooks networkThreadHooks;
+
+void setAmigaNetworkThreadHooks(const AmigaNetworkThreadHooks& hooks)
+{
+    networkThreadHooks = hooks;
+}
+
+void amigaNetworkThreadStarted()
+{
+    if (networkThreadHooks.started)
+        networkThreadHooks.started();
+}
+
+void amigaNetworkThreadFinished()
+{
+    if (networkThreadHooks.finished)
+        networkThreadHooks.finished();
+}
+
+// Receives CurlRequest's callbacks (on the main thread) for one handle.
+class ResourceHandleCurlDelegate final : public CurlRequestClient, public RefCounted<ResourceHandleCurlDelegate> {
+public:
+    static Ref<ResourceHandleCurlDelegate> create(ResourceHandle& handle) { return adoptRef(*new ResourceHandleCurlDelegate(handle)); }
+
+    void ref() const final { RefCounted::ref(); }
+    void deref() const final { RefCounted::deref(); }
+
+    void releaseHandle() { m_handle = nullptr; }
+
+    void curlDidSendData(CurlRequest&, unsigned long long sent, unsigned long long total) final
+    {
+        if (RefPtr handle = m_handle; handle && handle->client())
+            handle->client()->didSendData(handle.get(), sent, total);
+    }
+
+    void curlDidReceiveResponse(CurlRequest& request, CurlResponse&& response) final
+    {
+        if (RefPtr handle = m_handle)
+            handle->amigaDidReceiveResponse(request, WTF::move(response));
+    }
+
+    void curlDidReceiveData(CurlRequest&, Ref<SharedBuffer>&& buffer) final
+    {
+        if (RefPtr handle = m_handle; handle && handle->client())
+            handle->client()->didReceiveBuffer(handle.get(), buffer.get(), buffer->size());
+    }
+
+    void curlDidComplete(CurlRequest&, NetworkLoadMetrics&& metrics) final
+    {
+        if (RefPtr handle = m_handle; handle && handle->client())
+            handle->client()->didFinishLoading(handle.get(), metrics);
+    }
+
+    void curlDidFailWithError(CurlRequest&, ResourceError&& error, CertificateInfo&&) final
+    {
+        if (RefPtr handle = m_handle; handle && handle->client())
+            handle->client()->didFail(handle.get(), error);
+    }
+
+private:
+    explicit ResourceHandleCurlDelegate(ResourceHandle& handle)
+        : m_handle(&handle)
+    {
+    }
+
+    ResourceHandle* m_handle;
+};
+
+ResourceHandleInternal::~ResourceHandleInternal()
+{
+    if (m_curlDelegate)
+        m_curlDelegate->releaseHandle();
+    if (m_curlRequest)
+        m_curlRequest->invalidateClient();
+}
