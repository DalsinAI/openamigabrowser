+/*
+ * C library pieces libnix lacks, for WebCore on AmigaOS 3.x.
+ */
+#include <math.h>
+#include <sys/time.h>
+#include <sys/types.h>
+#include <proto/bsdsocket.h>
+
+double exp2(double x)
+{
+    return pow(2.0, x);
+}
+
+float exp2f(float x)
+{
+    return (float)pow(2.0, x);
+}
+
+/* bsdsocket.library's select() takes a sixth argument, the signals to wait
+ * for as well; WebCore's socket code waits for sockets only. The program
+ * opens bsdsocket.library (SocketBase) in the task that uses sockets. */
+int select(int nfds, fd_set* readfds, fd_set* writefds, fd_set* exceptfds, struct timeval* timeout)
+{
+    return WaitSelect(nfds, readfds, writefds, exceptfds, timeout, NULL);
+}
