+#include "DatatypesImageDecoder.h"
+
+#include "DatatypesDecode.h"
+#include <cstdlib>
+
+namespace WebCore {
+
+DatatypesImageDecoder::DatatypesImageDecoder(AlphaOption alphaOption, GammaAndColorProfileOption gammaAndColorProfileOption)
+    : ScalableImageDecoder(alphaOption, gammaAndColorProfileOption)
+{
+}
+
+static inline unsigned readBigEndian16(std::span<const uint8_t> data, size_t offset)
+{
+    return (data[offset] << 8) | data[offset + 1];
+}
+
+static inline unsigned readLittleEndian16(std::span<const uint8_t> data, size_t offset)
+{
+    return data[offset] | (data[offset + 1] << 8);
+}
+
+static inline uint32_t readBigEndian32(std::span<const uint8_t> data, size_t offset)
+{
+    return (uint32_t(data[offset]) << 24) | (uint32_t(data[offset + 1]) << 16) | (uint32_t(data[offset + 2]) << 8) | data[offset + 3];
+}
+
+static inline int32_t readLittleEndian32(std::span<const uint8_t> data, size_t offset)
+{
+    return static_cast<int32_t>(data[offset] | (data[offset + 1] << 8) | (data[offset + 2] << 16) | (uint32_t(data[offset + 3]) << 24));
+}
+
+// The picture's size from the start of the file, before it is all in, so
+// layout need not wait for the whole picture. Unknown formats wait for the
+// datatype.
+static std::optional<IntSize> sizeFromHeader(std::span<const uint8_t> data)
+{
+    // PNG: the IHDR chunk follows the 8-byte signature.
+    if (data.size() >= 24 && data[0] == 0x89 && data[1] == 'P' && data[2] == 'N' && data[3] == 'G')
+        return IntSize(readBigEndian32(data, 16), readBigEndian32(data, 20));
+    // GIF: the logical screen size.
+    if (data.size() >= 10 && data[0] == 'G' && data[1] == 'I' && data[2] == 'F')
+        return IntSize(readLittleEndian16(data, 6), readLittleEndian16(data, 8));
+    // BMP: the info header after the 14-byte file header.
+    if (data.size() >= 26 && data[0] == 'B' && data[1] == 'M')
+        return IntSize(std::abs(readLittleEndian32(data, 18)), std::abs(readLittleEndian32(data, 22)));
+    // JPEG: the first start-of-frame marker.
+    if (data.size() >= 4 && data[0] == 0xff && data[1] == 0xd8) {
+        size_t offset = 2;
+        while (offset + 9 < data.size()) {
+            if (data[offset] != 0xff) {
+                ++offset;
+                continue;
+            }
+            uint8_t marker = data[offset + 1];
+            if (marker == 0xff) {
+                ++offset;
+                continue;
+            }
+            bool startOfFrame = marker >= 0xc0 && marker <= 0xcf && marker != 0xc4 && marker != 0xc8 && marker != 0xcc;
+            if (startOfFrame)
+                return IntSize(readBigEndian16(data, offset + 7), readBigEndian16(data, offset + 5));
+            if (marker == 0xd8 || (marker >= 0xd0 && marker <= 0xd7) || marker == 0x01) {
+                offset += 2;
+                continue;
+            }
+            offset += 2 + readBigEndian16(data, offset + 2);
+        }
+        return std::nullopt;
+    }
+    // IFF ILBM: the BMHD chunk.
+    if (data.size() >= 24 && data[0] == 'F' && data[1] == 'O' && data[2] == 'R' && data[3] == 'M'
+        && data[8] == 'I' && data[9] == 'L' && data[10] == 'B' && data[11] == 'M'
+        && data[12] == 'B' && data[13] == 'M' && data[14] == 'H' && data[15] == 'D')
+        return IntSize(readBigEndian16(data, 20), readBigEndian16(data, 22));
+    return std::nullopt;
+}
+
+void DatatypesImageDecoder::tryDecodeSize(bool allDataReceived)
+{
+    // ScalableImageDecoder::setData() calls this with m_lock held.
+    assertIsHeld(m_lock);
+    if (!m_data)
+        return;
+    if (auto size = sizeFromHeader(m_data->span()); size && !size->isEmpty()) {
+        setSize(*size);
+        return;
+    }
+    if (!allDataReceived)
+        return;
+    // A format the header test does not know: let the datatype find the size.
+    decodeAll();
+}
+
+bool DatatypesImageDecoder::decodeAll()
+{
+    assertIsHeld(m_lock);
+    if (m_decodeAttempted)
+        return !m_frameBufferCache.isEmpty() && m_frameBufferCache.first().isComplete();
+    m_decodeAttempted = true;
+
+    auto data = m_data->span();
+    OBDTImage image;
+    if (!obdt_decode(data.data(), data.size(), &image))
+        return setFailed();
+
+    IntSize imageSize(image.width, image.height);
+    if (size() != imageSize) {
+        // Only before the size is known: once all the data is in, setSize()
+        // would take the decoder back to SizeAvailable.
+        if (isSizeAvailable() || !setSize(imageSize)) {
+            obdt_free(&image);
+            return setFailed();
+        }
+    }
+
+    if (m_frameBufferCache.isEmpty())
+        m_frameBufferCache.grow(1);
+    auto& buffer = m_frameBufferCache.first();
+    if (!buffer.initialize(imageSize, premultiplyAlpha())) {
+        obdt_free(&image);
+        return setFailed();
+    }
+
+    auto* backingStore = buffer.backingStore();
+    const uint8_t* pixel = image.pixels;
+    for (unsigned y = 0; y < image.height; ++y) {
+        for (unsigned x = 0; x < image.width; ++x, pixel += 4)
+            backingStore->setPixel(x, y, pixel[1], pixel[2], pixel[3], pixel[0]);
+    }
+    obdt_free(&image);
+
+    buffer.setHasAlpha(image.hasAlpha);
+    buffer.setDecodingStatus(DecodingStatus::Complete);
+    return true;
+}
+
+ScalableImageDecoderFrame* DatatypesImageDecoder::frameBufferAtIndex(size_t index)
+{
+    assertIsHeld(m_lock);
+    if (index)
+        return nullptr;
+    if (m_frameBufferCache.isEmpty())
+        m_frameBufferCache.grow(1);
+    auto* buffer = &m_frameBufferCache.first();
+    if (!buffer->isComplete() && isAllDataReceived())
+        decodeAll();
+    return buffer;
+}
+
+} // namespace WebCore
