+
+/* Decoding a picture through the system's datatypes (datatypes.library and
+ * picture.datatype V43 mode). Plain C, so that AmigaOS headers and their
+ * macros stay out of WebCore's C++. */
+
+#ifndef DatatypesDecode_h
+#define DatatypesDecode_h
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    unsigned width;
+    unsigned height;
+    int hasAlpha;
+    /* width * height pixels, 4 bytes each: alpha, red, green, blue, with the
+     * alpha not premultiplied. Free it with obdt_free(). */
+    unsigned char* pixels;
+} OBDTImage;
+
+/* 1 when the system's datatypes can read the picture in data; 0 when no
+ * datatype recognised it, it was damaged, or memory ran out. */
+int obdt_decode(const void* data, unsigned long size, OBDTImage* out);
+void obdt_free(OBDTImage*);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* DatatypesDecode_h */
