+                    m_hot.tstLongAbs(variable + 1);
+                    slowUnless(Builder::Equal);
+                    m_hot.bindShort(set);
+                }
+                owner = globalObject->globalLexicalEnvironment();
+            }
+            checkWritable(metadata.m_watchpointSet);
+            barrierCheck(value, [&] { m_hot.tstByteAbs(reinterpret_cast<uint8_t*>(owner) + JSCell::cellStateOffset()); });
+            if (value.isConstant) {
+                m_hot.storeImmAbs(value.hi, variable);
+                m_hot.storeImmAbs(value.lo, variable + 1);
+            } else {
