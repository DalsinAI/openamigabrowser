+        }
+        case ClosureVar: case ClosureVarWithVarInjectionChecks: case ResolvedClosureVar: {
+            intptr_t disp = JSLexicalEnvironment::offsetOfVariables() + static_cast<intptr_t>(metadata.m_operand) * static_cast<intptr_t>(sizeof(EncodedJSValue));
+            if (!fitsDisplacement(disp))
+                return false;
+            if (type == ResolvedClosureVar)
+                checkWritable(metadata.m_watchpointSet);
+            m_hot.moveaDisp(5, scope.lo, 0);
+            barrierCheck(value, [&] { m_hot.tstByteDisp(0, JSCell::cellStateOffset()); });
+            storeValueDisp(value, 0, static_cast<int>(disp));
+            return true;
+        }
+        default: {
+            m_hot.moveaDisp(5, scope.lo, 0);
