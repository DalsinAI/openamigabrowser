+    // Comparisons and tests on any value (stage J7), not only int32s: what
+    // the interpreter's handlers do with 64-bit operations, done with the
+    // high and low words. Doubles, strings compared by their contents and
+    // objects that act as undefined take the template.
+
+    // An operand as a whole value: a frame slot, or a constant's bits.
+    struct Value {
+        bool valid { false };
+        bool isConstant { false };
+        uint32_t hi { 0 }; // the constant's words, or the slot's displacements
+        uint32_t lo { 0 };
+        JSValue constant;
+    };
+    Value valueFor(VirtualRegister reg)
+    {
+        Value value;
+        if (reg.isConstant()) {
+            value.constant = m_codeBlock->getConstant(reg);
+            uint64_t bits = JSValue::encode(value.constant);
+            value.valid = true;
+            value.isConstant = true;
+            value.hi = static_cast<uint32_t>(bits >> 32);
+            value.lo = static_cast<uint32_t>(bits);
+            return value;
+        }
+        Operand op = operandFor(m_codeBlock, reg);
+        if (!op.valid)
+            return value;
+        value.valid = true;
+        value.hi = op.hi;
+        value.lo = op.lo;
+        return value;
+    }
+    unsigned jumpTarget(const JSInstruction* instruction, int target)
+    {
+        if (!target)
+            target = m_codeBlock->outOfLineJumpOffset(instruction);
+        return m_codeBlock->bytecodeOffset(instruction) + target;
+    }
+    void loadWord(const Value& value, bool high, unsigned dn)
+    {
+        uint32_t word = high ? value.hi : value.lo;
+        if (value.isConstant)
+            m_hot.moveImm(word, dn);
+        else
+            m_hot.loadFrame(static_cast<int>(word), dn);
+    }
+    // Compares dn with a value's word (dn - word).
+    void compareWord(unsigned dn, const Value& value, bool high)
+    {
+        uint32_t word = high ? value.hi : value.lo;
+        if (value.isConstant)
+            m_hot.cmpImm(word, dn);
+        else
+            m_hot.cmpFrame(static_cast<int>(word), dn);
+    }
+
+    // lhs === rhs: branches to equal or notEqual (lists of b<cc>.l fixups
+    // for the caller to bind), or to the slow path. As the interpreter: no
+    // doubles; equal bits are equal; a non-cell on either side, or a cell
+    // that is not a string or a BigInt, makes them unequal.
+    bool strictEqual(Value lhs, Value rhs, Vector<size_t>& equal, Vector<size_t>& notEqual)
+    {
+        if (lhs.isConstant && rhs.isConstant)
+            return false;
+        if (lhs.isConstant)
+            std::swap(lhs, rhs);
+        if (rhs.isConstant && rhs.constant.isDouble())
+            return false;
+        auto branch = [&](Builder::Condition cc, Vector<size_t>& to) { to.append(m_hot.branch(cc)); };
+        // lhs (a slot) by its high word: int32, not a number, or a double.
+        loadWord(lhs, true, 0);
+        m_hot.cmpImm(int32Tag, 0);
+        size_t lhsInt32 = m_hot.branch(Builder::Equal);
+        m_hot.tst(0);
+        slowUnless(Builder::NotEqual);
+        // lhs is not a number.
+        if (rhs.isConstant) {
+            if (rhs.constant.isInt32()) {
+                branch(Builder::Always, notEqual);
+                m_hot.bindBranch(lhsInt32);
+                m_hot.loadFrame(lhs.lo, 0);
+                m_hot.cmpImm(rhs.lo, 0);
+                branch(Builder::Equal, equal);
+                branch(Builder::Always, notEqual);
+                return true;
+            }
+        } else {
+            m_hot.loadFrame(rhs.hi, 1);
+            size_t bothNotNumbers = m_hot.branch(Builder::Equal); // tst.l via the move
+            m_hot.cmpImm(int32Tag, 1);
+            branch(Builder::Equal, notEqual);
+            slowUnless(Builder::Always);
+            m_hot.bindBranch(bothNotNumbers);
+        }
+        // Neither is a number.
+        m_hot.loadFrame(lhs.lo, 0);
+        compareWord(0, rhs, false);
+        branch(Builder::Equal, equal);
+        m_hot.btst1(0);
+        branch(Builder::NotEqual, notEqual);
+        if (rhs.isConstant) {
+            if (!rhs.constant.isCell() || rhs.constant.asCell()->type() > LastValueCompareCellType) {
+                branch(Builder::Always, notEqual);
+            } else {
+                m_hot.moveaFromData(0, 0);
+                m_hot.cmpByteImmDisp(LastValueCompareCellType, 0, JSCell::typeInfoTypeOffset());
+                branch(Builder::Higher, notEqual);
+                slowUnless(Builder::Always);
+            }
+        } else {
+            m_hot.loadFrame(rhs.lo, 1);
+            m_hot.btst1(1);
+            branch(Builder::NotEqual, notEqual);
+            m_hot.moveaFromData(0, 0);
+            m_hot.cmpByteImmDisp(LastValueCompareCellType, 0, JSCell::typeInfoTypeOffset());
+            branch(Builder::Higher, notEqual);
+            m_hot.moveaFromData(1, 0);
+            m_hot.cmpByteImmDisp(LastValueCompareCellType, 0, JSCell::typeInfoTypeOffset());
+            slowUnless(Builder::LowerSame);
+            branch(Builder::Always, notEqual);
+        }
+        // lhs is an int32: equal to an int32 with the same low word only.
+        m_hot.bindBranch(lhsInt32);
+        if (rhs.isConstant) {
+            branch(Builder::Always, notEqual);
+            return true;
+        }
+        m_hot.cmpFrame(rhs.hi, 0);
+        size_t bothInt32 = m_hot.branch(Builder::Equal);
+        m_hot.tstFrame(rhs.hi);
+        branch(Builder::Equal, notEqual);
+        slowUnless(Builder::Always);
+        m_hot.bindBranch(bothInt32);
+        m_hot.loadFrame(lhs.lo, 0);
+        m_hot.cmpFrame(rhs.lo, 0);
+        branch(Builder::Equal, equal);
+        branch(Builder::Always, notEqual);
+        return true;
+    }
+
+    // A boolean result: dst gets true where the branches in yes go, false
+    // where those in no go.
+    void storeBoolean(const Operand& dst, Vector<size_t>& yes, Vector<size_t>& no)
+    {
+        for (size_t i : yes)
+            m_hot.bindBranch(i);
+        m_hot.moveq(static_cast<int8_t>(JSValue::encode(jsBoolean(true))), 0);
+        size_t store = m_hot.branchShort(Builder::Always);
+        for (size_t i : no)
+            m_hot.bindBranch(i);
+        m_hot.moveq(static_cast<int8_t>(JSValue::encode(jsBoolean(false))), 0);
+        m_hot.bindShort(store);
+        m_hot.clrFrame(dst.hi);
+        m_hot.storeFrame(0, dst.lo);
+    }
+    void jumpOn(Vector<size_t>& taken, Vector<size_t>& notTaken, unsigned target)
+    {
+        for (size_t i : taken)
+            m_hot.bindBranch(i);
+        m_hot.branchToBytecode(Builder::Always, target);
+        for (size_t i : notTaken)
+            m_hot.bindBranch(i);
+    }
+
+    template<typename Op>
+    bool strictEqualOp(const JSInstruction* instruction, bool negate)
+    {
+        auto bytecode = instruction->as<Op>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Value lhs = valueFor(bytecode.m_lhs);
+        Value rhs = valueFor(bytecode.m_rhs);
+        if (!dst.valid || dst.isConstant || !lhs.valid || !rhs.valid)
+            return false;
+        Vector<size_t> equal, notEqual;
+        if (!strictEqual(lhs, rhs, equal, notEqual))
+            return false;
+        if (negate)
+            storeBoolean(dst, notEqual, equal);
+        else
+            storeBoolean(dst, equal, notEqual);
+        return true;
+    }
+    template<typename Op>
+    bool strictEqualJump(const JSInstruction* instruction, bool negate)
+    {
+        auto bytecode = instruction->as<Op>();
+        Value lhs = valueFor(bytecode.m_lhs);
+        Value rhs = valueFor(bytecode.m_rhs);
+        if (!lhs.valid || !rhs.valid)
+            return false;
+        Vector<size_t> equal, notEqual;
+        if (!strictEqual(lhs, rhs, equal, notEqual))
+            return false;
+        unsigned target = jumpTarget(instruction, bytecode.m_targetLabel);
+        if (negate)
+            jumpOn(notEqual, equal, target);
+        else
+            jumpOn(equal, notEqual, target);
+        return true;
+    }
+
+    // Truthiness for jtrue and jfalse: booleans, undefined and null, int32s,
+    // and cells other than strings, BigInts and objects that act as
+    // undefined.
+    template<typename Op>
+    bool truthJump(const JSInstruction* instruction, bool jumpIfTrue)
+    {
+        auto bytecode = instruction->as<Op>();
+        Value value = valueFor(bytecode.m_condition);
+        if (!value.valid || value.isConstant)
+            return false;
+        Vector<size_t> truthy, falsy;
+        m_hot.loadFrame(value.hi, 0);
+        size_t notNumber = m_hot.branch(Builder::Equal);
+        m_hot.cmpImm(int32Tag, 0);
+        slowUnless(Builder::NotEqual);
+        m_hot.tstFrame(value.lo);
+        truthy.append(m_hot.branch(Builder::NotEqual));
+        falsy.append(m_hot.branch(Builder::Always));
+        m_hot.bindBranch(notNumber);
+        m_hot.loadFrame(value.lo, 0);
+        m_hot.btst1(0);
+        size_t cell = m_hot.branch(Builder::Equal);
+        // true is the only other value with bit 0 set.
+        m_hot.btstImm(0, 0);
+        truthy.append(m_hot.branch(Builder::NotEqual));
+        falsy.append(m_hot.branch(Builder::Always));
+        m_hot.bindBranch(cell);
+        m_hot.moveaFromData(0, 0);
+        m_hot.cmpByteImmDisp(LastValueCompareCellType, 0, JSCell::typeInfoTypeOffset());
+        slowUnless(Builder::LowerSame);
+        static_assert(MasqueradesAsUndefined == 1);
+        m_hot.btstImmDisp(0, 0, JSCell::typeInfoFlagsOffset());
+        slowUnless(Builder::NotEqual);
+        truthy.append(m_hot.branch(Builder::Always));
+        unsigned target = jumpTarget(instruction, bytecode.m_targetLabel);
+        if (jumpIfTrue)
+            jumpOn(truthy, falsy, target);
+        else
+            jumpOn(falsy, truthy, target);
+        return true;
+    }
+
+    // value == null (or undefined): branches to yes or no. Cells are not,
+    // unless they act as undefined (the template).
+    bool equalNull(const Value& value, Vector<size_t>& yes, Vector<size_t>& no)
+    {
+        if (!value.valid || value.isConstant)
+            return false;
+        m_hot.tstFrame(value.hi);
+        no.append(m_hot.branch(Builder::NotEqual));
+        m_hot.loadFrame(value.lo, 0);
+        m_hot.btst1(0);
+        size_t cell = m_hot.branch(Builder::Equal);
+        static_assert(JSValue::UndefinedTag == 8 && JSValue::ValueNull == 2);
+        m_hot.andImm(~static_cast<uint32_t>(JSValue::UndefinedTag), 0);
+        m_hot.cmpImm(JSValue::ValueNull, 0);
+        yes.append(m_hot.branch(Builder::Equal));
+        no.append(m_hot.branch(Builder::Always));
+        m_hot.bindBranch(cell);
+        m_hot.moveaFromData(0, 0);
+        m_hot.btstImmDisp(0, 0, JSCell::typeInfoFlagsOffset());
+        slowUnless(Builder::NotEqual);
+        no.append(m_hot.branch(Builder::Always));
+        return true;
+    }
+    template<typename Op>
+    bool equalNullOp(const JSInstruction* instruction, bool negate)
+    {
+        auto bytecode = instruction->as<Op>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        if (!dst.valid || dst.isConstant)
+            return false;
+        Vector<size_t> yes, no;
+        if (!equalNull(valueFor(bytecode.m_operand), yes, no))
+            return false;
+        if (negate)
+            storeBoolean(dst, no, yes);
+        else
+            storeBoolean(dst, yes, no);
+        return true;
+    }
+    template<typename Op>
+    bool equalNullJump(const JSInstruction* instruction, bool negate)
+    {
+        auto bytecode = instruction->as<Op>();
+        Vector<size_t> yes, no;
+        if (!equalNull(valueFor(bytecode.m_value), yes, no))
+            return false;
+        unsigned target = jumpTarget(instruction, bytecode.m_targetLabel);
+        if (negate)
+            jumpOn(no, yes, target);
+        else
+            jumpOn(yes, no, target);
+        return true;
+    }
+    bool isUndefinedOrNull(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpIsUndefinedOrNull>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Value value = valueFor(bytecode.m_operand);
+        if (!dst.valid || dst.isConstant || !value.valid || value.isConstant)
+            return false;
+        // As the interpreter: no cell check, the bits only.
+        Vector<size_t> yes, no;
+        m_hot.tstFrame(value.hi);
+        no.append(m_hot.branch(Builder::NotEqual));
+        m_hot.loadFrame(value.lo, 0);
+        m_hot.andImm(~static_cast<uint32_t>(JSValue::UndefinedTag), 0);
+        m_hot.cmpImm(JSValue::ValueNull, 0);
+        yes.append(m_hot.branch(Builder::Equal));
+        no.append(m_hot.branch(Builder::Always));
+        storeBoolean(dst, yes, no);
+        return true;
+    }
+
+    // jeq_ptr and jneq_ptr: the whole value against a constant.
+    template<typename Op>
+    bool pointerJump(const JSInstruction* instruction, bool jumpIfEqual)
+    {
+        auto bytecode = instruction->as<Op>();
+        Value value = valueFor(bytecode.m_value);
+        Value pointer = valueFor(bytecode.m_specialPointer);
+        if (!value.valid || value.isConstant || !pointer.isConstant)
+            return false;
+        Vector<size_t> equal, notEqual;
+        m_hot.loadFrame(value.lo, 0);
+        m_hot.cmpImm(pointer.lo, 0);
+        notEqual.append(m_hot.branch(Builder::NotEqual));
+        m_hot.loadFrame(value.hi, 0);
+        m_hot.cmpImm(pointer.hi, 0);
+        notEqual.append(m_hot.branch(Builder::NotEqual));
+        equal.append(m_hot.branch(Builder::Always));
+        unsigned target = jumpTarget(instruction, bytecode.m_targetLabel);
+        if (jumpIfEqual) {
+            jumpOn(equal, notEqual, target);
+            return true;
+        }
+        for (size_t i : notEqual)
+            m_hot.bindBranch(i);
+        if constexpr (requires { bytecode.metadata(m_codeBlock).m_hasJumped; })
+            m_hot.moveByteImmAbs(1, &bytecode.metadata(m_codeBlock).m_hasJumped);
+        m_hot.branchToBytecode(Builder::Always, target);
+        for (size_t i : equal)
+            m_hot.bindBranch(i);
+        return true;
+    }
+
+    // less, greater, eq and the rest as values, and jeq and jneq: int32s.
+    template<typename Op>
+    bool int32Compare(const JSInstruction* instruction, Builder::Condition cc)
+    {
+        auto bytecode = instruction->as<Op>();
+        Operand lhs = operandFor(m_codeBlock, bytecode.m_lhs);
+        Operand rhs = operandFor(m_codeBlock, bytecode.m_rhs);
+        if (!lhs.valid || !rhs.valid || (lhs.isConstant && rhs.isConstant))
+            return false;
+        Operand dst;
+        if constexpr (requires { bytecode.m_dst; }) {
+            dst = operandFor(m_codeBlock, bytecode.m_dst);
+            if (!dst.valid || dst.isConstant)
+                return false;
+        }
+        checkInt32(lhs);
+        checkInt32(rhs);
+        load(lhs, 0);
+        if (rhs.isConstant)
+            m_hot.cmpImm(rhs.constant, 0);
+        else
+            m_hot.cmpFrame(rhs.lo, 0);
+        if constexpr (requires { bytecode.m_dst; }) {
+            Vector<size_t> yes, no;
+            yes.append(m_hot.branch(cc));
+            no.append(m_hot.branch(Builder::Always));
+            storeBoolean(dst, yes, no);
+        } else
+            m_hot.branchToBytecode(cc, jumpTarget(instruction, bytecode.m_targetLabel));
         return true;
     }
 
+    // Variables in scopes (stage J7): the interpreter's handlers for the
+    // resolve type the site's cache holds when the code is written, which
+    // the code checks it still holds; anything else takes the template.
+
+    static bool fitsDisplacement(intptr_t disp) { return disp >= -32768 && disp <= 32767 - 4; }
+    // The global object's watchpoint set (var injection, var read-only)
+    // still valid, or false (nothing written) when it is not now.
+    bool checkWatchpointSet(WatchpointSet& set)
+    {
+        if (set.state() == IsInvalidated)
+            return false;
+        m_hot.cmpByteImmAbs(IsInvalidated, reinterpret_cast<uint8_t*>(&set) + WatchpointSet::offsetOfState());
+        slowUnless(Builder::Equal);
+        return true;
+    }
+    // A write to a variable: an inline watchpoint set, if there is one,
+    // already invalidated (else the slow path notifies its watchers).
+    void checkWritable(InlineWatchpointSet* set)
+    {
+        if (!set)
+            return;
+        m_hot.cmpLongImmAbs(InlineWatchpointSet::encodeState(IsInvalidated), reinterpret_cast<uint8_t*>(set) + InlineWatchpointSet::offsetOfData());
+        slowUnless(Builder::NotEqual);
+    }
+    // The write barrier, as put_by_id's: storing a cell into an object the
+    // collector has already visited (cell state 0) takes the slow path.
+    // testTarget emits a test of the object's cell state byte.
+    template<typename TestTarget>
+    void barrierCheck(const Value& value, const TestTarget& testTarget)
+    {
+        static_assert(!blackThreshold);
+        if (value.isConstant) {
+            if (value.constant.isCell()) {
+                testTarget();
+                slowUnless(Builder::Equal);
+            }
+            return;
+        }
+        m_hot.tstFrame(value.hi);
+        size_t notCell1 = m_hot.branchShort(Builder::NotEqual);
+        m_hot.loadFrame(value.lo, 0);
+        m_hot.btst1(0);
+        size_t notCell2 = m_hot.branchShort(Builder::NotEqual);
+        m_hot.tst(0);
+        size_t notCell3 = m_hot.branchShort(Builder::Equal);
+        testTarget();
+        slowUnless(Builder::Equal);
+        m_hot.bindShort(notCell1);
+        m_hot.bindShort(notCell2);
+        m_hot.bindShort(notCell3);
+    }
+    // The value into d16(an).
+    void storeValueDisp(const Value& value, unsigned an, int disp)
+    {
+        if (value.isConstant) {
+            m_hot.storeImmDisp(value.hi, an, disp);
+            m_hot.storeImmDisp(value.lo, an, disp + 4);
+        } else {
+            m_hot.copyFrameToDisp(value.hi, an, disp);
+            m_hot.copyFrameToDisp(value.lo, an, disp + 4);
+        }
+    }
+    // A global property's place: its storage into a0 (from the scope in
+    // a0) and the displacement there; false when it does not fit.
+    bool propertyPlace(PropertyOffset offset, int& disp)
+    {
+        intptr_t d;
+        if (isInlineOffset(offset))
+            d = JSObject::offsetOfInlineStorage() + offsetInInlineStorage(offset) * static_cast<intptr_t>(sizeof(EncodedJSValue));
+        else
+            d = -static_cast<intptr_t>(offset - (firstOutOfLineOffset - 2)) * static_cast<intptr_t>(sizeof(EncodedJSValue));
+        if (!fitsDisplacement(d))
+            return false;
+        if (!isInlineOffset(offset))
+            m_hot.moveaDisp(0, JSObject::butterflyOffset(), 0);
+        disp = static_cast<int>(d);
+        return true;
+    }
+    // A global property site: the scope (in a0) has the cached structure,
+    // and the cache still has the offset the code was written for.
+    template<typename Metadata>
+    bool checkGlobalProperty(Metadata& metadata)
+    {
+        if (!metadata.m_structureID)
+            return false;
+        m_hot.loadDisp(0, JSCell::structureIDOffset(), 1);
+        m_hot.cmpLongAbs(&metadata.m_structureID, 1);
+        slowUnless(Builder::NotEqual);
+        m_hot.cmpLongImmAbs(static_cast<uint32_t>(metadata.m_operand), &metadata.m_operand);
+        slowUnless(Builder::NotEqual);
+        return true;
+    }
+
+    bool resolveScope(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpResolveScope>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Operand scope = operandFor(m_codeBlock, bytecode.m_scope);
+        if (!dst.valid || dst.isConstant || !scope.valid || scope.isConstant)
+            return false;
+        auto& metadata = bytecode.metadata(m_codeBlock);
+        ResolveType type = metadata.m_resolveType;
+        unsigned depth = 0;
+        switch (type) {
+        case GlobalProperty: case GlobalVar: case GlobalLexicalVar: case ModuleVar:
+        case GlobalPropertyWithVarInjectionChecks: case GlobalVarWithVarInjectionChecks: case GlobalLexicalVarWithVarInjectionChecks:
+            if (!metadata.m_constantScope)
+                return false;
+            break;
+        case ClosureVar: case ClosureVarWithVarInjectionChecks:
+            depth = metadata.m_localScopeDepth;
+            if (depth > 16)
+                return false;
+            break;
+        default:
+            return false;
+        }
+        m_hot.cmpLongImmAbs(type, &metadata.m_resolveType);
+        slowUnless(Builder::NotEqual);
+        if (needsVarInjectionChecks(type) && !checkWatchpointSet(m_codeBlock->globalObject()->varInjectionWatchpointSet()))
+            return false;
+        m_hot.clrFrame(dst.hi);
+        if (type == ClosureVar || type == ClosureVarWithVarInjectionChecks) {
+            m_hot.cmpLongImmAbs(depth, &metadata.m_localScopeDepth);
+            slowUnless(Builder::NotEqual);
+            m_hot.moveaDisp(5, scope.lo, 0);
+            for (unsigned i = 0; i < depth; ++i)
+                m_hot.moveaDisp(0, JSScope::offsetOfNext(), 0);
+            m_hot.storeAddressFrame(0, dst.lo);
+            return true;
+        }
+        if (type == GlobalProperty || type == GlobalPropertyWithVarInjectionChecks) {
+            // The global lexical binding epoch: no new global let or const since.
+            m_hot.moveLongAbs(&metadata.m_globalLexicalBindingEpoch, 0);
+            m_hot.loadAddressAbs(&metadata.m_constantScope, 0);
+            m_hot.cmpDisp(0, JSGlobalObject::offsetOfGlobalLexicalBindingEpoch(), 0);
+            slowUnless(Builder::NotEqual);
+            m_hot.storeAddressFrame(0, dst.lo);
+            return true;
+        }
+        m_hot.copyAbsToFrame(&metadata.m_constantScope, dst.lo);
+        return true;
+    }
+
+    bool getFromScope(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpGetFromScope>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Operand scope = operandFor(m_codeBlock, bytecode.m_scope);
+        if (!dst.valid || dst.isConstant || !scope.valid || scope.isConstant)
+            return false;
+        auto& metadata = bytecode.metadata(m_codeBlock);
+        GetPutInfo info = metadata.m_getPutInfo;
+        ResolveType type = info.resolveType();
+        switch (type) {
+        case GlobalProperty: case GlobalPropertyWithVarInjectionChecks:
+        case GlobalVar: case GlobalVarWithVarInjectionChecks:
+        case GlobalLexicalVar: case GlobalLexicalVarWithVarInjectionChecks:
+        case ClosureVar: case ClosureVarWithVarInjectionChecks:
+            break;
+        default:
+            return false;
+        }
+        m_hot.cmpLongImmAbs(info.operand(), &metadata.m_getPutInfo);
+        slowUnless(Builder::NotEqual);
+        if (needsVarInjectionChecks(type) && !checkWatchpointSet(m_codeBlock->globalObject()->varInjectionWatchpointSet()))
+            return false;
+        switch (type) {
+        case GlobalVar: case GlobalVarWithVarInjectionChecks:
+        case GlobalLexicalVar: case GlobalLexicalVarWithVarInjectionChecks: {
+            // The variable's storage, fixed for the site's variable.
+            auto* variable = reinterpret_cast<uint32_t*>(metadata.m_operand);
+            if (!variable)
+                return false;
+            if (type == GlobalLexicalVar || type == GlobalLexicalVarWithVarInjectionChecks) {
+                // Not yet initialised (empty, both words 0): the slow path throws.
+                m_hot.tstLongAbs(variable);
+                size_t set = m_hot.branchShort(Builder::NotEqual);
+                m_hot.tstLongAbs(variable + 1);
+                slowUnless(Builder::Equal);
+                m_hot.bindShort(set);
+            }
+            m_hot.copyAbsToFrame(variable, dst.hi);
+            m_hot.copyAbsToFrame(variable + 1, dst.lo);
+            return true;
+        }
+        case ClosureVar: case ClosureVarWithVarInjectionChecks: {
+            intptr_t disp = JSLexicalEnvironment::offsetOfVariables() + static_cast<intptr_t>(metadata.m_operand) * static_cast<intptr_t>(sizeof(EncodedJSValue));
+            if (!fitsDisplacement(disp))
+                return false;
+            m_hot.moveaDisp(5, scope.lo, 0);
+            m_hot.copyDispToFrame(0, static_cast<int>(disp), dst.hi);
+            m_hot.copyDispToFrame(0, static_cast<int>(disp) + 4, dst.lo);
+            return true;
+        }
+        default: {
+            m_hot.moveaDisp(5, scope.lo, 0);
+            if (!checkGlobalProperty(metadata))
+                return false;
+            int disp;
+            if (!propertyPlace(static_cast<PropertyOffset>(metadata.m_operand), disp))
+                return false;
+            m_hot.copyDispToFrame(0, disp, dst.hi);
+            m_hot.copyDispToFrame(0, disp + 4, dst.lo);
+            return true;
+        }
+        }
+    }
