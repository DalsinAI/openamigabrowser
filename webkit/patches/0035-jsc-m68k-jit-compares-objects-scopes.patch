+    bool putToScope(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpPutToScope>();
+        Operand scope = operandFor(m_codeBlock, bytecode.m_scope);
+        Value value = valueFor(bytecode.m_value);
+        if (!scope.valid || scope.isConstant || !value.valid)
+            return false;
+        auto& metadata = bytecode.metadata(m_codeBlock);
+        GetPutInfo info = metadata.m_getPutInfo;
+        ResolveType type = info.resolveType();
+        JSGlobalObject* globalObject = m_codeBlock->globalObject();
+        switch (type) {
+        case GlobalProperty: case GlobalPropertyWithVarInjectionChecks:
+        case GlobalVar: case GlobalVarWithVarInjectionChecks:
+        case GlobalLexicalVar: case GlobalLexicalVarWithVarInjectionChecks:
+        case ClosureVar: case ClosureVarWithVarInjectionChecks: case ResolvedClosureVar:
+            break;
+        default:
+            return false;
+        }
+        m_hot.cmpLongImmAbs(info.operand(), &metadata.m_getPutInfo);
+        slowUnless(Builder::NotEqual);
+        if (needsVarInjectionChecks(type) && !checkWatchpointSet(globalObject->varInjectionWatchpointSet()))
+            return false;
+        switch (type) {
+        case GlobalVar: case GlobalVarWithVarInjectionChecks:
+        case GlobalLexicalVar: case GlobalLexicalVarWithVarInjectionChecks: {
+            auto* variable = reinterpret_cast<uint32_t*>(metadata.m_operand);
+            if (!variable)
+                return false;
+            JSCell* owner;
+            if (type == GlobalVar || type == GlobalVarWithVarInjectionChecks) {
+                if (!checkWatchpointSet(globalObject->varReadOnlyWatchpointSet()))
+                    return false;
+                owner = globalObject;
+            } else {
