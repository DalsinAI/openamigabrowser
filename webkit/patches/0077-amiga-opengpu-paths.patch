+
+// PATH_FILL's work memory, made when it is first wanted: a band of rows as
+// large as fits in maxWorkBytes.
+bool GraphicsContextOpenGPU::ensureWork()
+{
+    if (m_work)
+        return true;
+    if (m_noWork || !m_gpu || !(m_gpu->caps & OBGPU_CAN_PATH) || m_gpu->target_w <= 0)
+        return false;
+    unsigned long row = 32UL * static_cast<unsigned long>(m_gpu->target_w + 4);
+    unsigned long rows = std::max(1UL, std::min(16UL, maxWorkBytes / row));
+    void* work = nullptr;
+    if (!tryFastMalloc(row * rows).getValue(work)) {
+        m_noWork = true;
+        return false;
+    }
+    m_work = static_cast<unsigned char*>(work);
+    obgpu_work(m_gpu, reinterpret_cast<uintptr_t>(work), row * rows);
+    return true;
+}
+
+// ---- paths ----------------------------------------------------------------------------
+
+// Paths can be drawn here: PATH_FILL, anti-aliased as cairo's, normal
+// blending, no shadow.
+bool GraphicsContextOpenGPU::pathsWanted()
+{
+    return m_gpu && (m_gpu->caps & OBGPU_CAN_PATH) && blendMode() == BlendMode::Normal && !hasDropShadow() && shouldAntialias()
+        && ensureWork();
+}
+
+// A fill or stroke brush as cairo paints it (Cairo::FillSource and
+// StrokeSource): a colour times the global alpha, or a gradient with the
+// global alpha in its stops. Patterns stay cairo's.
+bool GraphicsContextOpenGPU::paintFor(const SourceBrush& brush, Paint& paint)
+{
+    float globalAlpha = alpha();
+    if (brush.pattern())
+        return false;
+    if (auto* gradient = brush.gradient())
+        return gradientFor(*gradient, brush.gradientSpaceTransform(), globalAlpha, paint);
+    paint.argb = premultiplied(globalAlpha < 1 ? brush.color().colorWithAlphaMultipliedBy(globalAlpha) : brush.color());
+    return true;
+}
+
+// A gradient as GradientCairo.cpp makes it, where pixman and OpenGPU draw
+// it alike: linear and radial (an elliptical one through its matrix, as
+// cairo's), with stops of one alpha (pixman mixes them unpremultiplied,
+// OpenGPU premultiplied: the same when the alpha is). Conic gradients are
+// cairo's mesh, and stay cairo's.
+bool GraphicsContextOpenGPU::gradientFor(const Gradient& gradient, const AffineTransform& gradientSpaceTransform, float globalAlpha, Paint& paint)
+{
+    double m[6] = { gradientSpaceTransform.a(), gradientSpaceTransform.b(), gradientSpaceTransform.c(),
+        gradientSpaceTransform.d(), gradientSpaceTransform.e(), gradientSpaceTransform.f() };
+    double geometry[6] = { };
+    int kind = 0;
+    if (!gradientSpaceTransform.isInvertible())
+        return false;
+    bool ok = WTF::switchOn(gradient.data(),
+        [&](const Gradient::LinearData& data) {
+            kind = OBGPU_LINEAR;
+            geometry[0] = data.point0.x();
+            geometry[1] = data.point0.y();
+            geometry[2] = data.point1.x();
+            geometry[3] = data.point1.y();
+            return data.point0 != data.point1;
+        },
+        [&](const Gradient::RadialData& data) {
+            kind = OBGPU_RADIAL;
+            geometry[0] = data.point0.x();
+            geometry[1] = data.point0.y();
+            geometry[2] = data.startRadius;
+            geometry[3] = data.point1.x();
+            geometry[4] = data.point1.y();
+            geometry[5] = data.endRadius;
+            if (data.aspectRatio != 1) {
+                // cairo's pattern matrix: y about point0 scaled by the aspect ratio
+                if (!(data.aspectRatio > 0))
+                    return false;
+                m[1] /= data.aspectRatio;
+                m[3] /= data.aspectRatio;
+                m[5] = data.point0.y() + (m[5] - data.point0.y()) / data.aspectRatio;
+            }
+            return data.point0 != data.point1 || data.startRadius != data.endRadius;
+        },
+        [&](const Gradient::ConicData&) {
+            return false;
+        });
+    size_t count = gradient.stops().size();
+    if (!ok || !count || count > 256)
+        return false;
+    Vector<GradientColorStop, 16> stops;
+    for (auto& stop : gradient.stops())
+        stops.append(stop);
+    // cairo keeps its stops in order, those at one offset as they came
+    std::stable_sort(stops.begin(), stops.end(), [](auto& a, auto& b) { return a.offset < b.offset; });
+    m_stops.resize(count * 2);
+    float firstAlpha = 0;
+    for (size_t i = 0; i < count; i++) {
+        auto [r, g, b, a] = stops[i].color.toColorTypeLossy<SRGBA<float>>().resolved();
+        a *= globalAlpha;
+        if (!i)
+            firstAlpha = a;
+        else if (a != firstAlpha)
+            return false;
+        float offset = std::clamp(stops[i].offset, 0.0f, 1.0f);
+        m_stops[i * 2] = static_cast<unsigned long>(std::lround(offset * 65536.0));
+        m_stops[i * 2 + 1] = premultiplied(r, g, b, a);
+    }
+    paint.hasGradient = true;
+    paint.gradient.kind = kind;
+    switch (gradient.spreadMethod()) {
+    case GradientSpreadMethod::Pad:
+        paint.gradient.spread = OBGPU_PAD;
+        break;
+    case GradientSpreadMethod::Reflect:
+        paint.gradient.spread = OBGPU_REFLECT;
+        break;
+    case GradientSpreadMethod::Repeat:
+        paint.gradient.spread = OBGPU_REPEAT;
+        break;
+    }
+    for (int i = 0; i < 6; i++) {
+        bool linear = i < 4;
+        if (!(std::abs(m[i]) < (linear ? 32767 : (1 << 22))) || !(std::abs(geometry[i]) < 32767))
+            return false;
+        paint.gradient.m[i] = std::lround(m[i] * (linear ? 65536 : 256));
+        paint.gradient.geometry[i] = std::lround(geometry[i] * 65536);
+    }
+    paint.gradient.stops = static_cast<int>(count);
+    paint.gradient.stop = m_stops.span().data();
+    return true;
+}
+
+// cairo's stroke state, as cairo_stroke reads it: the width given, and its
+// context's caps, joins, miter limit and dashes (16.16 in the user's units).
+bool GraphicsContextOpenGPU::strokeFor(double width, obgpu_stroke& stroke, long* dashes)
+{
+    cairo_t* cr = m_cairo.cr();
+    if (!(std::abs(width) < 32767))
+        return false;
+    stroke.width = std::lround(width * 65536);
+    stroke.cap = static_cast<int>(cairo_get_line_cap(cr));
+    stroke.join = static_cast<int>(cairo_get_line_join(cr));
+    stroke.miter = std::lround(std::clamp(cairo_get_miter_limit(cr), 0.0, 255.0) * 65536);
+    stroke.dashes = cairo_get_dash_count(cr);
+    stroke.dash = dashes;
+    stroke.dash_offset = 0;
+    if (stroke.dashes > 64)
+        return false;
+    if (stroke.dashes) {
+        double lengths[64], offset = 0;
+        cairo_get_dash(cr, lengths, &offset);
+        for (int i = 0; i < stroke.dashes; i++) {
+            if (!(lengths[i] >= 0 && lengths[i] < 32767))
+                return false;
+            dashes[i] = std::lround(lengths[i] * 65536);
+        }
+        if (!(std::abs(offset) < 32767))
+            return false;
+        stroke.dash_offset = std::lround(offset * 65536);
+    }
+    return true;
+}
+
+// The path into the batch's writer: false when it can't take it (a point
+// past 24.8, or nothing can be drawn here).
+bool GraphicsContextOpenGPU::beginPath(const Path& path)
+{
+    if (!obgpu_path_begin(m_gpu))
+        return false;
+    bool fits = true;
+    auto fixed = [&](const FloatPoint& point, long* out) {
+        if (!(std::abs(point.x()) < (1 << 22)) || !(std::abs(point.y()) < (1 << 22))) {
+            fits = false;
+            return false;
+        }
+        out[0] = std::lround(point.x() * 256.0);
+        out[1] = std::lround(point.y() * 256.0);
+        return true;
+    };
+    path.applyElements([&](const PathElement& element) {
+        long p[6];
+        if (!fits)
+            return;
+        switch (element.type) {
+        case PathElement::Type::MoveToPoint:
+            if (fixed(element.points[0], p))
+                obgpu_path_move(m_gpu, p[0], p[1]);
+            break;
+        case PathElement::Type::AddLineToPoint:
+            if (fixed(element.points[0], p))
+                obgpu_path_line(m_gpu, p[0], p[1]);
+            break;
+        case PathElement::Type::AddQuadCurveToPoint:
+            if (fixed(element.points[0], p) && fixed(element.points[1], p + 2))
+                obgpu_path_quad(m_gpu, p[0], p[1], p[2], p[3]);
+            break;
+        case PathElement::Type::AddCurveToPoint:
+            if (fixed(element.points[0], p) && fixed(element.points[1], p + 2) && fixed(element.points[2], p + 4))
+                obgpu_path_cubic(m_gpu, p[0], p[1], p[2], p[3], p[4], p[5]);
+            break;
+        case PathElement::Type::CloseSubpath:
+            obgpu_path_close(m_gpu);
+            break;
+        }
+    });
+    if (!fits)
+        obgpu_path_cancel(m_gpu);
+    return fits;
+}
+
+bool GraphicsContextOpenGPU::fillPathWith(const Path& path, const Paint& paint, bool evenOdd, CompositeOperator op)
+{
+    return beginPath(path)
+        && obgpu_fill_path(m_gpu, paint.argb, paint.hasGradient ? &paint.gradient : nullptr, evenOdd, static_cast<int>(op));
+}
+
+bool GraphicsContextOpenGPU::strokePathWith(const Path& path, const Paint& paint, double width)
+{
+    obgpu_stroke stroke;
+    long dashes[64];
+    return strokeFor(width, stroke, dashes) && beginPath(path)
+        && obgpu_stroke_path(m_gpu, paint.argb, paint.hasGradient ? &paint.gradient : nullptr, &stroke,
+            static_cast<int>(compositeOperation()));
+}
+
+// A rectangle filled with a gradient: its path, non-zero.
+bool GraphicsContextOpenGPU::gradientRect(const FloatRect& rect, Gradient& gradient, const AffineTransform& gradientSpaceTransform, float globalAlpha)
+{
+    Paint paint;
+    if (!pathsWanted() || !gradientFor(gradient, gradientSpaceTransform, globalAlpha, paint))
+        return false;
+    Path path;
+    path.addRect(rect);
+    return fillPathWith(path, paint, false, compositeOperation());
+}
+
 bool GraphicsContextOpenGPU::solidFill(const FloatRect& rect, const Color& color, CompositeOperator op, BlendMode blendMode)
 {
     long r[4];
     if (!m_gpu || blendMode != BlendMode::Normal || hasDropShadow() || !fixedRect(rect, r))
         return false;
+    // edges between pixels are anti-aliased paths: only as cairo draws them
+    if (!shouldAntialias() || !ensureWork()) {
+        int caps = m_gpu->caps;
+        m_gpu->caps &= ~OBGPU_CAN_PATH;
+        bool drawn = obgpu_fill(m_gpu, r[0], r[1], r[2], r[3], premultiplied(color), static_cast<int>(op));
+        m_gpu->caps = caps;
+        return drawn;
+    }
     return obgpu_fill(m_gpu, r[0], r[1], r[2], r[3], premultiplied(color), static_cast<int>(op));
 }
 
