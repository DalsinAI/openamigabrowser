+
+/* ---- paths --------------------------------------------------------------------------- */
+
+#if OBGPU_LINEAR != OGPU_GRAD_LINEAR || OBGPU_RADIAL != OGPU_GRAD_RADIAL || OBGPU_PAD != OGPU_SPREAD_PAD \
