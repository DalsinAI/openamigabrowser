     unsigned alpha, int bilinear);
 
+/* Paths (stream v1.6's PATH_FILL and PATH_STROKE): begin, the elements
+ * (24.8 points in the user's space, through the transform), then
+ * obgpu_fill_path or obgpu_stroke_path, which end the path either way.
+ * The words go into scratch, the batch before them sent when they need
+ * the room; a path larger than all of scratch makes the elements return 0
+ * and the fill or stroke 0. A line or curve after a close starts a new
+ * subpath where the closed one started, as cairo's. A subpath of lines or
+ * curves that never leave its start is stroked as cairo strokes it: a dot
+ * with round caps, a square along x with square caps. begin returns 0
+ * when nothing can be drawn here (then the fill or stroke returns 0 too). */
+int obgpu_path_begin(struct obgpu *g);
+int obgpu_path_move(struct obgpu *g, long x, long y);
+int obgpu_path_line(struct obgpu *g, long x, long y);
+int obgpu_path_quad(struct obgpu *g, long x1, long y1, long x, long y);
+int obgpu_path_cubic(struct obgpu *g, long x1, long y1, long x2, long y2, long x, long y);
+int obgpu_path_close(struct obgpu *g);
+/* cairo_rectangle's: a closed subpath x, y, right, down, left (24.8). */
+int obgpu_path_rect(struct obgpu *g, long x, long y, long w, long h);
+/* The path dropped, when the caller can't finish it: it goes to cairo. */
+void obgpu_path_cancel(struct obgpu *g);
+
+/* A gradient, as stream.h's: linear (x0, y0, x1, y1) or radial (x0, y0,
+ * r0, x1, y1, r1), the geometry 16.16 in the gradient's space; m its
+ * space to the user's (a, b, c, d 16.16, e, f 24.8, as a transform); the
+ * stops' offsets (16.16, 0 to 0x10000, not decreasing) and premultiplied
+ * ARGB32 colours, in pairs. */
+#define OBGPU_LINEAR    1
+#define OBGPU_RADIAL    2
+#define OBGPU_PAD       0
+#define OBGPU_REPEAT    1
+#define OBGPU_REFLECT   2
+struct obgpu_gradient {
+    int kind, spread;
+    long m[6];
+    long geometry[6];
+    int stops;
+    const unsigned long *stop;
+};
+
+/* A stroke, in the user's units: the width (16.16), cairo's cap (butt,
+ * round, square) and join (miter, round, bevel) numbers, the miter limit
+ * (16.16), and dashes (16.16 lengths, on, off, ...; 0 of them: solid; at
+ * most 64; a dash of no length is a dot or a square, as cairo's) from an
+ * offset (16.16). */
+#define OBGPU_CAP_BUTT      0
+#define OBGPU_CAP_ROUND     1
+#define OBGPU_CAP_SQUARE    2
+#define OBGPU_JOIN_MITER    0
+#define OBGPU_JOIN_ROUND    1
+#define OBGPU_JOIN_BEVEL    2
+struct obgpu_stroke {
+    long width;
+    int cap, join;
+    long miter;
+    int dashes;
+    const long *dash;
+    long dash_offset;
+};
+
+/* The path filled (non-zero, or even-odd) or stroked, anti-aliased, with a
+ * colour (premultiplied ARGB32) or, when gradient is not 0, the gradient,
+ * by a WebCore operator that leaves the pixels outside the path as they
+ * are (source-over, source-atop, destination-over, destination-out, xor,
+ * plus-lighter). */
+int obgpu_fill_path(struct obgpu *g, unsigned long argb, const struct obgpu_gradient *gradient, int evenodd, int op);
+int obgpu_stroke_path(struct obgpu *g, unsigned long argb, const struct obgpu_gradient *gradient,
+    const struct obgpu_stroke *stroke, int op);
+
 /* Words waiting to be drawn. */
 int obgpu_pending(const struct obgpu *g);
 /* Sends the batch and waits for it, if it draws anything; 0, or the error. */
