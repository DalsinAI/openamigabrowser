+/* The most stops a gradient sent here has, and a coordinate of PATH_FILL's
+ * matrix (the CPU core's limit). */
+#define OBGPU_MAX_STOPS     256
+#define OBGPU_MATRIX_MAX    0x3FFFFFFFLL
+
+#define OBGPU_PATH_OPEN     1
+#define OBGPU_PATH_TOO_BIG  2
+
+/* Room for n scratch words after the open path, and with cmd for a path
+ * command in the stream: the batch before the path is sent when it is
+ * short of either, and the path moved to the start of scratch. */
+static int pathRoom(struct obgpu *g, long n, int cmd)
+{
+    long len = g->scratch_used - g->path_start, i;
+    if (g->scratch_used + n <= g->scratch_cap && (!cmd || g->words + OBGPU_CMD_MAX <= g->stream_cap))
+        return 1;
+    if (len + n > g->scratch_cap)
+        return 0;
+    obgpu_flush(g);
+    if (g->broken)
+        return 0;
+    begin(g);
+    for (i = 0; i < len * 4; i++)
+        g->scratch[i] = g->scratch[g->path_start * 4 + i];
+    g->path_start = 0;
+    g->scratch_used = len;
+    return 1;
+}
+
+int obgpu_path_begin(struct obgpu *g)
+{
+    g->path_state = 0;
+    if (!(g->caps & OBGPU_CAN_PATH) || !obgpu_drawable(g) || !g->work
+        || g->work_bytes < (unsigned long)(g->target_w + 4) * 32 || !room(g, 0))
+        return 0;
+    g->path_state = OBGPU_PATH_OPEN;
+    g->path_start = g->scratch_used;
+    g->path_closed = 0;
+    g->path_sx = g->path_sy = 0;
+    g->path_point = 1;
+    g->path_any = 0;
+    return 1;
+}
+
+static unsigned long get(const unsigned char *p)
+{
+    return (unsigned long)p[0] << 24 | (unsigned long)p[1] << 16 | (unsigned long)p[2] << 8 | p[3];
+}
+
+/* For caps that draw something: each open subpath that never leaves its
+ * start ends a 256th of a unit along x from it, so PATH_STROKE has a
+ * direction for them (cairo's for such a subpath: a dot, or a square
+ * along x). */
+static void pathDots(struct obgpu *g, long start, long len)
+{
+    unsigned char *w = g->scratch + start * 4;
+    unsigned long sx = 0, sy = 0;
+    long at = 0, last = -1;
+    int one = 1, closed = 0, np, k;
+    for (;;) {
+        unsigned long v = at < len ? get(w + at * 4) : OGPU_PATH_MOVE;
+        if (v == OGPU_PATH_MOVE) {
+            if (one && last >= 0 && !closed)
+                put(w + last * 4, (sx + 1) & 0xFFFFFFFFUL);
+            if (at >= len)
+                return;
+            sx = get(w + at * 4 + 4);
+            sy = get(w + at * 4 + 8);
+            one = 1;
+            last = -1;
+            closed = 0;
+            at += 3;
+            continue;
+        }
+        if (v == OGPU_PATH_CLOSE) {
+            closed = 1;
+            at++;
+            continue;
+        }
+        np = v == OGPU_PATH_QUAD ? 2 : v == OGPU_PATH_CUBIC ? 3 : 1;
+        for (k = 0; k < np; k++)
+            if (get(w + (at + 1 + 2 * k) * 4) != sx || get(w + (at + 2 + 2 * k) * 4) != sy)
+                one = 0;
+        last = at + 2 * np - 1;
+        at += 1 + 2 * np;
+    }
+}
+
+/* An element: its verb and n points (x, y, 24.8). */
+static int pathPut(struct obgpu *g, int verb, int n, const long *p)
+{
+    unsigned char *q;
+    int i;
+    if (g->path_state != OBGPU_PATH_OPEN)
+        return 0;
+    /* a subpath of one point closed: cairo gives it caps, so it is left
+     * open, a line to its start (pathDots) */
+    if (verb == OGPU_PATH_CLOSE && g->path_point && !g->path_closed) {
+        long e[2];
+        e[0] = g->path_sx;
+        e[1] = g->path_sy;
+        if (!pathPut(g, OGPU_PATH_LINE, 1, e))
+            return 0;
+        g->path_closed = 1;
+        return 1;
+    }
+    if (g->path_closed && verb != OGPU_PATH_MOVE && verb != OGPU_PATH_CLOSE) {
+        long s[2];
+        s[0] = g->path_sx;
+        s[1] = g->path_sy;
+        if (!pathPut(g, OGPU_PATH_MOVE, 1, s))
+            return 0;
+    }
+    if (!pathRoom(g, 1 + 2 * n, 0)) {
+        g->path_state = OBGPU_PATH_TOO_BIG;
+        return 0;
+    }
+    q = g->scratch + g->scratch_used * 4;
+    put(q, (unsigned long)verb);
+    for (i = 0; i < 2 * n; i++)
+        put(q + 4 + i * 4, (unsigned long)p[i]);
+    g->scratch_used += 1 + 2 * n;
+    if (verb == OGPU_PATH_MOVE) {
+        g->path_sx = p[0];
+        g->path_sy = p[1];
+        g->path_point = 1;
+    }
+    for (i = 0; i < n; i++)
+        if (p[2 * i] != g->path_sx || p[2 * i + 1] != g->path_sy)
+            g->path_point = 0;
+    g->path_closed = verb == OGPU_PATH_CLOSE;
+    g->path_any |= verb != OGPU_PATH_MOVE;
+    return 1;
+}
+
+int obgpu_path_move(struct obgpu *g, long x, long y)
+{
+    long p[2];
+    p[0] = x;
+    p[1] = y;
+    return pathPut(g, OGPU_PATH_MOVE, 1, p);
+}
+
+int obgpu_path_line(struct obgpu *g, long x, long y)
+{
+    long p[2];
+    p[0] = x;
+    p[1] = y;
+    return pathPut(g, OGPU_PATH_LINE, 1, p);
+}
+
+int obgpu_path_quad(struct obgpu *g, long x1, long y1, long x, long y)
+{
+    long p[4];
+    p[0] = x1;
+    p[1] = y1;
+    p[2] = x;
+    p[3] = y;
+    return pathPut(g, OGPU_PATH_QUAD, 2, p);
+}
+
+int obgpu_path_cubic(struct obgpu *g, long x1, long y1, long x2, long y2, long x, long y)
+{
+    long p[6];
+    p[0] = x1;
+    p[1] = y1;
+    p[2] = x2;
+    p[3] = y2;
+    p[4] = x;
+    p[5] = y;
+    return pathPut(g, OGPU_PATH_CUBIC, 3, p);
+}
+
+int obgpu_path_close(struct obgpu *g)
+{
+    return pathPut(g, OGPU_PATH_CLOSE, 0, 0);
+}
+
+int obgpu_path_rect(struct obgpu *g, long x, long y, long w, long h)
+{
+    return obgpu_path_move(g, x, y) && obgpu_path_line(g, x + w, y) && obgpu_path_line(g, x + w, y + h)
+        && obgpu_path_line(g, x, y + h) && obgpu_path_close(g);
+}
+
+void obgpu_path_cancel(struct obgpu *g)
+{
+    if (g->path_state)
+        g->scratch_used = g->path_start;
+    g->path_state = 0;
+}
+
+/* A 16.16 times a 16.16, as 16.16, rounded. */
+static obgpu_s64 mul1616(long a, long b)
+{
+    return floorShift((obgpu_s64)a * b + 0x8000, 16);
+}
+
+/* A transform (a, b, c, d 16.16, e, f 24.8) as PATH_FILL's matrix words
+ * m00, m01, m02, m10, m11, m12 (16.16); 0 when it does not fit. */
+static int matrixWords(const obgpu_s64 *m, unsigned long *w)
+{
+    obgpu_s64 v[6];
+    int i;
+    v[0] = m[0];
+    v[1] = m[2];
+    v[2] = m[4] * 256;
+    v[3] = m[1];
+    v[4] = m[3];
+    v[5] = m[5] * 256;
+    for (i = 0; i < 6; i++) {
+        if (v[i] > OBGPU_MATRIX_MAX || v[i] < -OBGPU_MATRIX_MAX)
+            return 0;
+        w[i] = (unsigned long)(long)v[i];
+    }
+    return 1;
+}
+
+/* The gradient's words in scratch at the batch's end: its matrix the
+ * transform times its own. 0 when they do not fit the fixed point. */
+static int gradientWords(struct obgpu *g, const struct obgpu_gradient *gr, unsigned long *address)
+{
+    const long *c = current(g)->m, *m = gr->m;
+    obgpu_s64 t[6];
+    unsigned long mw[6];
+    unsigned char *q = g->scratch + g->scratch_used * 4;
+    int i;
+    t[0] = mul1616(c[0], m[0]) + mul1616(c[2], m[1]);
+    t[1] = mul1616(c[1], m[0]) + mul1616(c[3], m[1]);
+    t[2] = mul1616(c[0], m[2]) + mul1616(c[2], m[3]);
+    t[3] = mul1616(c[1], m[2]) + mul1616(c[3], m[3]);
+    t[4] = mul16(c[0], m[4]) + mul16(c[2], m[5]) + c[4];
+    t[5] = mul16(c[1], m[4]) + mul16(c[3], m[5]) + c[5];
+    if (!matrixWords(t, mw))
+        return 0;
+    put(q, (unsigned long)gr->kind | (unsigned long)gr->spread << 8);
+    put(q + 4, (unsigned long)gr->stops);
+    for (i = 0; i < 6; i++) {
+        put(q + 8 + i * 4, mw[i]);
+        put(q + 32 + i * 4, (unsigned long)gr->geometry[i]);
+    }
+    for (i = 0; i < 2 * gr->stops; i++)
+        put(q + 56 + i * 4, gr->stop[i]);
+    *address = g->scratch_address + (unsigned long)g->scratch_used * 4;
+    g->scratch_used += OGPU_GRAD_WORDS(gr->stops);
+    return 1;
+}
+
+static int gradientOk(const struct obgpu_gradient *gr)
+{
+    long last = 0;
+    int i;
+    if ((gr->kind != OBGPU_LINEAR && gr->kind != OBGPU_RADIAL) || gr->spread < OBGPU_PAD || gr->spread > OBGPU_REFLECT
+        || gr->stops < 1 || gr->stops > OBGPU_MAX_STOPS || !gr->stop)
+        return 0;
+    for (i = 0; i < gr->stops; i++) {
+        long offset = (long)gr->stop[2 * i];
+        if (offset < last || offset > 0x10000)
+            return 0;
+        last = offset;
+    }
+    return 1;
+}
+
+/* The open path filled or stroked: PATH_FILL or PATH_STROKE with its words,
+ * the paint's and the dashes' after them in scratch. */
+static int pathDraw(struct obgpu *g, unsigned long argb, const struct obgpu_gradient *gr, unsigned long flags,
+    const struct obgpu_stroke *s, int op)
+{
+    const struct obgpu_level *l = current(g);
+    long start = g->path_start, len = g->scratch_used - start, extra = 0;
+    int state = g->path_state, pd = pdOperator(op), i, n = 15;
+    obgpu_s64 m[6];
+    unsigned long a[21], paint = argb & 0xFFFFFFFFUL, dash = 0;
+    int dashes = s ? s->dashes : 0;
+    g->path_state = 0;
+    if (state != OBGPU_PATH_OPEN) {
+        if (state)
+            g->scratch_used = start;
+        return 0;
+    }
+    /* what follows the path in scratch, and the path itself, go if it is not drawn */
+    if (!obgpu_drawable(g) || pd < 0 || pd == OGPU_PD_CLEAR || pd == OGPU_PD_SRC || (gr && !gradientOk(gr)))
+        goto cairo;
+    if (s && (s->cap < OBGPU_CAP_BUTT || s->cap > OBGPU_CAP_SQUARE || s->join < OBGPU_JOIN_MITER
+        || s->join > OBGPU_JOIN_BEVEL || s->dashes < 0 || s->dashes > 64 || (s->dashes && !s->dash)))
+        goto cairo;
+    for (i = 0; i < 6; i++)
+        m[i] = l->m[i];
+    if (!matrixWords(m, a + 7))
+        goto cairo;
+    /* nothing to draw: the operators here leave a pixel as it is where the
+     * paint is 0; an empty clip (CLIP's wh of 0 would be the whole target);
+     * a stroke of no width (cairo strokes nothing) */
+    if (!g->path_any || (!gr && !paint) || l->cx1 <= l->cx0 || l->cy1 <= l->cy0 || (s && s->width <= 0)) {
+        g->scratch_used = start;
+        return 1;
+    }
+    if (gr)
+        extra += OGPU_GRAD_WORDS(gr->stops);
+    /* dashes of no length (dots) need the pattern on and off in turn: an
+     * odd count is written twice */
+    if (dashes & 1)
+        for (i = 0; i < dashes; i++)
+            if (!s->dash[i]) {
+                dashes *= 2;
+                break;
+            }
+    extra += dashes;
+    if (!pathRoom(g, extra, 1))
+        goto cairo;
+    start = g->path_start;
+    if (s && s->cap != OBGPU_CAP_BUTT)
+        pathDots(g, start, len);
+    if (gr && !gradientWords(g, gr, &paint))
+        goto cairo;
+    if (dashes) {
+        unsigned char *q = g->scratch + g->scratch_used * 4;
+        long d[128];
+        for (i = 0; i < dashes; i++)
+            if ((d[i] = s->dash[i % s->dashes]) < 0)
+                goto cairo;
+        /* a dash of no length: a 256th of a unit, its gap that much shorter,
+         * so PATH_STROKE draws its caps as cairo does */
+        for (i = 0; !(dashes & 1) && i < dashes; i += 2)
+            if (d[i] < 0x100) {
+                d[i + 1] = d[i + 1] > 0x100 - d[i] ? d[i + 1] - (0x100 - d[i]) : 0;
+                d[i] = 0x100;
+            }
+        dash = g->scratch_address + (unsigned long)g->scratch_used * 4;
+        for (i = 0; i < dashes; i++)
+            put(q + i * 4, (unsigned long)d[i]);
+        g->scratch_used += dashes;
+    }
+    sendClip(g);
+    a[0] = (unsigned long)pd | flags | (gr ? OGPU_PATH_GRADIENT : 0);
+    a[1] = paint;
+    a[2] = 0;
+    a[3] = 0;
+    a[4] = 0;
+    a[5] = g->scratch_address + (unsigned long)start * 4;
+    a[6] = (unsigned long)len;
+    a[13] = g->work;
+    a[14] = g->work_bytes;
+    if (s) {
+        a[15] = (unsigned long)s->width;
+        a[16] = (unsigned long)s->cap | (unsigned long)s->join << 4;
+        a[17] = (unsigned long)(s->miter < 0 ? 0 : s->miter > 0xFFFFFF ? 0xFFFFFF : s->miter);
+        a[18] = dash;
+        a[19] = (unsigned long)dashes;
+        a[20] = (unsigned long)s->dash_offset;
+        n = 21;
+    }
+    emit(g, s ? OGPU_OP_PATH_STROKE : OGPU_OP_PATH_FILL, n, a);
+    g->drawn++;
+    g->counts->draws++;
+    return 1;
+cairo:
+    g->scratch_used = g->path_start;
+    return 0;
+}
+
+int obgpu_fill_path(struct obgpu *g, unsigned long argb, const struct obgpu_gradient *gradient, int evenodd, int op)
+{
+    return pathDraw(g, argb, gradient, evenodd ? OGPU_PATH_EVENODD : 0, 0, op);
+}
+
+int obgpu_stroke_path(struct obgpu *g, unsigned long argb, const struct obgpu_gradient *gradient,
+    const struct obgpu_stroke *stroke, int op)
+{
+    return pathDraw(g, argb, gradient, 0, stroke, op);
+}
+
+/* A rectangle with edges between pixels, or turned: its path, anti-aliased. */
+static int rectPath(struct obgpu *g, long x, long y, long w, long h, unsigned long argb, int op)
+{
+    if (!obgpu_path_begin(g))
+        return 0;
+    obgpu_path_rect(g, x, y, w, h);
+    return obgpu_fill_path(g, argb, 0, 0, op);
+}
