 void GraphicsContextOpenGPU::fillRect(const FloatRect& rect, Gradient& gradient, const AffineTransform& gradientSpaceTransform, RequiresClipToRect requiresClipToRect)
 {
+    if (gradientRect(rect, gradient, gradientSpaceTransform, alpha()))
+        return;
     handOn(OBGPU_GRADIENT);
     m_cairo.fillRect(rect, gradient, gradientSpaceTransform, requiresClipToRect);
 }
 
 void GraphicsContextOpenGPU::fillRoundedRectImpl(const FloatRoundedRect& rect, const Color& color)
 {
+    // as Cairo::fillRoundedRect: the colour as it is, no global alpha
+    if (pathsWanted()) {
+        Paint paint;
+        paint.argb = premultiplied(color);
+        Path path;
+        path.addRoundedRect(rect);
+        if (fillPathWith(path, paint, false, compositeOperation()))
+            return;
+    }
     handOn(OBGPU_ROUNDED);
     m_cairo.fillRoundedRectImpl(rect, color);
 }
 
 void GraphicsContextOpenGPU::fillRectWithRoundedHole(const FloatRect& rect, const FloatRoundedRect& hole, const Color& color)
 {
+    // as Cairo::fillRectWithRoundedHole: the fill brush and rule, not the colour
+    if (!color.isValid())
+        return;
+    Paint paint;
+    if (pathsWanted() && paintFor(fillBrush(), paint)) {
+        Path path;
+        path.addRect(rect);
+        if (!hole.radii().isZero())
+            path.addRoundedRect(hole);
+        else
+            path.addRect(hole.rect());
+        if (fillPathWith(path, paint, fillRule() == WindRule::EvenOdd, compositeOperation()))
+            return;
+    }
     handOn(OBGPU_ROUNDED);
     m_cairo.fillRectWithRoundedHole(rect, hole, color);
 }
 
 void GraphicsContextOpenGPU::strokeRect(const FloatRect& rect, float lineWidth)
 {
+    Paint paint;
+    if (pathsWanted() && paintFor(strokeBrush(), paint)) {
+        Path path;
+        path.addRect(rect);
+        if (strokePathWith(path, paint, lineWidth))
+            return;
+    }
     handOn(OBGPU_STROKE);
     m_cairo.strokeRect(rect, lineWidth);
 }
 
+void GraphicsContextOpenGPU::fillPath(const Path& path)
+{
+    if (path.isEmpty())
+        return;
+    Paint paint;
+    if (pathsWanted() && paintFor(fillBrush(), paint) && fillPathWith(path, paint, fillRule() == WindRule::EvenOdd, compositeOperation()))
+        return;
+    handOn(OBGPU_PATH);
+    m_cairo.fillPath(path);
+}
+
+void GraphicsContextOpenGPU::strokePath(const Path& path)
+{
+    if (path.isEmpty())
+        return;
+    Paint paint;
+    if (pathsWanted() && paintFor(strokeBrush(), paint) && strokePathWith(path, paint, cairo_get_line_width(m_cairo.cr())))
+        return;
+    handOn(OBGPU_STROKE);
+    m_cairo.strokePath(path);
+}
