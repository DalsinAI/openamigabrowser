-    static bool same(const Operand& a, const Operand& b) { return !a.isConstant && !b.isConstant && a.hi == b.hi; }
+    static bool same(const Operand& a, const Operand& b) { return !a.isConstant && !a.isDoubleConstant && !b.isConstant && !b.isDoubleConstant && a.hi == b.hi; }
+    static bool isConstant(const Operand& op) { return op.isConstant || op.isDoubleConstant; }
+
+    // A number into fpn: an int32 converts, a double unboxes (its high word
+    // less JSValue::DoubleEncodeOffset's). Anything else takes the slow path.
+    static constexpr uint32_t doubleEncodeOffsetHigh = static_cast<uint32_t>(JSValue::DoubleEncodeOffset >> 32);
+    void loadFloat(const Operand& op, unsigned fpn)
+    {
+        if (op.isConstant) {
+            m_hot.fmoveLongImm(op.constant, fpn);
+            return;
+        }
+        if (op.isDoubleConstant) {
+            m_hot.fmoveDoubleImm(std::bit_cast<uint64_t>(op.doubleConstant), fpn);
+            return;
+        }
+        m_hot.cmpFrameImm(int32Tag, op.hi);
+        size_t notInt32 = m_hot.branchShort(Builder::NotEqual);
+        m_hot.fmoveLongFrame(op.lo, fpn);
+        size_t done = m_hot.branchShort(Builder::Always);
+        m_hot.bindShort(notInt32);
+        m_hot.loadFrame(op.hi, 0);
+        m_hot.cmpImm(doubleEncodeOffsetHigh, 0);
+        slowUnless(Builder::CarrySet); // below every encoded double: a cell or other
+        m_hot.subImm(doubleEncodeOffsetHigh, 0);
+        m_hot.pushFrame(op.lo);
+        m_hot.push(0);
+        m_hot.fmoveDoublePop(fpn);
+        m_hot.bindShort(done);
+    }
+    // fpn into dst as a double JSValue, NaN made pure as JSValue asks.
+    void boxDouble(unsigned fpn, const Operand& dst)
+    {
+        m_hot.fop(Builder::FPTest, fpn, 0);
+        size_t ordered = m_hot.fbranchShort(Builder::FPOrdered);
+        m_hot.fmoveDoubleImm(std::bit_cast<uint64_t>(PNaN), fpn);
+        m_hot.bindFShort(ordered);
+        m_hot.fmoveDoublePush(fpn);
+        m_hot.pop(0);
+        m_hot.addImm(doubleEncodeOffsetHigh, 0);
+        m_hot.storeFrame(0, dst.hi);
+        m_hot.popToFrame(dst.lo);
+    }
+    void floatArith(OpcodeID opcode, const Operand& dst, const Operand& lhs, const Operand& rhs)
+    {
+        Builder::FPOperation operation = opcode == op_add ? Builder::FPAdd : opcode == op_sub ? Builder::FPSub : Builder::FPMul;
+        loadFloat(lhs, 0);
+        loadFloat(rhs, 1);
+        m_hot.fop(operation, 1, 0);
+        boxDouble(0, dst);
+    }
+    static bool isCompare(OpcodeID opcode)
+    {
+        switch (opcode) {
+        case op_jless: case op_jlesseq: case op_jgreater: case op_jgreatereq:
+        case op_jnless: case op_jnlesseq: case op_jngreater: case op_jngreatereq:
+            return true;
+        default:
+            return false;
+        }
+    }
+    static Builder::FPCondition floatCondition(OpcodeID opcode)
+    {
+        switch (opcode) {
+        case op_jless: return Builder::FPOrderedLess;
+        case op_jlesseq: return Builder::FPOrderedLessEqual;
+        case op_jgreater: return Builder::FPOrderedGreater;
+        case op_jgreatereq: return Builder::FPOrderedGreaterEqual;
+        // "not less" is true for NaN.
+        case op_jnless: return Builder::FPUnorderedGreaterEqual;
+        case op_jnlesseq: return Builder::FPUnorderedGreater;
+        case op_jngreater: return Builder::FPUnorderedLessEqual;
+        default: return Builder::FPUnorderedLess;
+        }
+    }
+    void floatCompare(OpcodeID opcode, const Operand& lhs, const Operand& rhs, unsigned target)
+    {
+        loadFloat(lhs, 0);
+        loadFloat(rhs, 1);
+        m_hot.fop(Builder::FPCompare, 1, 0); // fp0 - fp1
+        m_hot.fbranchToBytecode(floatCondition(opcode), target);
+    }
 
