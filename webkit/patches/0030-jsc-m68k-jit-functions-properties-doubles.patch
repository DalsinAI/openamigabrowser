 .../llint/LowLevelInterpreter64.asm           |  16 +
 .../JavaScriptCore/llint/M68KTemplateJIT.cpp  | 454 ++++++++++++++++--
 Source/JavaScriptCore/llint/M68KTemplateJIT.h |   7 +-
 .../offlineasm-py/offlineasm/m68k.py          |  12 +-
 Source/JavaScriptCore/offlineasm/m68k.rb      |   8 +-
 Source/JavaScriptCore/runtime/OptionsList.h   |   3 +-
 7 files changed, 452 insertions(+), 53 deletions(-)

diff --git a/Source/JavaScriptCore/llint/LLIntSlowPaths.cpp b/Source/JavaScriptCore/llint/LLIntSlowPaths.cpp
index feef09ae4e7..9333b282198 100644
--- a/Source/JavaScriptCore/llint/LLIntSlowPaths.cpp
+++ b/Source/JavaScriptCore/llint/LLIntSlowPaths.cpp
@@ -544,6 +544,11 @@ LLINT_SLOW_PATH_DECL(replace)
         codeBlock->dontJITAnytimeSoon();
     LLINT_END_IMPL();
 #else // ENABLE(JIT)
+#if CPU(M68K) && ENABLE(C_LOOP)
+    // The 68k template JIT: a function called (or returning) often gets its
+    // code now; op_enter runs it from the next call on.
+    M68KTemplateJIT::compileIfNeeded(codeBlock);
+#endif
     codeBlock->dontJITAnytimeSoon();
     LLINT_END_IMPL();
 #endif // ENABLE(JIT)
diff --git a/Source/JavaScriptCore/llint/LowLevelInterpreter64.asm b/Source/JavaScriptCore/llint/LowLevelInterpreter64.asm
index 059ff5bacb5..c186873a669 100644
--- a/Source/JavaScriptCore/llint/LowLevelInterpreter64.asm
+++ b/Source/JavaScriptCore/llint/LowLevelInterpreter64.asm
@@ -868,6 +868,22 @@ _llint_op_enter:
 
 .opEnterDispatch:
     checkTraps(macro()
+        if M68K
+            # The 68k template JIT (llint/M68KTemplateJIT.cpp): run this
+            # CodeBlock's code from the instruction after op_enter if it has
+            # any, else count towards compiling it.
+            loadp CodeBlock + LowWordOffset[cfr], t1
+            loadp CodeBlock::m_m68kTemplateMap[t1], t0
+            btpz t0, .opEnterNotCompiled
+            loadp PtrSize[t0], t0
+            jmp t0
+        .opEnterNotCompiled:
+            checkSwitchToJIT(
+                5,
+                macro ()
+                    callSlowPath(_llint_replace)
+                end)
+        end
         dispatchOp(narrow, op_enter)
     end)
 
