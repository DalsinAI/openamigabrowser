+    // Property access (stage J4), for the shape the interpreter's inline
+    // cache already holds: the object's structure is the cached one, the
+    // property is at the cached offset. The cache is read as the code runs,
+    // so it may change (or be cleared by the garbage collector) under the
+    // code; a miss takes the slow path, which updates it.
+
+    // The base cell into a0, or the slow path for anything else.
+    void loadCell(const Operand& base)
+    {
+        m_hot.tstFrame(base.hi);
+        slowUnless(Builder::NotEqual);
+        m_hot.loadFrame(base.lo, 0);
+        m_hot.btst1(0);
+        slowUnless(Builder::NotEqual);
+        m_hot.moveaFromData(0, 0);
+    }
+    // a0's property storage into a0 and the property's displacement from
+    // there into d1, given the property offset in d1. Calls access for the
+    // inline case and then for the out-of-line one, with the d8 to use.
+    template<typename Access>
+    void withProperty(const Access& access)
+    {
+        m_hot.cmpImm(firstOutOfLineOffset, 1);
+        size_t outOfLine = m_hot.branchShort(Builder::GreaterEqual);
+        m_hot.lsl3(1);
+        access(static_cast<int>(JSObject::offsetOfInlineStorage()));
+        size_t done = m_hot.branchShort(Builder::Always);
+        m_hot.bindShort(outOfLine);
+        // As the interpreter: the butterfly, less (offset - (first - 2)) values.
+        m_hot.moveaDisp(0, JSObject::butterflyOffset(), 0);
+        m_hot.neg(1);
+        m_hot.addImm(firstOutOfLineOffset - 2, 1);
+        m_hot.lsl3(1);
+        access(0);
+        m_hot.bindShort(done);
+    }
+
