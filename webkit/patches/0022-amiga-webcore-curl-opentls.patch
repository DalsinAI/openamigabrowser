+{
+    return notSupported();
+}
+
+auto CryptoKeyRSA::algorithm() const -> KeyAlgorithm
+{
+    Vector<uint8_t> publicExponent;
+
+    if (m_restrictedToSpecificHash) {
+        return CryptoRsaHashedKeyAlgorithm {
+            CryptoRsaKeyAlgorithm {
+                CryptoKeyAlgorithm { CryptoAlgorithmRegistry::singleton().name(algorithmIdentifier()) },
+                0,
+                Uint8Array::create(publicExponent.span())
+            },
+            CryptoKeyAlgorithm { CryptoAlgorithmRegistry::singleton().name(m_hash) }
+        };
+    }
+
+    return CryptoRsaKeyAlgorithm {
+        CryptoKeyAlgorithm { CryptoAlgorithmRegistry::singleton().name(algorithmIdentifier()) },
+        0,
+        Uint8Array::create(publicExponent.span())
+    };
+}
+
+std::unique_ptr<CryptoKeyRSAComponents> CryptoKeyRSA::exportData() const
+{
+    return nullptr;
+}
+
+// Serialized keys (IndexedDB, postMessage): copied as they are, as the
+// OpenSSL and libgcrypt ports do; with no keys to serialize, unused.
+
+std::optional<Vector<uint8_t>> defaultWebCryptoMasterKey()
+{
+    return std::nullopt;
+}
+
+bool wrapSerializedCryptoKey(const Vector<uint8_t>&, const Vector<uint8_t>& key, Vector<uint8_t>& result)
+{
+    result = Vector<uint8_t>(key);
+    return true;
+}
+
+std::optional<WrappedCryptoKey> readSerializedCryptoKey(const Vector<uint8_t>& wrappedKey)
+{
+    std::array<uint8_t, 24> a { 0 };
+    std::array<uint8_t, 16> b { 0 };
+    WrappedCryptoKey k { a, wrappedKey, b };
+    return k;
+}
+
+std::optional<Vector<uint8_t>> unwrapCryptoKey(const Vector<uint8_t>&, const WrappedCryptoKey& wrappedKey)
+{
+    return wrappedKey.encryptedKey;
+}
+
