+++ b/Source/WebCore/platform/network/amiga/CurlSSLHandleAmiga.cpp
@@ -28,33 +28,15 @@
 
 namespace WebCore {
 
-// AmiSSL keeps its trusted root certificates in AmiSSL:Certs, OpenSSL's
-// default verify paths, which curl uses when no CA file is given. The cipher
-// list prefers ciphers that are cheap on a 68k without AES instructions. The
-// key exchange offers X25519 and P-256 only: some servers (login.live.com)
-// pick P-384 when it is offered, and its arithmetic takes a 68020 several
-// seconds longer, which counts against the server's handshake timeout.
+// curl does TLS through OpenTLS (opentls.library), which checks certificates
+// against its own store (S:OpenTLS/ca-bundle.pem and ENVARC:OpenTLS/certs/)
+// when no CA file is given, so none is set here: a CA file would replace that
+// store. OpenTLS also picks the cipher suites and key exchange itself,
+// preferring suites that are cheap on a 68k without AES instructions, and
+// curl's OpenTLS backend takes no cipher or curve lists (curl refuses a
+// cipher list with CURLE_NOT_BUILT_IN), so none are set either.
 void CurlSSLHandle::platformInitialize()
 {
-    constexpr auto cipherList =
-        "TLS_CHACHA20_POLY1305_SHA256:"
-        "TLS_AES_128_GCM_SHA256:"
-        "TLS_AES_256_GCM_SHA384:"
-        "ECDHE-ECDSA-CHACHA20-POLY1305:"
-        "ECDHE-RSA-CHACHA20-POLY1305:"
-        "ECDHE-ECDSA-AES128-GCM-SHA256:"
-        "ECDHE-RSA-AES128-GCM-SHA256:"
-        "ECDHE-ECDSA-AES256-GCM-SHA384:"
-        "ECDHE-RSA-AES256-GCM-SHA384:"
-        "ECDHE-ECDSA-AES128-SHA:"
-        "ECDHE-RSA-AES128-SHA:"
-        "AES128-GCM-SHA256:"
-        "AES128-SHA"_s;
-    constexpr auto ecCurves =
-        "X25519:"
-        "P-256"_s;
-    setCipherList(cipherList);
-    setECCurves(ecCurves);
 }
 
 } // namespace WebCore
