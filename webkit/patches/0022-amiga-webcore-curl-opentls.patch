From 2c704df3dd3ac697ff2fa81ee4c44e3b6c61cc2f Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Mon, 19 Oct 2026 20:16:23 +0000
Subject: [PATCH] WebCore (Amiga): curl on OpenTLS, no OpenSSL in the engine

curl does TLS through OpenTLS (opentls.library, openamigacurl), so the
Amiga port no longer finds or links OpenSSL (AmiSSL): USE(OPENSSL) is off,
platform/OpenSSL.cmake is not included, and curl's OpenSSL-only files
(CurlSSLVerifier, OpenSSLHelper) are left out of the build.

The curl backend compiles its OpenSSL paths only with USE(OPENSSL): the
SSL_CTX callback, the TLS details for the inspector and the certificate
chain. Without OpenSSL a response has no CertificateInfo, and cipher and
curve lists go to curl only when a port sets them. The Amiga sets none,
nor a CA file: OpenTLS picks its own suites, curl's OpenTLS backend takes
no lists, and its own store is S:OpenTLS/ca-bundle.pem.

WebCrypto has no backend on the Amiga (crypto/amiga/CryptoAmiga.cpp):
crypto.subtle offers SHA-1 and SHA-2 digests, from PAL's CryptoDigest;
every other algorithm is not registered and gives NotSupportedError.
---
 Source/WebCore/PlatformAmiga.cmake            |  24 +-
 Source/WebCore/crypto/amiga/CryptoAmiga.cpp   | 370 ++++++++++++++++++
 Source/WebCore/crypto/keys/CryptoKeyEC.h      |  10 +
 Source/WebCore/crypto/keys/CryptoKeyRSA.h     |  11 +
 .../network/amiga/CurlSSLHandleAmiga.cpp      |  32 +-
 .../network/curl/CertificateInfoCurl.cpp      |  16 +-
 .../platform/network/curl/CurlContext.cpp     |  22 ++
 .../platform/network/curl/CurlContext.h       |   4 +
 .../platform/network/curl/CurlSSLHandle.h     |   2 +
 Source/cmake/OptionsAmiga.cmake               |   7 +-
 10 files changed, 464 insertions(+), 34 deletions(-)
 create mode 100644 Source/WebCore/crypto/amiga/CryptoAmiga.cpp

diff --git a/Source/WebCore/PlatformAmiga.cmake b/Source/WebCore/PlatformAmiga.cmake
index ed29f822..be2f0fc1 100644
--- a/Source/WebCore/PlatformAmiga.cmake
+++ b/Source/WebCore/PlatformAmiga.cmake
@@ -1,12 +1,23 @@
 include(platform/Cairo.cmake)
 include(platform/Curl.cmake)
 include(platform/FreeType.cmake)
-include(platform/OpenSSL.cmake)
 
-# AmiSSL: call OpenSSL through its stub functions (libamisslstubs) rather
-# than the inline library-call macros, which C++ such as ::BIO_new() cannot
-# use. The browser opens AmiSSL (InitAmiSSL) in each task that uses it.
-add_definitions(-DPROTO_AMISSL_H=1)
+# TLS is curl's own business: curl is built on OpenTLS (opentls.library,
+# openamigacurl), and WebCore links no OpenSSL. The curl files that hand
+# curl's OpenSSL objects to OpenSSL (the certificate chain collector and its
+# helpers) are left out, and the curl code that calls them is compiled out
+# with USE(OPENSSL) off.
+list(REMOVE_ITEM WebCore_SOURCES
+    platform/network/curl/CurlSSLVerifier.cpp
+    platform/network/curl/OpenSSLHelper.cpp
+)
+list(REMOVE_ITEM WebCore_PRIVATE_FRAMEWORK_HEADERS
+    platform/network/curl/CurlSSLVerifier.h
+    platform/network/curl/OpenSSLHelper.h
+)
+list(REMOVE_ITEM WebCore_LIBRARIES
+    OpenSSL::SSL
+)
 
 # Form controls and scrollbars are drawn by the Adwaita theme, which paints
 # with GraphicsContext only; the media controls it also carries are left out.
@@ -37,6 +48,9 @@ list(APPEND WebCore_SOURCES
     accessibility/playstation/AXObjectCachePlayStation.cpp
     accessibility/playstation/AccessibilityObjectPlayStation.cpp
 
+    # WebCrypto without a crypto library: digests only (PAL's CryptoDigest).
+    crypto/amiga/CryptoAmiga.cpp
+
     editing/amiga/EditorAmiga.cpp
 
     platform/amiga/LibCompatAmiga.c
