diff --git a/Source/WebCore/platform/network/amiga/OpenWebFetchAmiga.c b/Source/WebCore/platform/network/amiga/OpenWebFetchAmiga.c
new file mode 100644
index 00000000000..c7d9d7265c0
--- /dev/null
+++ b/Source/WebCore/platform/network/amiga/OpenWebFetchAmiga.c
@@ -0,0 +1,366 @@
+/*
+ * openweb.fetch for WebCore's network thread (OpenWebFetchAmiga.h).
+ *
+ * Each fetch keeps one call in flight once it has started: its HEAD until
+ * the head comes, then a READ. A "not yet" answer (the card's held call
+ * ran out its wait) is asked again at once, so on the card wf_wait() is
+ * always woken by an answer within the wait, and on the native transport
+ * wf_wait() moves every fetch on. Body bytes come in two buffers by turns:
+ * the next READ goes into one while WebCore copies the other.
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "OpenWebFetchAmiga.h"
+
+#if defined(__has_include)
+#if __has_include(<openweb/webfetch.h>)
+#define OBWF_TRANSPORT 1
+#endif
+#endif
+
+#ifdef OBWF_TRANSPORT
+
+#include <string.h>
+#include <exec/types.h>
+#include <exec/memory.h>
+#include <exec/tasks.h>
+#include <dos/dos.h>
+#include <proto/exec.h>
+#include <openweb/webfetch.h>
+
+#define OBWF_HEAD_ROOM (8UL << 10)
+#define OBWF_READ_ROOM (32UL << 10)
+/* How long the card may hold a HEAD or READ; the native transport asks
+ * without waiting and wf_wait() does the waiting. */
+#define OBWF_HOLD_MS 2000UL
+/* How long a SEND may wait for room in the upload queue. */
+#define OBWF_SEND_MS 100UL
+
+struct OBWFNet {
+    struct wf_service s;
+    int open;
+    struct Task *task;
+    BYTE bit;
+};
+
+struct OBWFFetch {
+    OBWFNet *net;
+    ULONG fetch;
+    int opened;
+    int busy;                   /* a is in flight */
+    struct wf_async a;
+    UBYTE *head;
+    ULONG headRoom;
+    UBYTE *buf[2];
+    int cur;                    /* the buffer the READ in flight writes */
+};
+
+/* openweb.fetch's error for a call that failed. */
+static unsigned long error_of(LONG status)
+{
+    if (status == OSERR_CANCELLED)
+        return WF_E_CANCELLED;
+    if (status == OSERR_LOST)
+        return WF_E_CLOSED;
+    if (status == OSERR_BADREQUEST)
+        return WF_E_PROTOCOL;
+    return WF_E_HOST;
+}
+
+int obwf_available(void)
+{
+    return 1;
+}
+
+OBWFNet *obwf_net_new(void)
+{
+    OBWFNet *n = AllocVec(sizeof *n, MEMF_ANY | MEMF_CLEAR);
+    if (!n)
+        return NULL;
+    n->task = FindTask(NULL);
+    if ((n->bit = AllocSignal(-1)) < 0) {
+        FreeVec(n);
+        return NULL;
+    }
+    n->open = wf_service_open(&n->s) == OSERR_OK;
+    return n;
+}
+
+void obwf_net_free(OBWFNet *n)
+{
+    if (!n)
+        return;
+    if (n->open)
+        wf_service_close(&n->s);
+    FreeSignal(n->bit);
+    FreeVec(n);
+}
+
+int obwf_net_decodes(OBWFNet *n)
+{
+    /* The card's host library decodes; the native transport hands coded
+     * bodies to the datatypes' hook, which is empty until stream.datatype
+     * is there, and then sends them as they came. */
+    return n->open && n->s.where != WF_WHERE_NATIVE;
+}
+
+void obwf_net_wait(OBWFNet *n, unsigned long ms)
+{
+    ULONG mask = 1UL << n->bit;
+    if (n->open)
+        wf_wait(&n->s, ms, mask);
+    else
+        Wait(mask);
+    /* The caller looks at its work after this, so a wake that came
+     * meanwhile is not lost. Ctrl-C, which the native transport leaves
+     * set, means nothing to this task. */
+    SetSignal(0, mask | SIGBREAKF_CTRL_C);
+}
+
+void obwf_net_wake(OBWFNet *n)
+{
+    Signal(n->task, 1UL << n->bit);
+}
+
+OBWFFetch *obwf_fetch_new(OBWFNet *n, const char *request, unsigned long length, int decode, int hasBody,
+                          unsigned long bodyLength, const void *part, unsigned long partLength,
+                          unsigned long timeout, unsigned long *error)
+{
+    OBWFFetch *f;
+    LONG status;
+    ULONG flags = (decode ? WF_DECODE : 0) | (hasBody ? WF_BODY : 0);
+    *error = WF_E_HOST;
+    if (!n->open) {
+        *error = WF_E_CONNECT;
+        return NULL;
+    }
+    if (!(f = AllocVec(sizeof *f, MEMF_ANY | MEMF_CLEAR)))
+        return NULL;
+    f->net = n;
+    f->headRoom = OBWF_HEAD_ROOM;
+    f->head = AllocVec(f->headRoom, MEMF_ANY);
+    f->buf[0] = AllocVec(OBWF_READ_ROOM, MEMF_ANY);
+    f->buf[1] = AllocVec(OBWF_READ_ROOM, MEMF_ANY);
+    if (!f->head || !f->buf[0] || !f->buf[1]) {
+        obwf_fetch_free(f);
+        return NULL;
+    }
+    status = wf_open(&n->s, request, length, flags, bodyLength, timeout, part, partLength, &f->fetch);
+    if (status != OSERR_OK) {
+        *error = error_of(status);
+        obwf_fetch_free(f);
+        return NULL;
+    }
+    f->opened = 1;
+    return f;
+}
+
+int obwf_fetch_send(OBWFFetch *f, const void *data, unsigned long length, int last)
+{
+    ULONG taken = 0;
+    if (wf_send(&f->net->s, f->fetch, data, length, last ? TRUE : FALSE, OBWF_SEND_MS, &taken) != OSERR_OK)
+        return -1;
+    return taken || (!length && last) ? 1 : 0;
+}
+
+/* Starts op into buf unless a call is in flight; 0 when it could not. */
+static int start(OBWFFetch *f, UWORD op, UBYTE *buf, ULONG room)
+{
+    if (f->busy)
+        return 1;
+    if (wf_async_start(&f->net->s, &f->a, op, f->fetch, buf, room, OBWF_HOLD_MS) != OSERR_OK)
+        return 0;
+    f->busy = 1;
+    return 1;
+}
+
+/* The call in flight, answered: 1 with its answer in f->a, 0 not yet. */
+static int answered(OBWFFetch *f)
+{
+    if (!wf_async_check(&f->a))
+        return 0;
+    f->busy = 0;
+    return 1;
+}
+
+int obwf_fetch_head(OBWFFetch *f, OBWFHead *out)
+{
+    struct wf_head h;
+    memset(out, 0, sizeof *out);
+    for (;;) {
+        if (!start(f, WF_OP_HEAD, f->head, f->headRoom)) {
+            out->error = WF_E_HOST;
+            return -1;
+        }
+        if (!answered(f))
+            return 0;
+        if (f->a.status == OSERR_TOOSMALL && f->a.result > f->headRoom) {
+            /* The head stays on the service's side: ask again with room for it. */
+            UBYTE *bigger = AllocVec(f->a.result, MEMF_ANY);
+            if (!bigger) {
+                out->error = WF_E_HOST;
+                return -1;
+            }
+            FreeVec(f->head);
+            f->head = bigger;
+            f->headRoom = f->a.result;
+            continue;
+        }
+        if (f->a.status != OSERR_OK) {
+            out->error = error_of(f->a.status);
+            return -1;
+        }
+        if (!f->a.result && !f->a.aux)
+            continue;                           /* not yet: ask again */
+        if (wf_head_parse(f->head, f->headRoom, &h) != OSERR_OK) {
+            out->error = WF_E_PROTOCOL;
+            return -1;
+        }
+        out->error = h.error;
+        out->status = h.status;
+        out->version = h.version;
+        out->lengthKnown = (h.flags & WF_H_LENGTH) != 0;
+        out->length = h.length;
+        out->text = h.text;
+        out->textLength = h.text_length;
+        out->info = h.info;
+        out->infoLength = h.info_length;
+        return 1;
+    }
+}
+
+long obwf_fetch_read(OBWFFetch *f, const void **data, int *end, unsigned long *error)
+{
+    ULONG got;
+    *data = NULL;
+    *end = 0;
+    *error = 0;
+    for (;;) {
+        if (!start(f, WF_OP_READ, f->buf[f->cur], OBWF_READ_ROOM)) {
+            *end = 1;
+            *error = WF_E_HOST;
+            return 0;
+        }
+        if (!answered(f))
+            return 0;
+        if (f->a.status != OSERR_OK) {
+            *end = 1;
+            *error = error_of(f->a.status);
+            return 0;
+        }
+        if (!f->a.result && !f->a.aux)
+            continue;                           /* not yet: ask again */
+        got = f->a.result;
+        *data = f->buf[f->cur];
+        if (f->a.aux & 1) {
+            *end = 1;
+            *error = (f->a.aux >> 8) & 0xff;
+            return (long)got;
+        }
+        /* The next READ goes into the other buffer while these bytes are copied. */
+        f->cur ^= 1;
+        start(f, WF_OP_READ, f->buf[f->cur], OBWF_READ_ROOM);
+        return (long)got;
+    }
+}
+
+void obwf_fetch_free(OBWFFetch *f)
+{
+    if (!f)
+        return;
+    if (f->busy)
+        wf_async_abort(&f->a);
+    if (f->opened)
+        wf_close(&f->net->s, f->fetch);
+    if (f->head)
+        FreeVec(f->head);
+    if (f->buf[0])
+        FreeVec(f->buf[0]);
+    if (f->buf[1])
+        FreeVec(f->buf[1]);
+    FreeVec(f);
+}
+
+#else /* no openweb.fetch client in this build */
+
+int obwf_available(void)
+{
+    return 0;
+}
+
+OBWFNet *obwf_net_new(void)
+{
+    return 0;
+}
+
+void obwf_net_free(OBWFNet *n)
+{
+    (void)n;
+}
+
+int obwf_net_decodes(OBWFNet *n)
+{
+    (void)n;
+    return 0;
+}
+
+void obwf_net_wait(OBWFNet *n, unsigned long ms)
+{
+    (void)n;
+    (void)ms;
+}
+
+void obwf_net_wake(OBWFNet *n)
+{
+    (void)n;
+}
+
+OBWFFetch *obwf_fetch_new(OBWFNet *n, const char *request, unsigned long length, int decode, int hasBody,
+                          unsigned long bodyLength, const void *part, unsigned long partLength,
+                          unsigned long timeout, unsigned long *error)
+{
+    (void)n;
+    (void)request;
+    (void)length;
+    (void)decode;
+    (void)hasBody;
+    (void)bodyLength;
+    (void)part;
+    (void)partLength;
+    (void)timeout;
+    *error = 9;
+    return 0;
+}
+
+int obwf_fetch_send(OBWFFetch *f, const void *data, unsigned long length, int last)
+{
+    (void)f;
+    (void)data;
+    (void)length;
+    (void)last;
+    return -1;
+}
+
+int obwf_fetch_head(OBWFFetch *f, OBWFHead *head)
+{
+    (void)f;
+    head->error = 9;
+    return -1;
+}
+
+long obwf_fetch_read(OBWFFetch *f, const void **data, int *end, unsigned long *error)
+{
+    (void)f;
+    *data = 0;
+    *end = 1;
+    *error = 9;
+    return 0;
+}
+
+void obwf_fetch_free(OBWFFetch *f)
+{
+    (void)f;
+}
+
+#endif
diff --git a/Source/WebCore/platform/network/amiga/OpenWebFetchAmiga.h b/Source/WebCore/platform/network/amiga/OpenWebFetchAmiga.h
new file mode 100644
index 00000000000..06076e21e81
--- /dev/null
+++ b/Source/WebCore/platform/network/amiga/OpenWebFetchAmiga.h
@@ -0,0 +1,78 @@
+/*
+ * openweb.fetch for WebCore's network thread (OpenWebFetchAmiga.c): the
+ * service opened once, fetches started, their bodies sent, their heads and
+ * bodies collected without blocking (wf_async_start and wf_wait, from
+ * openamigaservice's include/openweb/webfetch.h). Plain C, so that AmigaOS
+ * headers and their macros stay out of WebCore's C++.
+ *
+ * Every call but obwf_net_wake runs on the one task that called
+ * obwf_net_new. A build without openamigaservice's headers has no
+ * transport: obwf_available() is 0 and obwf_net_new answers NULL.
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef OpenWebFetchAmiga_h
+#define OpenWebFetchAmiga_h
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct OBWFNet OBWFNet;
+typedef struct OBWFFetch OBWFFetch;
+
+/* A response head, in the fetch's own memory until its next call. */
+typedef struct {
+    unsigned long error;        /* 0, or openweb.fetch's error, 1 to 9 */
+    unsigned long status;       /* the HTTP status */
+    unsigned long version;      /* the HTTP version times ten */
+    int lengthKnown;
+    unsigned long length;       /* the body's length, when lengthKnown */
+    const char *text;           /* the status line and the headers, each line ending in LF */
+    unsigned long textLength;
+    const char *info;           /* key=value lines: the TLS summary, or error= */
+    unsigned long infoLength;
+} OBWFHead;
+
+/* 1 when the engine was built with openamigaservice's client. */
+int obwf_available(void);
+
+/* Opens openweb.fetch (the card, a Cradle, or this Amiga's own TCP/IP
+ * and OpenTLS) and a signal to wake the task with. NULL when there is no
+ * transport or no signal; without a service every fetch fails. */
+OBWFNet *obwf_net_new(void);
+void obwf_net_free(OBWFNet *);
+/* 1 when the transport undoes gzip, deflate and br itself (WF_DECODE). */
+int obwf_net_decodes(OBWFNet *);
+/* Sleeps until a fetch may have moved on, for at most ms (on the card,
+ * until an answer comes back), or until obwf_net_wake. */
+void obwf_net_wait(OBWFNet *, unsigned long ms);
+/* From any task. */
+void obwf_net_wake(OBWFNet *);
+
+/* Starts a fetch: request is "METHOD URL\n" and "Name: value\n" lines.
+ * With hasBody, bodyLength is the body's whole length and part (partLength
+ * bytes, maybe 0) its first part. timeout in seconds (0: 30). NULL with
+ * *error (openweb.fetch's) when it could not start. */
+OBWFFetch *obwf_fetch_new(OBWFNet *, const char *request, unsigned long length, int decode, int hasBody,
+                          unsigned long bodyLength, const void *part, unsigned long partLength,
+                          unsigned long timeout, unsigned long *error);
+/* The body's next part: 1 taken, 0 not taken (the queue is full: send the
+ * same part again later), -1 the fetch failed. */
+int obwf_fetch_send(OBWFFetch *, const void *data, unsigned long length, int last);
+/* 1 with *head filled when the head is there (head->error non-zero when
+ * the fetch failed), 0 not yet, -1 failed (head->error says why). */
+int obwf_fetch_head(OBWFFetch *, OBWFHead *head);
+/* Body bytes: how many, at *data (the fetch's memory, until its next
+ * call); 0 when none came yet. *end is 1 when the body has ended, with
+ * *error 0 when it ended well, else openweb.fetch's error. */
+long obwf_fetch_read(OBWFFetch *, const void **data, int *end, unsigned long *error);
+/* Stops the fetch if it still runs, and frees it. */
+void obwf_fetch_free(OBWFFetch *);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* OpenWebFetchAmiga_h */
