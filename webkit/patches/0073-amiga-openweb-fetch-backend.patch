@@ -0,0 +1,501 @@
+/*
+ * One load on openweb.fetch (WebFetchAmiga.h), and the network thread that
+ * runs every one of them.
+ *
+ * The thread opens openweb.fetch once (the card, a Cradle, or this Amiga's
+ * own TCP/IP and OpenTLS: the transport chooses, and reads the proxies
+ * from the environment itself) and moves each load on in turn: OPEN with
+ * the request text and the body's first part, the rest of the body through
+ * SEND, then the head, then, once the client has taken the response, the
+ * body. Between turns it sleeps in wf_wait() on the network and on a
+ * signal the main thread sends it. Everything the client hears goes to it
+ * through the main thread's run loop, in order, as curl's thread does.
+ *
+ * Compressed bodies: the card's host undoes them (WF_DECODE). The native
+ * transport leaves that to the datatypes' stream classes, which are not
+ * there yet, so on it the request asks for "Accept-Encoding: identity".
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "config.h"
+#include "WebFetchAmiga.h"
+
+#include "AmigaNetwork.h"
+#include "BlobRegistry.h"
+#include "FormData.h"
+#include "HTTPHeaderNames.h"
+#include "ResourceError.h"
+#include "ResourceHandle.h"
+#include "ResourceHandleClient.h"
+#include "ResourceResponse.h"
+#include "SharedBuffer.h"
+#include <stdlib.h>
+#include <string.h>
+#include <string_view>
+#include <wtf/FileSystem.h>
+#include <wtf/Language.h>
+#include <wtf/Lock.h>
+#include <wtf/MainThread.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/Threading.h>
+#include <wtf/text/StringBuilder.h>
+
+namespace WebCore {
+
+// The size of each upload part.
+static constexpr size_t partSize = 64 * 1024;
+// Without a timeout of the request's own: a TLS handshake on a 68k takes
+// seconds, as curl's 120 s connect timeout allowed for (patch 0004).
+static constexpr unsigned defaultTimeout = 120;
+// openweb.fetch's longest timeout.
+static constexpr unsigned maximumTimeout = 300;
+// openweb.fetch's own errors (docs/OPENWEB_FETCH.md).
+static constexpr unsigned long errorTLS = 3;
+static constexpr unsigned long errorProtocol = 5;
+static constexpr unsigned long errorClosed = 7;
+static constexpr unsigned long errorHost = 9;
+
+// ---- the network thread ----
+
+struct FetchThread {
+    Lock lock;
+    Vector<Ref<AmigaWebFetch>> incoming;
+    OBWFNet* net { nullptr };
+    bool stopping { false };
+    bool broken { false };
+    RefPtr<Thread> thread;
+};
+
+static FetchThread& fetchThread()
+{
+    static NeverDestroyed<FetchThread> thread;
+    return thread;
+}
+
+static void wakeFetchThread()
+{
+    auto& thread = fetchThread();
+    Locker locker { thread.lock };
+    if (thread.net)
+        obwf_net_wake(thread.net);
+}
+
+static void runFetchThread()
+{
+    auto& thread = fetchThread();
+    amigaNetworkThreadStarted();
+    OBWFNet* net = obwf_net_new();
+    Vector<Ref<AmigaWebFetch>> active;
+    {
+        Locker locker { thread.lock };
+        thread.net = net;
+        if (!net) {
+            // No signal or no transport: every load fails, now and later.
+            thread.broken = true;
+            active = std::exchange(thread.incoming, { });
+        }
+    }
+    if (!net) {
+        for (auto& fetch : active)
+            fetch->failWithoutNetwork();
+        amigaNetworkThreadFinished();
+        return;
+    }
+
+    while (true) {
+        {
+            Locker locker { thread.lock };
+            if (thread.stopping)
+                break;
+            for (auto& fetch : std::exchange(thread.incoming, { }))
+                active.append(WTF::move(fetch));
+        }
+        for (size_t i = 0; i < active.size();) {
+            if (active[i]->step(net)) {
+                ++i;
+                continue;
+            }
+            active[i]->close();
+            active.removeAt(i);
+        }
+        obwf_net_wait(net, 1000);
+    }
+
+    for (auto& fetch : active)
+        fetch->close();
+    active.clear();
+    {
+        Locker locker { thread.lock };
+        thread.net = nullptr;
+    }
+    obwf_net_free(net);
+    amigaNetworkThreadFinished();
+}
+
+static void addToFetchThread(Ref<AmigaWebFetch>&& fetch)
+{
+    auto& thread = fetchThread();
+    {
+        Locker locker { thread.lock };
+        if (thread.broken) {
+            fetch->failWithoutNetwork();
+            return;
+        }
+        if (thread.stopping)
+            return;
+        thread.incoming.append(WTF::move(fetch));
+        if (thread.net)
+            obwf_net_wake(thread.net);
+    }
+    if (!thread.thread)
+        thread.thread = Thread::create("openweb.fetch"_s, runFetchThread, ThreadType::Network);
+}
+
+void AmigaWebFetch::stopThread()
+{
+    auto& thread = fetchThread();
+    {
+        Locker locker { thread.lock };
+        thread.stopping = true;
+        if (thread.net)
+            obwf_net_wake(thread.net);
+    }
+    if (auto running = std::exchange(thread.thread, nullptr))
+        running->waitForCompletion();
+}
+
+// ---- one load: the main thread ----
+
+bool AmigaWebFetch::isWanted()
+{
+    static const bool wanted = [] {
+        const char* value = getenv("OB_NET");
+        return obwf_available() && value && equalLettersIgnoringASCIICase(String::fromLatin1(value), "openweb"_s);
+    }();
+    return wanted;
+}
+
+// "METHOD URL" and the headers, one a line. Accept-Encoding is the
+// network thread's, as it depends on the transport.
+static Vector<char> requestText(const ResourceRequest& request, const String& user, const String& password)
+{
+    URL url = request.url();
+    url.removeFragmentIdentifier();
+    if (!user.isEmpty() || !password.isEmpty()) {
+        url.setUser(user);
+        url.setPassword(password);
+    }
+
+    StringBuilder text;
+    text.append(request.httpMethod(), ' ', url.string(), '\n');
+    bool hasLanguage = false;
+    for (auto& header : request.httpHeaderFields()) {
+        if (header.keyAsHTTPHeaderName == HTTPHeaderName::AcceptEncoding)
+            continue;
+        if (header.keyAsHTTPHeaderName == HTTPHeaderName::AcceptLanguage)
+            hasLanguage = true;
+        text.append(header.key, ": "_s, header.value, '\n');
+    }
+    if (!hasLanguage) {
+        // As curl's requests had it (CurlRequest::appendAcceptLanguageHeaderIfNeeded).
+        auto languages = userPreferredLanguages();
+        if (!languages.isEmpty()) {
+            text.append("Accept-Language: "_s);
+            for (size_t i = 0; i < languages.size(); ++i) {
+                if (i)
+                    text.append(", "_s);
+                text.append(languages[i]);
+            }
+            text.append('\n');
+        }
+    }
+    auto utf8 = text.toString().utf8();
+    return Vector<char>(byteCast<char>(utf8.span()));
+}
+
+AmigaWebFetch::AmigaWebFetch(ResourceHandle& handle, const ResourceRequest& request)
+    : m_handle(&handle)
+    , m_request(request)
+{
+}
+
+AmigaWebFetch::~AmigaWebFetch() = default;
+
+Ref<AmigaWebFetch> AmigaWebFetch::start(ResourceHandle& handle, const ResourceRequest& request, const String& user, const String& password)
+{
+    Ref fetch = adoptRef(*new AmigaWebFetch(handle, request));
+    fetch->m_requestText = requestText(request, user, password);
+    if (RefPtr body = request.httpBody(); body && !body->isEmpty()) {
+        // The network thread's own copy, with blobs made into their data and files.
+        fetch->m_body = body->isolatedCopy()->resolveBlobReferences(blobRegistry()->blobRegistryImpl());
+        fetch->m_bodyLength = fetch->m_body->lengthInBytes();
+    }
+    auto& method = request.httpMethod();
+    fetch->m_hasBody = fetch->m_body || (method != "GET"_s && method != "HEAD"_s);
+    double timeout = request.timeoutInterval();
+    fetch->m_timeout = timeout > 0 ? static_cast<unsigned>(std::clamp(timeout, 1.0, static_cast<double>(maximumTimeout))) : defaultTimeout;
+    addToFetchThread(fetch.copyRef());
+    return fetch;
+}
+
+void AmigaWebFetch::continueAfterResponse()
+{
+    m_mayRead = true;
+    wakeFetchThread();
+}
+
+void AmigaWebFetch::cancel()
+{
+    m_handle = nullptr;
+    m_cancelled = true;
+    wakeFetchThread();
+}
+
+void AmigaWebFetch::didReceiveHead(AmigaResponseHead&& head)
+{
+    RefPtr handle = m_handle;
+    if (!handle || m_cancelled)
+        return;
+    head.url = m_request.url();
+    ResourceResponse response(head);
+    handle->amigaDidReceiveResponse(m_request, head.headers, WTF::move(response));
+}
+
+void AmigaWebFetch::didFail(unsigned long error, bool certificateNotTrusted)
+{
+    RefPtr handle = m_handle;
+    if (!handle || m_cancelled)
+        return;
+    m_handle = nullptr;
+    static constexpr auto lastCode = static_cast<unsigned long>(ResourceError::AmigaCode::UploadFailed);
+    auto code = static_cast<ResourceError::AmigaCode>(error >= 1 && error <= lastCode ? error : errorProtocol);
+    if (certificateNotTrusted)
+        code = ResourceError::AmigaCode::CertificateNotTrusted;
+    auto type = code == ResourceError::AmigaCode::Timeout && m_request.timeoutInterval() ? ResourceError::Type::Timeout : ResourceError::Type::General;
+    handle->amigaDidFail(ResourceError(code, m_request.url(), { }, type));
+}
+
+// ---- one load: the network thread ----
+
+void AmigaWebFetch::failWithoutNetwork()
+{
+    callOnMainThread([protectedThis = Ref { *this }] {
+        protectedThis->didFail(errorHost, false);
+    });
+}
+
+bool AmigaWebFetch::fail(unsigned long error, bool certificateNotTrusted)
+{
+    callOnMainThread([protectedThis = Ref { *this }, error, certificateNotTrusted] {
+        protectedThis->didFail(error, certificateNotTrusted);
+    });
+    return false;
+}
+
+void AmigaWebFetch::close()
+{
+    obwf_fetch_free(std::exchange(m_fetch, nullptr));
+    m_file = { };
+    m_body = nullptr;
+}
+
+// The next part of the body into m_part (CurlFormDataStream's job): false
+// when it could not be read.
+bool AmigaWebFetch::readPart()
+{
+    size_t room = static_cast<size_t>(std::min<uint64_t>(partSize, m_bodyLeft));
+    m_part.resize(room);
+    size_t filled = 0;
+    auto& elements = m_body->elements();
+    while (filled < room && m_element < elements.size()) {
+        auto into = m_part.mutableSpan().subspan(filled);
+        std::optional<size_t> got = WTF::switchOn(elements[m_element].data,
+            [&](const Vector<uint8_t>& bytes) -> std::optional<size_t> {
+                size_t count = std::min(into.size(), bytes.size() - m_offset);
+                memcpy(into.data(), bytes.span().data() + m_offset, count);
+                m_offset += count;
+                if (m_offset == bytes.size()) {
+                    m_offset = 0;
+                    ++m_element;
+                }
+                return count;
+            }, [&](const FormDataElement::EncodedFileData& file) -> std::optional<size_t> {
+                if (!m_file) {
+                    m_file = FileSystem::openFile(file.filename, FileSystem::FileOpenMode::Read);
+                    if (!m_file)
+                        return std::nullopt;
+                    if (file.fileStart > 0 && !m_file.seek(file.fileStart, FileSystem::FileSeekOrigin::Beginning))
+                        return std::nullopt;
+                    m_fileLeft = file.fileLength < 0 ? std::numeric_limits<uint64_t>::max() : static_cast<uint64_t>(file.fileLength);
+                }
+                auto read = m_file.read(into.first(static_cast<size_t>(std::min<uint64_t>(into.size(), m_fileLeft))));
+                if (!read)
+                    return std::nullopt;
+                m_fileLeft -= *read;
+                if (!*read || !m_fileLeft) {
+                    m_file = { };
+                    ++m_element;
+                }
+                return static_cast<size_t>(*read);
+            }, [](const FormDataElement::EncodedBlobData&) -> std::optional<size_t> {
+                return std::nullopt;
+            }, [](const FormDataElement::PendingStreamData&) -> std::optional<size_t> {
+                return std::nullopt;
+            });
+        if (!got)
+            return false;
+        filled += *got;
+    }
+    // Less than the length said (a file that shrank) cannot be sent.
+    return filled == room;
+}
+
+// The rest of the body, as far as the transport takes it now: false when
+// the load failed.
+bool AmigaWebFetch::sendBody()
+{
+    while (m_bodyLeft) {
+        if (m_part.isEmpty() && !readPart())
+            return fail(static_cast<unsigned long>(ResourceError::AmigaCode::UploadFailed));
+        bool last = m_part.size() >= m_bodyLeft;
+        int taken = obwf_fetch_send(m_fetch, m_part.span().data(), m_part.size(), last);
+        if (taken < 0)
+            return fail(errorClosed);
+        if (!taken)
+            return true;
+        m_bodyLeft -= m_part.size();
+        m_part.clear();
+        callOnMainThread([protectedThis = Ref { *this }, sent = m_bodyLength - m_bodyLeft, total = m_bodyLength] {
+            if (RefPtr handle = protectedThis->m_handle; handle && handle->client())
+                handle->client()->didSendData(handle.get(), sent, total);
+        });
+    }
+    m_body = nullptr;
+    return true;
+}
+
+bool AmigaWebFetch::open(OBWFNet* net)
+{
+    static constexpr char identity[] = "Accept-Encoding: identity\n";
+    bool decode = obwf_net_decodes(net);
+    if (!decode)
+        m_requestText.append(std::span<const char> { identity, sizeof identity - 1 });
+    m_requestText.append('\0');
+
+    m_bodyLeft = m_body ? m_bodyLength : 0;
+    if (m_bodyLeft && !readPart())
+        return fail(static_cast<unsigned long>(ResourceError::AmigaCode::UploadFailed));
+    unsigned long error = 0;
+    m_fetch = obwf_fetch_new(net, m_requestText.span().data(), m_requestText.size() - 1, decode, m_hasBody,
+        static_cast<unsigned long>(m_bodyLength), m_part.span().data(), m_part.size(), m_timeout, &error);
+    m_requestText.clear();
+    if (!m_fetch)
+        return fail(error);
+    if (m_bodyLeft) {
+        m_bodyLeft -= m_part.size();
+        m_part.clear();
+    }
+    m_state = State::Head;
+    return true;
+}
+
+static AmigaResponseHead responseHead(const OBWFHead& head)
+{
+    AmigaResponseHead response;
+    response.statusCode = static_cast<int>(head.status);
+    response.httpVersion = static_cast<unsigned>(head.version);
+    response.expectedContentLength = head.lengthKnown ? static_cast<long long>(head.length) : 0;
+    auto text = unsafeMakeSpan(head.text, head.textLength);
+    while (!text.empty()) {
+        size_t end = 0;
+        while (end < text.size() && text[end] != '\n')
+            ++end;
+        size_t length = end;
+        if (length && text[length - 1] == '\r')
+            --length;
+        if (length)
+            response.headers.append(String::fromLatin1(text.first(length)));
+        text = text.subspan(std::min(end + 1, text.size()));
+    }
+    return response;
+}
+
+bool AmigaWebFetch::readBody()
+{
+    // A few parts at a time, so that every load moves on.
+    for (unsigned i = 0; i < 8; ++i) {
+        const void* data = nullptr;
+        int end = 0;
+        unsigned long error = 0;
+        long got = obwf_fetch_read(m_fetch, &data, &end, &error);
+        if (got > 0) {
+            auto buffer = SharedBuffer::create(unsafeMakeSpan(static_cast<const uint8_t*>(data), static_cast<size_t>(got)));
+            callOnMainThread([protectedThis = Ref { *this }, buffer = WTF::move(buffer)]() mutable {
+                if (RefPtr handle = protectedThis->m_handle; handle && !protectedThis->m_cancelled)
+                    handle->amigaDidReceiveData(WTF::move(buffer));
+            });
+        }
+        if (end) {
+            if (error)
+                return fail(error);
+            callOnMainThread([protectedThis = Ref { *this }] {
+                RefPtr handle = protectedThis->m_handle;
+                if (!handle || protectedThis->m_cancelled)
+                    return;
+                protectedThis->m_handle = nullptr;
+                NetworkLoadMetrics metrics;
+                metrics.responseEnd = MonotonicTime::now();
+                metrics.markComplete();
+                handle->amigaDidFinish(metrics);
+            });
+            return false;
+        }
+        if (got <= 0)
+            break;
+    }
+    return true;
+}
+
+bool AmigaWebFetch::step(OBWFNet* net)
+{
+    if (m_cancelled)
+        return false;
+    switch (m_state) {
+    case State::Start:
+        if (!open(net))
+            return false;
+        [[fallthrough]];
+    case State::Head: {
+        if (m_bodyLeft && !sendBody())
+            return false;
+        OBWFHead head;
+        int got = obwf_fetch_head(m_fetch, &head);
+        if (!got)
+            return true;
+        if (got < 0 || head.error) {
+            // A certificate the transport does not trust comes back with its summary.
+            bool untrusted = got > 0 && head.error == errorTLS && head.info
+                && std::string_view { head.info, static_cast<size_t>(head.infoLength) }.find("subject=") != std::string_view::npos;
+            return fail(head.error ? head.error : errorHost, untrusted);
+        }
+        // The body stops going out once the server has answered.
+        m_bodyLeft = 0;
+        m_body = nullptr;
+        callOnMainThread([protectedThis = Ref { *this }, response = responseHead(head)]() mutable {
+            protectedThis->didReceiveHead(WTF::move(response));
+        });
+        m_state = State::WaitForClient;
+        [[fallthrough]];
+    }
+    case State::WaitForClient:
+        if (!m_mayRead)
+            return true;
+        m_state = State::Body;
+        [[fallthrough]];
+    case State::Body:
+        return readBody();
+    }
+    return false;
+}
+
+} // namespace WebCore
