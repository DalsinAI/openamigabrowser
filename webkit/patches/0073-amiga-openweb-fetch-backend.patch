 class SynchronousClient final : public ResourceHandleClient {
 public:
diff --git a/Source/WebCore/platform/network/amiga/WebFetchAmiga.cpp b/Source/WebCore/platform/network/amiga/WebFetchAmiga.cpp
new file mode 100644
index 00000000000..8a4f2b65df1
--- /dev/null
