+/*
+ * One load on openweb.fetch (WebFetchAmiga.cpp): the second backend of
+ * ResourceHandleAmiga.cpp beside curl, picked with the Shell variable
+ * OB_NET (curl, the default, or openweb). ResourceHandleAmiga.cpp keeps
+ * the cookies, redirects and the HTTP cache for both; this is only the
+ * request on the wire, run from one network thread.
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include "OpenWebFetchAmiga.h"
+#include "ResourceRequest.h"
+#include <atomic>
+#include <wtf/FileHandle.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/Vector.h>
+
+namespace WebCore {
+
+class FormData;
+class ResourceHandle;
+struct AmigaResponseHead;
+
+class AmigaWebFetch final : public ThreadSafeRefCounted<AmigaWebFetch, WTF::DestructionThread::Main> {
+public:
+    // OB_NET=openweb (read once), in an engine built with openweb.fetch.
+    static bool isWanted();
+    // On the main thread: request goes out for handle, which hears of it
+    // through its amigaDid... calls. user and password, when given, go in
+    // the URL, for the transport to answer a 401 with (Basic or Digest).
+    static Ref<AmigaWebFetch> start(ResourceHandle&, const ResourceRequest&, const String& user, const String& password);
+    // Stops the network thread, whatever it is loading (at exit).
+    static void stopThread();
+
+    ~AmigaWebFetch();
+
+    // On the main thread: the client has taken the response, so the body
+    // may come; or the load is no longer wanted.
+    void continueAfterResponse();
+    void cancel();
+
+    // On the network thread: moves the load on, false once it has ended;
+    // then close() frees its fetch.
+    bool step(OBWFNet*);
+    void close();
+    void failWithoutNetwork();
+
+private:
+    AmigaWebFetch(ResourceHandle&, const ResourceRequest&);
+
+    bool open(OBWFNet*);
+    bool sendBody();
+    bool readPart();
+    bool readBody();
+    bool fail(unsigned long error, bool certificateNotTrusted = false);
+
+    // On the main thread.
+    void didReceiveHead(AmigaResponseHead&&);
+    void didFail(unsigned long error, bool certificateNotTrusted);
+
+    // The main thread's.
+    ResourceHandle* m_handle;
+    const ResourceRequest m_request;
+
+    // Made on the main thread before the start, then the network thread's.
+    Vector<char> m_requestText;
+    RefPtr<FormData> m_body;
+    uint64_t m_bodyLength { 0 };
+    bool m_hasBody { false };
+    unsigned m_timeout { 0 };
+
+    std::atomic<bool> m_cancelled { false };
+    std::atomic<bool> m_mayRead { false };
+
+    // The network thread's.
+    enum class State : uint8_t { Start, Head, WaitForClient, Body };
+    State m_state { State::Start };
+    OBWFFetch* m_fetch { nullptr };
+    uint64_t m_bodyLeft { 0 };
+    Vector<uint8_t> m_part;
+    size_t m_element { 0 };
+    size_t m_offset { 0 };
+    FileSystem::FileHandle m_file;
+    uint64_t m_fileLeft { 0 };
+};
+
+} // namespace WebCore
