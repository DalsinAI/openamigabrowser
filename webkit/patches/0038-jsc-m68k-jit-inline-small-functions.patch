         }
@@ -900,6 +903,15 @@ private:
             m_hot.bindBranch(next);
         }
         slowUnless(Builder::Always);
+        // Inlined into a caller (inlineCall): no table, and no getter calls,
+        // which would need this function's frame to be a real one.
+        if (m_inline) {
