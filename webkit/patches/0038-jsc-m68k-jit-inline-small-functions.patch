 namespace JSC {
 namespace M68KTemplateJIT {
@@ -619,6 +620,8 @@ public:
         if (!ok) {
             m_hot.bytes.shrink(start);
             m_hot.fixups.shrink(fixups);
+            while (!m_inlineGuards.isEmpty() && m_inlineGuards.last().first >= fixups)
+                m_inlineGuards.removeLast();
             slowBranches.clear();
