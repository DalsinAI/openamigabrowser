 extern "C" void jsc_m68k_llint_function_for_construct_prologue() __asm__("_llint_function_for_construct_prologue");
 extern "C" void jsc_m68k_llint_function_for_call_arity_check() __asm__("_llint_function_for_call_arity_check");
 extern "C" void jsc_m68k_llint_function_for_construct_arity_check() __asm__("_llint_function_for_construct_arity_check");
