diff --git a/Source/WTF/wtf/aros/OSAllocatorAROS.cpp b/Source/WTF/wtf/aros/OSAllocatorAROS.cpp
new file mode 100644
index 000000000..452f64558
--- /dev/null
+++ b/Source/WTF/wtf/aros/OSAllocatorAROS.cpp
@@ -0,0 +1,120 @@
+/*
+ * AROS implementation of WTF::OSAllocator for the non-MMU JSC C-loop port.
+ *
+ * AROS 68k does not provide mmap-style virtual address reservations. The
+ * standard C library does provide aligned_alloc(), so reservations are backed
+ * by real, zero-filled memory. Protection/guard-page requests remain explicit
+ * unsupported operations rather than being silently emulated.
+ */
+
+#include "config.h"
+#include <wtf/OSAllocator.h>
+
+#include <limits>
+#include <stdlib.h>
+#include <string.h>
+#include <wtf/Assertions.h>
+#include <wtf/PageBlock.h>
+
+namespace WTF {
+
+static void* tryAllocateAligned(size_t bytes, size_t alignment)
+{
+    if (!bytes)
+        bytes = alignment;
+
+    if (bytes > std::numeric_limits<size_t>::max() - (alignment - 1))
+        return nullptr;
+
+    size_t roundedSize = (bytes + alignment - 1) & ~(alignment - 1);
+    void* result = aligned_alloc(alignment, roundedSize);
+    if (result)
+        memset(result, 0, roundedSize);
+    return result;
+}
+
+void* OSAllocator::tryReserveAndCommitImpl(size_t bytes, Usage, void* address, bool, bool, bool, unsigned numGuardPagesToAddOnEachEnd, bool)
+{
+    // AROS has no mmap-like fixed-address reservation or guard-page facility.
+    if (address || numGuardPagesToAddOnEachEnd)
+        return nullptr;
+    return tryAllocateAligned(bytes, pageSize());
+}
+
+void* OSAllocator::tryReserveAndCommit(size_t bytes, Usage usage, void* address, bool writable, bool executable, bool jitCageEnabled, unsigned numGuardPagesToAddOnEachEnd)
+{
+    return tryReserveAndCommitImpl(bytes, usage, address, writable, executable, jitCageEnabled, numGuardPagesToAddOnEachEnd, false);
+}
+
+void* OSAllocator::reserveAndCommit(size_t bytes, Usage usage, void* address, bool writable, bool executable, bool jitCageEnabled, unsigned numGuardPagesToAddOnEachEnd)
+{
+    void* result = tryReserveAndCommit(bytes, usage, address, writable, executable, jitCageEnabled, numGuardPagesToAddOnEachEnd);
+    RELEASE_ASSERT(result);
+    return result;
+}
+
+void* OSAllocator::tryReserveUncommitted(size_t bytes, Usage usage, void* address, bool writable, bool executable, bool jitCageEnabled, unsigned numGuardPagesToAddOnEachEnd)
+{
+    // There is no reserve-without-commit distinction on classic AROS memory.
+    return tryReserveAndCommitImpl(bytes, usage, address, writable, executable, jitCageEnabled, numGuardPagesToAddOnEachEnd, true);
+}
+
+void* OSAllocator::reserveUncommitted(size_t bytes, Usage usage, void* address, bool writable, bool executable, bool jitCageEnabled, unsigned numGuardPagesToAddOnEachEnd)
+{
+    void* result = tryReserveUncommitted(bytes, usage, address, writable, executable, jitCageEnabled, numGuardPagesToAddOnEachEnd);
+    RELEASE_ASSERT(result);
+    return result;
+}
+
+void* OSAllocator::tryReserveUncommittedAligned(size_t bytes, size_t alignment, Usage, void* address, bool, bool, bool, unsigned numGuardPagesToAddOnEachEnd)
+{
+    if (address || numGuardPagesToAddOnEachEnd)
+        return nullptr;
+    if (!alignment || (alignment & (alignment - 1)))
+        return nullptr;
+    if (alignment < pageSize())
+        alignment = pageSize();
+    return tryAllocateAligned(bytes, alignment);
+}
+
+void OSAllocator::releaseDecommitted(void* address, size_t, unsigned numberOfGuardPagesOnEachEnd)
+{
+    RELEASE_ASSERT(!numberOfGuardPagesOnEachEnd);
+    free(address);
+}
+
+void OSAllocator::commit(void*, size_t, bool, bool)
+{
+    // Reservations are physically committed when allocated.
+}
+
+void OSAllocator::decommit(void* address, size_t bytes)
+{
+    // Keep the reservation but restore the zero-fill guarantee for a later
+    // logical commit.
+    if (address && bytes)
+        memset(address, 0, bytes);
+}
+
+void OSAllocator::hintMemoryNotNeededSoon(void*, size_t)
+{
+}
+
+bool OSAllocator::tryProtect(void*, size_t, bool readable, bool writable)
+{
+    // Classic AROS does not expose page protection on this target. Accept the
+    // normal read/write state only; surface any real protection requirement.
+    return readable && writable;
+}
+
+void OSAllocator::protect(void* address, size_t bytes, bool readable, bool writable)
+{
+    RELEASE_ASSERT(tryProtect(address, bytes, readable, writable));
+}
+
+void OSAllocator::zeroFill(void* address, size_t bytes)
+{
+    memset(address, 0, bytes);
+}
