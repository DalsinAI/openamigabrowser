index ae947fe28..76456eb8c 100644
--- a/Source/WTF/wtf/posix/FileHandlePOSIX.cpp
+++ b/Source/WTF/wtf/posix/FileHandlePOSIX.cpp
@@ -185,6 +185,56 @@ std::optional<MappedFileData> FileHandle::map(MappedFileMode mapMode, FileOpenMo
 
     return MappedFileData { WTF::move(fileData) };
 }
+#elif OS(AMIGA)
+std::optional<MappedFileData> FileHandle::map(MappedFileMode mapMode, FileOpenMode openMode)
+{
+    UNUSED_PARAM(mapMode);
+    if (openMode != FileOpenMode::Read)
+        return std::nullopt;
+
+    auto fileSize = size();
+    if (!fileSize)
+        return std::nullopt;
+    if (!*fileSize)
+        return MappedFileData::emptyFile();
+
+    size_t bytesToRead;
+    if (!WTF::convertSafely(*fileSize, bytesToRead))
+        return std::nullopt;
+
+    auto originalPosition = seek(0, FileSeekOrigin::Current);
+    if (!seek(0, FileSeekOrigin::Beginning))
+        return std::nullopt;
+
+    auto fileData = MallocSpan<uint8_t>::tryMalloc(bytesToRead);
+    if (!fileData) {
+        if (originalPosition)
+            seek(*originalPosition, FileSeekOrigin::Beginning);
+        return std::nullopt;
+    }
+
+    size_t totalBytesRead = 0;
+    while (totalBytesRead < bytesToRead) {
+        auto bytesRead = read(fileData.mutableSpan().subspan(totalBytesRead));
+        if (!bytesRead || !*bytesRead)
+            break;
+        totalBytesRead += *bytesRead;
+    }
+
+    if (originalPosition)
+        seek(*originalPosition, FileSeekOrigin::Beginning);
+    if (totalBytesRead != bytesToRead)
+        return std::nullopt;
+
+    return MappedFileData { WTF::move(fileData) };
+}
+#else
+std::optional<MappedFileData> FileHandle::map(MappedFileMode mapMode, FileOpenMode openMode)
+{
+    UNUSED_PARAM(mapMode);
+    UNUSED_PARAM(openMode);
+    return std::nullopt;
+}
 #endif // HAVE(MMAP)
 
