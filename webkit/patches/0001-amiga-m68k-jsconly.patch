+/*
+ * AROS signal lifecycle adapter for JSCOnly C-loop builds.
+ *
+ * Classic AROS does not expose the full POSIX signal surface expected by
+ * WTF's Unix signal backend. JSC's no-JIT path still initializes and freezes
+ * the SignalHandlers state as part of WTFConfig, so preserve that lifecycle
+ * without pretending unsupported Unix signal handling exists.
+ */
+
+#include "config.h"
+#include <wtf/Assertions.h>
+#include <wtf/WTFConfig.h>
+#include <wtf/threads/Signals.h>
+
+namespace WTF {
+
+void SignalHandlers::initialize()
+{
+    SignalHandlers& handlers = g_wtfConfig.signalHandlers;
+    RELEASE_ASSERT(handlers.initState == InitState::Uninitialized);
+    handlers.initState = InitState::Initializing;
+}
+
+void SignalHandlers::finalize()
+{
+    Config::AssertNotFrozenScope assertScope;
+    SignalHandlers& handlers = g_wtfConfig.signalHandlers;
+    RELEASE_ASSERT(handlers.initState == InitState::Initializing);
+    handlers.initState = InitState::Finalized;
+}
+
+} // namespace WTF
