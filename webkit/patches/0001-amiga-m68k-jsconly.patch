+    # AROS collect-aros records constructors in linker-set sections. GNU ld
+    # --gc-sections discards those records even when the referenced function
+    # is forced in with -u, leaving libraries such as pthread uninitialised.
+    if (NOT CMAKE_SYSTEM_NAME STREQUAL "AROS")
+        add_link_options("LINKER:--gc-sections")
+    endif ()
 endif ()
 
