diff --git a/Source/WTF/wtf/amigaos3/RandomAmigaOS3.h b/Source/WTF/wtf/amigaos3/RandomAmigaOS3.h
new file mode 100644
index 000000000..0c66a3ece
--- /dev/null
+++ b/Source/WTF/wtf/amigaos3/RandomAmigaOS3.h
@@ -0,0 +1,48 @@
+/*
+ * AmigaOS 3.x random bytes for WTF::RandomDevice.
+ *
+ * AmigaOS 3.x has no kernel entropy source. This mixes the clock, the
+ * current Task address and a running counter through splitmix64. It is
+ * good enough for hash seeds in the JSC shell; it is NOT cryptographic and
+ * must be replaced before anything security-sensitive runs on it.
+ */
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <time.h>
+#include <proto/exec.h>
+
+namespace WTF {
+
+inline uint64_t amigaOS3SplitMix64(uint64_t& state)
+{
+    uint64_t z = (state += 0x9e3779b97f4a7c15ULL);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    return z ^ (z >> 31);
+}
+
+inline void amigaOS3RandomBytes(uint8_t* buffer, size_t size)
+{
+    static uint64_t state;
+    static bool seeded;
+
+    Forbid();
+    if (!seeded) {
+        state = static_cast<uint64_t>(time(nullptr)) << 32;
+        state ^= static_cast<uint64_t>(clock());
+        state ^= static_cast<uint64_t>(reinterpret_cast<uintptr_t>(FindTask(nullptr))) << 16;
+        state ^= static_cast<uint64_t>(reinterpret_cast<uintptr_t>(&state));
+        seeded = true;
+    }
+    for (size_t i = 0; i < size; i += 8) {
+        uint64_t value = amigaOS3SplitMix64(state);
+        for (size_t j = 0; j < 8 && i + j < size; ++j)
+            buffer[i + j] = static_cast<uint8_t>(value >> (8 * j));
+    }
+    Permit();
+}
+
+} // namespace WTF
