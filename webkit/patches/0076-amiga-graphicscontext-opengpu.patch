+/*
+ * The window's GraphicsContext on OpenGPU (GraphicsContextOpenGPU.h).
+ *
+ * Every state change goes to the cairo context too, as it happens, so
+ * cairo can take any call at any time: the batch is sent and waited for
+ * first (one flush however many cairo calls follow), and its pictures are
+ * held until then. What OpenGPU draws is checked against cairo's rules in
+ * OpenGPUPaintAmiga.c: the fill colour as cairo turns it into 8 bits, the
+ * global alpha only where cairo applies it, no shadow, normal blending,
+ * edges on whole pixels.
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "config.h"
+#include "GraphicsContextOpenGPU.h"
+
+#if USE(CAIRO)
+
+#include "AffineTransform.h"
+#include "Color.h"
+#include "FloatRoundedRect.h"
+#include "Gradient.h"
+#include "ImageBuffer.h"
+#include "NativeImage.h"
+#include "Path.h"
+#include <algorithm>
+#include <cairo.h>
+#include <cmath>
+#include <stdio.h>
+#include <stdlib.h>
+#include <wtf/FastMalloc.h>
+#include <wtf/text/StringCommon.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebCore {
+
+// The batch: 8 KB of commands (some 250 draws) and 6 KB of patterns and
+// paths (64 pictures under a scale or a turn).
+static constexpr long streamWords = 2048;
+static constexpr long scratchWords = 1536;
+// PATH_FILL's work memory: 32 bytes a pixel of the width for each row of a
+// band, at most 128 KB.
+static constexpr unsigned long maxWorkBytes = 128 * 1024;
+
+bool GraphicsContextOpenGPU::isWanted()
+{
+    static const bool wanted = [] {
+        const char* value = getenv("OB_PAINT");
+        if (value && equalLettersIgnoringASCIICase(String::fromLatin1(value), "cairo"_s))
+            return false;
+        if (!(ob_opengpu_caps() & OBGPU_CAN_PD)) {
+            fprintf(stderr, "OpenBrowser: no opengpu.library with COMPOSITE_PD; the window is painted with cairo\n");
+            return false;
+        }
+        return true;
+    }();
+    return wanted;
+}
+
+static size_t gpuBytes()
+{
+    return (sizeof(obgpu) + 7) & ~static_cast<size_t>(7);
+}
+
+GraphicsContextOpenGPU::GraphicsContextOpenGPU(cairo_surface_t* surface, obgpu_counts* counts)
+    : m_cairo(surface)
+    , m_surface(surface)
+    , m_counts(counts ? counts : &m_ownCounts)
+{
+    void* block = nullptr;
+    int caps = ob_opengpu_caps();
+    if (!caps || !tryFastMalloc(gpuBytes() + (streamWords + scratchWords) * 4).getValue(block))
+        return;
+    m_gpu = static_cast<obgpu*>(block);
+    auto* stream = static_cast<unsigned char*>(block) + gpuBytes();
+    auto* scratch = stream + streamWords * 4;
+    obgpu_init(m_gpu, stream, streamWords, scratch, reinterpret_cast<uintptr_t>(scratch), scratchWords, submitBatch, this,
+        caps, m_counts);
+    if (cairo_surface_get_type(surface) != CAIRO_SURFACE_TYPE_IMAGE || cairo_image_surface_get_format(surface) != CAIRO_FORMAT_ARGB32
+        || !cairo_image_surface_get_data(surface)) {
+        m_gpu->broken = 1;
+        return;
+    }
+    obgpu_target(m_gpu, reinterpret_cast<uintptr_t>(cairo_image_surface_get_data(surface)), cairo_image_surface_get_stride(surface),
+        cairo_image_surface_get_width(surface), cairo_image_surface_get_height(surface));
+}
+
+GraphicsContextOpenGPU::~GraphicsContextOpenGPU()
+{
+    flush();
+    if (m_work)
+        fastFree(m_work);
+    if (m_gpu)
+        fastFree(m_gpu);
+}
+
+long GraphicsContextOpenGPU::submitBatch(void* user, const unsigned char* stream, long words)
+{
+    auto& context = *static_cast<GraphicsContextOpenGPU*>(user);
+    // cairo's own drawing finished first; afterwards it must not trust
+    // anything it remembers of these pixels
+    cairo_surface_flush(context.m_surface);
+    long result = ob_opengpu_run(stream, words);
+    cairo_surface_mark_dirty(context.m_surface);
+    context.m_pictures.shrink(0);
+    return result;
+}
+
+void GraphicsContextOpenGPU::flush() const
+{
+    if (m_gpu && obgpu_pending(m_gpu))
+        obgpu_flush(m_gpu);
+}
+
+void GraphicsContextOpenGPU::handOn(int kind) const
+{
+    flush();
+    m_counts->handed[kind]++;
+}
+
+GraphicsContextCairo* GraphicsContextOpenGPU::platformContext() const
+{
+    handOn(OBGPU_PLATFORM);
+    return &m_cairo;
+}
+
+void GraphicsContextOpenGPU::didUpdateState(GraphicsContextState& state)
+{
+    m_cairo.mergeLastChanges(state);
+    state.didApplyChanges();
+}
+
+// ---- the state ------------------------------------------------------------------------
+
+// A transform as OpenGPUPaintAmiga.h's fixed point: none when it does not fit.
+void GraphicsContextOpenGPU::syncMatrix()
+{
+    if (!m_gpu)
+        return;
+    auto ctm = m_cairo.getCTM(PossiblyIncludeDeviceScale);
+    double linear[4] = { ctm.a(), ctm.b(), ctm.c(), ctm.d() };
+    double move[2] = { ctm.e(), ctm.f() };
+    long m[6];
+    for (int i = 0; i < 4; i++) {
+        if (!(std::abs(linear[i]) < 32767)) {
+            obgpu_set_matrix(m_gpu, nullptr);
+            return;
+        }
+        m[i] = std::lround(linear[i] * 65536);
+    }
+    for (int i = 0; i < 2; i++) {
+        if (!(std::abs(move[i]) < 8388000)) {
+            obgpu_set_matrix(m_gpu, nullptr);
+            return;
+        }
+        m[4 + i] = std::lround(move[i] * 256);
+    }
+    obgpu_set_matrix(m_gpu, m);
+}
+
+// A rectangle in 24.8: false when it is too large for it (cairo's own limit).
+static bool fixedRect(const FloatRect& rect, long* out)
+{
+    float v[4] = { rect.x(), rect.y(), rect.width(), rect.height() };
+    for (int i = 0; i < 4; i++) {
+        if (!(std::abs(v[i]) < (1 << 22)))
+            return false;
+        out[i] = std::lround(v[i] * 256.0);
+    }
+    return true;
+}
+
+void GraphicsContextOpenGPU::save(GraphicsContextState::Purpose purpose)
+{
+    GraphicsContext::save(purpose);
+    m_cairo.save(purpose);
+    if (m_gpu)
+        obgpu_save(m_gpu);
+}
+
+void GraphicsContextOpenGPU::restore(GraphicsContextState::Purpose purpose)
+{
+    if (!stackSize())
+        return;
+    GraphicsContext::restore(purpose);
+    m_cairo.restore(purpose);
+    if (m_gpu)
+        obgpu_restore(m_gpu);
+}
+
+void GraphicsContextOpenGPU::scale(const FloatSize& size)
+{
+    m_cairo.scale(size);
+    syncMatrix();
+}
+
+void GraphicsContextOpenGPU::rotate(float angleInRadians)
+{
+    m_cairo.rotate(angleInRadians);
+    syncMatrix();
+}
+
+void GraphicsContextOpenGPU::translate(float x, float y)
+{
+    m_cairo.translate(x, y);
+    syncMatrix();
+}
+
+void GraphicsContextOpenGPU::concatCTM(const AffineTransform& transform)
+{
+    m_cairo.concatCTM(transform);
+    syncMatrix();
+}
+
+void GraphicsContextOpenGPU::setCTM(const AffineTransform& transform)
+{
+    m_cairo.setCTM(transform);
+    syncMatrix();
+}
+
+AffineTransform GraphicsContextOpenGPU::getCTM(IncludeDeviceScale includeScale) const
+{
+    return m_cairo.getCTM(includeScale);
+}
+
+void GraphicsContextOpenGPU::resetClip()
+{
+    m_cairo.resetClip();
+    if (m_gpu)
+        obgpu_reset_clip(m_gpu);
+}
+
+void GraphicsContextOpenGPU::clip(const FloatRect& rect)
+{
+    m_cairo.clip(rect);
+    if (!m_gpu)
+        return;
+    // as Cairo::clip clamps it
+    float limit = 1 << 22;
+    FloatRect clamped(std::max(rect.x(), -limit / 2), std::max(rect.y(), -limit / 2), std::min(rect.width(), limit), std::min(rect.height(), limit));
+    long r[4];
+    if (fixedRect(clamped, r))
+        obgpu_clip(m_gpu, r[0], r[1], r[2], r[3]);
+    else
+        obgpu_clip_other(m_gpu);
+}
+
+void GraphicsContextOpenGPU::clipRoundedRect(const FloatRoundedRect& rect)
+{
+    m_cairo.clipRoundedRect(rect);
+    if (!m_gpu)
+        return;
+    long r[4];
+    if (!rect.hasNonZeroRadii() && fixedRect(rect.rect(), r))
+        obgpu_clip(m_gpu, r[0], r[1], r[2], r[3]);
+    else
+        obgpu_clip_other(m_gpu);
+}
+
+void GraphicsContextOpenGPU::clipPath(const Path& path, WindRule windRule)
+{
+    m_cairo.clipPath(path, windRule);
+    if (m_gpu)
+        obgpu_clip_other(m_gpu);
+}
+
+void GraphicsContextOpenGPU::clipOut(const FloatRect& rect)
+{
+    m_cairo.clipOut(rect);
+    if (m_gpu)
+        obgpu_clip_other(m_gpu);
+}
+
+void GraphicsContextOpenGPU::clipOut(const Path& path)
+{
+    m_cairo.clipOut(path);
+    if (m_gpu)
+        obgpu_clip_other(m_gpu);
+}
+
+void GraphicsContextOpenGPU::clipToImageBuffer(ImageBuffer& buffer, const FloatRect& rect)
+{
+    // cairo draws into a group from here, put on the window at the restore
+    handOn(OBGPU_LAYER);
+    m_cairo.clipToImageBuffer(buffer, rect);
+    if (m_gpu)
+        obgpu_group(m_gpu);
+}
+
+IntRect GraphicsContextOpenGPU::clipBounds() const
+{
+    return m_cairo.clipBounds();
+}
+
+void GraphicsContextOpenGPU::beginTransparencyLayer(float opacity)
+{
+    handOn(OBGPU_LAYER);
+    GraphicsContext::beginTransparencyLayer(opacity);
+    m_cairo.beginTransparencyLayer(opacity);
+    GraphicsContext::save(GraphicsContextState::Purpose::TransparencyLayer);
+    if (m_gpu) {
+        obgpu_save(m_gpu);
+        obgpu_group(m_gpu);
+    }
+}
+
+void GraphicsContextOpenGPU::beginTransparencyLayer(CompositeOperator compositeOperator, BlendMode blendMode)
+{
+    handOn(OBGPU_LAYER);
+    GraphicsContext::beginTransparencyLayer(compositeOperator, blendMode);
+    static_cast<GraphicsContext&>(m_cairo).beginTransparencyLayer(compositeOperator, blendMode);
+    GraphicsContext::save(GraphicsContextState::Purpose::TransparencyLayer);
+    if (m_gpu) {
+        obgpu_save(m_gpu);
+        obgpu_group(m_gpu);
+    }
+}
+
+void GraphicsContextOpenGPU::endTransparencyLayer()
+{
+    flush();
+    GraphicsContext::endTransparencyLayer();
+    m_cairo.endTransparencyLayer();
+    GraphicsContext::restore(GraphicsContextState::Purpose::TransparencyLayer);
+    if (m_gpu)
+        obgpu_restore(m_gpu);
+}
+
+void GraphicsContextOpenGPU::setLineCap(LineCap lineCap)
+{
+    m_cairo.setLineCap(lineCap);
+}
+
+void GraphicsContextOpenGPU::setLineDash(const DashArray& dashes, float dashOffset)
+{
+    m_cairo.setLineDash(dashes, dashOffset);
+}
+
+void GraphicsContextOpenGPU::setLineJoin(LineJoin lineJoin)
+{
+    m_cairo.setLineJoin(lineJoin);
+}
+
+void GraphicsContextOpenGPU::setMiterLimit(float limit)
+{
+    m_cairo.setMiterLimit(limit);
+}
+
+RenderingMode GraphicsContextOpenGPU::renderingMode() const
+{
+    return m_cairo.renderingMode();
+}
+
+// ---- what OpenGPU draws -----------------------------------------------------------------
+
+// A colour as cairo puts it in an ARGB32 pixel: its 16-bit channels,
+// premultiplied, then the top 8 bits of each.
+static unsigned long premultiplied(const Color& color)
+{
+    auto [r, g, b, a] = color.toColorTypeLossy<SRGBA<float>>().resolved();
+    auto channel = [](double v) {
+        v = v < 0 ? 0 : v > 1 ? 1 : v;
+        return static_cast<unsigned long>(v * 65535.0 + 0.5) >> 8;
+    };
+    double alpha = a < 0 ? 0 : a > 1 ? 1 : a;
+    return channel(alpha) << 24 | channel(r * alpha) << 16 | channel(g * alpha) << 8 | channel(b * alpha);
+}
+
+bool GraphicsContextOpenGPU::solidFill(const FloatRect& rect, const Color& color, CompositeOperator op, BlendMode blendMode)
+{
+    long r[4];
+    if (!m_gpu || blendMode != BlendMode::Normal || hasDropShadow() || !fixedRect(rect, r))
+        return false;
+    return obgpu_fill(m_gpu, r[0], r[1], r[2], r[3], premultiplied(color), static_cast<int>(op));
+}
+
+void GraphicsContextOpenGPU::fillRect(const FloatRect& rect, RequiresClipToRect requiresClipToRect)
+{
+    auto& brush = fillBrush();
+    if (!brush.gradient() && !brush.pattern()) {
+        // as Cairo::fillRect with a FillSource: the colour times the global alpha
+        Color color = alpha() < 1 ? fillColor().colorWithAlphaMultipliedBy(alpha()) : fillColor();
+        if (solidFill(rect, color, compositeOperation(), blendMode()))
+            return;
+        handOn(OBGPU_FILL);
+    } else
+        handOn(brush.gradient() ? OBGPU_GRADIENT : OBGPU_PATTERN);
+    m_cairo.fillRect(rect, requiresClipToRect);
+}
+
+void GraphicsContextOpenGPU::fillRect(const FloatRect& rect, const Color& color)
+{
+    // as Cairo::fillRect with a colour: no global alpha, nothing for an
+    // invisible colour over
+    if (!color.isVisible() && compositeOperation() == CompositeOperator::SourceOver && blendMode() == BlendMode::Normal && !hasDropShadow())
+        return;
+    if (solidFill(rect, color, compositeOperation(), blendMode()))
+        return;
+    handOn(OBGPU_FILL);
+    m_cairo.fillRect(rect, color);
+}
+
+void GraphicsContextOpenGPU::clearRect(const FloatRect& rect)
+{
+    long r[4];
+    if (m_gpu && fixedRect(rect, r) && obgpu_fill(m_gpu, r[0], r[1], r[2], r[3], 0, OBGPU_OP_CLEAR))
+        return;
+    handOn(OBGPU_CLEAR);
+    m_cairo.clearRect(rect);
+}
+
+void GraphicsContextOpenGPU::drawNativeImage(const NativeImage& image, const FloatRect& destRect, const FloatRect& srcRect, ImagePaintingOptions options)
+{
+    cairo_surface_t* surface = image.platformImage().get();
+    if (m_gpu && surface && options.orientation() == ImageOrientation::Orientation::None && options.blendMode() == BlendMode::Normal
+        && !hasDropShadow() && cairo_surface_get_type(surface) == CAIRO_SURFACE_TYPE_IMAGE) {
+        cairo_format_t format = cairo_image_surface_get_format(surface);
+        if (format == CAIRO_FORMAT_ARGB32 || format == CAIRO_FORMAT_RGB24) {
+            cairo_surface_flush(surface);
+            obgpu_source source;
+            source.address = reinterpret_cast<uintptr_t>(cairo_image_surface_get_data(surface));
+            source.bpr = cairo_image_surface_get_stride(surface);
+            source.w = cairo_image_surface_get_width(surface);
+            source.h = cairo_image_surface_get_height(surface);
+            source.format = format == CAIRO_FORMAT_RGB24 ? OBGPU_RGB : OBGPU_ARGB;
+            if (!m_work && (m_gpu->caps & OBGPU_CAN_PATH) && m_gpu->target_w > 0) {
+                // a band of rows as large as fits in maxWorkBytes
+                unsigned long row = 32UL * static_cast<unsigned long>(m_gpu->target_w + 4);
+                unsigned long rows = std::max(1UL, std::min(16UL, maxWorkBytes / row));
+                void* work = nullptr;
+                if (tryFastMalloc(row * rows).getValue(work)) {
+                    m_work = static_cast<unsigned char*>(work);
+                    obgpu_work(m_gpu, reinterpret_cast<uintptr_t>(work), row * rows);
+                }
+            }
+            // as Cairo::drawSurface's filters: nearest, bilinear, or (GOOD and
+            // BEST, which are not bilinear when they shrink) pixel for pixel only
+            int filter = -1;
+            switch (imageInterpolationQualityForOptions(options)) {
+            case InterpolationQuality::DoNotInterpolate:
+                filter = 0;
+                break;
+            case InterpolationQuality::Low:
+                filter = 1;
+                break;
+            default:
+                break;
+            }
+            float globalAlpha = std::clamp(alpha(), 0.0f, 1.0f);
+            unsigned alpha8 = globalAlpha >= 1 ? 255 : static_cast<unsigned>(globalAlpha * 65535.0 + 0.5) >> 8;
+            long dst[4], src[4];
+            if (source.address && fixedRect(destRect, dst) && fixedRect(srcRect, src)
+                && obgpu_image(m_gpu, &source, dst, src, static_cast<int>(options.compositeOperator()), alpha8, filter)) {
+                if (obgpu_pending(m_gpu))
+                    m_pictures.append(surface);
+                return;
+            }
+        }
+    }
+    handOn(OBGPU_IMAGE);
+    m_cairo.drawNativeImage(image, destRect, srcRect, options);
+}
+
+void GraphicsContextOpenGPU::drawImageBuffer(ImageBuffer& buffer, const FloatRect& destination, const FloatRect& source, ImagePaintingOptions options)
+{
+    // The picture is the buffer's own pixels, which may be drawn into again
+    // before the batch would go: it goes now.
+    GraphicsContext::drawImageBuffer(buffer, destination, source, options);
+    flush();
+}
