+void GraphicsContextOpenGPU::strokePath(const Path& path)
+{
+    handOn(OBGPU_STROKE);
+    m_cairo.strokePath(path);
+}
+
+void GraphicsContextOpenGPU::drawPattern(const NativeImage& image, const FloatRect& destRect, const FloatRect& tileRect, const AffineTransform& patternTransform, const FloatPoint& phase, const FloatSize& spacing, ImagePaintingOptions options)
+{
+    handOn(OBGPU_PATTERN);
+    m_cairo.drawPattern(image, destRect, tileRect, patternTransform, phase, spacing, options);
+}
+
+void GraphicsContextOpenGPU::drawFocusRing(const Path& path, float outlineWidth, const Color& color, float zoomFactor)
+{
+    handOn(OBGPU_FOCUS);
+    m_cairo.drawFocusRing(path, outlineWidth, color, zoomFactor);
+}
+
+void GraphicsContextOpenGPU::drawFocusRing(const Vector<FloatRect>& rects, float outlineWidth, const Color& color, float zoomFactor)
+{
+    handOn(OBGPU_FOCUS);
+    m_cairo.drawFocusRing(rects, outlineWidth, color, zoomFactor);
+}
+
+void GraphicsContextOpenGPU::drawGlyphs(const Font& font, std::span<const GlyphBufferGlyph> glyphs, std::span<const GlyphBufferAdvance> advances, const FloatPoint& point, FontSmoothingMode smoothing)
+{
+    handOn(OBGPU_GLYPHS);
+    m_cairo.drawGlyphs(font, glyphs, advances, point, smoothing);
+}
+
+void GraphicsContextOpenGPU::drawGlyphsImmediate(const FontBase& font, std::span<const GlyphBufferGlyph> glyphs, std::span<const GlyphBufferAdvance> advances, const FloatPoint& point, FontSmoothingMode smoothing)
+{
+    handOn(OBGPU_GLYPHS);
+    m_cairo.drawGlyphsImmediate(font, glyphs, advances, point, smoothing);
+}
+
+void GraphicsContextOpenGPU::drawLinesForText(const FloatPoint& point, float thickness, std::span<const FloatSegment> segments, bool isPrinting, bool doubleLines, StrokeStyle style)
+{
+    handOn(OBGPU_TEXT_LINES);
+    m_cairo.drawLinesForText(point, thickness, segments, isPrinting, doubleLines, style);
+}
+
+void GraphicsContextOpenGPU::drawDotsForDocumentMarker(const FloatRect& rect, DocumentMarkerLineStyle style)
+{
+    handOn(OBGPU_TEXT_LINES);
+    m_cairo.drawDotsForDocumentMarker(rect, style);
+}
+
+} // namespace WebCore
+
+#endif // USE(CAIRO)
diff --git a/Source/WebCore/platform/graphics/amiga/GraphicsContextOpenGPU.h b/Source/WebCore/platform/graphics/amiga/GraphicsContextOpenGPU.h
new file mode 100644
index 00000000000..9f2fe7fb74c
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/GraphicsContextOpenGPU.h
@@ -0,0 +1,120 @@
+/*
+ * The window's GraphicsContext on OpenGPU: rectangles of one colour,
+ * clearRect, rectangle clips and pictures go into one OpenGPU batch
+ * (OpenGPUPaintAmiga.h); every other call goes to a GraphicsContextCairo
+ * on the same pixels and the same state, after the batch is sent and drawn.
+ * The shell variable OB_PAINT=cairo, or no opengpu.library with stream
+ * v1.4's COMPOSITE_PD, keeps the window on cairo alone (isWanted()).
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#if USE(CAIRO)
+
+#include "GraphicsContextCairo.h"
+#include "OpenGPUPaintAmiga.h"
+#include "RefPtrCairo.h"
+#include <wtf/Vector.h>
+
+namespace WebCore {
+
+class WEBCORE_EXPORT GraphicsContextOpenGPU final : public GraphicsContext {
+    WTF_MAKE_NONCOPYABLE(GraphicsContextOpenGPU);
+public:
+    // An ARGB32 cairo image surface; counts may be null.
+    GraphicsContextOpenGPU(cairo_surface_t*, obgpu_counts*);
+    ~GraphicsContextOpenGPU();
+
+    // OpenGPU is there and OB_PAINT does not say cairo.
+    static bool isWanted();
+
+    bool hasPlatformContext() const final { return true; }
+    // cairo's, for callers that draw with it themselves: after the batch.
+    GraphicsContextCairo* platformContext() const final;
+
+    void didUpdateState(GraphicsContextState&) final;
+
+    void save(GraphicsContextState::Purpose = GraphicsContextState::Purpose::SaveRestore) final;
+    void restore(GraphicsContextState::Purpose = GraphicsContextState::Purpose::SaveRestore) final;
+
+    void drawRect(const FloatRect&, float borderThickness = 1) final;
+    void drawLine(const FloatPoint&, const FloatPoint&) final;
+    void drawEllipse(const FloatRect&) final;
+    void fillPath(const Path&) final;
+    void strokePath(const Path&) final;
+
+    void beginTransparencyLayer(float opacity) final;
+    void beginTransparencyLayer(CompositeOperator, BlendMode) final;
+    void endTransparencyLayer() final;
+
+    using GraphicsContext::fillRect;
+    void fillRect(const FloatRect&, RequiresClipToRect = RequiresClipToRect::Yes) final;
+    void fillRect(const FloatRect&, const Color&) final;
+    void fillRect(const FloatRect&, Gradient&) final;
+    void fillRect(const FloatRect&, Gradient&, const AffineTransform&, RequiresClipToRect = RequiresClipToRect::Yes) final;
+    void fillRoundedRectImpl(const FloatRoundedRect&, const Color&) final;
+    void fillRectWithRoundedHole(const FloatRect&, const FloatRoundedRect&, const Color&) final;
+    void clearRect(const FloatRect&) final;
+    void strokeRect(const FloatRect&, float lineWidth) final;
+
+    RenderingMode renderingMode() const final;
+
+    void resetClip() final;
+    void clip(const FloatRect&) final;
+    void clipRoundedRect(const FloatRoundedRect&) final;
+    void clipPath(const Path&, WindRule = WindRule::EvenOdd) final;
+    void clipOut(const FloatRect&) final;
+    void clipOut(const Path&) final;
+    void clipToImageBuffer(ImageBuffer&, const FloatRect&) final;
+    IntRect clipBounds() const final;
+
+    void setLineCap(LineCap) final;
+    void setLineDash(const DashArray&, float dashOffset) final;
+    void setLineJoin(LineJoin) final;
+    void setMiterLimit(float) final;
+
+    void drawNativeImage(const NativeImage&, const FloatRect& destRect, const FloatRect& srcRect, ImagePaintingOptions = { }) final;
+    using GraphicsContext::drawImageBuffer;
+    void drawImageBuffer(ImageBuffer&, const FloatRect& destination, const FloatRect& source, ImagePaintingOptions = { }) final;
+    using GraphicsContext::drawPattern;
+    void drawPattern(const NativeImage&, const FloatRect& destRect, const FloatRect& tileRect, const AffineTransform& patternTransform, const FloatPoint& phase, const FloatSize& spacing, ImagePaintingOptions = { }) final;
+
+    using GraphicsContext::scale;
+    void scale(const FloatSize&) final;
+    void rotate(float angleInRadians) final;
+    void translate(float x, float y) final;
+    void concatCTM(const AffineTransform&) final;
+    void setCTM(const AffineTransform&) final;
+    AffineTransform getCTM(IncludeDeviceScale = PossiblyIncludeDeviceScale) const final;
+
+    void drawFocusRing(const Path&, float outlineWidth, const Color&, float zoomFactor) final;
+    void drawFocusRing(const Vector<FloatRect>&, float outlineWidth, const Color&, float zoomFactor) final;
+
+    void drawGlyphs(const Font&, std::span<const GlyphBufferGlyph>, std::span<const GlyphBufferAdvance>, const FloatPoint&, FontSmoothingMode) final;
+    void drawGlyphsImmediate(const FontBase&, std::span<const GlyphBufferGlyph>, std::span<const GlyphBufferAdvance>, const FloatPoint&, FontSmoothingMode) final;
+    void drawLinesForText(const FloatPoint&, float thickness, std::span<const FloatSegment>, bool isPrinting, bool doubleLines, StrokeStyle) final;
+    void drawDotsForDocumentMarker(const FloatRect&, DocumentMarkerLineStyle) final;
+
+private:
+    static long submitBatch(void* user, const unsigned char* stream, long words);
+    // The batch sent, then a call of this kind counted for cairo.
+    void handOn(int kind) const;
+    void flush() const;
+    void syncMatrix();
+    bool solidFill(const FloatRect&, const Color&, CompositeOperator, BlendMode);
+
+    mutable GraphicsContextCairo m_cairo;
+    cairo_surface_t* m_surface;
+    obgpu_counts m_ownCounts { };
+    obgpu_counts* m_counts;
+    // the state, the stream and the scratch words in one block (not on the stack)
+    obgpu* m_gpu { nullptr };
+    unsigned char* m_work { nullptr };
+    // The pictures in the batch, kept until it is drawn.
+    mutable Vector<RefPtr<cairo_surface_t>, 16> m_pictures;
+};
+
+} // namespace WebCore
+
+#endif // USE(CAIRO)
diff --git a/Source/WebCore/platform/graphics/amiga/OpenGPULibraryAmiga.c b/Source/WebCore/platform/graphics/amiga/OpenGPULibraryAmiga.c
new file mode 100644
index 00000000000..017286bfac2
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/OpenGPULibraryAmiga.c
@@ -0,0 +1,76 @@
+/*
+ * opengpu.library for GraphicsContextOpenGPU (OpenGPUPaintAmiga.h's
+ * ob_opengpu_caps and ob_opengpu_run). Opened at run time, once, through
+ * openamigartg's inline calls; nothing is linked. A missing library, or one
+ * older than stream v1.4 (it answers OGPU_NONE for COMPOSITE_PD), leaves
+ * the engine on cairo.
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "OpenGPUPaintAmiga.h"
+
+#include <exec/types.h>
+#include <exec/libraries.h>
+#include <proto/exec.h>
+
+/* The engine's own base: a program's OpenGPUBase is left alone. */
+#define OPENGPU_BASE_NAME OBOpenGPUBase
+#include <opengpu/opengpu.h>
+#include <inline/opengpu.h>
+
+#include <pthread.h>
+#include <stdlib.h>
+
+static struct Library *OBOpenGPUBase;
+static int s_caps;
+static pthread_once_t s_openOnce = PTHREAD_ONCE_INIT;
+
+static void closeOpenGPU(void)
+{
+    if (OBOpenGPUBase) {
+        CloseLibrary(OBOpenGPUBase);
+        OBOpenGPUBase = NULL;
+    }
+}
+
+static int done(ULONG answer)
+{
+    return OGPU_ANSWER(answer) != OGPU_NONE;
+}
+
+static void openOpenGPU(void)
+{
+    OBOpenGPUBase = OpenLibrary((CONST_STRPTR)OPENGPU_NAME, OPENGPU_VERSION);
+    if (!OBOpenGPUBase)
+        return;
+    if (!done(OGPU_Query(OGPU_OP_COMPOSITE_PD, OGPU_FMT_ARGB32))) {
+        closeOpenGPU();
+        return;
+    }
+    s_caps = OBGPU_CAN_PD;
+    if (done(OGPU_Query(OGPU_OP_PATH_FILL, OGPU_FMT_ARGB32)))
+        s_caps |= OBGPU_CAN_PATH;
+    atexit(closeOpenGPU);
+}
+
+int ob_opengpu_caps(void)
+{
+    pthread_once(&s_openOnce, openOpenGPU);
+    return s_caps;
+}
+
+long ob_opengpu_run(const unsigned char *stream, long words)
+{
+    ULONG fence = 0;
+    LONG r, w;
+    if (!OBOpenGPUBase)
+        return OGPU_ERR_DEVICE;
+    /* the CPU has drawn it when this returns; a driver may still be busy */
+    r = OGPU_Submit((APTR)stream, (ULONG)words, &fence);
+    if (fence) {
+        w = OGPU_Wait(fence);
+        if (!r)
+            r = w;
+    }
+    return r;
+}
diff --git a/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.c b/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.c
new file mode 100644
index 00000000000..60e597dc53c
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.c
@@ -0,0 +1,652 @@
+/*
+ * GraphicsContextOpenGPU's drawing as OpenGPU stream words
+ * (OpenGPUPaintAmiga.h; the stream is openamigartg's include/opengpu/stream.h).
+ *
+ * What is drawn here, as cairo draws it:
+ * - a rectangle of one colour whose visible edges fall on whole pixels,
+ *   under a transform that keeps it upright: FILL (copy, clear, or an
+ *   opaque colour over) or COMPOSITE_PD with a solid source (the other
+ *   operators cairo bounds by the rectangle). Edges between pixels need
+ *   anti-aliasing (step 6.3, the paths).
+ * - a picture drawn pixel for pixel: COMPOSITE_PD from its slot, with the
+ *   global alpha as a solid mask; scaled or under any other transform, a
+ *   PATH_FILL of its rectangle painted with the picture as a pattern
+ *   (PAD edges, nearest or bilinear), which is premultiplied as cairo is.
+ *   COMPOSITE_AFFINE is not used: its blends are SDL's, on colours not
+ *   premultiplied.
+ * cairo bounds IN, OUT, DEST_IN and DEST_ATOP by the clip, not the shape,
+ * and PlusDarker and Difference are blend modes: those stay cairo's, as
+ * do clips that are not upright rectangles on whole pixels.
+ *
+ * One batch: the target and the pictures in slots, each picture bound once
+ * a batch (a slot is bound again when all 15 are used: commands run in
+ * order), the clip sent when it changes, until the caller flushes or the
+ * stream is full.
+ * MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+#include "OpenGPUPaintAmiga.h"
+
+#include <opengpu/stream.h>
+
+#if OBGPU_SLOTS != OGPU_MAX_SLOTS
+#error "OBGPU_SLOTS is OpenGPU's OGPU_MAX_SLOTS"
+#endif
+
+/* 64-bit products, once a call: libgcc's on the 68k, never per pixel. */
+typedef long long obgpu_s64;
+
+#define OBGPU_L_MATRIX_BAD  1   /* the transform does not fit the fixed point */
+#define OBGPU_L_CLIP_OTHER  2   /* a clip only cairo has */
+#define OBGPU_L_GROUP       4   /* cairo draws into a group of its own */
+
+/* The largest target or picture side, and a point OpenGPU takes (16 bits). */
+#define OBGPU_MAX_SIDE      OGPU_MAX_SIZE
+#define OBGPU_POINT_MAX     32767
+
+/* The words a command may need at most: CLIP, SURFACE, PATH_FILL. */
+#define OBGPU_CMD_MAX       (3 + 6 + 16)
+#define OBGPU_HEAD_WORDS    (6 + 2)
+#define OBGPU_PATTERN_SCRATCH (OGPU_PATTERN_WORDS + 13)
+
+static const char *const kindNames[OBGPU_KINDS] = {
+    "fill", "clear", "image", "pattern", "gradient", "rounded", "path",
+    "stroke", "glyphs", "textlines", "focus", "layer", "platform"
+};
+
+const char *obgpu_kind_name(int kind)
+{
+    return kind >= 0 && kind < OBGPU_KINDS ? kindNames[kind] : "other";
+}
+
+/* ---- fixed point --------------------------------------------------------------------- */
+
+/* floor(v / 2^n), for n of 8 or 16, with no shift of a negative number. */
+static obgpu_s64 floorShift(obgpu_s64 v, int n)
+{
+    obgpu_s64 one = (obgpu_s64)1 << n;
+    return v >= 0 ? v / one : -((-v + one - 1) / one);
+}
+
+/* A 16.16 times a 24.8, as 24.8, rounded. */
+static obgpu_s64 mul16(long f, obgpu_s64 v)
+{
+    return floorShift((obgpu_s64)f * v + 0x8000, 16);
+}
+
+static int whole(obgpu_s64 v8)
+{
+    return floorShift(v8, 8) * 256 == v8;
+}
+
+static obgpu_s64 mapX(const long *m, long x, long y)
+{
+    return mul16(m[0], x) + mul16(m[2], y) + m[4];
+}
+
+static obgpu_s64 mapY(const long *m, long x, long y)
+{
+    return mul16(m[1], x) + mul16(m[3], y) + m[5];
+}
+
+/* ---- the stream ---------------------------------------------------------------------- */
+
+static void put(unsigned char *p, unsigned long v)
+{
+    p[0] = (unsigned char)(v >> 24);
+    p[1] = (unsigned char)(v >> 16);
+    p[2] = (unsigned char)(v >> 8);
+    p[3] = (unsigned char)v;
+}
+
+static unsigned long xy(long x, long y)
+{
+    return OGPU_XY((unsigned long)x, (unsigned long)y);
+}
+
+/* One command: its opcode and n words after the header. */
+static void emit(struct obgpu *g, int op, int n, const unsigned long *a)
+{
+    unsigned char *p = g->stream + g->words * 4;
+    int i;
+    put(p, OGPU_HDR(op, n + 1));
+    for (i = 0; i < n; i++)
+        put(p + 4 + i * 4, a[i]);
+    g->words += 1 + n;
+}
+
+static void bindSlot(struct obgpu *g, int slot, const struct obgpu_source *s)
+{
+    unsigned long a[5];
+    a[0] = (unsigned long)slot;
+    a[1] = s->address;
+    a[2] = (unsigned long)s->bpr;
+    a[3] = xy(s->w, s->h);
+    a[4] = s->format == OBGPU_RGB ? OGPU_FMT_XRGB32 : OGPU_FMT_ARGB32;
+    emit(g, OGPU_OP_SURFACE, 5, a);
+    g->slot[slot] = *s;
+}
+
+static void begin(struct obgpu *g)
+{
+    struct obgpu_source t;
+    unsigned long a[1];
+    int i;
+    t.address = g->target;
+    t.bpr = g->target_bpr;
+    t.w = g->target_w;
+    t.h = g->target_h;
+    t.format = OBGPU_ARGB;
+    for (i = 0; i < OBGPU_SLOTS; i++)
+        g->slot[i].address = 0;
+    g->words = 0;
+    g->drawn = 0;
+    g->scratch_used = 0;
+    bindSlot(g, 0, &t);
+    a[0] = 0;
+    emit(g, OGPU_OP_TARGET, 1, a);
+    g->next_slot = 1;
+    g->clip_sent = 0;
+}
+
+long obgpu_flush(struct obgpu *g)
+{
+    long r = 0;
+    if (g->drawn && g->submit) {
+        r = g->submit(g->user, g->stream, g->words);
+        g->counts->flushes++;
+        if (r)
+            g->broken = 1;
+    }
+    g->words = 0;
+    g->drawn = 0;
+    g->scratch_used = 0;
+    return r;
+}
+
+int obgpu_pending(const struct obgpu *g)
+{
+    return g->drawn;
+}
+
+/* Room for a command of at most OBGPU_CMD_MAX words and scratch words:
+ * the batch is sent first when it is short of either. */
+static int room(struct obgpu *g, long scratch)
+{
+    if (g->words && (g->words + OBGPU_CMD_MAX > g->stream_cap || g->scratch_used + scratch > g->scratch_cap))
+        obgpu_flush(g);
+    if (g->broken)
+        return 0;
+    if (!g->words)
+        begin(g);
+    return 1;
+}
+
+/* The slot a picture has in this batch, bound if new. */
+static int slotOf(struct obgpu *g, const struct obgpu_source *s)
+{
+    int i;
+    for (i = 1; i < OBGPU_SLOTS; i++) {
+        const struct obgpu_source *b = &g->slot[i];
+        if (b->address == s->address && b->bpr == s->bpr && b->w == s->w && b->h == s->h && b->format == s->format)
+            return i;
+    }
+    i = g->next_slot;
+    g->next_slot = i + 1 < OBGPU_SLOTS ? i + 1 : 1;
+    bindSlot(g, i, s);
+    return i;
+}
+
+static const struct obgpu_level *current(const struct obgpu *g)
+{
+    return &g->level[g->depth];
+}
+
+/* The core clips each command to the last CLIP: keep it the state's. */
+static void sendClip(struct obgpu *g)
+{
+    const struct obgpu_level *l = current(g);
+    unsigned long a[2];
+    if (g->clip_sent && g->sx0 == l->cx0 && g->sy0 == l->cy0 && g->sx1 == l->cx1 && g->sy1 == l->cy1)
+        return;
+    a[0] = xy(l->cx0, l->cy0);
+    a[1] = xy(l->cx1 - l->cx0, l->cy1 - l->cy0);
+    emit(g, OGPU_OP_CLIP, 2, a);
+    g->clip_sent = 1;
+    g->sx0 = l->cx0;
+    g->sy0 = l->cy0;
+    g->sx1 = l->cx1;
+    g->sy1 = l->cy1;
+}
+
+/* ---- the state ----------------------------------------------------------------------- */
+
+void obgpu_init(struct obgpu *g, unsigned char *stream, long stream_words, unsigned char *scratch,
+    unsigned long scratch_address, long scratch_words, obgpu_submit_fn submit, void *user, int caps,
+    struct obgpu_counts *counts)
+{
+    unsigned char *p = (unsigned char *)g;
+    unsigned long i;
+    for (i = 0; i < sizeof *g; i++)
+        p[i] = 0;
+    g->stream = stream;
+    g->stream_cap = stream_words;
+    g->scratch = scratch;
+    g->scratch_address = scratch_address;
+    g->scratch_cap = scratch_words;
+    g->submit = submit;
+    g->user = user;
+    g->caps = caps;
+    g->counts = counts ? counts : &g->own_counts;
+    if (stream_words < OBGPU_HEAD_WORDS + OBGPU_CMD_MAX || !(caps & OBGPU_CAN_PD))
+        g->broken = 1;
+    if (scratch_words < OBGPU_PATTERN_SCRATCH)
+        g->caps &= ~OBGPU_CAN_PATH;
+    g->level[0].m[0] = 0x10000;
+    g->level[0].m[3] = 0x10000;
+}
+
+void obgpu_target(struct obgpu *g, unsigned long address, long bpr, int w, int h)
+{
+    struct obgpu_level *l = &g->level[g->depth];
+    g->target = address;
+    g->target_bpr = bpr;
+    g->target_w = w;
+    g->target_h = h;
+    l->cx0 = l->cy0 = 0;
+    l->cx1 = w;
+    l->cy1 = h;
+    if (w <= 0 || h <= 0 || w > OBGPU_MAX_SIDE || h > OBGPU_MAX_SIDE || bpr < (long)w * 4)
+        g->broken = 1;
+}
+
+void obgpu_work(struct obgpu *g, unsigned long address, unsigned long bytes)
+{
+    g->work = address;
+    g->work_bytes = bytes;
+}
+
+void obgpu_save(struct obgpu *g)
+{
+    struct obgpu_level *from, *to;
+    int i;
+    if (g->lost || g->depth + 1 >= OBGPU_DEPTH) {
+        g->lost++;
+        return;
+    }
+    from = &g->level[g->depth];
+    to = from + 1;
+    for (i = 0; i < 6; i++)
+        to->m[i] = from->m[i];
+    to->cx0 = from->cx0;
+    to->cy0 = from->cy0;
+    to->cx1 = from->cx1;
+    to->cy1 = from->cy1;
+    to->flags = from->flags;
+    g->depth++;
+}
+
+void obgpu_restore(struct obgpu *g)
+{
+    if (g->lost)
+        g->lost--;
+    else if (g->depth)
+        g->depth--;
+}
+
+void obgpu_set_matrix(struct obgpu *g, const long *m)
+{
+    struct obgpu_level *l = &g->level[g->depth];
+    int i;
+    if (g->lost)
+        return;
+    if (!m) {
+        l->flags |= OBGPU_L_MATRIX_BAD;
+        return;
+    }
+    for (i = 0; i < 6; i++)
+        l->m[i] = m[i];
+    l->flags &= ~OBGPU_L_MATRIX_BAD;
+}
+
+static int upright(const struct obgpu_level *l)
+{
+    return !(l->flags & OBGPU_L_MATRIX_BAD) && !l->m[1] && !l->m[2];
+}
+
+/* A rectangle (24.8) through an upright transform: its edges on the
+ * target, 24.8, left to right and top to bottom. */
+static void mapRect(const struct obgpu_level *l, long x, long y, long w, long h, obgpu_s64 *e)
+{
+    obgpu_s64 t;
+    e[0] = mapX(l->m, x, 0);
+    e[2] = mapX(l->m, x + w, 0);
+    e[1] = mapY(l->m, 0, y);
+    e[3] = mapY(l->m, 0, y + h);
+    if (e[0] > e[2]) { t = e[0]; e[0] = e[2]; e[2] = t; }
+    if (e[1] > e[3]) { t = e[1]; e[1] = e[3]; e[3] = t; }
+}
+
+/* Edges e (24.8) within the clip, as whole pixels in r, when every edge
+ * the clip leaves visible falls on a whole pixel. 0: an edge needs
+ * anti-aliasing. r empty (r[2] <= r[0] or r[3] <= r[1]): nothing to draw. */
+static int visible(const struct obgpu_level *l, const obgpu_s64 *e, int *r)
+{
+    obgpu_s64 c[4];
+    int i;
+    c[0] = (obgpu_s64)l->cx0 * 256;
+    c[1] = (obgpu_s64)l->cy0 * 256;
+    c[2] = (obgpu_s64)l->cx1 * 256;
+    c[3] = (obgpu_s64)l->cy1 * 256;
+    /* wholly outside: nothing to draw, wherever its edges are */
+    if (e[2] <= c[0] || e[0] >= c[2] || e[3] <= c[1] || e[1] >= c[3] || c[2] <= c[0] || c[3] <= c[1]) {
+        r[0] = r[2] = l->cx0;
+        r[1] = r[3] = l->cy0;
+        return 1;
+    }
+    for (i = 0; i < 4; i++) {
+        int outside = i < 2 ? e[i] <= c[i] : e[i] >= c[i];
+        if (outside)
+            r[i] = (int)(c[i] / 256);
+        else if (!whole(e[i]))
+            return 0;
+        else
+            r[i] = (int)(e[i] / 256);
+    }
+    return 1;
+}
+
+void obgpu_clip(struct obgpu *g, long x, long y, long w, long h)
+{
+    struct obgpu_level *l = &g->level[g->depth];
+    obgpu_s64 e[4];
+    int r[4];
+    if (g->lost || (l->flags & OBGPU_L_CLIP_OTHER))
+        return;
+    if (!upright(l)) {
+        l->flags |= OBGPU_L_CLIP_OTHER;
+        return;
+    }
+    if (w < 0) { x += w; w = -w; }
+    if (h < 0) { y += h; h = -h; }
+    mapRect(l, x, y, w, h, e);
+    if (!visible(l, e, r)) {
+        l->flags |= OBGPU_L_CLIP_OTHER;
+        return;
+    }
+    if (r[2] <= r[0] || r[3] <= r[1]) {
+        r[2] = r[0];
+        r[3] = r[1];
+    }
+    l->cx0 = r[0];
+    l->cy0 = r[1];
+    l->cx1 = r[2];
+    l->cy1 = r[3];
+}
+
+void obgpu_clip_other(struct obgpu *g)
+{
+    if (!g->lost)
+        g->level[g->depth].flags |= OBGPU_L_CLIP_OTHER;
+}
+
+void obgpu_group(struct obgpu *g)
+{
+    if (!g->lost)
+        g->level[g->depth].flags |= OBGPU_L_GROUP;
+}
+
+void obgpu_reset_clip(struct obgpu *g)
+{
+    struct obgpu_level *l = &g->level[g->depth];
+    if (g->lost)
+        return;
+    l->cx0 = l->cy0 = 0;
+    l->cx1 = g->target_w;
+    l->cy1 = g->target_h;
+    l->flags &= ~OBGPU_L_CLIP_OTHER;
+}
+
+int obgpu_drawable(const struct obgpu *g)
+{
+    return !g->broken && !g->lost && !(current(g)->flags & (OBGPU_L_MATRIX_BAD | OBGPU_L_CLIP_OTHER | OBGPU_L_GROUP));
+}
+
+/* ---- the operators ------------------------------------------------------------------- */
+
+/* WebCore's operator as COMPOSITE_PD's, where cairo bounds it by the shape
+ * drawn (pixman's operators, as cairo's): -1 otherwise. */
+static int pdOperator(int op)
+{
+    switch (op) {
+    case OBGPU_OP_CLEAR: return OGPU_PD_CLEAR;
+    case OBGPU_OP_COPY: return OGPU_PD_SRC;
+    case OBGPU_OP_SOURCE_OVER: return OGPU_PD_OVER;
+    case OBGPU_OP_SOURCE_ATOP: return OGPU_PD_ATOP;
+    case OBGPU_OP_DESTINATION_OVER: return OGPU_PD_OVER_REVERSE;
+    case OBGPU_OP_DESTINATION_OUT: return OGPU_PD_OUT_REVERSE;
+    case OBGPU_OP_XOR: return OGPU_PD_XOR;
+    case OBGPU_OP_PLUS_LIGHTER: return OGPU_PD_ADD;
+    default: return -1;
+    }
+}
+
+/* ---- drawing ------------------------------------------------------------------------- */
+
+int obgpu_fill(struct obgpu *g, long x, long y, long w, long h, unsigned long argb, int op)
+{
+    const struct obgpu_level *l = current(g);
+    obgpu_s64 e[4];
+    int r[4], pd = pdOperator(op);
+    unsigned long a[7];
+    unsigned alpha = (unsigned)(argb >> 24) & 255;
+    argb &= 0xFFFFFFFFUL;
+    if (!obgpu_drawable(g) || pd < 0 || !upright(l))
+        return 0;
+    if (w < 0) { x += w; w = -w; }
+    if (h < 0) { y += h; h = -h; }
+    if (!w || !h)
+        return 1;
+    mapRect(l, x, y, w, h, e);
+    if (!visible(l, e, r))
+        return 0;
+    if (r[2] <= r[0] || r[3] <= r[1])
+        return 1;
+    if ((pd == OGPU_PD_OVER || pd == OGPU_PD_ADD || pd == OGPU_PD_OVER_REVERSE) && !argb)
+        return 1;
+    if (!room(g, 0))
+        return 0;
+    sendClip(g);
+    a[0] = xy(r[0], r[1]);
+    a[1] = xy(r[2] - r[0], r[3] - r[1]);
+    if (pd == OGPU_PD_CLEAR || pd == OGPU_PD_SRC || (pd == OGPU_PD_OVER && alpha == 255)) {
+        a[2] = pd == OGPU_PD_CLEAR ? 0 : argb;
+        emit(g, OGPU_OP_FILL, 3, a);
+    } else {
+        a[0] = (unsigned long)pd | OGPU_PD_SOLID;
+        a[1] = argb;
+        a[2] = 0;
+        a[3] = 0;
+        a[4] = 0;
+        a[5] = xy(r[0], r[1]);
+        a[6] = xy(r[2] - r[0], r[3] - r[1]);
+        emit(g, OGPU_OP_COMPOSITE_PD, 7, a);
+    }
+    g->drawn++;
+    g->counts->draws++;
+    return 1;
+}
+
+/* A picture pixel for pixel: COMPOSITE_PD from its slot. */
+static int imageCopy(struct obgpu *g, const struct obgpu_source *s, const int *d, int sx, int sy, int pd,
+    unsigned alpha)
+{
+    const struct obgpu_level *l = current(g);
+    int x0 = d[0], y0 = d[1], x1 = d[2], y1 = d[3], slot;
+    unsigned long a[7];
+    if (x0 < l->cx0) { sx += l->cx0 - x0; x0 = l->cx0; }
+    if (y0 < l->cy0) { sy += l->cy0 - y0; y0 = l->cy0; }
+    if (x1 > l->cx1) x1 = l->cx1;
+    if (y1 > l->cy1) y1 = l->cy1;
+    if (x1 <= x0 || y1 <= y0)
+        return 1;
+    if (!room(g, 0))
+        return 0;
+    sendClip(g);
+    slot = slotOf(g, s);
+    a[0] = (unsigned long)pd | (alpha < 255 ? OGPU_PD_MASK_SOLID : 0);
+    a[1] = (unsigned long)slot;
+    a[2] = xy(sx, sy);
+    a[3] = alpha;
+    a[4] = 0;
+    a[5] = xy(x0, y0);
+    a[6] = xy(x1 - x0, y1 - y0);
+    emit(g, OGPU_OP_COMPOSITE_PD, 7, a);
+    g->drawn++;
+    g->counts->draws++;
+    return 1;
+}
+
+static int fits32(obgpu_s64 v)
+{
+    return v > -0x7FFFFFFFLL && v < 0x7FFFFFFFLL;
+}
+
+/* A picture under any transform: PATH_FILL of the destination's corners
+ * on the target, painted with the picture's rectangle as a pattern. As
+ * cairo does it: the source rectangle widened to whole pixels (its
+ * subsurface), PAD beyond them, mapped onto the destination. */
+static int imageTransformed(struct obgpu *g, const struct obgpu_source *s, const long *dst, const long *src, int pd,
+    unsigned alpha, int bilinear)
+{
+    const struct obgpu_level *l = current(g);
+    const long *m = l->m;
+    obgpu_s64 kx, ky, tx, ty, p[6], cx[4], cy[4];
+    long psx, psy, psw, psh;
+    unsigned char *q;
+    unsigned long a[15], pattern, path;
+    int i, slot;
+    /* Operators that act outside the shape on PATH_FILL (CLEAR, SRC) stay cairo's. */
+    if (!(g->caps & OBGPU_CAN_PATH) || pd == OGPU_PD_CLEAR || pd == OGPU_PD_SRC || bilinear < 0)
+        return 0;
+    if (!g->work || g->work_bytes < (unsigned long)(g->target_w + 4) * 32)
+        return 0;
+    /* the destination's size over the source's, 16.16 */
+    kx = (obgpu_s64)dst[2] * 65536 / src[2];
+    ky = (obgpu_s64)dst[3] * 65536 / src[3];
+    psx = (long)floorShift(src[0], 8);
+    psy = (long)floorShift(src[1], 8);
+    psw = (long)floorShift(src[0] + src[2] + 255, 8) - psx;
+    psh = (long)floorShift(src[1] + src[3] + 255, 8) - psy;
+    if (psx + psw > s->w)
+        psw = s->w - psx;
+    if (psy + psh > s->h)
+        psh = s->h - psy;
+    if (psw <= 0 || psh <= 0)
+        return 1;
+    /* the pattern's pixel (0, 0) in the destination's space, 24.8 */
+    tx = dst[0] + floorShift((obgpu_s64)(psx * 256 - src[0]) * kx + 0x8000, 16);
+    ty = dst[1] + floorShift((obgpu_s64)(psy * 256 - src[1]) * ky + 0x8000, 16);
+    /* the pattern's pixels to the target, 16.16 */
+    p[0] = floorShift((obgpu_s64)m[0] * kx + 0x8000, 16);
+    p[1] = floorShift((obgpu_s64)m[2] * ky + 0x8000, 16);
+    p[3] = floorShift((obgpu_s64)m[1] * kx + 0x8000, 16);
+    p[4] = floorShift((obgpu_s64)m[3] * ky + 0x8000, 16);
+    p[2] = (mul16(m[0], tx) + mul16(m[2], ty) + m[4]) * 256;
+    p[5] = (mul16(m[1], tx) + mul16(m[3], ty) + m[5]) * 256;
+    for (i = 0; i < 6; i++)
+        if (!fits32(p[i]))
+            return 0;
+    /* the destination's corners on the target, 24.8 */
+    for (i = 0; i < 4; i++) {
+        long x = dst[0] + (i == 1 || i == 2 ? dst[2] : 0), y = dst[1] + (i >= 2 ? dst[3] : 0);
+        cx[i] = mapX(m, x, y);
+        cy[i] = mapY(m, x, y);
+        if (cx[i] <= -0x7FFFFF00LL || cx[i] >= 0x7FFFFF00LL || cy[i] <= -0x7FFFFF00LL || cy[i] >= 0x7FFFFF00LL)
+            return 0;
+    }
+    if (!room(g, OBGPU_PATTERN_SCRATCH))
+        return 0;
+    sendClip(g);
+    slot = slotOf(g, s);
+    /* the pattern, then the path, in scratch */
+    pattern = g->scratch_address + (unsigned long)g->scratch_used * 4;
+    q = g->scratch + g->scratch_used * 4;
+    put(q, (unsigned long)slot);
+    put(q + 4, OGPU_PATTERN_PAD | (bilinear ? OGPU_PATTERN_BILINEAR : 0));
+    put(q + 8, xy(psx, psy));
+    put(q + 12, xy(psw, psh));
+    for (i = 0; i < 6; i++)
+        put(q + 16 + i * 4, (unsigned long)(long)p[i]);
+    put(q + 40, alpha);
+    q += OGPU_PATTERN_WORDS * 4;
+    path = pattern + OGPU_PATTERN_WORDS * 4;
+    for (i = 0; i < 4; i++) {
+        put(q, i ? OGPU_PATH_LINE : OGPU_PATH_MOVE);
+        put(q + 4, (unsigned long)(long)cx[i]);
+        put(q + 8, (unsigned long)(long)cy[i]);
+        q += 12;
+    }
+    put(q, OGPU_PATH_CLOSE);
+    g->scratch_used += OBGPU_PATTERN_SCRATCH;
+    a[0] = (unsigned long)pd | OGPU_PATH_PATTERN;
+    a[1] = pattern;
+    a[2] = 0;
+    a[3] = 0;
+    a[4] = 0;
+    a[5] = path;
+    a[6] = 13;
+    a[7] = 0x10000;
+    a[8] = 0;
+    a[9] = 0;
+    a[10] = 0;
+    a[11] = 0x10000;
+    a[12] = 0;
+    a[13] = g->work;
+    a[14] = g->work_bytes;
+    emit(g, OGPU_OP_PATH_FILL, 15, a);
+    g->drawn++;
+    g->counts->draws++;
+    return 1;
+}
+
+int obgpu_image(struct obgpu *g, const struct obgpu_source *s, const long *dst, const long *src, int op,
+    unsigned alpha, int bilinear)
+{
+    const struct obgpu_level *l = current(g);
+    int pd = pdOperator(op);
+    if (!obgpu_drawable(g) || pd < 0 || pd == OGPU_PD_CLEAR)
+        return 0;
+    if (s->w <= 0 || s->h <= 0 || s->w > OBGPU_MAX_SIDE || s->h > OBGPU_MAX_SIDE || s->bpr < (long)s->w * 4
+        || s->bpr > 0x01000000L || (s->format != OBGPU_ARGB && s->format != OBGPU_RGB))
+        return 0;
+    /* copy with a global alpha is cairo's lerp, not pixman's SRC with a mask */
+    if (alpha > 255 || (pd == OGPU_PD_SRC && alpha < 255))
+        return 0;
+    /* flips and empty sources stay cairo's; a destination under half a pixel draws nothing, as cairo's */
+    if (dst[2] < 0 || dst[3] < 0 || src[2] <= 0 || src[3] <= 0)
+        return 0;
+    /* an empty clip: CLIP's wh of 0 would be the whole target */
+    if (dst[2] < 128 || dst[3] < 128 || !alpha || l->cx1 <= l->cx0 || l->cy1 <= l->cy0)
+        return 1;
+    /* sources outside the picture are clipped by cairo, with the destination */
+    if (src[0] < 0 || src[1] < 0 || src[0] + src[2] > (long)s->w * 256 || src[1] + src[3] > (long)s->h * 256)
+        return 0;
+    if (upright(l) && l->m[0] > 0 && l->m[3] > 0 && whole(src[0]) && whole(src[1]) && whole(src[2]) && whole(src[3])) {
+        obgpu_s64 e[4];
+        int r[4];
+        mapRect(l, dst[0], dst[1], dst[2], dst[3], e);
+        if (whole(e[0]) && whole(e[1]) && whole(e[2]) && whole(e[3])
+            && e[2] - e[0] == src[2] && e[3] - e[1] == src[3]) {
+            r[0] = (int)(e[0] / 256);
+            r[1] = (int)(e[1] / 256);
+            r[2] = (int)(e[2] / 256);
+            r[3] = (int)(e[3] / 256);
+            if (e[0] < -OBGPU_POINT_MAX * 256LL || e[1] < -OBGPU_POINT_MAX * 256LL
+                || e[2] > OBGPU_POINT_MAX * 256LL || e[3] > OBGPU_POINT_MAX * 256LL)
+                return 0;
+            return imageCopy(g, s, r, (int)(src[0] / 256), (int)(src[1] / 256), pd, alpha);
+        }
+    }
+    return imageTransformed(g, s, dst, src, pd, alpha, bilinear);
+}
diff --git a/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.h b/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.h
new file mode 100644
index 00000000000..2005f634ce7
--- /dev/null
+++ b/Source/WebCore/platform/graphics/amiga/OpenGPUPaintAmiga.h
@@ -0,0 +1,158 @@
+/*
+ * GraphicsContextOpenGPU's drawing as OpenGPU stream words: the transform,
+ * the clip stack, save and restore, rectangle fills, pictures, the
+ * operators and the batches (OpenGPUPaintAmiga.c). Plain C with no
+ * WebKit, no C library and no floating point, so the host tests build it
+ * against openamigartg's CPU core (openamigabrowser tests/test_opengpu_paint.c).
+ *
+ * Coordinates are fixed point: 24.8 (256 a pixel) for points and sizes,
+ * a transform's linear part (a, b, c, d) in 16.16 and its translation
+ * (e, f) in 24.8: x' = a x + c y + e, y' = b x + d y + f, as WebCore's
+ * AffineTransform. Colours are premultiplied ARGB32 words, as cairo's.
+ * Every drawing call returns 1 when it is done (or there was nothing to
+ * draw) and 0 when the caller must hand it to cairo; a 0 adds nothing to
+ * the batch. MIT, Copyright (c) 2026 AmigaChrome Team.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef OpenGPUPaintAmiga_h
+#define OpenGPUPaintAmiga_h
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* What the back end does (opengpu.library's OGPU_Query): COMPOSITE_PD
+ * (stream v1.4) for fills that blend and for pictures, and PATH_FILL (v1.6)
+ * for pictures under a scale or any other transform. Without PD nothing is
+ * drawn here. */
+#define OBGPU_CAN_PD    1
+#define OBGPU_CAN_PATH  2
+
+/* WebCore's CompositeOperator, in its order (GraphicsTypes.h). */
+enum {
+    OBGPU_OP_CLEAR, OBGPU_OP_COPY, OBGPU_OP_SOURCE_OVER, OBGPU_OP_SOURCE_IN, OBGPU_OP_SOURCE_OUT,
+    OBGPU_OP_SOURCE_ATOP, OBGPU_OP_DESTINATION_OVER, OBGPU_OP_DESTINATION_IN, OBGPU_OP_DESTINATION_OUT,
+    OBGPU_OP_DESTINATION_ATOP, OBGPU_OP_XOR, OBGPU_OP_PLUS_DARKER, OBGPU_OP_PLUS_LIGHTER, OBGPU_OP_DIFFERENCE
+};
+
+/* The calls handed to cairo, by kind, for the counts. */
+enum {
+    OBGPU_FILL, OBGPU_CLEAR, OBGPU_IMAGE, OBGPU_PATTERN, OBGPU_GRADIENT, OBGPU_ROUNDED, OBGPU_PATH,
+    OBGPU_STROKE, OBGPU_GLYPHS, OBGPU_TEXT_LINES, OBGPU_FOCUS, OBGPU_LAYER, OBGPU_PLATFORM, OBGPU_KINDS
+};
+
+struct obgpu_counts {
+    unsigned long draws;                /* commands OpenGPU drew */
+    unsigned long flushes;              /* batches sent and waited for */
+    unsigned long handed[OBGPU_KINDS];  /* calls cairo drew */
+};
+
+/* "fill", "glyphs" and so on: the kind's name in the counts' report. */
+const char *obgpu_kind_name(int kind);
+
+/* A picture's pixels: premultiplied ARGB32 (A, R, G, B in memory), or RGB
+ * with the first byte unused (cairo's RGB24 on the 68k). */
+#define OBGPU_ARGB 0
+#define OBGPU_RGB  1
+struct obgpu_source {
+    unsigned long address;
+    long bpr;
+    int w, h;
+    int format;
+};
+
+/* Saves kept; past them everything goes to cairo until the restores come
+ * back down. */
+#define OBGPU_DEPTH 64
+#define OBGPU_SLOTS 16
+
+struct obgpu_level {
+    long m[6];                  /* a, b, c, d (16.16), e, f (24.8) */
+    int cx0, cy0, cx1, cy1;     /* the clip, target pixels, x0 <= x < x1 */
+    int flags;                  /* OBGPU_L_ in OpenGPUPaintAmiga.c */
+};
+
+/* Sends words of stream and waits until they are drawn; 0, or OpenGPU's error. */
+typedef long (*obgpu_submit_fn)(void *user, const unsigned char *stream, long words);
+
+struct obgpu {
+    obgpu_submit_fn submit;
+    void *user;
+    int caps;
+    int broken;                 /* a batch failed: everything goes to cairo from then on */
+    /* the target: premultiplied ARGB32 */
+    unsigned long target;
+    long target_bpr;
+    int target_w, target_h;
+    /* the batch, and the scratch words its commands point at (patterns,
+     * paths), at an address the back end reaches */
+    unsigned char *stream;
+    long stream_cap, words;
+    int drawn;                  /* draws in the batch */
+    unsigned char *scratch;
+    unsigned long scratch_address;
+    long scratch_cap, scratch_used;
+    /* PATH_FILL's work memory, at least 32 bytes per pixel of the target's width */
+    unsigned long work, work_bytes;
+    /* the batch's slots (0 is the target) and the clip it has */
+    struct obgpu_source slot[OBGPU_SLOTS];
+    int next_slot;
+    int clip_sent, sx0, sy0, sx1, sy1;
+    /* the state stack */
+    int depth, lost;
+    struct obgpu_level level[OBGPU_DEPTH];
+    struct obgpu_counts *counts;
+    struct obgpu_counts own_counts;
+};
+
+/* stream_words of at least 64, scratch_words of at least 32; counts may be
+ * 0. The transform starts as the identity and the clip as the target. */
+void obgpu_init(struct obgpu *g, unsigned char *stream, long stream_words, unsigned char *scratch,
+    unsigned long scratch_address, long scratch_words, obgpu_submit_fn submit, void *user, int caps,
+    struct obgpu_counts *counts);
+void obgpu_target(struct obgpu *g, unsigned long address, long bpr, int w, int h);
+void obgpu_work(struct obgpu *g, unsigned long address, unsigned long bytes);
+
+void obgpu_save(struct obgpu *g);
+void obgpu_restore(struct obgpu *g);
+/* The current transform; 0 when it does not fit the fixed point (then
+ * nothing is drawn here until a restore or a transform that fits). */
+void obgpu_set_matrix(struct obgpu *g, const long *m);
+/* Clip to a rectangle (24.8, through the transform). One that is not on
+ * whole pixels, or not upright, makes the clip one only cairo has. */
+void obgpu_clip(struct obgpu *g, long x, long y, long w, long h);
+/* A clip only cairo has (paths, clip-outs, masks), until the restore. */
+void obgpu_clip_other(struct obgpu *g);
+/* cairo draws into a group of its own from here (a transparency layer, a
+ * mask) until the restore: nothing is drawn here. */
+void obgpu_group(struct obgpu *g);
+void obgpu_reset_clip(struct obgpu *g);
+/* 1 when the state lets anything be drawn here. */
+int obgpu_drawable(const struct obgpu *g);
+
+/* A rectangle (24.8) of one colour (premultiplied ARGB32) by a WebCore
+ * operator: fillRect, and clearRect as OBGPU_OP_CLEAR. */
+int obgpu_fill(struct obgpu *g, long x, long y, long w, long h, unsigned long argb, int op);
+/* A picture: src (x, y, w, h in its pixels, 24.8) drawn into dst (x, y, w,
+ * h, 24.8, through the transform) by an operator, times alpha (0-255),
+ * bilinear: 1 bilinear, 0 nearest, -1 neither (only pixel for pixel). The
+ * pixels must stay as they are until the batch has gone. */
+int obgpu_image(struct obgpu *g, const struct obgpu_source *s, const long *dst, const long *src, int op,
+    unsigned alpha, int bilinear);
+
+/* Words waiting to be drawn. */
+int obgpu_pending(const struct obgpu *g);
+/* Sends the batch and waits for it, if it draws anything; 0, or the error. */
+long obgpu_flush(struct obgpu *g);
+
+/* openamigabrowser's engine only (OpenGPULibraryAmiga.c): opens
+ * opengpu.library once and says what it does (OBGPU_CAN_), 0 when it is
+ * missing or older than stream v1.4; and sends a batch and waits for it. */
+int ob_opengpu_caps(void);
+long ob_opengpu_run(const unsigned char *stream, long words);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
