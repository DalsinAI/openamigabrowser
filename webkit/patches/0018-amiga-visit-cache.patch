+// The Amiga port's bytecode cache: a script's compiled bytecode (its
+// top-level code and the functions compiled while the page loaded) kept in
+// the disk cache's "js" drawer, named by the script's URL and the hash of
+// its text, so a revisit decodes it instead of parsing the script. The same
+// scheme as the jsc shell's --diskCachePath (jsc.cpp, ShellSourceProvider).
+
+#include "config.h"
+#include "CachedScriptSourceProvider.h"
+
+#if PLATFORM(AMIGA) && ENABLE_AMIGA_BYTECODE_CACHE
+
+#include "platform/network/amiga/AmigaDiskCache.h"
+#include <JavaScriptCore/CachedBytecode.h>
+#include <JavaScriptCore/BytecodeCacheError.h>
+#include <JavaScriptCore/CachedTypes.h>
+#include <JavaScriptCore/HeapCellInlines.h>
+#include <JavaScriptCore/UnlinkedFunctionExecutable.h>
+#include <wtf/FileHandle.h>
+#include <wtf/FileSystem.h>
+#include <wtf/HashSet.h>
+#include <wtf/HexNumber.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/SHA1.h>
+#include <wtf/Scope.h>
+#include <wtf/text/MakeString.h>
+
+namespace WebCore {
+
+// Off until decoding is fixed on the 68k: the cached bytecode is read but
+// JavaScriptCore compiles the script again (and appends a second copy), so
+// it costs time instead of saving it. setAmigaBytecodeCacheEnabled() turns
+// it on for testing.
+static bool bytecodeCacheEnabled;
+
+void setAmigaBytecodeCacheEnabled(bool enabled)
+{
+    bytecodeCacheEnabled = enabled;
+}
+
+static HashSet<const CachedScriptSourceProvider*>& liveProviders()
+{
+    static NeverDestroyed<HashSet<const CachedScriptSourceProvider*>> providers;
+    return providers;
+}
+
+void CachedScriptSourceProvider::amigaRegister()
+{
+    liveProviders().add(this);
+}
+
+void CachedScriptSourceProvider::amigaUnregister()
+{
+    liveProviders().remove(this);
+    commitCachedBytecode();
+}
+
+void commitAmigaBytecodeCaches()
+{
+    for (auto* provider : copyToVector(liveProviders()))
+        provider->commitCachedBytecode();
+}
+
+String CachedScriptSourceProvider::amigaBytecodePath() const
+{
+    auto& cache = AmigaDiskCache::singleton();
+    if (!bytecodeCacheEnabled || !cache.isEnabled() || !m_cachedScript->response().url().protocolIsInHTTPFamily())
+        return { };
+    auto directory = FileSystem::pathByAppendingComponent(cache.directory(), "js"_s);
+    SHA1 sha1;
+    auto url = m_cachedScript->response().url().string().utf8();
+    sha1.addBytes(byteCast<uint8_t>(url.span()));
+    SHA1::Digest digest;
+    sha1.computeHash(digest);
+    auto name = makeString(String::fromLatin1(SHA1::hexDigest(digest).data()).left(16), '-', hex(hash(), 8), ".jsbc"_s);
+    return FileSystem::pathByAppendingComponent(directory, name);
+}
+
+RefPtr<JSC::CachedBytecode> CachedScriptSourceProvider::cachedBytecode() const
+{
+    if (m_triedLoadingBytecode)
+        return m_cachedBytecode;
+    m_triedLoadingBytecode = true;
+    auto path = amigaBytecodePath();
+    if (path.isNull())
+        return nullptr;
+    auto handle = FileSystem::openFile(path, FileSystem::FileOpenMode::Read);
+    if (!handle)
+        return nullptr;
+    auto mapped = handle.map(FileSystem::MappedFileMode::Private);
+    if (!mapped || !mapped->size())
+        return nullptr;
+    m_cachedBytecode = JSC::CachedBytecode::create(WTF::move(*mapped));
+    amigaDiskCacheLog("bytecode-load", makeString(m_cachedBytecode->size(), ' ', m_cachedScript->response().url().string()));
+    return m_cachedBytecode;
+}
+
+void CachedScriptSourceProvider::cacheBytecode(const JSC::BytecodeCacheGenerator& generator) const
+{
+    if (amigaBytecodePath().isNull())
+        return;
+    if (!m_cachedBytecode)
+        m_cachedBytecode = JSC::CachedBytecode::create();
+    if (auto update = generator())
+        m_cachedBytecode->addGlobalUpdate(*update);
+}
+
+void CachedScriptSourceProvider::updateCache(const JSC::UnlinkedFunctionExecutable* executable, const JSC::SourceCode&, JSC::CodeSpecializationKind kind, const JSC::UnlinkedFunctionCodeBlock* codeBlock) const
+{
+    if (!m_cachedBytecode)
+        return;
+    JSC::BytecodeCacheError error;
+    RefPtr<JSC::CachedBytecode> cachedBytecode = JSC::encodeFunctionCodeBlock(executable->vm(), codeBlock, error);
+    if (cachedBytecode && !error.isValid())
+        m_cachedBytecode->addFunctionUpdate(executable, kind, *cachedBytecode);
+}
+
+void CachedScriptSourceProvider::commitCachedBytecode() const
+{
+    if (!m_cachedBytecode || !m_cachedBytecode->hasUpdates())
+        return;
+    auto clearBytecode = makeScopeExit([&] {
+        m_cachedBytecode = nullptr;
+    });
+    auto path = amigaBytecodePath();
+    if (path.isNull())
+        return;
+    FileSystem::makeAllDirectories(FileSystem::parentPath(path));
+    auto handle = FileSystem::openFile(path, FileSystem::FileOpenMode::ReadWrite);
+    if (!handle)
+        return;
+    auto fileSize = handle.size();
+    size_t cacheFileSize;
+    if (!fileSize || !WTF::convertSafely(*fileSize, cacheFileSize) || cacheFileSize != m_cachedBytecode->size())
+        return; // Someone else updated it meanwhile.
+    if (!handle.truncate(m_cachedBytecode->sizeForUpdate()))
+        return;
+    amigaDiskCacheLog("bytecode-store", makeString(m_cachedBytecode->sizeForUpdate(), ' ', m_cachedScript->response().url().string()));
+    m_cachedBytecode->commitUpdates([&](off_t offset, std::span<const uint8_t> data) {
+        if (handle.seek(offset, FileSystem::FileSeekOrigin::Beginning))
+            handle.write(data);
+    });
+}
+
+} // namespace WebCore
+
+#endif // PLATFORM(AMIGA)
