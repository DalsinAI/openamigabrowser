+// A response from the disk cache, handed over from the run loop as a
+// network load would be.
+static void serveFromDiskCache(ResourceHandle& handle, AmigaCacheEntry&& entry)
+{
+    RunLoop::mainSingleton().dispatch([protectedThis = Ref { handle }, entry = WTF::move(entry)]() mutable {
+        auto& handle = protectedThis.get();
+        auto* client = handle.client();
+        if (!client)
+            return;
+        ResourceResponse response(entry.response);
+        response.setSource(ResourceResponse::Source::DiskCache);
+        client->didReceiveResponseAsync(&handle, WTF::move(response), [protectedThis = Ref { handle }, body = WTF::move(entry.body)]() mutable {
+            auto& handle = protectedThis.get();
+            if (!handle.client())
+                return;
+            if (!body.isEmpty()) {
+                auto size = body.size();
+                handle.client()->didReceiveBuffer(&handle, SharedBuffer::create(WTF::move(body)), size);
+            }
+            if (handle.client())
+                handle.client()->didFinishLoading(&handle, NetworkLoadMetrics { });
+        });
+    });
+}
