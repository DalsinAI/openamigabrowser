+namespace WebCore {
+
+// An entry's file: "OBC1", then big-endian fields: the time it was stored
+// (milliseconds since 1970, 8 bytes), status code, HTTP version and expected
+// length (4, 4, 8), the URL and each header line as a 4-byte length and
+// UTF-8, the number of header lines before them, and the body.
+static constexpr std::array<uint8_t, 4> magic { 'O', 'B', 'C', '1' };
+
+// The 16 drawers, "0" to "f", by the name's first hex digit.
+static String drawerName(unsigned index)
+{
+    return String::fromLatin1(std::array<char, 2> { "0123456789abcdef"[index & 15], 0 }.data());
+}
+
+// Set by the program (setAmigaDiskCacheLogging): say what the cache does
+// with each request.
+static bool loggingEnabled;
+
+static bool logging()
+{
+    return loggingEnabled;
+}
+
+void setAmigaDiskCacheLogging(bool enabled)
+{
+    loggingEnabled = enabled;
+}
+
+static void log(const char* what, const URL& url)
+{
+    if (logging()) {
+        printf("OBCACHE %s %s\n", what, url.string().utf8().data());
+        fflush(stdout);
+    }
+}
+
+void amigaDiskCacheLog(const char* what, const String& detail)
+{
+    if (logging()) {
+        printf("OBCACHE %s %s\n", what, detail.utf8().data());
+        fflush(stdout);
+    }
+}
+
+AmigaDiskCache& AmigaDiskCache::singleton()
+{
+    static NeverDestroyed<AmigaDiskCache> cache;
+    return cache;
+}
+
+void setAmigaDiskCacheDirectory(const String& directory, uint64_t capacity)
+{
+    AmigaDiskCache::singleton().setDirectory(directory, capacity);
+}
+
+void AmigaDiskCache::setDirectory(const String& directory, uint64_t capacity)
+{
+    m_directory = directory;
+    m_capacity = capacity;
+    if (m_directory.isEmpty())
+        return;
+    for (unsigned i = 0; i < 16; ++i)
+        FileSystem::makeAllDirectories(FileSystem::pathByAppendingComponent(m_directory, drawerName(i)));
+    trim();
+}
+
+String AmigaDiskCache::pathForURL(const URL& url) const
+{
+    URL key = url;
+    key.removeFragmentIdentifier();
+    SHA1 sha1;
+    auto utf8 = key.string().utf8();
+    sha1.addBytes(byteCast<uint8_t>(utf8.span()));
+    SHA1::Digest digest;
+    sha1.computeHash(digest);
+    auto name = String::fromLatin1(SHA1::hexDigest(digest).data());
+    return FileSystem::pathByAppendingComponent(FileSystem::pathByAppendingComponent(m_directory, name.left(1)), name);
+}
+
+namespace {
+
+class Writer {
+public:
+    void bytes(std::span<const uint8_t> data) { m_data.append(data); }
+    void u32(uint32_t value)
+    {
+        for (int shift = 24; shift >= 0; shift -= 8)
+            m_data.append(static_cast<uint8_t>(value >> shift));
+    }
+    void u64(uint64_t value)
+    {
+        u32(static_cast<uint32_t>(value >> 32));
+        u32(static_cast<uint32_t>(value));
+    }
+    void string(const String& value)
+    {
+        auto utf8 = value.utf8();
+        u32(utf8.length());
+        bytes(byteCast<uint8_t>(utf8.span()));
+    }
+    Vector<uint8_t>& data() { return m_data; }
+
+private:
+    Vector<uint8_t> m_data;
+};
+
+class Reader {
+public:
+    explicit Reader(std::span<const uint8_t> data)
+        : m_data(data)
+    {
+    }
+    bool ok() const { return m_ok; }
+    std::span<const uint8_t> bytes(size_t length)
+    {
+        if (!m_ok || length > m_data.size() - m_position) {
+            m_ok = false;
+            return { };
+        }
+        auto result = m_data.subspan(m_position, length);
+        m_position += length;
+        return result;
+    }
+    uint32_t u32()
+    {
+        auto data = bytes(4);
+        if (!m_ok)
+            return 0;
+        return (uint32_t(data[0]) << 24) | (uint32_t(data[1]) << 16) | (uint32_t(data[2]) << 8) | data[3];
+    }
+    uint64_t u64()
+    {
+        uint64_t high = u32();
+        return (high << 32) | u32();
+    }
+    String string()
+    {
+        auto data = bytes(u32());
+        return m_ok ? String::fromUTF8(data) : String();
+    }
+    std::span<const uint8_t> rest() { return bytes(m_data.size() - m_position); }
+
+private:
+    std::span<const uint8_t> m_data;
+    size_t m_position { 0 };
+    bool m_ok { true };
+};
+
+} // namespace
+
+bool AmigaDiskCache::read(const String& path, AmigaCacheEntry& entry) const
+{
+    auto contents = FileSystem::readEntireFile(path);
+    if (!contents)
+        return false;
+    Reader reader(contents->span());
+    auto fileMagic = reader.bytes(magic.size());
+    if (!reader.ok() || !std::ranges::equal(fileMagic, std::span { magic }))
+        return false;
+    entry.storedTime = WallTime::fromRawSeconds(static_cast<double>(reader.u64()) / 1000.0);
+    entry.response.statusCode = reader.u32();
+    entry.response.httpVersion = reader.u32();
+    entry.response.expectedContentLength = static_cast<long long>(reader.u64());
+    entry.response.url = URL { reader.string() };
+    unsigned headerCount = reader.u32();
+    entry.response.headers.clear();
+    for (unsigned i = 0; i < headerCount && reader.ok(); ++i)
+        entry.response.headers.append(reader.string());
+    auto body = reader.rest();
+    if (!reader.ok() || !entry.response.url.isValid())
+        return false;
+    entry.body = Vector<uint8_t>(body);
+    return true;
+}
+
+void AmigaDiskCache::write(const String& path, const URL& url, const CurlResponse& response, std::span<const uint8_t> body, WallTime time)
+{
+    Writer writer;
+    writer.bytes(std::span { magic });
+    writer.u64(static_cast<uint64_t>(time.secondsSinceEpoch().milliseconds()));
+    writer.u32(static_cast<uint32_t>(response.statusCode));
+    writer.u32(static_cast<uint32_t>(response.httpVersion));
+    writer.u64(static_cast<uint64_t>(response.expectedContentLength));
+    writer.string(url.string());
+    // Cookies were taken when the response arrived; a cached copy must not
+    // set them again (this is a private cache, as a browser's is).
+    Vector<String> headers;
+    for (auto& header : response.headers) {
+        if (!header.startsWithIgnoringASCIICase("set-cookie:"_s))
+            headers.append(header);
+    }
+    writer.u32(headers.size());
+    for (auto& header : headers)
+        writer.string(header);
+    writer.bytes(body);
+    auto oldSize = FileSystem::fileSize(path).value_or(0);
+    if (!FileSystem::overwriteEntireFile(path, writer.data().span()))
+        log("write-failed", url);
+    else {
+        m_size += writer.data().size();
+        m_size -= std::min<uint64_t>(m_size, oldSize);
+        if (m_size > m_capacity)
+            trim();
+    }
+}
+
+static bool requestHasConditions(const ResourceRequest& request)
+{
+    return !request.httpHeaderField(HTTPHeaderName::IfNoneMatch).isEmpty()
+        || !request.httpHeaderField(HTTPHeaderName::IfModifiedSince).isEmpty()
+        || !request.httpHeaderField(HTTPHeaderName::Range).isEmpty();
+}
+
+static bool isCacheableRequest(const ResourceRequest& request)
+{
+    return request.url().protocolIsInHTTPFamily() && request.httpMethod() == "GET"_s && !request.httpBody()
+        && request.httpHeaderField(HTTPHeaderName::Authorization).isEmpty()
+        && !requestHasConditions(request)
+        && request.cachePolicy() != ResourceRequestCachePolicy::DoNotUseAnyCache;
+}
+
+AmigaCacheUse AmigaDiskCache::lookup(const ResourceRequest& request, AmigaCacheEntry& entry)
+{
+    if (!isEnabled() || !isCacheableRequest(request) || request.cachePolicy() == ResourceRequestCachePolicy::ReloadIgnoringCacheData)
+        return AmigaCacheUse::Network;
+    if (parseCacheControlDirectives(request.httpHeaderFields()).noCache && request.cachePolicy() == ResourceRequestCachePolicy::UseProtocolCachePolicy)
+        return AmigaCacheUse::Network;
+    auto path = pathForURL(request.url());
+    if (!read(path, entry)) {
+        log("miss", request.url());
+        return AmigaCacheUse::Network;
+    }
+    if (entry.response.url != request.url()) {
+        URL a = entry.response.url, b = request.url();
+        a.removeFragmentIdentifier();
+        b.removeFragmentIdentifier();
+        if (a != b)
+            return AmigaCacheUse::Network;
+    }
+
+    ResourceResponse response(entry.response);
+    bool hasValidator = !response.httpHeaderField(HTTPHeaderName::ETag).isEmpty() || !response.httpHeaderField(HTTPHeaderName::LastModified).isEmpty();
+    switch (request.cachePolicy()) {
+    case ResourceRequestCachePolicy::ReturnCacheDataElseLoad:
+    case ResourceRequestCachePolicy::ReturnCacheDataDontLoad:
+        return AmigaCacheUse::Serve;
+    case ResourceRequestCachePolicy::RefreshAnyCacheData:
+        return hasValidator ? AmigaCacheUse::Revalidate : AmigaCacheUse::Network;
+    default:
+        break;
+    }
+    auto directives = parseCacheControlDirectives(response.httpHeaderFields());
+    if (!directives.noCache) {
+        auto lifetime = computeFreshnessLifetimeForHTTPFamily(response, entry.storedTime);
+        auto age = computeCurrentAge(response, entry.storedTime);
+        if (age < lifetime) {
+            log("fresh", request.url());
+            return AmigaCacheUse::Serve;
+        }
+    }
+    log(hasValidator ? "stale-revalidate" : "stale", request.url());
+    return hasValidator ? AmigaCacheUse::Revalidate : AmigaCacheUse::Network;
+}
+
+bool AmigaDiskCache::canStore(const ResourceRequest& request, const CurlResponse& curlResponse) const
+{
+    if (!isEnabled())
+        return false;
+    if (!isCacheableRequest(request) || curlResponse.statusCode != 200) {
+        log("not-cacheable-request", request.url());
+        return false;
+    }
+    if (parseCacheControlDirectives(request.httpHeaderFields()).noStore) {
+        log("no-store-request", request.url());
+        return false;
+    }
+    CurlResponse copy = curlResponse;
+    ResourceResponse response(copy);
+    auto directives = parseCacheControlDirectives(response.httpHeaderFields());
+    const char* reason = nullptr;
+    bool hasValidator = !response.httpHeaderField(HTTPHeaderName::ETag).isEmpty() || !response.httpHeaderField(HTTPHeaderName::LastModified).isEmpty();
+    if (directives.noStore)
+        reason = "no-store";
+    else if (response.httpHeaderField(HTTPHeaderName::Vary).contains('*'))
+        reason = "vary-star";
+    else if (response.expectedContentLength() > static_cast<long long>(maximumEntrySize))
+        reason = "too-big";
+    else if (!hasValidator && computeFreshnessLifetimeForHTTPFamily(response, WallTime::now()) <= 0_s)
+        reason = "no-lifetime";
+    if (reason) {
+        log(reason, request.url());
+        return false;
+    }
+    return true;
+}
+
+void AmigaDiskCache::store(const URL& url, const CurlResponse& response, const Vector<uint8_t>& body)
+{
+    if (!isEnabled() || body.size() > maximumEntrySize)
+        return;
+    log("store", url);
+    write(pathForURL(url), url, response, body.span(), WallTime::now());
+}
+
+void AmigaDiskCache::didRevalidate(const URL& url, AmigaCacheEntry& entry, const CurlResponse& notModified)
+{
+    // The 304's headers replace the stored ones of the same name (new Date,
+    // Expires, Cache-Control, ETag), as HTTP asks.
+    for (auto& header : notModified.headers) {
+        auto colon = header.find(':');
+        if (colon == notFound)
+            continue;
+        auto name = header.left(colon + 1);
+        entry.response.headers.removeAllMatching([&](auto& stored) {
+            return stored.startsWithIgnoringASCIICase(name);
+        });
+        entry.response.headers.append(header);
+    }
+    entry.storedTime = WallTime::now();
+    if (isEnabled())
+        write(pathForURL(url), url, entry.response, entry.body.span(), entry.storedTime);
+}
+
+// Keeps the cache within its capacity: the least recently stored entries go.
+void AmigaDiskCache::trim()
+{
+    struct File {
+        String path;
+        uint64_t size;
+        WallTime time;
+    };
+    Vector<File> files;
+    uint64_t total = 0;
+    for (unsigned i = 0; i < 16; ++i) {
+        auto drawer = FileSystem::pathByAppendingComponent(m_directory, drawerName(i));
+        for (auto& name : FileSystem::listDirectory(drawer)) {
+            auto path = FileSystem::pathByAppendingComponent(drawer, name);
+            auto size = FileSystem::fileSize(path).value_or(0);
+            files.append({ path, size, FileSystem::fileModificationTime(path).value_or(WallTime { }) });
+            total += size;
+        }
+    }
+    if (total > m_capacity) {
+        std::ranges::sort(files, [](auto& a, auto& b) { return a.time < b.time; });
+        uint64_t target = m_capacity / 10 * 9;
+        for (auto& file : files) {
+            if (total <= target)
+                break;
+            if (FileSystem::deleteFile(file.path))
+                total -= file.size;
+        }
+    }
+    m_size = total;
+}
+
+} // namespace WebCore
