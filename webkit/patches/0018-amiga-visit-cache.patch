+namespace WebCore {
+
+class ResourceRequest;
+class ResourceResponse;
+
+// The Amiga port's HTTP disk cache: responses kept as files (one per URL,
+// named by the URL's SHA-1, in 16 drawers), served again while they are
+// fresh by HTTP's rules and revalidated with the server (If-None-Match,
+// If-Modified-Since) once stale. All on the main thread.
+struct AmigaCacheEntry {
+    WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(AmigaCacheEntry);
+    CurlResponse response;
+    Vector<uint8_t> body;
+    WallTime storedTime;
+};
+
+enum class AmigaCacheUse { Network, Serve, Revalidate };
+
+class AmigaDiskCache {
+public:
+    static AmigaDiskCache& singleton();
+
+    // directory empty: off. capacity in bytes.
+    void setDirectory(const String& directory, uint64_t capacity);
+    bool isEnabled() const { return !m_directory.isEmpty(); }
+    const String& directory() const { return m_directory; }
+
+    // What to do with a request, and the entry when it is not Network.
+    AmigaCacheUse lookup(const ResourceRequest&, AmigaCacheEntry&);
+
+    // Whether a response to this request may be kept.
+    bool canStore(const ResourceRequest&, const CurlResponse&) const;
+    void store(const URL&, const CurlResponse&, const Vector<uint8_t>& body);
+
+    // A 304: the stored entry is good again, with the new headers' times.
+    void didRevalidate(const URL&, AmigaCacheEntry&, const CurlResponse& notModified);
+
+    static constexpr size_t maximumEntrySize = 4 * 1024 * 1024;
+
+private:
+    String pathForURL(const URL&) const;
+    bool read(const String& path, AmigaCacheEntry&) const;
+    void write(const String& path, const URL&, const CurlResponse&, std::span<const uint8_t> body, WallTime);
+    void trim();
+
+    String m_directory;
+    uint64_t m_capacity { 0 };
+    uint64_t m_size { 0 };
+};
+
+// For the program: where the cache lives and how big it may grow.
+WEBCORE_EXPORT void setAmigaDiskCacheDirectory(const String& directory, uint64_t capacity);
+// Prints what the cache does with each request ("OBCACHE ...").
+WEBCORE_EXPORT void setAmigaDiskCacheLogging(bool);
+void amigaDiskCacheLog(const char* what, const String& detail);
+
+} // namespace WebCore
