 # Expects that CodeBlock is in t1, which is what prologue() leaves behind.
 # Must call dispatch(0) after calling this.
+# The 68k template JIT (llint/M68KTemplateJIT.cpp): a function with code
+# runs it from its op_enter, on this frame.
+macro m68kEnterCompiledCode()
+    if M68K
+        loadp CodeBlock + LowWordOffset[cfr], t1
+        loadp CodeBlock::m_m68kTemplateEntry[t1], t0
+        btpz t0, .notCompiled
+        jmp t0
+    .notCompiled:
+    end
+end
