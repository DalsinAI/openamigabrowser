+    # Value profiles feed the optimizing JITs; the 68k has none of those, so
+    # it skips them (a 64-bit multiply and store per profiled instruction).
+    if not M68K
+        getu(size, opcodeStruct, profileName, scratch)
+        mulq constexpr (-sizeof(ValueProfile)), scratch
+        storeq value, constexpr (-sizeof(UnlinkedMetadataTable::LinkingData)) + ValueProfile::m_buckets[metadataTable, scratch, 1]
+    end
 end
 
 # After calling, calling bytecode is claiming input registers are not used.
@@ -868,6 +872,22 @@ _llint_op_enter:
 
 .opEnterDispatch:
     checkTraps(macro()
+        if M68K
+            # The 68k template JIT (llint/M68KTemplateJIT.cpp): run this
+            # CodeBlock's code from the instruction after op_enter if it has
+            # any, else count towards compiling it.
+            loadp CodeBlock + LowWordOffset[cfr], t1
+            loadp CodeBlock::m_m68kTemplateMap[t1], t0
+            btpz t0, .opEnterNotCompiled
+            loadp PtrSize[t0], t0
+            jmp t0
