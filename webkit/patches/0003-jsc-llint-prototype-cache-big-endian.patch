diff --git a/Source/JavaScriptCore/bytecode/GetByIdMetadata.h b/Source/JavaScriptCore/bytecode/GetByIdMetadata.h
index d5f766808a..9ce3da54ba 100644
--- a/Source/JavaScriptCore/bytecode/GetByIdMetadata.h
+++ b/Source/JavaScriptCore/bytecode/GetByIdMetadata.h
@@ -138,13 +138,19 @@ inline void GetByIdModeMetadata::setProtoLoadMode(Structure* structure, Property
 
     // The write to cachedSlot also writes the mode, since they overlap in the struct layout. We know that
     // the mode ProtoLoad is 0 by the static assertion above.
+#if CPU(BIG_ENDIAN) && !CPU(ADDRESS64)
+    // Big-endian with 32-bit pointers: the pointer goes in the slot's first
+    // four bytes, where the LLInt's pointer-sized load reads it, and the last
+    // four bytes (padding4, mode, hitCountForLLIntCaching) stay zero.
+    protoLoadMode.cachedSlot = static_cast<uint64_t>(std::bit_cast<uintptr_t>(cachedSlot)) << 32;
+#else
     protoLoadMode.cachedSlot = static_cast<uint64_t>(std::bit_cast<uintptr_t>(cachedSlot));
+#endif
 
     ASSERT(mode == GetByIdMode::ProtoLoad);
     ASSERT(!hitCountForLLIntCaching);
     ASSERT(protoLoadMode.structureID == structure->id());
     ASSERT(protoLoadMode.cachedOffset == offset);
-    ASSERT(protoLoadMode.cachedSlot == static_cast<uint64_t>(std::bit_cast<uintptr_t>(cachedSlot)));
 }
 
 } // namespace JSC
