+++ b/Source/WebCore/inspector/InspectorInstrumentationPublic.h
@@ -32,9 +32,22 @@ namespace WebCore {
     if (!InspectorInstrumentationPublic::hasFrontends()) [[likely]] \
         return value;
 
+// The Amiga port has no Web Inspector: there are never any frontends, and
+// the instrumentation that runs without one (the console's backlog, network
+// bookkeeping) returns at once too, so no inspector code is linked.
+#if PLATFORM(AMIGA)
+#define RETURN_IF_NO_INSPECTOR(value) return value
+#else
+#define RETURN_IF_NO_INSPECTOR(value) do { } while (0)
+#endif
+
 class WEBCORE_EXPORT InspectorInstrumentationPublic {
 public:
+#if PLATFORM(AMIGA)
+    static constexpr bool hasFrontends() { return false; }
+#else
     static bool hasFrontends() { return s_frontendCounter; }
+#endif
     static std::atomic<int> s_frontendCounter;
 };
 
