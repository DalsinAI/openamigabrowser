diff --git a/Source/JavaScriptCore/PlatformAmiga.cmake b/Source/JavaScriptCore/PlatformAmiga.cmake
index a9992017ace..ced0cb6c1ed 100644
--- a/Source/JavaScriptCore/PlatformAmiga.cmake
+++ b/Source/JavaScriptCore/PlatformAmiga.cmake
@@ -4,3 +4,14 @@ include(${CMAKE_CURRENT_LIST_DIR}/PlatformJSCOnly.cmake)
 # The C-loop interpreter runs every line of JavaScript: build it for speed
 # (-O2) even when the rest is built for size.
 target_compile_options(LowLevelInterpreterLib PRIVATE -O2)
+
+# No Web Inspector: the Amiga port has no inspector frontend, local or
+# remote. Of JavaScriptCore's inspector/ folder only what WebCore's console
+# uses is built (console messages, their arguments and call stacks); the
+# agents, the injected script, the protocol's dispatchers and objects and
+# the global object's inspector controller are left out.
+list(APPEND JavaScriptCore_UNIFIED_SOURCE_EXCLUDES
+    "^inspector/agents/"
+    "^inspector/(ContentSearchUtilities|InjectedScript|InspectorAgentRegistry|InspectorBackendDispatcher|InspectorFrontendDispatchers|InspectorFrontendRouter|InspectorProtocolObjects|InspectorTarget)"
+    "^inspector/(JSGlobalObjectConsoleClient|JSGlobalObjectDebugger|JSGlobalObjectInspectorController|JSInjectedScriptHost|JSJavaScriptCallFrame|JavaScriptCallFrame|PerGlobalObjectWrapperWorld|ScriptFunctionCall)"
+)
