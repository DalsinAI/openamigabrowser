+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS
+ * IN THE SOFTWARE.
+ */
+
+#include "config.h"
+#include "M68KTemplateJIT.h"
+
+#if CPU(M68K) && ENABLE(C_LOOP)
+
+#include "CodeBlock.h"
+#include "M68KTemplateStitch.h"
+#include "Options.h"
+#include <wtf/DataLog.h>
+#include <wtf/FastMalloc.h>
+
+#if OS(AMIGA)
+#include <proto/exec.h>
+#else
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+// The templates, generated beside LLIntAssembly.h. Their code lives in
+// LowLevelInterpreter.cpp's asm, next to the interpreter they jump into.
+#define M68K_TEMPLATE(name) \
+    extern "C" const struct m68k_tpl jsc_m68k_tpl_##name __asm__("_jsc_m68k_tpl_" #name); \
+    extern "C" const struct m68k_tpl jsc_m68k_tpl_##name##_wide16 __asm__("_jsc_m68k_tpl_" #name "_wide16"); \
+    extern "C" const struct m68k_tpl jsc_m68k_tpl_##name##_wide32 __asm__("_jsc_m68k_tpl_" #name "_wide32");
+#include "LLIntTemplateIndex.h"
+#undef M68K_TEMPLATE
+
+namespace JSC {
+namespace M68KTemplateJIT {
+
+namespace {
+
+struct TemplateSet {
+    const m68k_tpl* narrow;
+    const m68k_tpl* wide16;
+    const m68k_tpl* wide32;
+};
+
+struct Templates {
+    TemplateSet byOpcode[NUMBER_OF_BYTECODE_IDS] { };
+
+    Templates()
+    {
+#define M68K_TEMPLATE(name) byOpcode[name] = { &jsc_m68k_tpl_##name, &jsc_m68k_tpl_##name##_wide16, &jsc_m68k_tpl_##name##_wide32 };
+#include "LLIntTemplateIndex.h"
+#undef M68K_TEMPLATE
+    }
+};
+
+const Templates& templates()
+{
+    static const Templates* instance = new Templates;
+    return *instance;
+}
+
+const m68k_tpl* templateFor(const JSInstruction* instruction)
+{
+    auto opcode = instruction->opcodeID();
+    if (static_cast<unsigned>(opcode) >= NUMBER_OF_BYTECODE_IDS)
+        return nullptr;
+    const TemplateSet& set = templates().byOpcode[opcode];
+    switch (instruction->width()) {
+    case OpcodeSize::Narrow: return set.narrow;
+    case OpcodeSize::Wide16: return set.wide16;
+    case OpcodeSize::Wide32: return set.wide32;
+    }
+    return nullptr;
+}
+
+void makeExecutable(void* code, size_t size)
+{
+#if OS(AMIGA)
+    UNUSED_PARAM(code);
+    UNUSED_PARAM(size);
+#else
+    // Test hosts (m68k Linux under qemu) enforce execute permission; the
+    // Amiga does not.
+    uintptr_t pageSize = sysconf(_SC_PAGESIZE);
+    uintptr_t begin = reinterpret_cast<uintptr_t>(code) & ~(pageSize - 1);
+    uintptr_t end = (reinterpret_cast<uintptr_t>(code) + size + pageSize - 1) & ~(pageSize - 1);
+    mprotect(reinterpret_cast<void*>(begin), end - begin, PROT_READ | PROT_WRITE | PROT_EXEC);
+#endif
+}
+
+void flushInstructionCache(void* code, size_t size)
+{
+#if OS(AMIGA)
+    CacheClearE(code, size, CACRF_ClearI | CACRF_ClearD);
+#else
+    __builtin___clear_cache(static_cast<char*>(code), static_cast<char*>(code) + size);
+#endif
+}
+
+bool compile(CodeBlock* codeBlock)
+{
+    const auto& instructions = codeBlock->instructions();
+    unsigned bytecodeSize = instructions.size();
+    if (bytecodeSize > Options::m68kTemplateJITMaximumBytecodeSize())
+        return false;
+
+    size_t codeSize = 0;
+    for (const auto& instruction : instructions) {
+        const m68k_tpl* tpl = templateFor(instruction.ptr());
+        if (!tpl)
+            return false;
+        codeSize += tpl->length;
+    }
+
+    uint8_t* code = nullptr;
+    void** map = nullptr;
+    if (!tryFastMalloc(codeSize).getValue(code) || !tryFastZeroedMalloc(bytecodeSize * sizeof(void*)).getValue(map)) {
+        fastFree(code);
+        fastFree(map);
+        return false;
+    }
+
+    // One copy per instruction, in bytecode order, so each falls through into
+    // the next when PC moves on by one instruction.
+    size_t offset = 0;
+    for (const auto& instruction : instructions) {
+        const JSInstruction* ptr = instruction.ptr();
+        map[instruction.offset()] = code + offset;
+        offset += m68k_tpl_stitch(code + offset, templateFor(ptr), reinterpret_cast<const uint8_t*>(ptr), instruction.offset(), ptr->size());
+    }
+    RELEASE_ASSERT(offset == codeSize);
+    makeExecutable(code, codeSize);
+    flushInstructionCache(code, codeSize);
+
+    codeBlock->m_m68kTemplateCode = code;
+    codeBlock->m_m68kTemplateMap = map;
+    codeBlock->m_m68kTemplateMapSize = bytecodeSize;
+    dataLogLnIf(Options::verboseOSR(), *codeBlock, ": 68k template JIT, ", bytecodeSize, " bytecode bytes -> ", codeSize, " code bytes");
+    return true;
+}
+
+} // anonymous namespace
+
+void* entryFor(CodeBlock* codeBlock, const JSInstruction* pc)
+{
+    if (!Options::useM68KTemplateJIT())
+        return nullptr;
+    if (!codeBlock->m_m68kTemplateMap) {
+        if (codeBlock->m_m68kTemplateFailed || !compile(codeBlock)) {
+            codeBlock->m_m68kTemplateFailed = true;
+            return nullptr;
+        }
+    }
+    unsigned bytecodeOffset = codeBlock->bytecodeOffset(pc);
+    return codeBlock->m_m68kTemplateMap[bytecodeOffset];
+}
+
+void release(CodeBlock* codeBlock)
+{
+    fastFree(codeBlock->m_m68kTemplateCode);
+    fastFree(codeBlock->m_m68kTemplateMap);
+    codeBlock->m_m68kTemplateCode = nullptr;
+    codeBlock->m_m68kTemplateMap = nullptr;
+    codeBlock->m_m68kTemplateMapSize = 0;
+}
+
+} // namespace M68KTemplateJIT
+} // namespace JSC
+
+#endif // CPU(M68K) && ENABLE(C_LOOP)
