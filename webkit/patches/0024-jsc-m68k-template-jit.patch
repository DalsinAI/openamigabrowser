+#include "M68KTemplateJIT.h"
 #include <wtf/NeverDestroyed.h>
 #include <wtf/StringPrintStream.h>
 
@@ -513,6 +514,12 @@ LLINT_SLOW_PATH_DECL(loop_osr)
     ASSERT(jumpTarget);
     
     LLINT_RETURN_TWO(jumpTarget, callFrame->topOfFrame());
+#elif CPU(M68K) && ENABLE(C_LOOP)
+    // The 68k template JIT: the interpreter jumps to the returned code, on
+    // the same frame, at this loop hint.
+    void* target = M68KTemplateJIT::entryFor(codeBlock, pc);
+    codeBlock->dontJITAnytimeSoon();
+    LLINT_RETURN_TWO(target, nullptr);
 #else // ENABLE(JIT)
     UNUSED_PARAM(pc);
     codeBlock->dontJITAnytimeSoon();
