 .../JavaScriptCore/llint/LLIntSlowPaths.cpp   |   7 +
 .../llint/LowLevelInterpreter.cpp             |   6 +
 .../llint/LowLevelInterpreter64.asm           |  26 ++
 .../JavaScriptCore/llint/M68KTemplateJIT.cpp  | 186 ++++++++++
