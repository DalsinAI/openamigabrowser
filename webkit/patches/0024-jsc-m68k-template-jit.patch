diff --git a/Source/JavaScriptCore/llint/LowLevelInterpreter64.asm b/Source/JavaScriptCore/llint/LowLevelInterpreter64.asm
index dcbe958183b..059ff5bacb5 100644
--- a/Source/JavaScriptCore/llint/LowLevelInterpreter64.asm
+++ b/Source/JavaScriptCore/llint/LowLevelInterpreter64.asm
@@ -506,6 +506,13 @@ else
                 move PC, a1
                 cCall2(_llint_loop_osr)
                 loadPC()
+                if M68K
+                    # The 68k template JIT (llint/M68KTemplateJIT.cpp): carry
+                    # on in this CodeBlock's code, on the same frame.
+                    btpz r0, .stayInInterpreter
+                    jmp r0
+                .stayInInterpreter:
+                end
             end)
     end
 end
@@ -3844,3 +3851,22 @@ op(loop_osr_entry_gate, macro ()
         crash() # Should never reach here.
     end
 end)
+
+if M68K
+# The 68k template JIT's way back (llint/M68KTemplateJIT.cpp): its code
+# jumps here when PC did not move on to the next instruction (a jump, a slow
+# path that changed PC, an exception). Carry on in this CodeBlock's code at
+# PC if it has any there, else in the interpreter.
+global _jsc_m68k_tjit_redispatch
+_jsc_m68k_tjit_redispatch:
+    loadp CodeBlock + LowWordOffset[cfr], t1
+    loadp CodeBlock::m_m68kTemplateMap[t1], t0
+    btpz t0, .tjitInterpret
+    loadi CodeBlock::m_m68kTemplateMapSize[t1], t1
+    bpaeq PC, t1, .tjitInterpret
+    loadp [t0, PC, PtrSize], t0
+    btpz t0, .tjitInterpret
+    jmp t0
+.tjitInterpret:
+    nextInstruction()
+end
diff --git a/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp b/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp
new file mode 100644
index 00000000000..ac5ee216887
--- /dev/null
+++ b/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp
@@ -0,0 +1,186 @@
+/*
+ * Copyright (c) 2026 AmigaChrome Team
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy
+ * of this software and associated documentation files (the "Software"), to
