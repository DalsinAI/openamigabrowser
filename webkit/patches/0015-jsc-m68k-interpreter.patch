+# IN THE SOFTWARE.
+
+require "config"
+require "ast"
+require "opt"
+
+# The Motorola 68020-68060 back end (AmigaOS, GNU as, Motorola syntax).
+#
+# It runs the C loop's version of the interpreter (the C_LOOP setting stays
+# on, so JavaScriptCore keeps its C-interpreter plumbing: its own JavaScript
+# stack, slow paths called as plain C functions, no assembler), but as 68k
+# code instead of C.
+#
+# The interpreter is written for 64-bit registers; the 68k has eight 32-bit
+# data registers and seven address registers. So:
+#
+# - cfr lives in a5; it only ever holds a pointer.
+# - Every other interpreter register (t0-t12, sp, lr, csr0-csr10, ...) is a
+#   64-bit slot in a register file in memory, _jsc_m68k_vrf, big-endian: the
+#   high word at +0, the low word at +4. 32-bit and pointer operations use the
+#   low word and clear the high word when they write, as 32-bit operations do
+#   on 64-bit machines. sp is the C loop's JavaScript stack pointer, not a7;
+#   push and pop move pointer-sized slots on it, as the C loop does.
+# - ft0-ft5 are fp0-fp5 (fp7 is scratch). Double arithmetic uses the 68040's
+#   fdadd/fdsub/fdmul/fddiv/fdsqrt, which round to double whatever the FPCR
+#   says.
+# - d0-d7, a0, a1 are scratch inside each instruction. a2-a4 and a6 are not
+#   used, so C functions called from here keep them, as the ABI asks.
+#
+# One register file serves the whole program: JavaScript runs on one thread
+# here. CLoop::execute (LowLevelInterpreter.cpp) saves it on the way in and
+# restores it on the way out, so a nested entry from C (C -> JavaScript -> C
+# -> JavaScript) leaves the outer one's registers as they were, like the C
+# loop's local variables.
+
+M68K_VRF = "_jsc_m68k_vrf"
+
+M68K_GPR_SLOTS = [
+    "t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8", "t9", "t10", "t11", "t12",
+    "sp", "lr", "pc", "zr",
+    "csr0", "csr1", "csr2", "csr3", "csr4", "csr5", "csr6", "csr7", "csr8", "csr9", "csr10",
+]
+
+M68K_VRF_SIZE = M68K_GPR_SLOTS.size * 8
+M68K_VRF_SP = "#{M68K_VRF}+#{M68K_GPR_SLOTS.index("sp") * 8 + 4}"
+M68K_VRF_LR = "#{M68K_VRF}+#{M68K_GPR_SLOTS.index("lr") * 8 + 4}"
+M68K_VRF_LR_HI = "#{M68K_VRF}+#{M68K_GPR_SLOTS.index("lr") * 8}"
+
+# ft0-ft5 are fp0-fp5; fp7 is the back end's own scratch.
+M68K_FP_SCRATCH = "fp7"
+
+def m68kHex(value)
+    "0x%x" % (value & 0xffffffff)
+end
+
+$m68kLabelCounter = 0
+
+def m68kNewLabel
+    $m68kLabelCounter += 1
+    "Lm68k#{$m68kLabelCounter}"
+end
+
+class RegisterID
+    def m68kPinned
+        name == "cfr" ? "a5" : nil
+    end
+
+    def m68kSlot
+        index = M68K_GPR_SLOTS.index(name)
+        raise "Bad register #{name} for M68K at #{codeOriginString}" unless index
+        index * 8
+    end
+
+    def m68kHi
+        raise "No high word for #{name}" if m68kPinned
+        "#{M68K_VRF}+#{m68kSlot}"
+    end
+
+    def m68kLo
+        return m68kPinned if m68kPinned
+        "#{M68K_VRF}+#{m68kSlot + 4}"
+    end
+end
+
+class FPRegisterID
+    def m68kOperand
+        case name
+        when "ft0", "fa0", "fr"
+            "fp0"
+        when "ft1", "fa1"
+            "fp1"
+        when "ft2", "fa2"
+            "fp2"
+        when "ft3", "fa3"
+            "fp3"
+        when "ft4"
+            "fp4"
+        when "ft5"
+            "fp5"
+        else
+            raise "Bad register #{name} for M68K at #{codeOriginString}"
+        end
+    end
+end
+
+class Immediate
+    def m68kLo
+        "##{m68kHex(value)}"
+    end
+
+    def m68kHi
+        "##{m68kHex(value >> 32)}"
+    end
+end
+
+class LabelReference
+    def m68kSymbol
+        asmLabel
+    end
+end
+
+class LocalLabelReference
+    def m68kSymbol
+        asmLabel
+    end
+end
+
+# The effective address of a memory operand, extra bytes on. Loads the base
+# (and index) into areg (and ireg) first when they are not already in
+# hardware registers.
+def m68kAddress(operand, extra = 0, areg = "a0", ireg = "d7")
+    case operand
+    when Address
+        base = operand.base
+        offset = operand.offset.value + extra
+        if base.m68kPinned
+            "#{offset}(#{base.m68kPinned})"
+        else
+            $asm.puts "move.l #{base.m68kLo},#{areg}"
+            "#{offset}(#{areg})"
+        end
+    when BaseIndex
+        base = operand.base
+        offset = operand.offset.value + extra
+        baseRegister = base.m68kPinned
+        unless baseRegister
+            $asm.puts "move.l #{base.m68kLo},#{areg}"
+            baseRegister = areg
+        end
+        $asm.puts "move.l #{operand.index.m68kLo},#{ireg}"
+        "(#{offset},#{baseRegister},#{ireg}.l*#{operand.scaleValue})"
+    when AbsoluteAddress
+        "#{m68kHex(operand.address.value + extra)}"
+    else
+        raise "Not an address: #{operand.inspect} at #{operand.codeOriginString}"
+    end
+end
+
+# Both words of a 64-bit memory operand, computing the base only once.
+def m68kAddressPair(operand, areg = "a0", ireg = "d7")
+    hi = m68kAddress(operand, 0, areg, ireg)
+    lo = case operand
+         when Address
+             hi.sub(/\A(-?\d+)/) { ($1.to_i + 4).to_s }
+         when BaseIndex
+             hi.sub(/\A\((-?\d+),/) { "(#{$1.to_i + 4}," }
+         when AbsoluteAddress
+             m68kHex(operand.address.value + 4)
+         end
+    [hi, lo]
+end
+
+# A 32-bit source operand as a string, emitting a load when it lives in
+# memory behind an address.
+def m68kSource32(operand, scratch = "d1")
+    case operand
+    when RegisterID, Immediate
+        operand.m68kLo
+    when Address, BaseIndex, AbsoluteAddress
+        $asm.puts "move.l #{m68kAddress(operand, 0, "a1", "d6")},#{scratch}"
+        scratch
+    when LabelReference, LocalLabelReference
+        "##{operand.m68kSymbol}"
+    else
+        raise "Bad 32-bit operand #{operand.inspect}"
+    end
+end
+
+# Loads a 64-bit operand into hi:lo data registers.
+def m68kLoad64(operand, hi, lo)
+    case operand
+    when RegisterID
+        if operand.m68kPinned
+            $asm.puts "move.l #{operand.m68kPinned},#{lo}"
+            $asm.puts "moveq #0,#{hi}"
+        else
+            $asm.puts "move.l #{operand.m68kHi},#{hi}"
+            $asm.puts "move.l #{operand.m68kLo},#{lo}"
+        end
+    when Immediate
+        $asm.puts "move.l #{operand.m68kHi},#{hi}"
+        $asm.puts "move.l #{operand.m68kLo},#{lo}"
+    when LabelReference, LocalLabelReference
+        $asm.puts "move.l ##{operand.m68kSymbol},#{lo}"
+        $asm.puts "moveq #0,#{hi}"
+    when Address, BaseIndex, AbsoluteAddress
+        hiAddress, loAddress = m68kAddressPair(operand, "a1", "d6")
+        $asm.puts "move.l #{hiAddress},#{hi}"
+        $asm.puts "move.l #{loAddress},#{lo}"
+    else
+        raise "Bad 64-bit operand #{operand.class} at #{operand.codeOriginString}"
+    end
+end
+
+# Stores hi:lo into a 64-bit destination register.
+def m68kStore64(hi, lo, operand)
+    unless operand.is_a? RegisterID
+        hiAddress, loAddress = m68kAddressPair(operand)
+        $asm.puts "move.l #{hi},#{hiAddress}"
+        $asm.puts "move.l #{lo},#{loAddress}"
+        return
+    end
+    if operand.m68kPinned
+        $asm.puts "move.l #{lo},#{operand.m68kPinned}"
+    else
+        $asm.puts "move.l #{hi},#{operand.m68kHi}"
+        $asm.puts "move.l #{lo},#{operand.m68kLo}"
+    end
+end
+
+# Stores a 32-bit result, zero-extended, into a destination register.
+def m68kStore32(value, operand)
+    unless operand.is_a? RegisterID
+        $asm.puts "move.l #{value},#{m68kAddress(operand)}"
+        return
+    end
+    if operand.m68kPinned
+        $asm.puts "move.l #{value},#{operand.m68kPinned}"
+    else
+        $asm.puts "move.l #{value},#{operand.m68kLo}"
+        $asm.puts "clr.l #{operand.m68kHi}"
+    end
+end
+
+def m68kStore32Signed(value, operand)
+    unless operand.is_a? RegisterID
+        $asm.puts "move.l #{value},#{m68kAddress(operand)}"
+        return
+    end
+    if operand.m68kPinned
+        $asm.puts "move.l #{value},#{operand.m68kPinned}"
+    else
+        $asm.puts "move.l #{value},#{operand.m68kLo}"
+        $asm.puts "smi d5"
+        $asm.puts "extb.l d5"
+        $asm.puts "move.l d5,#{operand.m68kHi}"
+    end
+end
+
+def m68kJcc(condition)
+    {
+        "eq" => "jeq", "neq" => "jne",
+        "a" => "jhi", "aeq" => "jcc", "b" => "jcs", "beq" => "jls",
+        "gt" => "jgt", "gteq" => "jge", "lt" => "jlt", "lteq" => "jle",
+    }[condition] or raise "Bad condition #{condition}"
+end
+
+def m68kScc(condition)
+    {
+        "eq" => "seq", "neq" => "sne",
+        "a" => "shi", "aeq" => "scc", "b" => "scs", "beq" => "sls",
+        "gt" => "sgt", "gteq" => "sge", "lt" => "slt", "lteq" => "sle",
+    }[condition] or raise "Bad condition #{condition}"
+end
+
+class Instruction
+    def m68kTarget(operand)
+        case operand
+        when LabelReference, LocalLabelReference
+            operand.m68kSymbol
+        else
+            raise "Bad branch target #{operand.inspect} at #{codeOriginString}"
+        end
+    end
+
+    # dst = a op b (three operands) or dst = dst op src (two).
+    def m68kBinary32(opcode, signExtendResult = false)
+        if operands.size == 3
+            a, b, dst = operands
+        else
+            a, b, dst = operands[1], operands[0], operands[1]
+        end
+        $asm.puts "move.l #{m68kSource32(a, "d0")},d0"
+        $asm.puts "#{opcode} #{m68kSource32(b, "d1")},d0"
+        signExtendResult ? m68kStore32Signed("d0", dst) : m68kStore32("d0", dst)
+    end
+
+    def m68kLogical64(opcode)
+        if operands.size == 3
+            a, b, dst = operands
+        else
+            a, b, dst = operands[1], operands[0], operands[1]
+        end
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        $asm.puts "#{opcode} d2,d0"
+        $asm.puts "#{opcode} d3,d1"
+        m68kStore64("d0", "d1", dst)
+    end
+
+    def m68kAdd64
+        if operands.size == 3
+            a, b, dst = operands
+        else
+            a, b, dst = operands[1], operands[0], operands[1]
+        end
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        $asm.puts "add.l d3,d1"
+        $asm.puts "addx.l d2,d0"
+        m68kStore64("d0", "d1", dst)
+    end
+
+    def m68kSub64
+        if operands.size == 3
+            a, b, dst = operands
+        else
+            a, b, dst = operands[1], operands[0], operands[1]
+        end
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        $asm.puts "sub.l d3,d1"
+        $asm.puts "subx.l d2,d0"
+        m68kStore64("d0", "d1", dst)
+    end
+
+    # 64 x 64 -> low 64 bits: lo*lo (full) + (hi*lo + lo*hi) << 32.
+    def m68kMul64
+        if operands.size == 3
+            a, b, dst = operands
+        else
+            a, b, dst = operands[1], operands[0], operands[1]
+        end
+        if b.is_a? Immediate and a.is_a? RegisterID
+            a, b = b, a
+        end
+        if a.is_a? Immediate and a.value != 0 and isPowerOfTwo(a.value.abs) and a.value.abs < (1 << 31)
+            shift = Math.log2(a.value.abs).to_i
+            m68kLoad64(b, "d0", "d1")
+            m68kShiftLeft64Constant(shift, "d0", "d1")
+            if a.value < 0
+                $asm.puts "neg.l d1"
+                $asm.puts "negx.l d0"
+            end
+            m68kStore64("d0", "d1", dst)
+            return
+        end
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        $asm.puts "move.l d0,d4"
+        $asm.puts "muls.l d3,d4"          # a.hi * b.lo, low word
+        $asm.puts "move.l d2,d5"
+        $asm.puts "muls.l d1,d5"          # b.hi * a.lo, low word
+        $asm.puts "add.l d5,d4"
+        $asm.puts "mulu.l d3,d0:d1"       # a.lo * b.lo, 64 bits
+        $asm.puts "add.l d4,d0"
+        m68kStore64("d0", "d1", dst)
+    end
+
+    def m68kShiftLeft64Constant(shift, hi, lo)
+        shift &= 63
+        return if shift == 0
+        if shift >= 32
+            $asm.puts "move.l #{lo},#{hi}"
+            m68kShift32Constant("lsl.l", shift - 32, hi)
+            $asm.puts "moveq #0,#{lo}"
+        else
+            $asm.puts "move.l #{lo},d4"
+            m68kShift32Constant("lsl.l", shift, hi)
+            m68kShift32Constant("lsr.l", 32 - shift, "d4")
+            $asm.puts "or.l d4,#{hi}"
+            m68kShift32Constant("lsl.l", shift, lo)
+        end
+    end
+
+    def m68kShift32Constant(opcode, shift, register)
+        while shift > 0
+            step = shift > 8 ? 8 : shift
+            $asm.puts "#{opcode} ##{step},#{register}"
+            shift -= step
+        end
+    end
+
+    # 32-bit shifts and rotates; the count is taken mod 32.
+    def m68kShift32(opcode)
+        if operands.size == 3
+            value, amount, dst = operands
+        else
+            value, amount, dst = operands[1], operands[0], operands[1]
+        end
+        $asm.puts "move.l #{m68kSource32(value, "d0")},d0"
+        if amount.is_a? Immediate
+            m68kShift32Constant(opcode, amount.value & 31, "d0")
+        else
+            $asm.puts "move.l #{m68kSource32(amount, "d1")},d1"
+            $asm.puts "and.l #31,d1"
+            $asm.puts "#{opcode} d1,d0"
+        end
+        m68kStore32("d0", dst)
+    end
+
+    # 64-bit shifts: kind is :left, :right (arithmetic) or :uright.
+    def m68kShift64(kind)
+        if operands.size == 3
+            value, amount, dst = operands
+        else
+            value, amount, dst = operands[1], operands[0], operands[1]
+        end
+        m68kLoad64(value, "d0", "d1")
+        if amount.is_a? Immediate
+            shift = amount.value & 63
+            case kind
+            when :left
+                m68kShiftLeft64Constant(shift, "d0", "d1")
+            when :right, :uright
+                hiShift = kind == :right ? "asr.l" : "lsr.l"
+                if shift >= 32
+                    $asm.puts "move.l d0,d1"
+                    m68kShift32Constant(hiShift, shift - 32, "d1")
+                    if kind == :right
+                        $asm.puts "tst.l d0"
+                        $asm.puts "smi d0"
+                        $asm.puts "extb.l d0"
+                    else
+                        $asm.puts "moveq #0,d0"
+                    end
+                elsif shift > 0
+                    $asm.puts "move.l d0,d4"
+                    m68kShift32Constant("lsr.l", shift, "d1")
+                    m68kShift32Constant("lsl.l", 32 - shift, "d4")
+                    $asm.puts "or.l d4,d1"
+                    m68kShift32Constant(hiShift, shift, "d0")
+                end
+            end
+            m68kStore64("d0", "d1", dst)
+            return
+        end
+        done = m68kNewLabel
+        big = m68kNewLabel
+        $asm.puts "move.l #{m68kSource32(amount, "d2")},d2"
+        $asm.puts "and.l #63,d2"
+        $asm.puts "jeq #{done}"
+        $asm.puts "cmp.l #32,d2"
+        $asm.puts "jge #{big}"
+        $asm.puts "moveq #32,d3"
+        $asm.puts "sub.l d2,d3"
+        case kind
+        when :left
+            $asm.puts "move.l d1,d4"
+            $asm.puts "lsr.l d3,d4"
+            $asm.puts "lsl.l d2,d0"
+            $asm.puts "or.l d4,d0"
+            $asm.puts "lsl.l d2,d1"
+        else
+            $asm.puts "move.l d0,d4"
+            $asm.puts "lsl.l d3,d4"
+            $asm.puts "lsr.l d2,d1"
+            $asm.puts "or.l d4,d1"
+            $asm.puts "#{kind == :right ? "asr.l" : "lsr.l"} d2,d0"
+        end
+        $asm.puts "jra #{done}"
+        $asm.puts "#{big}:"
+        $asm.puts "sub.l #32,d2"
+        case kind
+        when :left
+            $asm.puts "move.l d1,d0"
+            $asm.puts "lsl.l d2,d0"
+            $asm.puts "moveq #0,d1"
+        when :right
+            $asm.puts "move.l d0,d1"
+            $asm.puts "asr.l d2,d1"
+            $asm.puts "tst.l d0"
+            $asm.puts "smi d0"
+            $asm.puts "extb.l d0"
+        when :uright
+            $asm.puts "move.l d0,d1"
+            $asm.puts "lsr.l d2,d1"
+            $asm.puts "moveq #0,d0"
+        end
+        $asm.puts "#{done}:"
+        m68kStore64("d0", "d1", dst)
+    end
+
+    # 64-bit rotates through two shifts.
+    def m68kRotate64(left)
+        if operands.size == 3
+            value, amount, dst = operands
+        else
+            value, amount, dst = operands[1], operands[0], operands[1]
+        end
+        raise "Variable 64-bit rotate not supported at #{codeOriginString}" unless amount.is_a? Immediate
+        shift = amount.value & 63
+        shift = (64 - shift) & 63 unless left
+        m68kLoad64(value, "d0", "d1")
+        if shift >= 32
+            $asm.puts "exg d0,d1"
+            shift -= 32
+        end
+        if shift > 0
+            $asm.puts "move.l d0,d2"
+            $asm.puts "move.l d1,d3"
+            m68kShift32Constant("lsl.l", shift, "d0")
+            m68kShift32Constant("lsr.l", 32 - shift, "d3")
+            $asm.puts "or.l d3,d0"
+            m68kShift32Constant("lsl.l", shift, "d1")
+            m68kShift32Constant("lsr.l", 32 - shift, "d2")
+            $asm.puts "or.l d2,d1"
+        end
+        m68kStore64("d0", "d1", dst)
+    end
+
+    # Loads that widen into the destination register.
+    def m68kLoad(size, signed)
+        source, dst = operands
+        address = m68kAddress(source)
+        case size
+        when 1
+            if signed
+                $asm.puts "move.b #{address},d0"
+                $asm.puts "extb.l d0"
+            else
+                $asm.puts "moveq #0,d0"
+                $asm.puts "move.b #{address},d0"
+            end
+        when 2
+            if signed
+                $asm.puts "move.w #{address},d0"
+                $asm.puts "ext.l d0"
+            else
+                $asm.puts "moveq #0,d0"
+                $asm.puts "move.w #{address},d0"
+            end
+        when 4
+            $asm.puts "move.l #{address},d0"
+        end
+        signed == :quad ? m68kStore32Signed("d0", dst) : m68kStore32("d0", dst)
+    end
+
+    def m68kStore(size)
+        value, destination = operands
+        suffix = { 1 => "b", 2 => "w", 4 => "l" }[size]
+        source = case value
+                 when Immediate
+                     "##{m68kHex(value.value)}"
+                 when RegisterID
+                     if value.m68kPinned
+                         value.m68kPinned
+                     else
+                         $asm.puts "move.l #{value.m68kLo},d0"
+                         "d0"
+                     end
+                 else
+                     raise "Bad store value #{value.inspect} at #{codeOriginString}"
+                 end
+        $asm.puts "move.#{suffix} #{source},#{m68kAddress(destination)}"
+    end
+
+    # 32-bit compare of a against b: sets the flags for a - b.
+    def m68kCompare32(a, b, size = "l")
+        if size == "l"
+            $asm.puts "move.l #{m68kSource32(a, "d0")},d0"
+            $asm.puts "cmp.l #{m68kSource32(b, "d1")},d0"
+        else
+            m68kByteOperand(a, "d0")
+            m68kByteOperand(b, "d1")
+            $asm.puts "cmp.b d1,d0"
+        end
+    end
+
+    def m68kByteOperand(operand, register)
+        case operand
+        when Immediate
+            $asm.puts "move.b ##{operand.value & 0xff},#{register}"
+        when RegisterID
+            if operand.m68kPinned
+                $asm.puts "move.l #{operand.m68kPinned},#{register}"
+            else
+                $asm.puts "move.b #{M68K_VRF}+#{operand.m68kSlot + 7},#{register}"
+            end
+        else
+            $asm.puts "move.b #{m68kAddress(operand, 0, "a1", "d6")},#{register}"
+        end
+    end
+
+    # 64-bit compare and branch to target when a <condition> b holds.
+    def m68kBranch64(condition, a, b, target)
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        skip = m68kNewLabel
+        case condition
+        when "eq"
+            $asm.puts "cmp.l d2,d0"
+            $asm.puts "jne #{skip}"
+            $asm.puts "cmp.l d3,d1"
+            $asm.puts "jeq #{target}"
+        when "neq"
+            $asm.puts "cmp.l d2,d0"
+            $asm.puts "jne #{target}"
+            $asm.puts "cmp.l d3,d1"
+            $asm.puts "jne #{target}"
+        else
+            strict = { "a" => "jhi", "aeq" => "jhi", "b" => "jcs", "beq" => "jcs",
+                       "gt" => "jgt", "gteq" => "jgt", "lt" => "jlt", "lteq" => "jlt" }[condition]
+            opposite = { "a" => "jcs", "aeq" => "jcs", "b" => "jhi", "beq" => "jhi",
+                         "gt" => "jlt", "gteq" => "jlt", "lt" => "jgt", "lteq" => "jgt" }[condition]
+            low = { "a" => "jhi", "aeq" => "jcc", "b" => "jcs", "beq" => "jls",
+                    "gt" => "jhi", "gteq" => "jcc", "lt" => "jcs", "lteq" => "jls" }[condition]
+            $asm.puts "cmp.l d2,d0"
+            $asm.puts "#{strict} #{target}"
+            $asm.puts "#{opposite} #{skip}"
+            $asm.puts "cmp.l d3,d1"
+            $asm.puts "#{low} #{target}"
+        end
+        $asm.puts "#{skip}:"
+    end
+
+    def m68kBranch(kind, condition)
+        a, b, target = operands
+        target = m68kTarget(target)
+        case kind
+        when :int, :ptr
+            m68kCompare32(a, b)
+            $asm.puts "#{m68kJcc(condition)} #{target}"
+        when :byte
+            m68kCompare32(a, b, "b")
+            $asm.puts "#{m68kJcc(condition)} #{target}"
+        when :quad
+            m68kBranch64(condition, a, b, target)
+        end
+    end
+
+    def m68kCompareSet(kind, condition)
+        a, b, dst = operands
+        case kind
+        when :int, :ptr
+            m68kCompare32(a, b)
+            $asm.puts "#{m68kScc(condition)} d0"
+        when :byte
+            m68kCompare32(a, b, "b")
+            $asm.puts "#{m68kScc(condition)} d0"
+        when :quad
+            yes = m68kNewLabel
+            done = m68kNewLabel
+            m68kBranch64(condition, a, b, yes)
+            $asm.puts "moveq #0,d0"
+            $asm.puts "jra #{done}"
+            $asm.puts "#{yes}:"
+            $asm.puts "moveq #1,d0"
+            $asm.puts "#{done}:"
+            m68kStore32("d0", dst)
+            return
+        end
+        $asm.puts "and.l #1,d0"
+        m68kStore32("d0", dst)
+    end
+
+    # Sets the flags from value & mask (mask defaults to all ones).
+    def m68kTest(kind, value, mask)
+        case kind
+        when :byte
+            m68kByteOperand(value, "d0")
+            if mask
+                m68kByteOperand(mask, "d1")
+                $asm.puts "and.b d1,d0"
+            else
+                $asm.puts "tst.b d0"
+            end
+        when :int, :ptr
+            $asm.puts "move.l #{m68kSource32(value, "d0")},d0"
+            if mask
+                $asm.puts "and.l #{m68kSource32(mask, "d1")},d0"
+            else
+                $asm.puts "tst.l d0"
+            end
+        when :quad
+            m68kLoad64(value, "d0", "d1")
+            if mask
+                m68kLoad64(mask, "d2", "d3")
+                $asm.puts "and.l d2,d0"
+                $asm.puts "and.l d3,d1"
+            end
+            # N from the high word, Z from both.
+            $asm.puts "move.l d0,d4"
+            $asm.puts "or.l d1,d4"
+            $asm.puts "seq d4"
+            $asm.puts "tst.l d0"
+            $asm.puts "smi d5"
+        end
+    end
+
+    def m68kBranchTest(kind, condition)
+        if operands.size == 3
+            value, mask, target = operands
+        else
+            value, target = operands
+            mask = nil
+        end
+        target = m68kTarget(target)
+        m68kTest(kind, value, mask)
+        if kind == :quad
+            case condition
+            when "s"
+                $asm.puts "tst.b d5"
+                $asm.puts "jne #{target}"
+            when "z"
+                $asm.puts "tst.b d4"
+                $asm.puts "jne #{target}"
+            when "nz"
+                $asm.puts "tst.b d4"
+                $asm.puts "jeq #{target}"
+            end
+        else
+            $asm.puts "#{{ "s" => "jmi", "z" => "jeq", "nz" => "jne" }[condition]} #{target}"
+        end
+    end
+
+    def m68kSetTest(kind, condition)
+        if operands.size == 3
+            value, mask, dst = operands
+        else
+            value, dst = operands
+            mask = nil
+        end
+        m68kTest(kind, value, mask)
+        if kind == :quad
+            case condition
+            when "s"
+                $asm.puts "move.b d5,d0"
+            when "z"
+                $asm.puts "move.b d4,d0"
+            when "nz"
+                $asm.puts "move.b d4,d0"
+                $asm.puts "not.b d0"
+            end
