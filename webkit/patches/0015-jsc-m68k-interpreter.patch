+            m68kSetTest({ "i" => :int, "p" => :ptr, "q" => :quad, "b" => :byte }[$1], $2)
+        when /^b(add|sub|mul|or)([ipq])(o|s|z|nz)$/
+            m68kOpBranch($1, { "i" => :int, "p" => :ptr, "q" => :quad }[$2], $3)
+        when "jmp"
+            target = operands[0]
+            case target
+            when LabelReference, LocalLabelReference
+                $asm.puts "jra #{target.m68kSymbol}"
+            when RegisterID
+                $asm.puts "move.l #{target.m68kLo},a0"
+                $asm.puts "jmp (a0)"
+            else
+                $asm.puts "move.l #{m68kAddress(target)},a0"
+                $asm.puts "jmp (a0)"
+            end
+        when "call"
+            raise "Generic call is not supported by the C loop's interpreter at #{codeOriginString}"
+        when "ret"
+            $asm.puts "move.l #{M68K_VRF_LR},a0"
+            $asm.puts "jmp (a0)"
+        when "cloopCrash"
+            $asm.puts "jsr _abort"
+        when "cloopCallJSFunction"
+            uid = $asm.newUID
+            label = "llint_cloop_did_return_from_js_#{uid}"
+            $asm.puts "move.l ##{Assembler.externOrGlobalLabelReference(label)},#{M68K_VRF_LR}"
+            $asm.puts "clr.l #{M68K_VRF_LR_HI}"
+            $asm.puts "move.l #{m68kSource32(operands[0], "d0")},a0"
+            $asm.puts "jmp (a0)"
+            $asm.putsLabel(label, true, false, false, false)
+        when "cloopCallNative"
+            # EncodedJSValue function(JSGlobalObject*, CallFrame*): t0, t1 in, t0 out.
+            $asm.puts "move.l #{m68kSource32(operands[0], "d2")},d2"
+            $asm.puts "move.l _jsc_m68k_cloop_sp_field,a0"
+            $asm.puts "move.l #{M68K_VRF_SP},(a0)"
+            $asm.puts "move.l #{RegisterID.forName(codeOrigin, "t1").m68kLo},-(sp)"
+            $asm.puts "move.l #{RegisterID.forName(codeOrigin, "t0").m68kLo},-(sp)"
+            $asm.puts "move.l d2,a0"
+            $asm.puts "jsr (a0)"
+            $asm.puts "addq.l #8,sp"
+            m68kStore64("d0", "d1", RegisterID.forName(codeOrigin, "t0"))
+        when "cloopCallSlowPath", "cloopCallSlowPath3", "cloopCallSlowPath4"
+            m68kCallC(operands[0], operands[1..-1], true)
+        when "cloopCallSlowPathVoid"
+            m68kCallC(operands[0], operands[1..-1], false)
+        when "cloopDo"
+        when "push"
+            m68kPush
+        when "pop"
+            m68kPop
+        when "nop", "memfence"
+            $asm.puts "nop" if opcode == "nop"
+        when "break"
+            $asm.puts "illegal"
+        when "tagReturnAddress", "untagReturnAddress", "removeCodePtrTag", "untagArrayPtr", "removeArrayPtrTag", "tagCodePtr"
+        when "lzcnti"
+            # bfffo finds the first set bit from the top: its offset is the count.
+            done = m68kNewLabel
+            $asm.puts "move.l #{m68kSource32(operands[0], "d1")},d1"
+            $asm.puts "moveq #32,d0"
+            $asm.puts "tst.l d1"
+            $asm.puts "jeq #{done}"
+            $asm.puts "bfffo d1{#0:#32},d0"
+            $asm.puts "#{done}:"
+            m68kStore32("d0", operands[1])
+        when "lzcntq"
+            done = m68kNewLabel
+            low = m68kNewLabel
+            m68kLoad64(operands[0], "d2", "d3")
+            $asm.puts "tst.l d2"
+            $asm.puts "jeq #{low}"
+            $asm.puts "bfffo d2{#0:#32},d0"
+            $asm.puts "jra #{done}"
+            $asm.puts "#{low}:"
+            $asm.puts "moveq #64,d0"
+            $asm.puts "tst.l d3"
+            $asm.puts "jeq #{done}"
+            $asm.puts "bfffo d3{#0:#32},d0"
+            $asm.puts "add.l #32,d0"
+            $asm.puts "#{done}:"
+            m68kStore32("d0", operands[1])
+        when "tzcnti"
+            # Isolate the lowest set bit (x & -x), then count from the top.
+            done = m68kNewLabel
+            $asm.puts "move.l #{m68kSource32(operands[0], "d1")},d1"
+            $asm.puts "moveq #32,d0"
+            $asm.puts "tst.l d1"
+            $asm.puts "jeq #{done}"
+            $asm.puts "move.l d1,d2"
+            $asm.puts "neg.l d2"
+            $asm.puts "and.l d2,d1"
+            $asm.puts "bfffo d1{#0:#32},d0"
+            $asm.puts "eor.l #31,d0"
+            $asm.puts "#{done}:"
+            m68kStore32("d0", operands[1])
+        when "peek"
+            source, dst = operands
+            $asm.puts "move.l #{source.value * 8}(sp),d0"
+            $asm.puts "move.l #{source.value * 8 + 4}(sp),d1"
+            m68kStore64("d0", "d1", dst)
+        when "poke"
+            value, slot = operands
+            m68kLoad64(value, "d0", "d1")
+            $asm.puts "move.l d0,#{slot.value * 8}(sp)"
+            $asm.puts "move.l d1,#{slot.value * 8 + 4}(sp)"
+        else
+            lowerDefault
+        end
+    end
+end
