 # WebAssembly generator
 
diff --git a/Source/JavaScriptCore/llint/LLIntOfflineAsmConfig.h b/Source/JavaScriptCore/llint/LLIntOfflineAsmConfig.h
index 1872e8cf35..a57d1c9544 100644
--- a/Source/JavaScriptCore/llint/LLIntOfflineAsmConfig.h
+++ b/Source/JavaScriptCore/llint/LLIntOfflineAsmConfig.h
@@ -37,10 +37,18 @@
 #define OFFLINE_ASM_ARM64E 0
 #define OFFLINE_ASM_X86_64 0
 #define OFFLINE_ASM_RISCV64 0
+// The C loop's interpreter as 68k code (offlineasm/m68k.rb), built when
+// CMake's JSC_M68K_LLINT is on.
+#if CPU(M68K) && defined(JSC_M68K_LLINT) && JSC_M68K_LLINT
+#define OFFLINE_ASM_M68K 1
+#else
+#define OFFLINE_ASM_M68K 0
+#endif
 
 #else // ENABLE(C_LOOP)
 
 #define OFFLINE_ASM_C_LOOP 0
+#define OFFLINE_ASM_M68K 0
 
 #if CPU(X86_64)
 #define OFFLINE_ASM_X86_64 1
diff --git a/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp b/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
index 5bfbbd9142..ba7377f512 100644
--- a/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
+++ b/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
@@ -92,6 +92,37 @@ WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
 
 using WebConfig::g_config;
 
+#if OFFLINE_ASM_M68K
+
+// The C loop's interpreter as 68k code (offlineasm/m68k.rb): the generated
+// LLIntAssembly.h is one top-level asm statement, and every opcode and glue
+// label is a global symbol, so CLoop::execute below can fill the opcode maps
+// with their addresses.
+#undef SYMBOL_STRING
+#define SYMBOL_STRING(name) "_" #name
+#undef LABEL_REFERENCE
+#define LABEL_REFERENCE(name) SYMBOL_STRING(name)
+#undef LOCAL_LABEL_STRING
+#define LOCAL_LABEL_STRING(name) "L" #name
+
+#define OFFLINE_ASM_BEGIN __asm__(".text\n"
+#define OFFLINE_ASM_END );
+
+#define OFFLINE_ASM_M68K_GLOBAL(label) \
+    ".text\n.balign 2\n.globl " SYMBOL_STRING(label) "\n" SYMBOL_STRING(label) ":\n"
+
+// Opcode and glue labels are also referred to as local labels.
+#define OFFLINE_ASM_OPCODE_LABEL(__opcode) OFFLINE_ASM_M68K_GLOBAL(llint_##__opcode) LOCAL_LABEL_STRING(llint_##__opcode) ":\n"
+#define OFFLINE_ASM_GLUE_LABEL(__opcode) OFFLINE_ASM_M68K_GLOBAL(__opcode) LOCAL_LABEL_STRING(__opcode) ":\n"
+#define OFFLINE_ASM_GLOBAL_LABEL(label) OFFLINE_ASM_M68K_GLOBAL(label)
+#define OFFLINE_ASM_UNALIGNED_GLOBAL_LABEL(label) OFFLINE_ASM_M68K_GLOBAL(label)
+#define OFFLINE_ASM_ALIGNED_GLOBAL_LABEL(label, align) ".balign " #align "\n" OFFLINE_ASM_M68K_GLOBAL(label)
+#define OFFLINE_ASM_GLOBAL_EXPORT_LABEL(label) OFFLINE_ASM_M68K_GLOBAL(label)
+#define OFFLINE_ASM_UNALIGNED_GLOBAL_EXPORT_LABEL(label) OFFLINE_ASM_M68K_GLOBAL(label)
+#define OFFLINE_ASM_LOCAL_LABEL(label) LOCAL_LABEL_STRING(label) ":\n"
+
+#else // !OFFLINE_ASM_M68K
+
 // These are for building a C Loop interpreter:
 #define OFFLINE_ASM_BEGIN
 #define OFFLINE_ASM_END
@@ -128,6 +159,8 @@ using WebConfig::g_config;
 
 #define OFFLINE_ASM_LOCAL_LABEL(label) label: TRACE_LABEL("OFFLINE_ASM_LOCAL_LABEL", #label); USE_LABEL(label);
 
+#endif // OFFLINE_ASM_M68K
+
 namespace JSC {
 
 class CallLinkInfo;
@@ -234,6 +267,158 @@ static void decodeResult(UGPRPair result, CLoopRegister& t0, CLoopRegister& t1)
 // The llint C++ interpreter loop:
 //
 
+#if OFFLINE_ASM_M68K
+
+// The 68k interpreter's register file (offlineasm/m68k.rb): one 64-bit slot
+// per interpreter register, big-endian, in this order.
+enum M68KSlot : unsigned {
+    M68KSlotT0 = 0, M68KSlotT1 = 1, M68KSlotT2 = 2,
+    M68KSlotSP = 13, M68KSlotLR = 14,
+    M68KSlotCSR1 = 18, M68KSlotCSR2 = 19,
+    M68KSlotCount = 28,
+};
+
+extern "C" {
+alignas(8) uint64_t jsc_m68k_vrf[M68KSlotCount];
+// Where the C loop's stack pointer is kept (CLoopStack), stored before every
+// call into C so the garbage collector sees the JavaScript stack's extent.
+void* jsc_m68k_cloop_sp_field;
+EncodedJSValue jsc_m68k_llint_enter(const void* opcode, CallFrame*);
+}
+
+// Saves the C registers the ABI asks to keep (the interpreter uses all of
+// them), sets cfr (a5) and jumps to the first opcode. The interpreter comes
+// back through llint_return_to_host with its result in t0.
+__asm__(
+    ".text\n"
+    ".balign 2\n"
+    ".globl _jsc_m68k_llint_enter\n"
+    "_jsc_m68k_llint_enter:\n"
+    "    movem.l d2-d7/a2-a6,-(sp)\n"
+    "    fmovem.x fp2-fp7,-(sp)\n"
+    "    move.l 120(sp),a0\n"
+    "    move.l 124(sp),a5\n"
+    "    jmp (a0)\n"
+    ".globl _llint_return_to_host\n"
+    "_llint_return_to_host:\n"
+    "    move.l _jsc_m68k_vrf,d0\n"
+    "    move.l _jsc_m68k_vrf+4,d1\n"
+    "    fmovem.x (sp)+,fp2-fp7\n"
+    "    movem.l (sp)+,d2-d7/a2-a6\n"
+    "    rts\n"
+);
+
+#include "LLIntAssembly.h"
+
+namespace M68KLabels {
+extern "C" {
+#define M68K_DECLARE_OPCODE(__opcode, length) \
+    void llint_##__opcode(); void llint_##__opcode##_wide16(); void llint_##__opcode##_wide32();
+#define M68K_DECLARE_HELPER(__opcode, length) \
+    void __opcode(); void __opcode##_wide16(); void __opcode##_wide32();
+#define M68K_DECLARE_GLUE(__opcode, length) void __opcode();
+FOR_EACH_BYTECODE_ID(M68K_DECLARE_OPCODE)
+FOR_EACH_BYTECODE_HELPER_ID(M68K_DECLARE_HELPER)
+FOR_EACH_CLOOP_BYTECODE_HELPER_ID(M68K_DECLARE_GLUE)
+FOR_EACH_LLINT_NATIVE_HELPER(M68K_DECLARE_GLUE)
+FOR_EACH_CLOOP_RETURN_HELPER_ID(M68K_DECLARE_GLUE)
+#undef M68K_DECLARE_OPCODE
+#undef M68K_DECLARE_HELPER
+#undef M68K_DECLARE_GLUE
+}
+} // namespace M68KLabels
+
+// The address of CLoopStack's stack pointer: found by setting a marker
+// through its setter, as the field itself is private.
+static void* findCLoopStackPointerField(CLoopStack& stack)
+{
+    void* saved = stack.currentStackPointer();
+    void* marker = reinterpret_cast<void*>(0x6d36386bu);
+    stack.setCurrentStackPointer(marker);
+    // Fields are only 2-byte aligned on the 68k: look at every halfword.
+    uint8_t* bytes = reinterpret_cast<uint8_t*>(&stack);
+    void* field = nullptr;
+    for (size_t i = 0; i + sizeof(void*) <= sizeof(CLoopStack); i += 2) {
+        void* value;
+        memcpy(&value, bytes + i, sizeof(value));
+        if (value == marker) {
+            field = bytes + i;
+            break;
+        }
+    }
+    stack.setCurrentStackPointer(saved);
+    RELEASE_ASSERT(field);
+    return field;
+}
+
+static void setM68KSlot(M68KSlot slot, uint64_t value)
+{
+    jsc_m68k_vrf[slot] = value;
+}
+
+JSValue CLoop::execute(OpcodeID entryOpcodeID, void* executableAddress, VM* vm, ProtoCallFrame* protoCallFrame, bool isInitializationPass)
+{
+    if (isInitializationPass) [[unlikely]] {
+        Opcode* opcodeMap = LLInt::opcodeMap();
+        Opcode* opcodeMapWide16 = LLInt::opcodeMapWide16();
+        Opcode* opcodeMapWide32 = LLInt::opcodeMapWide32();
+
+#define OPCODE_ENTRY(__opcode, length) \
+        opcodeMap[__opcode] = reinterpret_cast<void*>(M68KLabels::llint_##__opcode); \
+        opcodeMapWide16[__opcode] = reinterpret_cast<void*>(M68KLabels::llint_##__opcode##_wide16); \
+        opcodeMapWide32[__opcode] = reinterpret_cast<void*>(M68KLabels::llint_##__opcode##_wide32);
+#define HELPER_ENTRY(__opcode, length) \
+        opcodeMap[__opcode] = reinterpret_cast<void*>(M68KLabels::__opcode); \
+        opcodeMapWide16[__opcode] = reinterpret_cast<void*>(M68KLabels::__opcode##_wide16); \
+        opcodeMapWide32[__opcode] = reinterpret_cast<void*>(M68KLabels::__opcode##_wide32);
+#define LLINT_OPCODE_ENTRY(__opcode, length) \
+        opcodeMap[__opcode] = reinterpret_cast<void*>(M68KLabels::__opcode);
+
+        FOR_EACH_BYTECODE_ID(OPCODE_ENTRY)
+        FOR_EACH_BYTECODE_HELPER_ID(HELPER_ENTRY)
+        FOR_EACH_CLOOP_BYTECODE_HELPER_ID(LLINT_OPCODE_ENTRY)
+        FOR_EACH_LLINT_NATIVE_HELPER(LLINT_OPCODE_ENTRY)
+        FOR_EACH_CLOOP_RETURN_HELPER_ID(LLINT_OPCODE_ENTRY)
+#undef OPCODE_ENTRY
+#undef HELPER_ENTRY
+#undef LLINT_OPCODE_ENTRY
+
+        uint8_t* exceptionInstructions = reinterpret_cast<uint8_t*>(LLInt::exceptionInstructions());
+        for (unsigned i = 0; i < maxBytecodeStructLength + 1; ++i)
+            exceptionInstructions[i] = llint_throw_from_slow_path_trampoline;
+
+        return JSValue();
+    }
+
+    CLoopStack& cloopStack = vm->cloopStack();
+    void* spAtEntry = cloopStack.currentStackPointer();
+
+    // The outer entry's registers, as the C loop keeps them in its own locals.
+    uint64_t savedRegisters[M68KSlotCount];
+    memcpy(savedRegisters, jsc_m68k_vrf, sizeof(savedRegisters));
+    void* savedStackPointerField = jsc_m68k_cloop_sp_field;
+    jsc_m68k_cloop_sp_field = findCLoopStackPointerField(cloopStack);
+
+    // The incoming arguments of doVMEntryToJavaScript, and the C loop's
+    // initial registers.
+    setM68KSlot(M68KSlotT0, reinterpret_cast<uintptr_t>(executableAddress));
+    setM68KSlot(M68KSlotT1, reinterpret_cast<uintptr_t>(vm));
+    setM68KSlot(M68KSlotT2, reinterpret_cast<uintptr_t>(protoCallFrame));
+    setM68KSlot(M68KSlotSP, reinterpret_cast<uintptr_t>(spAtEntry));
+    setM68KSlot(M68KSlotLR, reinterpret_cast<uintptr_t>(M68KLabels::llint_return_to_host));
+    setM68KSlot(M68KSlotCSR1, JSValue::NumberTag);
+    setM68KSlot(M68KSlotCSR2, JSValue::NotCellMask);
+
+    EncodedJSValue result = jsc_m68k_llint_enter(getOpcode(entryOpcodeID), vm->topCallFrame);
+
+    memcpy(jsc_m68k_vrf, savedRegisters, sizeof(savedRegisters));
+    jsc_m68k_cloop_sp_field = savedStackPointerField;
+    cloopStack.setCurrentStackPointer(spAtEntry);
+    return JSValue::decode(result);
+}
+
+#else // !OFFLINE_ASM_M68K
+
 JSValue CLoop::execute(OpcodeID entryOpcodeID, void* executableAddress, VM* vm, ProtoCallFrame* protoCallFrame, bool isInitializationPass)
 {
     // WARNING: it is critical to avoid 'std::bit_cast' in the CAST macro that follows and in
@@ -449,6 +634,8 @@ JSValue CLoop::execute(OpcodeID entryOpcodeID, void* executableAddress, VM* vm,
     return JSValue(); // to suppress a compiler warning.
 } // Interpreter::llintCLoopExecute()
 
+#endif // OFFLINE_ASM_M68K
+
 } // namespace JSC
 
 WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
