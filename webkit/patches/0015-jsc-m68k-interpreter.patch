From be55d1e2421b4ce129b396ab1cca1faf056de93a Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Tue, 6 Oct 2026 17:09:43 +0100
Subject: [PATCH] JSC: the C loop's interpreter as 68k code (offlineasm M68K
 back end)

CMake's JSC_M68K_LLINT turns it on for CPU(M68K) with the C loop. The C++
side keeps all its C-loop plumbing; offlineasm emits the C loop's version of
LowLevelInterpreter*.asm as 68k assembly instead of C, and CLoop::execute
enters it. Interpreter registers live in a 64-bit register file in memory
(cfr in a5); slow paths are plain C calls.
---
 Source/JavaScriptCore/CMakeLists.txt          |   16 +
 .../llint/LLIntOfflineAsmConfig.h             |    8 +
 .../llint/LowLevelInterpreter.cpp             |  187 +++
 Source/JavaScriptCore/offlineasm/backends.rb  |    3 +
 Source/JavaScriptCore/offlineasm/m68k.rb      | 1363 +++++++++++++++++
 Source/JavaScriptCore/offlineasm/settings.rb  |    5 +
 6 files changed, 1582 insertions(+)
 create mode 100644 Source/JavaScriptCore/offlineasm/m68k.rb

diff --git a/Source/JavaScriptCore/CMakeLists.txt b/Source/JavaScriptCore/CMakeLists.txt
index bd4af3836c..041afb7eb7 100644
--- a/Source/JavaScriptCore/CMakeLists.txt
+++ b/Source/JavaScriptCore/CMakeLists.txt
@@ -258,6 +258,7 @@ set(OFFLINE_ASM
     offlineasm/cloop.rb
     offlineasm/config.rb
     offlineasm/instructions.rb
+    offlineasm/m68k.rb
     offlineasm/offsets.rb
     offlineasm/opt.rb
     offlineasm/parser.rb
@@ -330,6 +331,12 @@ if (NOT ENABLE_JIT)
     endif ()
 endif ()
 
+# 68k: the C loop's interpreter as 68k code (offlineasm/m68k.rb) instead of C.
+option(JSC_M68K_LLINT "Build the 68k interpreter instead of the C loop's C code" OFF)
+if (JSC_M68K_LLINT AND WTF_CPU_M68K AND ENABLE_C_LOOP)
+    set(OFFLINE_ASM_BACKEND "M68K")
+endif ()
+
 add_custom_command(
     OUTPUT ${JavaScriptCore_DERIVED_SOURCES_DIR}/AirOpcode.h ${JavaScriptCore_DERIVED_SOURCES_DIR}/AirOpcodeGenerated.h
     MAIN_DEPENDENCY ${JAVASCRIPTCORE_DIR}/b3/air/AirOpcode.opcodes
@@ -453,6 +460,9 @@ set(LLIntSettingsExtractor_DEPENDENCIES
 set_property(TARGET LLIntSettingsExtractor PROPERTY SKIP_CODESIGN YES)
 set_property(TARGET LLIntSettingsExtractor PROPERTY SKIP_DSYM YES)
 WEBKIT_EXECUTABLE(LLIntSettingsExtractor)
+if (OFFLINE_ASM_BACKEND STREQUAL "M68K")
+    target_compile_definitions(LLIntSettingsExtractor PRIVATE JSC_M68K_LLINT=1)
+endif ()
 
 # LLIntSettingsExtractor target needs to have a direct or indirect
 # dependency to Bytecodes target for CMake Visual Studio generator to
@@ -483,6 +493,9 @@ set(LLIntOffsetsExtractor_DEPENDENCIES
 set_property(TARGET LLIntOffsetsExtractor PROPERTY SKIP_CODESIGN YES)
 set_property(TARGET LLIntOffsetsExtractor PROPERTY SKIP_DSYM YES)
 WEBKIT_EXECUTABLE(LLIntOffsetsExtractor)
+if (OFFLINE_ASM_BACKEND STREQUAL "M68K")
+    target_compile_definitions(LLIntOffsetsExtractor PRIVATE JSC_M68K_LLINT=1)
+endif ()
 
 # The build system will execute asm.rb every time LLIntOffsetsExtractor's mtime is newer than
 # LLIntAssembly.h's mtime. The problem we have here is: asm.rb has some built-in optimization
@@ -522,6 +535,9 @@ add_custom_command(
 # single source file, so we need to create a separate target for it.
 add_library(LowLevelInterpreterLib OBJECT llint/LowLevelInterpreter.cpp
     ${JavaScriptCore_DERIVED_SOURCES_DIR}/${LLIntOutput})
+if (OFFLINE_ASM_BACKEND STREQUAL "M68K")
+    target_compile_definitions(LowLevelInterpreterLib PRIVATE JSC_M68K_LLINT=1)
