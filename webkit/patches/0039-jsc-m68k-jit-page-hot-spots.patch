+    // `index in array` (the array builtins' hole checks): true for an int32
+    // index below the length of an Int32Shape or ContiguousShape array where
+    // the element is not a hole; anything else is the template.
+    bool inByVal(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpInByVal>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Operand base = operandFor(m_codeBlock, bytecode.m_base);
+        Operand index = operandFor(m_codeBlock, bytecode.m_property);
+        if (!dst.valid || dst.isConstant || !base.valid || base.isConstant || !index.valid)
+            return false;
+        loadCell(base);
+        checkInt32(index);
+        load(index, 1);
+        loadShape(false);
+        m_hot.cmpByteImm(Int32Shape, 0);
+        size_t shapeOk = m_hot.branchShort(Builder::Equal);
+        m_hot.cmpByteImm(ContiguousShape, 0);
+        slowUnless(Builder::NotEqual);
+        m_hot.bindShort(shapeOk);
+        m_hot.moveaDisp(0, JSObject::butterflyOffset(), 0);
+        m_hot.cmpDisp(0, Butterfly::offsetOfPublicLength(), 1);
+        slowUnless(Builder::CarryClear); // index >= length, unsigned (negative too)
+        m_hot.lsl3(1);
+        // A hole (the empty value, all zero) is the template's.
+        m_hot.loadIndexed(0, 1, 0, 0);
+        size_t notHole = m_hot.branchShort(Builder::NotEqual);
+        m_hot.loadIndexed(0, 1, 4, 0);
+        slowUnless(Builder::Equal);
+        m_hot.bindShort(notHole);
+        m_hot.moveq(static_cast<int8_t>(JSValue::encode(jsBoolean(true))), 0);
+        m_hot.clrFrame(dst.hi);
+        m_hot.storeFrame(0, dst.lo);
+        return true;
+    }
+
+    // for-in's next name (the interpreter's OwnStructureMode case), also on
+    // the first step, for an object with no indexed properties, and on the
+    // last, past the names: while the object has the enumerator's
+    // structure. Anything else is the template.
+    bool enumeratorNext(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpEnumeratorNext>();
+        Operand name = operandFor(m_codeBlock, bytecode.m_propertyName);
+        Operand mode = operandFor(m_codeBlock, bytecode.m_mode);
+        Operand index = operandFor(m_codeBlock, bytecode.m_index);
+        Operand base = operandFor(m_codeBlock, bytecode.m_base);
+        Operand enumerator = operandFor(m_codeBlock, bytecode.m_enumerator);
+        for (const Operand* op : { &name, &mode, &index, &base, &enumerator }) {
+            if (!op->valid || op->isConstant)
+                return false;
+        }
+        using Enumerator = JSPropertyNameEnumerator;
+        loadCell(base);
+        m_hot.loadFrame(enumerator.lo, 1);
+        m_hot.moveaFromData(1, 1);
+        m_hot.loadDisp(0, JSCell::structureIDOffset(), 0);
+        m_hot.cmpDisp(1, Enumerator::cachedStructureIDOffset(), 0);
+        slowUnless(Builder::NotEqual);
+        // d1 the next index; the first step starts at the structure's names.
+        m_hot.loadFrame(index.lo, 1);
+        m_hot.word(0x5281); // addq.l #1,d1
+        m_hot.loadFrame(mode.lo, 0);
+        m_hot.cmpImm(Enumerator::OwnStructureMode, 0);
+        size_t own = m_hot.branchShort(Builder::Equal);
+        static_assert(!Enumerator::InitMode);
+        m_hot.tst(0);
+        slowUnless(Builder::NotEqual);
+        m_hot.loadDisp(1, Enumerator::indexedLengthOffset(), 0);
+        slowUnless(Builder::NotEqual);
+        m_hot.loadDisp(1, Enumerator::endGenericPropertyIndexOffset(), 0);
+        slowUnless(Builder::Equal);
+        m_hot.moveq(0, 1);
+        m_hot.bindShort(own);
+        m_hot.cmpDisp(1, Enumerator::endStructurePropertyIndexOffset(), 1);
+        size_t inStructure = m_hot.branchShort(Builder::CarrySet); // index < end, unsigned
+        // Past all the names (none from the prototype chain): the sentinel.
+        m_hot.cmpDisp(1, Enumerator::endGenericPropertyIndexOffset(), 1);
+        slowUnless(Builder::CarrySet);
+        m_hot.moveImm(static_cast<uint32_t>(reinterpret_cast<uintptr_t>(m_codeBlock->vm().smallStrings.sentinelString())), 0);
+        size_t store = m_hot.branchShort(Builder::Always);
+        m_hot.bindShort(inStructure);
+        m_hot.moveaDisp(1, Enumerator::cachedPropertyNamesVectorOffset(), 1);
+        m_hot.word(0x2031); m_hot.word(Builder::index(1, 0) | 0x0400); // move.l 0(a1,d1.l*4),d0
+        m_hot.bindShort(store);
+        m_hot.clrFrame(name.hi);
+        m_hot.storeFrame(0, name.lo);
+        m_hot.storeFrameImm(int32Tag, index.hi);
+        m_hot.storeFrame(1, index.lo);
+        m_hot.storeFrameImm(int32Tag, mode.hi);
+        m_hot.storeFrameImm(Enumerator::OwnStructureMode, mode.lo);
+        return true;
+    }
