+        // Two strings: flat ones with the same StringImpl are equal, and
+        // two different atoms are not; anything else is the slow path's.
+        static_assert(StringImpl::flagIsAtom() < 256);
+        constexpr unsigned atomBit = std::countr_zero(StringImpl::flagIsAtom());
+        static_assert(JSString::isRopeInPointer == 1);
+        auto flatString = [&](unsigned dn) {
+            m_hot.cmpByteImmDisp(StringType, 0, JSCell::typeInfoTypeOffset());
+            slowUnless(Builder::NotEqual);
+            m_hot.loadDisp(0, JSString::offsetOfValue(), dn);
+            m_hot.btstImm(0, dn);
+            slowUnless(Builder::NotEqual);
+        };
+        auto atom = [&](unsigned dn) {
+            m_hot.moveaFromData(dn, 0);
+            m_hot.btstImmDisp(atomBit, 0, StringImpl::flagsOffset() + 3);
+            slowUnless(Builder::Equal);
+        };
         if (rhs.isConstant) {
-            if (!rhs.constant.isCell() || rhs.constant.asCell()->type() > LastValueCompareCellType) {
+            JSCell* cell = rhs.constant.isCell() ? rhs.constant.asCell() : nullptr;
+            if (!cell || cell->type() > LastValueCompareCellType) {
                 branch(Builder::Always, notEqual);
             } else {
                 m_hot.moveaFromData(0, 0);
                 m_hot.cmpByteImmDisp(LastValueCompareCellType, 0, JSCell::typeInfoTypeOffset());
                 branch(Builder::Higher, notEqual);
-                slowUnless(Builder::Always);
+                auto* string = cell->type() == StringType ? static_cast<JSString*>(cell) : nullptr;
+                if (string && !string->isRope() && string->tryGetValueImpl()->isAtom()) {
+                    flatString(0);
+                    m_hot.cmpImm(static_cast<uint32_t>(reinterpret_cast<uintptr_t>(string->tryGetValueImpl())), 0);
+                    branch(Builder::Equal, equal);
+                    atom(0);
