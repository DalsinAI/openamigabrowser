     // get_by_val's string (no indexing shape; a0 the cell, d0 its shape,
     // d1 the index): the character's string, for codes below 256.
     void stringCharacterValue(const Operand& dst)
     {
         m_hot.tstByte(0);
         slowUnless(Builder::NotEqual);
+        // Or an arguments object's element, below its length.
+        m_hot.cmpByteImmDisp(DirectArgumentsType, 0, JSCell::typeInfoTypeOffset());
+        size_t notArguments = m_hot.branchShort(Builder::NotEqual);
+        int storage = static_cast<int>(DirectArguments::storageOffset());
+        if (storage + 4 > 127)
+            slowUnless(Builder::Always);
+        else {
+            directArguments();
+            m_hot.cmpDisp(0, DirectArguments::offsetOfLength(), 1);
+            slowUnless(Builder::CarryClear); // index >= length, unsigned (negative too)
+            m_hot.lsl3(1);
+            m_hot.copyIndexedToFrame(0, 1, storage, dst.hi);
+            m_hot.copyIndexedToFrame(0, 1, storage + 4, dst.lo);
+        }
+        size_t done = m_hot.branch(Builder::Always);
+        m_hot.bindShort(notArguments);
         m_hot.cmpByteImmDisp(StringType, 0, JSCell::typeInfoTypeOffset());
         slowUnless(Builder::NotEqual);
         stringCharacter([&](Builder::Condition cc) { slowUnless(cc); });
@@ -1202,6 +1314,7 @@ private:
         slowUnless(Builder::Equal);
         m_hot.clrFrame(dst.hi);
         m_hot.storeFrame(0, dst.lo);
+        m_hot.bindBranch(done);
     }
 
     // As getByVal, in bounds only (the template grows arrays), and not to
@@ -1285,15 +1398,31 @@ private:
         m_hot.storeFrame(0, dst.lo);
         return true;
     }
-    // get_length's string (a0 the cell).
+    // get_length's string, or arguments object while nothing on it was
+    // overridden (a0 the cell).
     void stringLengthValue(const Operand& dst)
     {
         m_hot.cmpByteImmDisp(StringType, 0, JSCell::typeInfoTypeOffset());
-        slowUnless(Builder::NotEqual);
+        size_t notString = m_hot.branchShort(Builder::NotEqual);
         stringLength();
+        size_t done = m_hot.branchShort(Builder::Always);
+        m_hot.bindShort(notString);
+        directArguments();
+        m_hot.loadDisp(0, DirectArguments::offsetOfLength(), 0);
+        m_hot.bindShort(done);
         m_hot.storeFrameImm(int32Tag, dst.hi);
         m_hot.storeFrame(0, dst.lo);
     }
+    // a0 a DirectArguments whose length, callee and elements are its own
+    // (overrodeThings() false), or the slow path. Uses d0.
+    void directArguments()
+    {
+        static_assert(sizeof(CagedBarrierPtr<Gigacage::Primitive, bool>) == sizeof(uint32_t)); // m_mappedArguments
+        m_hot.cmpByteImmDisp(DirectArgumentsType, 0, JSCell::typeInfoTypeOffset());
+        slowUnless(Builder::NotEqual);
+        m_hot.loadDisp(0, DirectArguments::offsetOfMappedArguments(), 0);
+        slowUnless(Builder::NotEqual);
+    }
 
