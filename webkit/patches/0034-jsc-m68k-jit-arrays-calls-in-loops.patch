@@ -293,7 +300,7 @@ public:
     enum FPOperation { FPAdd = 0x66, FPSub = 0x6c, FPMul = 0x67, FPCompare = 0x38, FPTest = 0x3a };
     void fop(FPOperation op, unsigned src, unsigned dst) { word(0xf200); word((src << 10) | (dst << 7) | op); }
 
-    enum Condition { Always = 0, Higher = 2, LowerSame = 3, CarrySet = 5, NotEqual = 6, Equal = 7, OverflowSet = 9, GreaterEqual = 12, Less = 13, Greater = 14, LessEqual = 15 };
+    enum Condition { Always = 0, Higher = 2, LowerSame = 3, CarryClear = 4, CarrySet = 5, NotEqual = 6, Equal = 7, OverflowSet = 9, GreaterEqual = 12, Less = 13, Greater = 14, LessEqual = 15 };
     // b<cc>.b within a fast path: branchShort, then bindShort at the target.
     size_t branchShort(Condition cc)
     {
@@ -690,6 +697,127 @@ private:
         return true;
     }
 
+    // a0's indexing type byte into d0, masked: the shape and, with
+    // copyOnWrite, the copy-on-write bit.
+    void loadShape(bool copyOnWrite)
+    {
+        m_hot.loadByteDisp(0, JSCell::indexingTypeAndMiscOffset(), 0);
+        m_hot.andByteImm(IndexingShapeMask | (copyOnWrite ? CopyOnWrite : 0), 0);
+    }
+
+    // Arrays of int32s or of any values (the interpreter's Int32Shape and
+    // ContiguousShape), by an int32 index below the length; anything else
+    // is the template.
+    bool getByVal(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpGetByVal>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Operand base = operandFor(m_codeBlock, bytecode.m_base);
+        Operand index = operandFor(m_codeBlock, bytecode.m_property);
+        if (!dst.valid || dst.isConstant || !base.valid || base.isConstant || !index.valid)
+            return false;
+        loadCell(base);
+        checkInt32(index);
+        load(index, 1);
+        loadShape(false);
+        m_hot.cmpByteImm(Int32Shape, 0);
+        size_t shapeOk = m_hot.branchShort(Builder::Equal);
+        m_hot.cmpByteImm(ContiguousShape, 0);
+        slowUnless(Builder::NotEqual);
+        m_hot.bindShort(shapeOk);
+        m_hot.moveaDisp(0, JSObject::butterflyOffset(), 0);
+        m_hot.cmpDisp(0, Butterfly::offsetOfPublicLength(), 1);
+        slowUnless(Builder::CarryClear); // index >= length, unsigned (negative too)
+        m_hot.lsl3(1);
+        // A hole (the empty value, all zero) is the template's.
+        m_hot.loadIndexed(0, 1, 0, 0);
+        size_t notHole = m_hot.branchShort(Builder::NotEqual);
+        m_hot.loadIndexed(0, 1, 4, 0);
+        slowUnless(Builder::Equal);
+        m_hot.bindShort(notHole);
+        m_hot.copyIndexedToFrame(0, 1, 0, dst.hi);
+        m_hot.copyIndexedToFrame(0, 1, 4, dst.lo);
+        return true;
+    }
+
+    // As getByVal, in bounds only (the template grows arrays), and not to
+    // copy-on-write arrays. An Int32Shape array only takes int32s.
+    bool putByVal(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpPutByVal>();
+        Operand base = operandFor(m_codeBlock, bytecode.m_base);
+        Operand index = operandFor(m_codeBlock, bytecode.m_property);
+        Operand value = operandFor(m_codeBlock, bytecode.m_value);
+        if (!base.valid || base.isConstant || !index.valid || !value.valid)
+            return false;
+        loadCell(base);
+        checkInt32(index);
+        load(index, 1);
+        loadShape(true);
+        m_hot.cmpByteImm(Int32Shape, 0);
+        size_t notInt32Shape = m_hot.branchShort(Builder::NotEqual);
+        if (!value.isConstant) {
+            m_hot.cmpFrameImm(int32Tag, value.hi);
+            slowUnless(Builder::NotEqual);
+        }
+        size_t shapeOk = m_hot.branchShort(Builder::Always);
+        m_hot.bindShort(notInt32Shape);
+        m_hot.cmpByteImm(ContiguousShape, 0);
+        slowUnless(Builder::NotEqual);
+        if (!value.isConstant) {
+            // Storing a cell may need the write barrier, as in putById.
+            static_assert(!blackThreshold);
+            m_hot.tstFrame(value.hi);
+            size_t notCell1 = m_hot.branchShort(Builder::NotEqual);
+            m_hot.loadFrame(value.lo, 0);
+            m_hot.btst1(0);
+            size_t notCell2 = m_hot.branchShort(Builder::NotEqual);
+            m_hot.tst(0);
+            size_t notCell3 = m_hot.branchShort(Builder::Equal);
+            m_hot.tstByteDisp(0, JSCell::cellStateOffset());
+            slowUnless(Builder::Equal);
+            m_hot.bindShort(notCell1);
+            m_hot.bindShort(notCell2);
+            m_hot.bindShort(notCell3);
+        }
+        m_hot.bindShort(shapeOk);
+        m_hot.moveaDisp(0, JSObject::butterflyOffset(), 0);
+        m_hot.cmpDisp(0, Butterfly::offsetOfPublicLength(), 1);
+        slowUnless(Builder::CarryClear);
+        m_hot.lsl3(1);
+        if (value.isConstant) {
+            m_hot.storeImmIndexed(int32Tag, 0, 1, 0);
+            m_hot.storeImmIndexed(static_cast<uint32_t>(value.constant), 0, 1, 4);
+        } else {
+            m_hot.copyFrameToIndexed(value.hi, 0, 1, 0);
+            m_hot.copyFrameToIndexed(value.lo, 0, 1, 4);
+        }
+        return true;
+    }
+
+    // An array's length (the interpreter's GetByIdMode::ArrayLength).
+    bool getLength(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpGetLength>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        Operand base = operandFor(m_codeBlock, bytecode.m_base);
+        if (!dst.valid || dst.isConstant || !base.valid || base.isConstant)
+            return false;
+        loadCell(base);
+        m_hot.loadByteDisp(0, JSCell::indexingTypeAndMiscOffset(), 0);
+        static_assert(IsArray == 1);
+        m_hot.btstImm(0, 0);
+        slowUnless(Builder::Equal);
+        m_hot.andByteImm(IndexingShapeMask, 0);
+        slowUnless(Builder::Equal);
+        m_hot.moveaDisp(0, JSObject::butterflyOffset(), 0);
+        m_hot.loadDisp(0, Butterfly::offsetOfPublicLength(), 0);
+        slowUnless(Builder::Less); // above INT32_MAX: a double
+        m_hot.storeFrameImm(int32Tag, dst.hi);
+        m_hot.storeFrame(0, dst.lo);
+        return true;
+    }
+
     bool putById(const JSInstruction* instruction)
     {
         auto bytecode = instruction->as<OpPutById>();
@@ -1014,6 +1142,12 @@ private:
             return Options::useM68KPropertyFastPaths() && getById(instruction);
         case op_put_by_id:
             return Options::useM68KPropertyFastPaths() && putById(instruction);
+        case op_get_by_val:
+            return Options::useM68KPropertyFastPaths() && getByVal(instruction);
+        case op_put_by_val:
+            return Options::useM68KPropertyFastPaths() && putByVal(instruction);
+        case op_get_length:
+            return Options::useM68KPropertyFastPaths() && getLength(instruction);
         default:
             return false;
         }
@@ -1139,12 +1273,24 @@ private:
             return true;
         case op_mov: {
             auto bytecode = instruction->as<OpMov>();
-            if (bytecode.m_src.isConstant() && !m_codeBlock->getConstant(bytecode.m_src).isInt32())
-                return false;
+            if (bytecode.m_src.isConstant() && !m_codeBlock->getConstant(bytecode.m_src).isInt32()) {
+                // Another constant (undefined for a call's this, say): its
+                // slot stays out of the registers.
+                cell(bytecode.m_dst);
+                return !bytecode.m_dst.isConstant();
+            }
             add(bytecode.m_dst);
             add(bytecode.m_src);
             return true;
         }
+        // A call: its callee is a cell, its arguments are slots written
+        // before it; the registers are reloaded after it.
+        case op_call: {
+            auto bytecode = instruction->as<OpCall>();
+            add(bytecode.m_dst);
+            cell(bytecode.m_callee);
+            return !bytecode.m_dst.isConstant() && !bytecode.m_callee.isConstant();
+        }
         // Property access, with the plain code's fast paths; get_by_id's
         // result can be one of the registers.
         case op_get_by_id: {
@@ -1160,6 +1306,26 @@ private:
                 add(bytecode.m_value);
             return Options::useM68KPropertyFastPaths() && !bytecode.m_base.isConstant();
         }
+        case op_get_by_val: {
+            auto bytecode = instruction->as<OpGetByVal>();
+            add(bytecode.m_dst);
+            cell(bytecode.m_base);
+            add(bytecode.m_property);
+            return result(Options::useM68KPropertyFastPaths() && !bytecode.m_base.isConstant() && !bytecode.m_dst.isConstant());
+        }
+        case op_put_by_val: {
+            auto bytecode = instruction->as<OpPutByVal>();
+            cell(bytecode.m_base);
+            add(bytecode.m_property);
+            add(bytecode.m_value);
+            return result(Options::useM68KPropertyFastPaths() && !bytecode.m_base.isConstant());
+        }
+        case op_get_length: {
+            auto bytecode = instruction->as<OpGetLength>();
+            add(bytecode.m_dst);
+            cell(bytecode.m_base);
+            return Options::useM68KPropertyFastPaths() && !bytecode.m_base.isConstant() && !bytecode.m_dst.isConstant();
+        }
         case op_inc: add(instruction->as<OpInc>().m_srcDst); return true;
         case op_dec: add(instruction->as<OpDec>().m_srcDst); return true;
 #define M68K_BINARY(name, Op) case name: { auto bytecode = instruction->as<Op>(); add(bytecode.m_dst); add(bytecode.m_lhs); add(bytecode.m_rhs); return result(true); }
@@ -1232,13 +1398,14 @@ private:
             ++handled;
             for (auto reg : cells)
                 cellSlots.add(displacement(reg));
-            if (instruction->opcodeID() == op_mov && !regs[1].isConstant())
+            if (instruction->opcodeID() == op_mov && regs.size() == 2 && !regs[1].isConstant())
                 moves.append({ displacement(regs[0]), displacement(regs[1]) });
             // mov and the arithmetic list their result first; it is written
             // after the others are read.
             OpcodeID opcode = instruction->opcodeID();
             bool writesFirst = opcode == op_mov || opcode == op_add || opcode == op_sub || opcode == op_mul
-                || opcode == op_bitand || opcode == op_bitor || opcode == op_bitxor || opcode == op_get_by_id;
+                || opcode == op_bitand || opcode == op_bitor || opcode == op_bitxor || opcode == op_get_by_id
+                || opcode == op_get_by_val || opcode == op_get_length || opcode == op_call;
             for (unsigned pass = 0; pass < 2; ++pass) {
                 for (unsigned i = 0; i < regs.size(); ++i) {
                     bool isWrite = writesFirst && !i;
@@ -1456,6 +1623,15 @@ private:
             auto bytecode = instruction->as<OpMov>();
             if (bytecode.m_dst.isConstant())
                 return Stop;
+            if (bytecode.m_src.isConstant() && !m_codeBlock->getConstant(bytecode.m_src).isInt32()) {
+                Value dst = valueFor(bytecode.m_dst);
+                if (dst.reg >= 0)
+                    return Stop;
+                uint64_t bits = JSValue::encode(m_codeBlock->getConstant(bytecode.m_src));
+                m_code.storeFrameImm(static_cast<uint32_t>(bits >> 32), dst.hi);
+                m_code.storeFrameImm(static_cast<uint32_t>(bits), dst.lo);
+                return Next;
+            }
             Value dst = valueFor(bytecode.m_dst);
             Value src = valueFor(bytecode.m_src);
             if (dst.reg < 0 && src.reg < 0 && !src.isConstant) {
@@ -1485,8 +1661,29 @@ private:
             store(0, value);
             return Next;
         }
+        case op_call: {
+            Vector<size_t> branches;
+            FloatPath floatPath;
+            if (!m_fastPaths.emit(instruction, offset, branches, floatPath))
+                return Stop;
+            for (size_t i : branches)
+                m_code.fixups[i].targetBuffer = m_plainStart[offset];
+            // The callee used the registers: reload them from the frame,
+            // where every write went. A variable that is no longer an int32
+            // (or not yet one) goes on in the plain code.
+            unsigned next = offset + instruction->size();
+            for (auto [slot, reg] : m_registers) {
+                m_code.cmpFrameImm(int32Tag, slot);
+                m_code.branchToBuffer(Builder::NotEqual, m_plainStart[next]);
+                m_code.loadFrame(slot + 4, reg);
+            }
+            return Next;
+        }
         case op_get_by_id:
-        case op_put_by_id: {
+        case op_put_by_id:
+        case op_get_by_val:
+        case op_put_by_val:
+        case op_get_length: {
             Vector<size_t> branches;
             FloatPath floatPath;
             if (!m_fastPaths.emit(instruction, offset, branches, floatPath))
@@ -1494,8 +1691,15 @@ private:
             // Its slow cases run the plain code's instruction.
             for (size_t i : branches)
                 m_code.fixups[i].targetBuffer = m_plainStart[offset];
-            if (instruction->opcodeID() == op_get_by_id) {
-                Value dst = valueFor(instruction->as<OpGetById>().m_dst);
+            std::optional<VirtualRegister> result;
+            if (instruction->opcodeID() == op_get_by_id)
+                result = instruction->as<OpGetById>().m_dst;
+            else if (instruction->opcodeID() == op_get_by_val)
+                result = instruction->as<OpGetByVal>().m_dst;
+            else if (instruction->opcodeID() == op_get_length)
+                result = instruction->as<OpGetLength>().m_dst;
+            if (result) {
+                Value dst = valueFor(*result);
                 if (dst.reg >= 0) {
                     // Not an int32: the value is in the frame; go on in the plain code.
                     m_code.cmpFrameImm(int32Tag, dst.hi);
