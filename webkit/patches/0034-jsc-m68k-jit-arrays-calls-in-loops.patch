 #include "JSCallee.h"
@@ -218,6 +220,11 @@ public:
     void lsl3(unsigned dn) { word(0xe788 | dn); } // lsl.l #3,dn
     void neg(unsigned dn) { word(0x4480 | dn); } // neg.l dn
     void tst(unsigned dn) { word(0x4a80 | dn); } // tst.l dn
+    void loadByteDisp(unsigned an, int disp, unsigned dn) { word(0x1028 | (dn << 9) | an); word(disp); } // move.b d16(an),dn
+    void andByteImm(uint8_t imm, unsigned dn) { word(0x0200 | dn); word(imm); } // andi.b #imm,dn
+    void cmpByteImm(uint8_t imm, unsigned dn) { word(0x0c00 | dn); word(imm); } // cmpi.b #imm,dn
+    void btstImm(unsigned bit, unsigned dn) { word(0x0800 | dn); word(bit); } // btst #bit,dn
+    void loadIndexed(unsigned an, unsigned index, int d8, unsigned dn) { word(0x2030 | (dn << 9) | an); word(Builder::index(index, d8)); } // move.l d8(an,index.l),dn
     // An index byte for d8(an,dn.l).
     static uint16_t index(unsigned dn, int d8)
