From 620dc478e4bcf8b65b906ecfb19385aa9e35dc42 Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Tue, 20 Oct 2026 23:20:23 +0000
Subject: [PATCH] JavaScriptCore: array access and calls in loops in the 68k
 template JIT

- get_by_val and put_by_val get their own code for arrays of int32s or of
  any values (Int32Shape, ContiguousShape) by an int32 index below the
  length: holes, other shapes, copy-on-write arrays, appends and other
  bases go to the template. put_by_val stores only int32s to an Int32Shape
  array, and leaves stores of cells that may need the write barrier to the
  template, as put_by_id does.
- get_length gets its own code for arrays (the interpreter's ArrayLength
  mode).
- Loop register copies cover get_by_val, put_by_val, get_length, moves of
  any constant to slots outside the registers, and calls: after a call
  the registers are reloaded from the frame, where every write went.
- A nested entry from C++ saves only the register file's sp and lr slots:
  the m68k interpreter uses no other slot a C call must keep.

An array loop runs 3.5x fewer 68k instructions (8.5x fewer than the
interpreter), sort with a comparator 1.08x, closures 1.07x, calls 1.03x.
---
 .../llint/LowLevelInterpreter.cpp             |  15 +-
 .../JavaScriptCore/llint/M68KTemplateJIT.cpp  | 220 +++++++++++++++++-
 2 files changed, 220 insertions(+), 15 deletions(-)

diff --git a/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp b/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
index 6e7ecbb49ae..c68861d1896 100644
--- a/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
+++ b/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
@@ -364,19 +364,20 @@ static void* findCLoopStackPointerField(CLoopStack& stack)
     return field;
 }
 
-// The first register file slot a nested entry must give back: the
-// interpreter's t registers are not kept across the C call a nested entry
-// happens in (as on every CPU), so only sp, lr, pc, zr and the callee-saved
-// registers are.
+// The register file slots a nested entry must give back: the interpreter's
+// t registers are not kept across the C call a nested entry happens in (as
+// on every CPU), and its callee-saved registers are 68k registers
+// (M68K_PINNED in offlineasm/m68k.py) or constants, so only sp and lr are.
 static constexpr unsigned M68KSlotFirstKept = M68KSlotSP;
-static constexpr unsigned M68KKeptWords = (M68KSlotCount - M68KSlotFirstKept) * 2;
+static_assert(M68KSlotLR == M68KSlotSP + 1);
+static constexpr unsigned M68KKeptWords = 4;
 
 // A straight run of move.l (a)+,(a)+: the C library's memcpy, and a loop,
 // cost several times the copy for these few words on the 68k.
 static ALWAYS_INLINE void copyM68KWords(uint32_t* to, const uint32_t* from)
 {
-    static_assert(M68KKeptWords == 30);
-    __asm__ volatile(".rept 30\n\tmove.l (%1)+,(%0)+\n\t.endr"
+    static_assert(M68KKeptWords == 4);
+    __asm__ volatile(".rept 4\n\tmove.l (%1)+,(%0)+\n\t.endr"
         : "+a"(to), "+a"(from)
         :
         : "memory");
diff --git a/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp b/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp
index 13c0a569c46..6b999621df8 100644
--- a/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp
+++ b/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp
@@ -28,7 +28,9 @@
