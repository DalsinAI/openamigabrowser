From ecabf310c91808fdccd70ef308ef38b91bc5449b Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Fri, 23 Oct 2026 16:47:29 +0000
Subject: [PATCH] WebCore: find the package's openfont.library from the
 engine's drawer

The one engine runs from the drawer's Libs/WebBrowser/, while the package
keeps openfont.library in the drawer's Libs/. Without LIBS:openfont.library
the engine looked in PROGDIR:Libs/ only, opened no library, found no face
and stopped at lastResortFallbackFont's RELEASE_ASSERT on most pages. It
now also looks in PROGDIR:/ (the drawer's Libs/).

Team 3
---
 .../WebCore/platform/graphics/openfont/OpenFontLibrary.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/Source/WebCore/platform/graphics/openfont/OpenFontLibrary.c b/Source/WebCore/platform/graphics/openfont/OpenFontLibrary.c
index 6a748803917..f50110e4270 100644
--- a/Source/WebCore/platform/graphics/openfont/OpenFontLibrary.c
+++ b/Source/WebCore/platform/graphics/openfont/OpenFontLibrary.c
@@ -60,9 +60,12 @@ static void closeOpenFont(void)
 static void openOpenFont(void)
 {
     /* Version 1 is a preview whose structures may change in version 2, so
-     * version 1 exactly, with revision 3's layout calls: LIBS:'s, or the
-     * one in the program's drawer when LIBS: has none or an older one. */
-    static const char* const names[] = { OPENFONTNAME, "PROGDIR:Libs/" OPENFONTNAME };
+     * version 1 exactly, with revision 3's layout calls: LIBS:'s, or, when
+     * LIBS: has none or an older one, the one the package brings. The
+     * engine runs from the drawer's Libs/WebBrowser/, so that one is in
+     * the folder above (PROGDIR:/); a program in the drawer itself finds
+     * it in PROGDIR:Libs/. */
+    static const char* const names[] = { OPENFONTNAME, "PROGDIR:/" OPENFONTNAME, "PROGDIR:Libs/" OPENFONTNAME };
     unsigned i;
     for (i = 0; i < sizeof names / sizeof names[0] && !OpenFontBase; ++i) {
         OpenFontBase = OpenLibrary((CONST_STRPTR)names[i], OPENFONT_VERSION);
