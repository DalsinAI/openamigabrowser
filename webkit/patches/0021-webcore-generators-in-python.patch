+class HeapRange:
+    def __init__(self, first, last):
+        self.first = first
+        self.last = last
+
+
+def rubyEach(tree):
+    """Ruby's tree.map { |key, value| }: a mapping's pairs, or a list's items with no value."""
+    if isinstance(tree, dict):
+        return list(tree.items())
+    return [(item, None) for item in tree]
+
+
+class AbstractHeap:
+    def __init__(self, name, tree):
+        self.name = name
+        self.parent = None
+        if tree is None:
+            self.children = []
+        else:
+            self.children = [AbstractHeap(key, value) for key, value in rubyEach(tree)]
+        self.range = None
+
+    def setParent(self, parent):
+        parent.children.append(self)
+        self.parent = parent
+
+    def compute(self, start):
+        current = start
+        if not self.children:
+            self.range = HeapRange(start, current + 1)
+            return
+
+        for child in self.children:
+            child.compute(current)
+            current = child.range.last
+
+        self.range = HeapRange(start, current)
+
+    def dump(self, output):
+        self.shallowDump(output)
+        if self.parent:
+            output.write("-> ")
+            self.parent.dump(output)
+
+    def shallowDump(self, output):
+        output.write("%s<%d,%d>" % (self.name, self.range.first, self.range.last))
+
+    def deepDump(self, output, indent):
+        self.printIndent(output, indent)
+        self.shallowDump(output)
+        if not self.children:
+            output.write("\n")
+            return
+
+        output.write(":\n")
+        for child in self.children:
+            child.deepDump(output, indent + 1)
+
+    def generate(self, output):
+        output.write("constexpr JSC::DOMJIT::HeapRange %s(JSC::DOMJIT::HeapRange::ConstExpr, %d, %d);\n" % (self.name, self.range.first, self.range.last))
+        for child in self.children:
+            child.generate(output)
+
+    def printIndent(self, output, indent):
+        output.write("    " * indent)
