+#    documentation and/or other materials provided with the distribution.
+#
+# THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''
+# AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+# THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+# PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
+# BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+# CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+# SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+# INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+# Generates QuirkBehaviorID, the QuirkBehaviors:: constants, and the QuirksAccessors base class of Quirks
+# from QuirkBehaviors.yaml.
+#
+# usage: GenerateQuirkBehaviors.py [--outputDir <output>] --template <file> [--template <file>...]
+#            <QuirkBehaviors.yaml>
+#
+# Templates are ERB templates whose code is Python (".pyerb"); a template
+# named X.pyerb writes X. The YAML reader and the template renderer are
+# GeneratePreferences.py's.
+
+import argparse
+import os
+import re
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "WTF", "Scripts"))
+
+from GeneratePreferences import YAMLSubsetError, renderTemplateText, rubyInspect, yamlLoadFile  # noqa: E402
+
+
+def loadBehaviors(path):
+    try:
+        root = yamlLoadFile(path)
+    except YAMLSubsetError as e:
+        sys.stderr.write("error: Could not parse input file %s: %s\n" % (path, e))
+        sys.exit(1)
+    if not isinstance(root, dict) or not root:
+        sys.stderr.write("error: Input file %s is not a mapping of QuirkBehaviorID names to their fields.\n" % path)
+        sys.exit(1)
+    return list(root.items())
+
+
+class QuirkBehavior:
+    def __init__(self, id, opts):
+        self.id = id
+        self.available = opts.get("available") or "always"
+        self.parameters = opts.get("parameters") or []
+        self.isStatic = opts.get("static") or False
+        self.conditions = opts.get("conditions") or []
+        self.requiredConditions = self.conditions if opts.get("conditionsRequired") else []
+        self.accessor = None if opts.get("implementation") == "custom" else (opts.get("accessor") or self.constantName)
+        self.isExported = opts.get("export") or False
+
+    # Ruby's accessor and predicate methods are properties here, so that the
+    # templates read as the Ruby ones do.
+
+    @property
+    def constantName(self):
+        return self.id[0].lower() + self.id[1:]
+
+    @property
+    def availableExpression(self):
+        return re.sub(r"\b([A-Za-z_]\w*)\b", r"BuildCondition::\1", self.available, flags=re.A)
+
+    @property
+    def initializer(self):
+        fields = [".id = QuirkBehaviorID::%s" % self.id, ".isAvailable = %s" % self.availableExpression]
+        if self.parameters:
+            fields.append(".quirkParametersNeeded = %s" % self.optionSet("QuirkParametersNeeded", ["Needs%s" % parameter for parameter in self.parameters]))
+        if self.conditions:
+            fields.append(".quirkConditionsSupported = %s" % self.optionSet("QuirkConditionsSupported", self.conditions))
+        if self.requiredConditions:
+            fields.append(".quirkConditionsNeeded = %s" % self.optionSet("QuirkConditionsSupported", self.requiredConditions))
+        return "{ %s }" % ", ".join(fields)
+
+    @property
+    def hasGeneratedAccessor(self):
+        return self.accessor is not None
+
+    @property
+    def shape(self):
+        if self.isStatic:
+            return "staticURL"
+        if self.conditions == ["SecondaryURL"]:
+            return "secondaryURL"
+        if self.conditions == ["ElementSelector"]:
+            return "node"
+        return None
+
+    @property
+    def argument(self):
+        return {"staticURL": "const URL&", "secondaryURL": "const URL&", "node": "const Node&"}.get(self.shape)
+
+    # Only the argument-less body is free of refcounting; the others copy a URL or hold a RefPtr.
+    @property
+    def isNoDelete(self):
+        return self.shape is None
+
+    @property
+    def parameterList(self):
+        if self.argument:
+            return "%s %s" % (self.argument, "node" if self.shape == "node" else "url")
+        return ""
+
+    @property
+    def declaration(self):
+        prefix = "WEBCORE_EXPORT " if self.isExported else ""
+        if self.isStatic:
+            prefix += "static "
+        nodelete = "NODELETE " if self.isNoDelete else ""
+        return "%sbool %s%s(%s)%s;" % (prefix, nodelete, self.accessor, self.argument or "", self.constSuffix)
+
+    @property
+    def definitionSignature(self):
+        return "bool QuirksAccessors::%s(%s)%s" % (self.accessor, self.parameterList, self.constSuffix)
+
+    @property
+    def body(self):
+        id = "QuirkBehaviorID::%s" % self.id
+        shape = self.shape
+        if shape == "staticURL":
+            return "return resolveTopURLQuirks(url).isBehaviorEnabled(%s);" % id
+        if shape == "secondaryURL":
+            return "return needsQuirks() && m_quirksData.behaviorAppliesToURL(%s, url);" % id
+        if shape == "node":
+            return "return needsQuirks() && behaviorAppliesToNode(%s, &node);" % id
+        return "return needsQuirks() && m_quirksData.isBehaviorEnabled(%s);" % id
+
+    @property
+    def constSuffix(self):
+        return "" if self.isStatic else " const"
+
+    def optionSet(self, type, values):
+        values = ["%s::%s" % (type, value) for value in values]
+        return values[0] if len(values) == 1 else "OptionSet<%s> { %s }" % (type, ", ".join(values))
+
+
+class QuirkBehaviors:
+    FIELDS = ["available", "parameters", "conditions", "conditionsRequired", "implementation", "accessor", "static", "export"]
+    GENERATED_ONLY_FIELDS = ["accessor", "static", "export"]
+    PARAMETERS = ["Script", "UserAgent", "ChromeCompatibilityVersion", "CookieNames"]
+    CONDITIONS = ["ElementSelector", "SecondaryURL", "DocumentSelector"]
+
+    def __init__(self, path):
+        self.behaviors = []
+        self.warning = "THIS FILE WAS AUTOMATICALLY GENERATED, DO NOT EDIT."
+
+        failed = [False]
+
+        def reject(msg):
+            sys.stderr.write("error: %s: %s\n" % (path, msg))
+            failed[0] = True
+
+        seen = {}
+        accessorNames = {}
+        for id, opts in loadBehaviors(path):
+            if id in seen:
+                reject("%s is defined more than once." % id)
+                continue
+            seen[id] = True
+            opts = opts or {}
+            if not re.fullmatch(r"[A-Z]\w*", id, flags=re.A):
+                reject("%s is not a valid QuirkBehaviorID name." % id)
+            for field in opts.keys():
+                if field not in self.FIELDS:
+                    reject("%s has unknown field \"%s\". Allowed fields: %s." % (id, field, ", ".join(self.FIELDS)))
+            for parameter in opts.get("parameters") or []:
+                if parameter not in self.PARAMETERS:
+                    reject("%s has unknown parameter \"%s\"." % (id, parameter))
+            for condition in opts.get("conditions") or []:
+                if condition not in self.CONDITIONS:
+                    reject("%s has unknown condition \"%s\"." % (id, condition))
+
+            behavior = QuirkBehavior(id, opts)
+            generated = behavior.hasGeneratedAccessor
+            if opts.get("implementation") and opts["implementation"] != "custom":
+                reject("%s has implementation \"%s\"; the only value is \"custom\"." % (id, opts["implementation"]))
+            if not generated:
+                for field in self.GENERATED_ONLY_FIELDS:
+                    if field in opts:
+                        reject("%s has a custom implementation, so \"%s\" would be ignored." % (id, field))
+            if generated and behavior.parameters:
+                reject("%s has parameters, which a generated accessor cannot read. Use \"implementation: custom\"." % id)
+            if generated and behavior.shape == "staticURL" and behavior.conditions:
+                reject("%s is static, so it only sees top-URL quirks and cannot evaluate conditions." % id)
+            if generated and behavior.conditions and not behavior.shape:
+                reject("%s has conditions %s; a generated accessor supports only [ElementSelector] or [SecondaryURL]. Use \"implementation: custom\"." % (id, rubyInspect(behavior.conditions)))
+            if generated and accessorNames.get(behavior.accessor):
+                reject("%s's accessor %s is also generated for %s." % (id, behavior.accessor, accessorNames[behavior.accessor]))
+            if generated:
+                accessorNames[behavior.accessor] = id
+            if opts.get("conditionsRequired") and not behavior.conditions:
+                reject("%s has conditionsRequired but no conditions." % id)
+            if opts.get("accessor") and opts["accessor"] == behavior.constantName:
+                reject("%s has accessor %s, which is already the default; remove it." % (id, behavior.accessor))
+
+            self.behaviors.append(behavior)
+        if failed[0]:
+            sys.exit(1)
+
+    def renderTemplate(self, templateFile, outputDirectory):
+        name = os.path.basename(templateFile)
+        if name.endswith(".pyerb"):
+            name = name[:-len(".pyerb")]
+        resultFile = os.path.join(outputDirectory, name)
+        tempResultFile = resultFile + ".tmp"
+
+        with open(templateFile) as f:
+            output = renderTemplateText(f.read(), templateFile, self)
+        with open(tempResultFile, "w") as f:
+            f.write(output)
+        oldContents = None
+        if os.path.exists(resultFile):
+            with open(resultFile) as f:
+                oldContents = f.read()
+        if oldContents != output:
+            os.replace(tempResultFile, resultFile)
+        else:
+            os.remove(tempResultFile)
+            if os.path.getmtime(resultFile) < os.path.getmtime(templateFile):
+                os.utime(resultFile)
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        usage="%(prog)s [--outputDir <output>] --template <file> [--template <file>...] <QuirkBehaviors.yaml>")
+    parser.add_argument("--template", action="append", default=[], help="template to use for generation (may be specified multiple times)")
+    parser.add_argument("--outputDir", default=os.getcwd(), help="directory to generate file in (default: cwd)")
+    parser.add_argument("behaviorsFile", nargs="*")
+    options = parser.parse_args()
+
+    if len(options.behaviorsFile) != 1:
+        parser.print_usage()
+        sys.exit(1)
+
+    os.makedirs(options.outputDir, exist_ok=True)
+
+    quirkBehaviors = QuirkBehaviors(options.behaviorsFile[0])
+
+    for template in options.template:
+        quirkBehaviors.renderTemplate(template, options.outputDir)
+
+
+if __name__ == "__main__":
+    main()
