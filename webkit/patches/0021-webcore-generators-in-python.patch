+
+namespace WebCore {
+
+QuirksAccessors::QuirksAccessors(Document& document)
+    : m_document(document)
+{
+}
+
+QuirksAccessors::~QuirksAccessors() = default;
+
+bool QuirksAccessors::needsQuirks() const
+{
+    return m_document && m_document->settings().needsSiteSpecificQuirks();
+}
+
+bool QuirksAccessors::elementMatchesSelectorCondition(ASCIILiteral selector, const Node* node)
+{
+    if (!node)
+        return false;
+
+    RefPtr element = lineageOfType<Element>(*node).first();
+    if (!element)
+        return false;
+
+    auto* query = SelectorQueryCache::singleton().add(selector, protect(element->document()));
+    if (!query) {
+        ASSERT_NOT_REACHED();
+        return false;
+    }
+
+    return query->matches(const_cast<Element&>(*element));
+}
+
+bool QuirksAccessors::behaviorAppliesToNode(QuirkBehaviorID id, const Node* node) const
+{
+    if (!m_quirksData.isBehaviorEnabled(id))
+        return false;
+
+    for (const auto& behavior : m_quirksData.behaviors()) {
+        if (behavior.id != id)
+            continue;
+
+        if (!behavior.conditions.elementSelector)
+            return true;
+
+        if (elementMatchesSelectorCondition(*behavior.conditions.elementSelector, node))
+            return true;
+    }
+
+    return false;
+}
+
+RefPtr<Element> QuirksAccessors::firstElementMatchingSelectorCondition(ASCIILiteral selector, Document& document)
+{
+    auto* query = SelectorQueryCache::singleton().add(selector, document);
+    if (!query) {
+        ASSERT_NOT_REACHED();
+        return nullptr;
+    }
+
+    return query->queryFirst(document);
+}
+
+RefPtr<Element> QuirksAccessors::elementMatchingDocumentSelectorCondition(QuirkBehaviorID id) const
+{
+    if (!m_quirksData.isBehaviorEnabled(id))
+        return nullptr;
+
+    RefPtr document = m_document.get();
+    if (!document)
+        return nullptr;
+
+    for (const auto& behavior : m_quirksData.behaviors()) {
+        if (behavior.id != id || !behavior.conditions.documentSelector)
+            continue;
+
+        if (RefPtr element = firstElementMatchingSelectorCondition(*behavior.conditions.documentSelector, *document))
+            return element;
+    }
+
+    return nullptr;
+}
+
+bool QuirksAccessors::behaviorAppliesToDocument(QuirkBehaviorID id) const
+{
+    if (!m_quirksData.isBehaviorEnabled(id))
+        return false;
+
+    bool appliesUnconditionally = std::ranges::any_of(m_quirksData.behaviors(), [&](const auto& behavior) {
+        return behavior.id == id && !behavior.conditions.documentSelector;
+    });
+
+    return appliesUnconditionally || elementMatchingDocumentSelectorCondition(id);
+}
+<%- for behavior in [x for x in self.behaviors if x.hasGeneratedAccessor]: -%>
+
+<%= behavior.definitionSignature %>
+{
+    <%= behavior.body %>
+}
+<%- end -%>
+
+} // namespace WebCore
