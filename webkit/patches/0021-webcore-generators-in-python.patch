+# 1. Redistributions of source code must retain the above copyright
+#    notice, this list of conditions and the following disclaimer.
+# 2. Redistributions in binary form must reproduce the above copyright
+#    notice, this list of conditions and the following disclaimer in the
+#    documentation and/or other materials provided with the distribution.
+#
+# THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''
+# AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+# THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+# PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
+# BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+# CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+# SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+# INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+# usage: GenerateSettings.py [--outputDir <output>] --template <input> [--template <file>...]
+#            <settings> [<settings>...]
+#
+# Templates are ERB templates whose code is Python (".pyerb"); a template
+# named X.pyerb writes X. The YAML reader and the template renderer are
+# GeneratePreferences.py's.
+
+import argparse
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "WTF", "Scripts"))
+
+from GeneratePreferences import YAMLSubsetError, renderTemplateText, yamlLoadFile  # noqa: E402
+
+# Keep in sync with GeneratePreferences.py, which validates this shape.
+FRONTENDS = ["WebKitLegacy", "WebKit", "WebCore"]
+
+
+# "defaultValue" is the value shared by every frontend the preference is in,
+# either directly or as a map of build conditions ending in "default". A frontend
+# is listed under it only where its value differs.
+def defaultValueFor(name, options, frontend):
+    specification = options.get("defaultValue")
+    if specification is None:
+        print("ERROR: %s: \"defaultValue\" is required and cannot be empty." % name)
+        sys.exit(255)
+    if not isinstance(specification, dict):
+        return {"default": specification}
+
+    if frontend in specification:
+        value = specification[frontend]
+    else:
+        value = {key: v for key, v in specification.items() if key not in FRONTENDS}
+    return value if isinstance(value, dict) else {"default": value}
+
+
+PREFERENCES_FILE_NAMES = ["UnifiedWebPreferences.yaml", "WebPreferencesAdditions.yaml"]
+
+SETTINGS_KEYS = """
+  comment condition defaultValue disableInLockdownMode inspectorOverride refinedType
+  status type webcoreExcludeFromInternalSettings webcoreGetter webcoreImplementation
+  webcoreName webcoreOnChange
+""".split()
+
+
+def validate(path, parsed):
+    failed = False
+    for name, options in parsed.items():
+        for key in options.keys():
+            if key not in SETTINGS_KEYS:
+                print("ERROR: %s: %s: \"%s\" is not a known key." % (path, name, key))
+                failed = True
+        if isinstance(options.get("defaultValue"), dict) and any(key in FRONTENDS for key in options["defaultValue"].keys()):
+            print("ERROR: %s: %s: \"defaultValue\" must not name frontends, these settings are WebCore only." % (path, name))
+            failed = True
+    if failed:
+        sys.exit(255)
+
+
+def load(path):
+    try:
+        parsed = yamlLoadFile(path)
+    except YAMLSubsetError as e:
+        print("ERROR: Could not parse input file: %s" % e)
+        sys.exit(255)
+
+    if not parsed:
+        return {}
+
+    previousName = None
+    for name in parsed.keys():
+        if previousName is not None and previousName > name:
+            print("ERROR: Input file %s is not sorted. First out of order name found is '%s'." % (path, name))
+            sys.exit(255)
+        previousName = name
+
+    if os.path.basename(path) not in PREFERENCES_FILE_NAMES:
+        validate(path, parsed)
+
+    return parsed
+
+
+class Setting:
+    def __init__(self, name, options):
+        self.name = self.normalizeNameForWebCore(name, options)
+        self.options = options
+        self.type = options.get("refinedType") or options.get("type")
+        self.status = options.get("status")
+        self.defaultValues = defaultValueFor(name, options, "WebCore")
+        self.excludeFromInternalSettings = options.get("webcoreExcludeFromInternalSettings") or False
+        self.disableInLockdownMode = options.get("disableInLockdownMode") or False
+        self.condition = options.get("condition")
+        self.onChange = options.get("webcoreOnChange")
+        self.getter = options.get("webcoreGetter")
+        self.inspectorOverride = options.get("inspectorOverride")
+        self.customImplementation = options.get("webcoreImplementation") == "custom"
+
+    def normalizeNameForWebCore(self, name, options):
+        if options.get("webcoreName"):
+            return options["webcoreName"]
+        elif name.startswith("VP"):
+            return name[0:2].lower() + name[2:]
+        elif name.startswith(("CSSOM", "HTTPS")):
+            return name
+        elif name.startswith(("URL", "CSS", "XSS", "FTP", "DOM", "DNS", "PDF", "ICE", "HDR", "RTC", "SVG")):
+            return name[0:3].lower() + name[3:]
+        elif name.startswith(("HTTP", "HTML")):
+            return name[0:4].lower() + name[4:]
+        return name[0].lower() + name[1:]
+
+    # Ruby's predicate and accessor methods are properties here, so that the
+    # templates read as the Ruby ones do.
+
+    @property
+    def valueType(self):
+        return self.type != "String" and self.type != "URL"
+
+    @property
+    def idlType(self):
+        # FIXME: Add support for more types including enum types.
+        return {"uint32_t": "unsigned long", "double": "double", "String": "DOMString", "bool": "boolean"}.get(self.type)
+
+    @property
+    def parameterType(self):
+        if self.valueType:
+            return self.type
+        return "const %s&" % self.type
+
+    @property
+    def hasComplexSetter(self):
+        return self.onChange is not None or self.hasInspectorOverride
+
+    @property
+    def setterFunctionName(self):
+        name = self.name
+        if name.startswith("html"):
+            return "set" + name[0:4].upper() + name[4:]
+        elif name.startswith(("url", "css", "xss", "ftp", "dom", "dns", "ice", "hdr", "pdf", "rtc", "svg")):
+            return "set" + name[0:3].upper() + name[3:]
+        elif name.startswith("vp"):
+            return "set" + name[0:2].upper() + name[2:]
+        return "set" + name[0].upper() + name[1:]
+
+    @property
+    def getterFunctionName(self):
+        return self.getter or self.name
+
+    @property
+    def hasInspectorOverride(self):
+        return self.inspectorOverride is True
+
+    @property
+    def stableFeature(self):
+        # FIXME: Not all "embedder" settings should be considered stable, only the
+        # settings that are on by default. Assuming embedder gets split into two
+        # categories (off-by-default and on-by-default), only the latter should be
+        # considered stable.
+        return not self.status or self.status in ("embedder", "internal", "stable", "mature")
+
+
+class Conditional:
+    def __init__(self, condition, settings):
+        self.condition = condition
+
+        self.settings = settings
+        self.settingsNeedingImplementation = [s for s in self.settings if not s.customImplementation]
+
+        self.boolSettings = [s for s in self.settings if s.type == "bool"]
+        self.boolSettingsNeedingImplementation = [s for s in self.boolSettings if not s.customImplementation]
+
+        self.nonBoolSettings = [s for s in self.settings if s.type != "bool"]
+        self.nonBoolSettingsNeedingImplementation = [s for s in self.nonBoolSettings if not s.customImplementation]
+
+        self.settingsWithComplexSetters = [s for s in self.settings if s.hasComplexSetter]
+        self.settingsWithComplexSettersNeedingImplementation = [s for s in self.settingsWithComplexSetters if not s.customImplementation]
+
+
+class SettingSet:
+    def __init__(self, settings):
+        self.settings = sorted(settings, key=lambda setting: setting.name)
+
+        self.inspectorOverrideSettings = [s for s in self.settings if s.hasInspectorOverride]
+
+        self.conditions = []
+        conditionsMap = {}
+        for setting in [s for s in self.settings if s.condition]:
+            conditionsMap.setdefault(setting.condition, []).append(setting)
+        for key, value in conditionsMap.items():
+            self.conditions.append(Conditional(key, value))
+        self.conditions.sort(key=lambda conditional: conditional.condition)
+
+        # We also add the unconditional settings as the first element in the conditions array.
+        self.conditions.insert(0, Conditional(None, [s for s in self.settings if not s.condition]))
+
+
+class Settings:
+    def __init__(self, settingsFiles):
+        settingsByName = {}
+        globalSettingsByName = {}
+        for file in settingsFiles:
+            for name, options in load(file).items():
+                # Preferences excluded from WebCore have no Settings member at all, and the
+                # deprecated globals are declared by hand in DeprecatedGlobalSettings.h.
+                if options.get("webcoreDeprecatedGlobalSettings"):
+                    target = globalSettingsByName
+                elif "WebCore" not in (options.get("excludeFrom") or []):
+                    target = settingsByName
+                else:
+                    continue
+                if name in target:
+                    print("ERROR: %s: %s is already defined, and the later definition would silently win." % (file, name))
+                    sys.exit(255)
+                target[name] = Setting(name, options)
+
+        self.allSettingsSet = SettingSet(list(settingsByName.values()))
+        self.unstableFeatures = [s for s in settingsByName.values() if not s.stableFeature]
+        self.unstableGlobalFeatures = [s for s in globalSettingsByName.values() if not s.stableFeature]
+
+    def renderTemplate(self, template, outputDirectory):
+        name = os.path.basename(template)
+        if name.endswith(".pyerb"):
+            name = name[:-len(".pyerb")]
+        with open(template) as f:
+            output = renderTemplateText(f.read(), template, self)
+        with open(os.path.join(outputDirectory, name), "w") as f:
+            f.write(output)
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        usage="%(prog)s [--outputDir <output>] --template <input> [--template <file>...] <settings> [<settings>...]")
+    parser.add_argument("--outputDir", help="directory to generate file in")
+    parser.add_argument("--template", action="append", default=[], help="template to use for generation (may be specified multiple times)")
+    parser.add_argument("settingsFiles", nargs="*")
+    options = parser.parse_args()
+
+    if not options.settingsFiles:
+        parser.print_usage()
+        sys.exit(1)
+
+    outputDirectory = options.outputDir or os.getcwd()
+    os.makedirs(outputDirectory, exist_ok=True)
+
+    settings = Settings(options.settingsFiles)
+
+    for template in options.template:
+        settings.renderTemplate(template, outputDirectory)
+
+
+if __name__ == "__main__":
+    main()
