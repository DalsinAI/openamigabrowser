 )
 
+# Web platform features the port turns off (OptionsAmiga.cmake) are left out
+# of the build, not only switched off by setting: their IDL files (so no
+# JavaScript bindings are generated, and no constructor or property names
+# them), the bindings generated from those files, and their sources. The
+# rest of WebCore leaves their calls out with the feature's ENABLE() flag.
+# The IDL files stay readable to the bindings generator (INCLUDED_FILES in
+# CMakeLists.txt) for compiled-out members that still name their types.
+set(WebCore_LEFT_OUT_IDL_FILES "")
+macro(AMIGA_LEAVE_OUT _feature _idlRegex)
+    if (NOT ${_feature})
+        foreach (_idl IN LISTS WebCore_IDL_FILES WebCore_SUPPLEMENTAL_IDL_FILES)
+            if (_idl MATCHES "${_idlRegex}")
+                list(APPEND WebCore_LEFT_OUT_IDL_FILES "${_idl}")
+                get_filename_component(_name "${_idl}" NAME_WE)
+                if (NOT _name MATCHES "\\+")
+                    list(APPEND WebCore_UNIFIED_SOURCE_EXCLUDES "^JS${_name}\\.cpp( |$)")
+                endif ()
+            endif ()
+        endforeach ()
+        list(FILTER WebCore_IDL_FILES EXCLUDE REGEX "${_idlRegex}")
+        list(FILTER WebCore_SUPPLEMENTAL_IDL_FILES EXCLUDE REGEX "${_idlRegex}")
+        list(APPEND WebCore_UNIFIED_SOURCE_EXCLUDES ${ARGN})
+    endif ()
+endmacro()
+
+AMIGA_LEAVE_OUT(ENABLE_ACCESSIBILITY "^$"
+    "^accessibility/"
+)
+AMIGA_LEAVE_OUT(ENABLE_ASYNC_CLIPBOARD "(^|/)Modules/async-clipboard/"
+    "^Modules/async-clipboard/"
+)
+AMIGA_LEAVE_OUT(ENABLE_CACHE_API "(^|/)Modules/cache/"
+    # The connection classes stay: CacheStorageProvider (page/) is built on them.
+    "^Modules/cache/(DOMCache|DOMCacheStorage|WindowOrWorkerGlobalScopeCaches)\\.cpp"
+)
+AMIGA_LEAVE_OUT(ENABLE_CREDENTIAL_MANAGEMENT "(^|/)Modules/(credentialmanagement|identity)/"
+    "^Modules/(credentialmanagement|identity)/"
+)
+AMIGA_LEAVE_OUT(ENABLE_FILE_SYSTEM_API "(^|/)Modules/(filesystem|entriesapi)/"
+    # FileSystemStorageConnection stays: StorageConnection and serialized values use it.
+    "^Modules/entriesapi/"
+    "^Modules/filesystem/(FileSystemDirectoryHandle|FileSystemFileHandle|FileSystemHandle|FileSystemHandleStorageKeepAlive|FileSystemSyncAccessHandle|FileSystemWritableFileStream|FileSystemWritableFileStreamSink|WorkerFileSystemStorageConnection)\\.cpp"
+)
+AMIGA_LEAVE_OUT(ENABLE_INDEXED_DATABASE "(^|/)Modules/indexeddb/"
+    "^Modules/indexeddb/"
+    "^bindings/js/IDBBindingUtilities\\.cpp"
+    "^bindings/js/JSIDB(Cursor|CursorWithValue|ObjectStore|Record|Request|Transaction)Custom\\.cpp"
+)
+AMIGA_LEAVE_OUT(ENABLE_PUSH_API "(^|/)Modules/push-api/(Push|ServiceWorker)"
+    "^Modules/push-api/"
+)
+AMIGA_LEAVE_OUT(ENABLE_SERVICE_WORKER "(^|/)workers/service/"
+    # The value types stay: loaders and workers carry them.
+    "^workers/service/(server|context|background-fetch)/"
+    "^workers/service/(ExtendableEvent|ExtendableMessageEvent|FetchEvent|InstallEvent|NavigationPreloadManager|SWClientConnection|ServiceWorker|ServiceWorkerClient|ServiceWorkerClients|ServiceWorkerContainer|ServiceWorkerGlobalScope|ServiceWorkerJob|ServiceWorkerProvider|ServiceWorkerRegistration|ServiceWorkerWindowClient|WorkerSWClientConnection)\\.cpp"
+    "^bindings/js/JS(ExtendableMessageEvent|FetchEvent|ServiceWorkerGlobalScope)Custom\\.cpp"
+)
+AMIGA_LEAVE_OUT(ENABLE_SHARED_WORKER "(^|/)workers/shared/"
+    "^workers/shared/"
+)
