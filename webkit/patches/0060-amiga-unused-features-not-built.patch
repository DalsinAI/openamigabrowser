+// The Amiga port builds WebCore without IndexedDB (ENABLE_INDEXED_DATABASE
+// off, patch 0060): Modules/indexeddb/ is not compiled and no document or
+// worker makes an IDBConnectionProxy. Code outside it still holds the proxy
+// and the database-names request in RefPtrs, whose destructors and vtables
+// name these functions; they are never reached.
+
+#include "config.h"
+
+#if !ENABLE(INDEXED_DATABASE)
+
+#include "IDBConnectionProxy.h"
+#include "IDBDatabaseNameAndVersionRequest.h"
+
+namespace WebCore {
+
+void IDBClient::IDBConnectionProxy::deref()
+{
+    RELEASE_ASSERT_NOT_REACHED();
+}
+
+bool IDBDatabaseNameAndVersionRequest::virtualHasPendingActivity() const
+{
+    return false;
+}
+
+void IDBDatabaseNameAndVersionRequest::stop()
+{
+}
+
+} // namespace WebCore
+
+#endif // !ENABLE(INDEXED_DATABASE)
