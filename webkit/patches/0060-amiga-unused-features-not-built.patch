+// The Amiga port builds WebCore without accessibility (ENABLE_ACCESSIBILITY
+// off, patch 0060): accessibility/ is not compiled and documents never make
+// an AXObjectCache. The few accessibility helpers that code outside
+// accessibility/ still calls are answered here.
+
+#include "config.h"
+
+#if !ENABLE(ACCESSIBILITY)
+
+#include "AXObjectCache.h"
+#include "AccessibilityObject.h"
+#include <wtf/text/StringView.h>
+
+namespace WebCore {
+
+// The ARIA role of an element, for the roles WebCore checks for outside
+// accessibility/ (buttons and navigation landmarks); any other role is
+// Unknown. As in AccessibilityObject.cpp, the first known token counts.
+AccessibilityRole AccessibilityObject::ariaRoleToWebCoreRole(const String& value)
+{
+    if (value.isEmpty())
+        return AccessibilityRole::Unknown;
+    for (auto roleName : StringView(value).split(' ')) {
+        if (equalLettersIgnoringASCIICase(roleName, "button"_s))
+            return AccessibilityRole::Button;
+        if (equalLettersIgnoringASCIICase(roleName, "navigation"_s))
+            return AccessibilityRole::LandmarkNavigation;
+    }
+    return AccessibilityRole::Unknown;
+}
+
+// Text for accessibility notifications, which are never posted.
+String AccessibilityObject::stringForVisiblePositionRange(const VisiblePositionRange&)
+{
+    return { };
+}
+
+// Editing commands note the text they replace for a notification; with no
+// AXObjectCache there is nothing to note or to post.
+AccessibilityReplacedText::AccessibilityReplacedText(const VisibleSelection&)
+{
+}
+
+void AccessibilityReplacedText::postTextStateChangeNotification(AXObjectCache*, AXTextEditType, const String&, const VisibleSelection&)
+{
+}
+
+// Called only through a document's AXObjectCache, which is never made.
+void AXObjectCache::handlePageEditibilityChanged(Document&)
+{
+}
+
+} // namespace WebCore
+
+#endif // !ENABLE(ACCESSIBILITY)
