From 757c5c15fec04e0a222137b660a401c5c1e0dd06 Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Thu, 22 Oct 2026 06:12:47 +0000
Subject: [PATCH] JavaScriptCore: arguments objects made in the 68k template
 JIT

op_create_direct_arguments makes the DirectArguments in line, as the
DFG does: a cell sized for max(length, parameter count) slots from the
cell space's allocator for that size and its current interval, then
the arguments copied in from the frame. More than 32 slots, a size with
no allocator yet, or an empty interval is the template's.

Team 3
---
 .../JavaScriptCore/llint/M68KTemplateJIT.cpp  | 84 +++++++++++++++++++
 1 file changed, 84 insertions(+)

diff --git a/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp b/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp
index 7577bbe4d6b..8ebeb3cc3c2 100644
--- a/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp
+++ b/Source/JavaScriptCore/llint/M68KTemplateJIT.cpp
@@ -1384,6 +1384,88 @@ private:
         return true;
     }
 
+    // `arguments` (the DFG's compileCreateDirectArguments; the
+    // interpreter's DirectArguments::createByCopying): a cell of the size
+    // for max(length, the parameter count) slots from the cell space's
+    // allocator for that size, its current interval, then the arguments
+    // (the frame has a slot for every parameter) copied in. More than 32
+    // slots, a size with no allocator yet or an empty interval is the
+    // template's.
+    bool createDirectArguments(const JSInstruction* instruction)
+    {
+        auto bytecode = instruction->as<OpCreateDirectArguments>();
+        Operand dst = operandFor(m_codeBlock, bytecode.m_dst);
+        if (!dst.valid || dst.isConstant || m_inline)
+            return false;
+        constexpr unsigned maxCapacity = 32;
+        unsigned minCapacity = m_codeBlock->numParameters() - 1;
+        Structure* structure = m_codeBlock->globalObject()->directArgumentsStructure();
+        CompleteSubspace* subspace = subspaceForConcurrently<DirectArguments>(m_codeBlock->vm());
+        if (minCapacity > maxCapacity || !structure || structure->inlineCapacity() || !subspace)
+            return false;
+        constexpr int slot = sizeof(Register);
+        constexpr int count = static_cast<int>(CallFrameSlot::argumentCountIncludingThis) * slot + 4;
+        constexpr int intervalStart = LocalAllocator::offsetOfFreeList() + FreeList::offsetOfIntervalStart();
+        constexpr int intervalEnd = LocalAllocator::offsetOfFreeList() + FreeList::offsetOfIntervalEnd();
+        unsigned storage = DirectArguments::storageOffset();
+        static_assert(sizeof(Allocator) == sizeof(LocalAllocator*) && MarkedSpace::sizeStep == 16);
+        if (storage + maxCapacity * sizeof(Register) > MarkedSpace::largeCutoff)
+            return false;
+        // d0 the capacity, then the size's allocator into a1.
+        m_hot.loadFrame(count, 0);
+        m_hot.word(0x5380); // subq.l #1,d0
+        if (minCapacity) {
+            m_hot.word(0x0c80); m_hot.longWord(minCapacity); // cmpi.l #imm,d0
+            size_t enough = m_hot.branchShort(Builder::CarryClear);
+            m_hot.word(0x203c); m_hot.longWord(minCapacity); // move.l #imm,d0
+            m_hot.bindShort(enough);
+        }
+        m_hot.word(0x0c80); m_hot.longWord(maxCapacity);
+        slowUnless(Builder::Higher);
+        m_hot.word(0x2200); // move.l d0,d1
+        m_hot.word(0xe789); // lsl.l #3,d1
+        m_hot.word(0x0681); m_hot.longWord(storage + MarkedSpace::sizeStep - 1); // addi.l #imm,d1
+        m_hot.word(0xe889); // lsr.l #4,d1
+        m_hot.word(0xe589); // lsl.l #2,d1
+        m_hot.word(0x43f9); m_hot.longWord(reinterpret_cast<uintptr_t>(subspace->allocatorsForSizeSteps().data())); // lea (abs).l,a1
+        m_hot.word(0x2231); m_hot.word(0x1800); // move.l 0(a1,d1.l),d1
+        slowUnless(Builder::Equal);
+        m_hot.moveaFromData(1, 1);
+        // The cell from the interval (allocateObject).
+        m_hot.moveaDisp(1, intervalStart, 0);
+        m_hot.word(0xb1e9); m_hot.word(intervalEnd); // cmpa.l end(a1),a0
+        slowUnless(Builder::CarryClear);
+        m_hot.loadDisp(1, LocalAllocator::offsetOfCellSize(), 1);
+        m_hot.word(0xd288); // add.l a0,d1
+        m_hot.word(0x2341); m_hot.word(intervalStart); // move.l d1,start(a1)
+        static_assert(sizeof(StructureID) == sizeof(uint32_t));
+        m_hot.storeImmDisp(reinterpret_cast<uintptr_t>(structure), 0, JSCell::structureIDOffset());
+        m_hot.word(0x2179); m_hot.longWord(reinterpret_cast<uintptr_t>(structure) + Structure::indexingModeIncludingHistoryOffset()); m_hot.word(JSCell::indexingTypeAndMiscOffset()); // move.l (abs).l,d16(a0)
+        m_hot.word(0x42a8); m_hot.word(JSObject::butterflyOffset()); // clr.l d16(a0)
+        m_hot.word(0x42a8); m_hot.word(DirectArguments::offsetOfModifiedArgumentsDescriptor());
+        m_hot.word(0x42a8); m_hot.word(DirectArguments::offsetOfMappedArguments());
+        m_hot.storeImmDisp(minCapacity, 0, DirectArguments::offsetOfMinCapacity());
+        m_hot.loadFrame(count, 1);
+        m_hot.word(0x5381); // subq.l #1,d1
+        m_hot.word(0x2141); m_hot.word(DirectArguments::offsetOfLength()); // move.l d1,d16(a0)
+        m_hot.copyFrameToDisp(static_cast<int>(CallFrameSlot::callee) * slot + 4, 0, DirectArguments::offsetOfCallee());
+        // d0 slots from the first argument on.
+        m_hot.word(0x4a80); // tst.l d0
+        size_t none = m_hot.branchShort(Builder::Equal);
+        m_hot.word(0x43ed); m_hot.word(CallFrame::argumentOffset(0) * slot); // lea d16(a5),a1
+        m_hot.word(0x4de8); m_hot.word(storage); // lea d16(a0),a6
+        size_t loop = m_hot.size();
+        m_hot.word(0x2cd9); // move.l (a1)+,(a6)+
+        m_hot.word(0x2cd9);
+        m_hot.word(0x5380); // subq.l #1,d0
+        m_hot.branchToBuffer(Builder::NotEqual, loop);
+        m_hot.bindShort(none);
+        m_hot.clrFrame(dst.hi);
+        m_hot.word(0x2008); // move.l a0,d0
+        m_hot.storeFrame(0, dst.lo);
+        return true;
+    }
+
     // `index in array` (the array builtins' hole checks): true for an int32
     // index below the length of an Int32Shape or ContiguousShape array where
     // the element is not a hole; anything else is the template.
@@ -3185,6 +3267,8 @@ private:
             return Options::useM68KPropertyFastPaths() && newObject(instruction);
         case op_new_array:
             return Options::useM68KPropertyFastPaths() && newArray(instruction);
+        case op_create_direct_arguments:
+            return Options::useM68KPropertyFastPaths() && createDirectArguments(instruction);
         case op_create_this:
             return Options::useM68KPropertyFastPaths() && createThis(instruction);
         case op_put_by_val:
-- 
