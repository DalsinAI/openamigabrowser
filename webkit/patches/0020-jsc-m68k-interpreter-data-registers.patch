From 898a6482da7b0fc8a870c97a0486ccc6c4d54342 Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Mon, 19 Oct 2026 00:02:43 +0100
Subject: [PATCH] offlineasm M68K: t0-t3 in data registers (J1)

The low words of t0-t3 live in d4-d7 instead of the register file; their
high words stay there. The low word is what 32-bit and pointer operations
use, so most of the interpreter's work on them becomes register work: 32-bit
arithmetic, compares and tests go straight to the data register, and an
index in one of them is used as the index register as it is. Scratch is now
d0-d3, a0, a1 and a6 (an index loaded from memory). C functions keep d4-d7,
and jsc_m68k_llint_enter loads them from the register file on entry (the
caller's are saved as before); llint_return_to_host takes t0's low word
from d4.

The generated interpreter has 58% fewer register-file accesses (56.6k ->
23.6k) and 7% fewer instructions.
---
 .../llint/LowLevelInterpreter.cpp             |  17 ++-
 .../offlineasm-py/offlineasm/m68k.py          | 143 ++++++++++++------
 2 files changed, 106 insertions(+), 54 deletions(-)

diff --git a/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp b/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
index ba7377f..58dd3dd 100644
--- a/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
+++ b/Source/JavaScriptCore/llint/LowLevelInterpreter.cpp
@@ -269,8 +269,10 @@ static void decodeResult(UGPRPair result, CLoopRegister& t0, CLoopRegister& t1)
 
 #if OFFLINE_ASM_M68K
 
-// The 68k interpreter's register file (offlineasm/m68k.rb): one 64-bit slot
-// per interpreter register, big-endian, in this order.
+// The 68k interpreter's register file (offlineasm-py/offlineasm/m68k.py):
+// one 64-bit slot per interpreter register, big-endian, in this order. t0-t3
+// keep only their high words here while the interpreter runs; their low
+// words are in d4-d7.
 enum M68KSlot : unsigned {
     M68KSlotT0 = 0, M68KSlotT1 = 1, M68KSlotT2 = 2,
     M68KSlotSP = 13, M68KSlotLR = 14,
@@ -287,8 +289,9 @@ EncodedJSValue jsc_m68k_llint_enter(const void* opcode, CallFrame*);
 }
 
 // Saves the C registers the ABI asks to keep (the interpreter uses all of
-// them), sets cfr (a5) and jumps to the first opcode. The interpreter comes
-// back through llint_return_to_host with its result in t0.
+// them), sets cfr (a5), loads t0-t3's low words into d4-d7 (they live there,
+// the high words in the register file) and jumps to the first opcode. The
+// interpreter comes back through llint_return_to_host with its result in t0.
 __asm__(
     ".text\n"
     ".balign 2\n"
@@ -298,11 +301,15 @@ __asm__(
     "    fmovem.x fp2-fp7,-(sp)\n"
     "    move.l 120(sp),a0\n"
     "    move.l 124(sp),a5\n"
+    "    move.l _jsc_m68k_vrf+4,d4\n"
+    "    move.l _jsc_m68k_vrf+12,d5\n"
+    "    move.l _jsc_m68k_vrf+20,d6\n"
+    "    move.l _jsc_m68k_vrf+28,d7\n"
     "    jmp (a0)\n"
     ".globl _llint_return_to_host\n"
     "_llint_return_to_host:\n"
     "    move.l _jsc_m68k_vrf,d0\n"
-    "    move.l _jsc_m68k_vrf+4,d1\n"
+    "    move.l d4,d1\n"
     "    fmovem.x (sp)+,fp2-fp7\n"
     "    movem.l (sp)+,d2-d7/a2-a6\n"
     "    rts\n"
diff --git a/Source/JavaScriptCore/offlineasm-py/offlineasm/m68k.py b/Source/JavaScriptCore/offlineasm-py/offlineasm/m68k.py
index a5d3572..bfb4709 100644
--- a/Source/JavaScriptCore/offlineasm-py/offlineasm/m68k.py
+++ b/Source/JavaScriptCore/offlineasm-py/offlineasm/m68k.py
@@ -32,6 +32,9 @@
 # data registers and seven address registers. So:
 #
 # - cfr lives in a5; it only ever holds a pointer.
+# - t0 to t3's low words live in d4 to d7, their high words in the register
+#   file below. The low word is what 32-bit and pointer operations use, so
+#   most of the interpreter's work on them is register work.
 # - Every other interpreter register (t0-t12, sp, lr, csr0-csr10, ...) is a
 #   64-bit slot in a register file in memory, _jsc_m68k_vrf, big-endian: the
 #   high word at +0, the low word at +4. 32-bit and pointer operations use the
@@ -41,8 +44,10 @@
 # - ft0-ft5 are fp0-fp5 (fp7 is scratch). Double arithmetic uses the 68040's
 #   fdadd/fdsub/fdmul/fddiv/fdsqrt, which round to double whatever the FPCR
 #   says.
-# - d0-d7, a0, a1 are scratch inside each instruction. a2-a4 and a6 are not
-#   used, so C functions called from here keep them, as the ABI asks.
+# - d0-d3, a0, a1 and a6 are scratch inside each instruction (a6 holds an
+#   index loaded from memory). d4-d7 and a2-a5 are the interpreter's: C
+#   functions called from here keep them, as the ABI asks, and
+#   jsc_m68k_llint_enter (LowLevelInterpreter.cpp) saves the caller's.
 #
 # One register file serves the whole program: JavaScript runs on one thread
 # here. CLoop::execute (LowLevelInterpreter.cpp) saves it on the way in and
@@ -77,6 +82,13 @@ M68K_PINNED = {"cfr": "a5", "csr0": "a3", "t4": "a2", "csr3": "a4"}
 # writes are dropped.
 M68K_CONSTANT_REGISTERS = {"csr1": 0xfffe000000000000, "csr2": 0xfffe000000000002}
 
+# The low words of the hottest temporaries live in data registers (J1). Their
+# high words stay in the register file.
+M68K_DATA = {"t0": "d4", "t1": "d5", "t2": "d6", "t3": "d7"}
+
+# The index register for a BaseIndex whose index is in memory.
+M68K_INDEX_SCRATCH = "a6"
+
 M68K_VRF_SIZE = len(M68K_GPR_SLOTS) * 8
 M68K_VRF_SP = "%s+%d" % (M68K_VRF, M68K_GPR_SLOTS.index("sp") * 8 + 4)
 M68K_VRF_LR = "%s+%d" % (M68K_VRF, M68K_GPR_SLOTS.index("lr") * 8 + 4)
@@ -112,6 +124,10 @@ def _registerSlot(self):
     return M68K_GPR_SLOTS.index(self.name) * 8
 
 
+def _registerData(self):
+    return M68K_DATA.get(self.name)
+
+
 def _registerHi(self):
     if self.m68kPinned():
         raise Exception("No high word for %s" % self.name)
@@ -121,10 +137,13 @@ def _registerHi(self):
 def _registerLo(self):
     if self.m68kPinned():
         return self.m68kPinned()
+    if self.m68kData():
+        return self.m68kData()
     return "%s+%d" % (M68K_VRF, self.m68kSlot() + 4)
 
 
 RegisterID.m68kPinned = _registerPinned
+RegisterID.m68kData = _registerData
 RegisterID.m68kSlot = _registerSlot
 RegisterID.m68kHi = _registerHi
 RegisterID.m68kLo = _registerLo
@@ -176,7 +195,7 @@ def _isPinnedRegister(operand):
 # The effective address of a memory operand, extra bytes on. Loads the base
 # (and index) into areg (and ireg) first when they are not already in
 # hardware registers.
-def m68kAddress(operand, extra=0, areg="a0", ireg="d7"):
+def m68kAddress(operand, extra=0, areg="a0", ireg=M68K_INDEX_SCRATCH):
     if isinstance(operand, Address):
         base = operand.base
         offset = operand.offset.value + extra
@@ -191,7 +210,7 @@ def m68kAddress(operand, extra=0, areg="a0", ireg="d7"):
         if not baseRegister:
             emit("move.l %s,%s" % (base.m68kLo(), areg))
             baseRegister = areg
-        index = operand.index.m68kPinned()
+        index = operand.index.m68kPinned() or operand.index.m68kData()
         if not index:
             emit("move.l %s,%s" % (operand.index.m68kLo(), ireg))
             index = ireg
@@ -203,7 +222,7 @@ def m68kAddress(operand, extra=0, areg="a0", ireg="d7"):
 
 
 # Both words of a 64-bit memory operand, computing the base only once.
-def m68kAddressPair(operand, areg="a0", ireg="d7"):
+def m68kAddressPair(operand, areg="a0", ireg=M68K_INDEX_SCRATCH):
