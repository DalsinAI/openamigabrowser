index 0000000..6a3fa50
--- /dev/null
+++ b/Source/JavaScriptCore/generator-py/DSL.py
@@ -0,0 +1,238 @@
+# Copyright (C) 2018-2021 Apple Inc. All rights reserved.
+# Copyright (C) 2026 AmigaChrome Team (Python port of JavaScriptCore/generator/DSL.rb).
+#
+# Redistribution and use in source and binary forms, with or without
+# modification, are permitted provided that the following conditions
+# are met:
+# 1. Redistributions of source code must retain the above copyright
+#    notice, this list of conditions and the following disclaimer.
+# 2. Redistributions in binary form must reproduce the above copyright
+#    notice, this list of conditions and the following disclaimer in the
+#    documentation and/or other materials provided with the distribution.
+#
+# THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''
+# AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+# THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+# PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
+# BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+# CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+# SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+# INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+from Assertion import assert_
+from Opcode import Opcode
+from RubyListReader import Reader, Symbol
+from Section import Section
+from Type import Type, Template
+import GeneratedFile
+
+
+class DSL:
+    def __init__(self):
+        self.sections = []
+        self.wasm_section = None
+        self.current_section = None
+        self.names = {}
+        self.namespaces = []
+
+    def begin_section(self, name, config=None):
+        assert_("must call `end_section` before beginning a new section", self.current_section is None)
+        self.current_section = Section(name, config or {})
+
+    def end_section(self, name):
+        assert_("current section's name is `%s`, but end_section was called with `%s`" % (self.current_section.name, name),
+                self.current_section.name == name)
+        if self.current_section.config.get("preserve_order"):
+            self.current_section.validate()
+        else:
+            self.current_section.sort()
+        self.current_section.create_ids()
+        self.sections.append(self.current_section)
+        if self.current_section.is_wasm():
+            assert_("Cannot have 2 wasm sections", self.wasm_section is None)
+            self.wasm_section = self.current_section
+        self.current_section = None
+
+    def op(self, name, config=None):
+        assert_("`op` can only be called in between `begin_section` and `end_section`", self.current_section is not None)
+        self.current_section.add_opcode(name, config or {})
+
+    def op_group(self, desc, ops, config):
+        assert_("`op_group` can only be called in between `begin_section` and `end_section`", self.current_section is not None)
+        self.current_section.add_opcode_group(desc, ops, config)
+
+    def simd_op_group(self, desc, ops, config):
+        assert_("`simd_op_group` can only be called in between `begin_section` and `end_section`", self.current_section is not None)
+
+        for op in ops:
+            variants = ["i32x4", "i64x2", "f32x4", "f64x2"]
+            if config.get("makeSignedVariants"):
+                variants += ["i8x16_u", "i8x16_s", "i16x8_u", "i16x8_s"]
+            else:
+                variants += ["i8x16", "i16x8"]
+
+            if config.get("makeAllSignedAndUnsignedVariants"):
+                variants = ["i8x16_u", "i8x16_s", "i16x8_u", "i16x8_s", "i32x4_u", "i32x4_s", "i64x2_u", "i64x2_s", "f32x4", "f64x2"]
+            if config.get("makeOnlyFloatingPointVariants"):
+                variants = ["f32x4", "f64x2"]
+            if config.get("makeOnlyV128"):
+                variants = ["v128"]
+            if config.get("makeOnlyI8"):
+                variants = ["i8x16"]
+            if config.get("makeOnlyF32"):
+                variants = ["f32x4"]
+            if config.get("makeOnlyF64"):
+                variants = ["f64x2"]
+
+            if config.get("skipI64Variant"):
+                variants = [v for v in variants if "i64x2" not in v]
+            if config.get("skipI32Variant"):
+                variants = [v for v in variants if "i32x4" not in v]
+            if config.get("skipI8Variant"):
+                variants = [v for v in variants if "i8x16" not in v]
+            if config.get("skipFloatVariants"):
+                variants = [v for v in variants if "f32x4" not in v and "f64x2" not in v]
+
+            if config.get("variants"):
+                variants = config["variants"]
+
+            opList = [Symbol("%s_%s" % (op, v)) for v in variants]
+            self.current_section.add_opcode_group(Symbol("%s%s" % (desc, op)), opList, config)
+
+    def types(self, types):
+        for type in types:
+            type = "::".join(self.namespaces + ["%s" % type])
+            self.names[type] = Type(type)
+
+    def templates(self, types):
+        for type in types:
+            type = "::".join(self.namespaces + ["%s" % type])
+            self.names[type] = Template(type)
+
+    def autogenerate_wasm_opcodes(self):
+        raise Exception("autogenerate_wasm_opcodes: the Wasm section is not supported by this port")
+
+    def run(self, options):
+        bytecode_list_path = options["bytecode_list"]
+        with open(bytecode_list_path) as f:
+            bytecode_list = f.read()
+
+        with open(options["wasm_json_filename"]) as f:
+            self.wasm_json = f.read()
+
+        reader = Reader(bytecode_list, bytecode_list_path, self.names)
+        commands = {
+            "types": self.types,
+            "templates": self.templates,
+            "begin_section": self.begin_section,
+            "end_section": self.end_section,
+            "op": self.op,
+            "op_group": self.op_group,
+            "simd_op_group": self.simd_op_group,
+            "autogenerate_wasm_opcodes": self.autogenerate_wasm_opcodes,
+        }
+        for command, args, kwargs, line in reader.statements():
+            if command not in commands:
+                raise Exception("%s:%d: unknown command %r" % (bytecode_list_path, line, command))
+            if kwargs:
+                args = args + [dict(kwargs)]
+            commands[command](*args)
+        assert_("must end last section", self.current_section is None)
+
+        self.write_bytecodes(bytecode_list, options["bytecodes_filename"])
+        self.write_bytecode_structs(bytecode_list, options["bytecode_structs_filename"])
+        self.write_bytecode_dumper(bytecode_list, options["bytecode_dumper_filename"])
+        self.write_bytecodes_init(options["init_asm_filename"], bytecode_list)
+        self.write_indices(bytecode_list, options["bytecode_indices_filename"])
+
+    def write_bytecodes(self, bytecode_list, bytecodes_filename):
+        def fill(template):
+            template.prefix = "#pragma once\n"
+            num_opcodes = sum(len(s.opcodes) for s in self.sections)
+            template.body = "\n".join(
+                [s.header_helpers(num_opcodes) for s in self.sections] +
+                [s.for_each_struct() for s in self.sections if s.config.get("emit_in_structs_file")])
+        GeneratedFile.create(bytecodes_filename, [bytecode_list], fill)
+
+    def write_bytecode_structs(self, bytecode_list, bytecode_structs_filename):
+        def fill(template):
+            template.prefix = """#pragma once
+
+#include "ArithProfile.h"
+#include "ArrayAllocationProfile.h"
+#include "BytecodeDumper.h"
+#include "Fits.h"
+#include "GetByIdMetadata.h"
+#include "Instruction.h"
+#include "IterationModeMetadata.h"
+#include "JSPropertyNameEnumerator.h"
+#include "Opcode.h"
+#include "PrivateFieldPutKind.h"
+#include "PutByStatus.h"
+#include "PutByIdFlags.h"
+#include "ToThisStatus.h"
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+
+namespace JSC {
+
+class BasicBlockLocation;
+
+void dumpBytecode(BytecodeDumperBase<JSInstructionStream>* dumper, JSInstructionStream::Offset, const JSInstruction*);
+
+"""
+            template.body = "%s\n\n" % "\n".join(
+                op.struct() for op in self.opcodes_filter(lambda s: s.config.get("emit_in_structs_file") and not s.is_wasm()))
+            template.suffix = """} // namespace JSC
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+"""
+        GeneratedFile.create(bytecode_structs_filename, [bytecode_list], fill)
+
+    def write_bytecode_dumper(self, bytecode_list, bytecode_dumper_filename):
+        def fill(template):
+            template.prefix = """#include "config.h"
+#include "BytecodeDumper.h"
+
+#include "ButterflyInlines.h"
+#include "BytecodeStructs.h"
+
+namespace JSC {
+"""
+            template.body = "%s\n" % Opcode.dump_bytecode(
+                "Bytecode", "JSOpcodeTraits",
+                self.opcodes_filter(lambda s: s.config.get("emit_in_structs_file") and not s.is_wasm()))
+            template.suffix = "} // namespace JSC"
+        GeneratedFile.create(bytecode_dumper_filename, [bytecode_list], fill)
+
+    def write_init_asm(self, opcodes, filename, dependencies):
+        def fill(template):
+            template.multiline_comment = None
+            template.line_comment = "#"
+            template.body = "\n".join(
+                [op.set_entry_address(i) for i, op in enumerate(opcodes)] +
+                [op.set_entry_address_wide16(i) for i, op in enumerate(opcodes)] +
+                [op.set_entry_address_wide32(i) for i, op in enumerate(opcodes)])
+        GeneratedFile.create(filename, dependencies, fill)
+
+    def write_bytecodes_init(self, bytecodes_init_filename, *dependencies):
+        self.write_init_asm(self.opcodes_for("emit_in_asm_file"), bytecodes_init_filename, list(dependencies))
+
+    def write_indices(self, bytecode_list, indices_filename):
+        opcodes = self.opcodes_for("emit_in_structs_file")
+
+        def fill(template):
+            template.prefix = "namespace JSC {\n"
+            # Ruby's join of nested arrays: an opcode without operands gives an empty line.
+            template.body = "\n".join("\n".join(op.struct_indices()) for op in opcodes)
+            template.suffix = "\n} // namespace JSC"
+        GeneratedFile.create(indices_filename, [bytecode_list], fill)
+
+    def opcodes_for(self, file):
+        return [op for s in self.sections if s.config.get(file) for op in s.opcodes]
+
+    def opcodes_filter(self, predicate):
+        return [op for s in self.sections if predicate(s) for op in s.opcodes]
