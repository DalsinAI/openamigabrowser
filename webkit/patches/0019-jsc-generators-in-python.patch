+# INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+# usage: asm.py [-I<dir>...] asmFile offsetsFile outputFileName variants
+#               [--platform=<OS>] [--webkit-additions-path=<path>]
+#               [--binary-format=<format>] [--depfile=<depfile>]
+
+import hashlib
+import os
+import shlex
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+sys.setrecursionlimit(100000)
+
+from offlineasm import config  # noqa: E402
+from offlineasm.assembler import Assembler, Output  # noqa: E402
+from offlineasm import backends  # noqa: E402,F401
+from offlineasm.offsets import (offsetsAndConfigurationIndexForVariants, MissingMagicValuesException,  # noqa: E402
+                                buildOffsetsMap)
+from offlineasm.parser import IncludeFile, parse, parseHash  # noqa: E402
+from offlineasm.self_hash import selfHash  # noqa: E402
+from offlineasm.settings import computeSettingsCombinations, forSettings, emitCodeInConfiguration  # noqa: E402
+from offlineasm import transform  # noqa: E402,F401
+
+
+def parseOptions(argv, names):
+    """OptionParser's --name=value handling for the options asm.rb takes;
+    the rest of argv are the positional arguments, as Ruby's parse! left them."""
+    options = {}
+    positional = []
+    for argument in argv:
+        if argument.startswith("--"):
+            name, _, value = argument[2:].partition("=")
+            key = names.get(name)
+            if key is None:
+                sys.stderr.write("%s: invalid option: %s\n" % (os.path.basename(sys.argv[0]), argument))
+                sys.exit(1)
+            options[key] = value
+        else:
+            positional.append(argument)
+    return options, positional
+
+
+def main():
+    argv = sys.argv[1:]
+    IncludeFile.processIncludeOptions(argv)
+
+    config.options, argv = parseOptions(argv, {
+        "platform": "platform",
+        "webkit-additions-path": "webkit_additions_path",
+        "binary-format": "binary_format",
+        "depfile": "depfile",
+    })
+
+    asmFile = argv.pop(0)
+    offsetsFile = argv.pop(0)
+    outputFlnm = argv.pop(0)
+    variants = [v for v in __import__("re").split(r"[,\s]+", argv.pop(0)) if v != ""]
+
+    try:
+        configurationList = offsetsAndConfigurationIndexForVariants(offsetsFile, variants)
+    except MissingMagicValuesException:
+        sys.stderr.write("offlineasm: No magic values found in %s. Skipping assembly file generation.\n" % offsetsFile)
+        sys.exit(1)
+
+    # We want this in all ELF systems we support, except for C_LOOP (we'll disable it later on if we are building cloop)
+    config.emitELFDebugDirectives = config.options.get("binary_format") == "ELF"
+
+    inputHash = "// offlineasm input hash: " + parseHash(asmFile, config.options) + \
+        " " + hashlib.sha1(" ".join(" ".join(str(x) for x in (v[0] + [v[1]])) for v in configurationList).encode()).hexdigest() + \
+        " " + selfHash() + \
+        " " + hashlib.sha1(config.options.get("platform", "").encode()).hexdigest()
+
+    if os.path.exists(outputFlnm) and (not config.options.get("depfile") or os.path.exists(config.options["depfile"])):
+        lastLine = None
+        with open(outputFlnm, "r") as f:
+            for line in f:
+                line = line.rstrip("\n")
+                if line != "":
+                    lastLine = line
+        if lastLine is not None and lastLine == inputHash:
+            # Nothing changed.
+            sys.exit(0)
+
+    with open(outputFlnm, "w") as outp:
+        config.output = Output(outp)
+
+        config.asm = Assembler(config.output)
+
+        sources = set()
+        ast = parse(asmFile, config.options, sources)
+        settingsCombinations = computeSettingsCombinations(ast)
+
+        if config.options.get("depfile"):
+            with open(config.options["depfile"], "w") as depfile:
+                depfile.write(shlex.quote(outputFlnm) + ": ")
+                depfile.write(" ".join(shlex.quote(s) for s in sorted(sources)) + "\n")
+
+        for configuration in configurationList:
+            offsetsList = configuration[0]
+            configIndex = configuration[1]
+
+            def generate(concreteSettings, lowLevelAST, backend):
+                # There could be multiple backends we are generating for, but the C_LOOP is
+                # always by itself so this check to turn off enableDebugAnnotations won't
+                # affect the generation for any other backend.
+                if backend == "C_LOOP":
+                    config.enableDebugAnnotations = False
+                    config.preferredCommentStartColumn = 60
+                    config.emitELFDebugDirectives = False
+
+                lowLevelAST = lowLevelAST.demacroify({})
+                mapping = buildOffsetsMap(lowLevelAST, offsetsList)
+                lowLevelAST = lowLevelAST.resolve(mapping)
+                lowLevelAST.validate()
+
+                def emit(concreteSettings_, ast_, backend_):
+                    config.currentSettings = concreteSettings
+                    config.asm.inAsm(lambda: lowLevelAST.lower(backend))
+                emitCodeInConfiguration(concreteSettings, lowLevelAST, backend, emit)
+
+            forSettings(settingsCombinations[configIndex], ast, generate)
+
+        outp.flush()
+        os.fsync(outp.fileno())
+        config.output.puts(inputHash)
+
+
+if __name__ == "__main__":
+    main()
