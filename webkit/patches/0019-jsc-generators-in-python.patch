+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+import Fits
+from Argument import Argument
+
+_emitter_local = [None]
+
+
+class Metadata:
+    def __init__(self, fields, initializers):
+        self.fields = fields
+        self.initializers = initializers
+
+    def empty(self):
+        return self.fields is None
+
+    def length(self):
+        return 0 if self.empty() else len(self.fields)
+
+    def struct(self, op):
+        if self.empty():
+            return None
+
+        def generateOffsetOfFunctions(prefix, fieldNames):
+            return "\n".join(
+                "%sstatic constexpr ptrdiff_t offsetOf%s%s() { return OBJECT_OFFSETOF(Metadata, m_%s); }"
+                % (prefix, fieldName[0].upper(), fieldName[1:], fieldName)
+                for fieldName in fieldNames)
+
+        def convertFields(prefix, fields, fieldNames):
+            lines = []
+            for field, type in fields.items():
+                if isinstance(type, dict):
+                    lines.append("%sunion {\n%s\n%s};" % (prefix, convertFields(prefix + "    ", type, fieldNames), prefix))
+                else:
+                    fieldName = "%s" % field
+                    fieldNames.append(fieldName)
+                    lines.append("%s%s m_%s;" % (prefix, type, fieldName))
+            return "\n".join(lines)
+
+        fieldNames = []
+        prefix = "        "
+        fields = convertFields(prefix, self.fields, fieldNames)
+        fields = fields + "\n" + generateOffsetOfFunctions(prefix, fieldNames)
+
+        inits = None
+        if self.initializers:
+            inits = "\n            : " + "\n            , ".join(
+                "m_%s(__op.m_%s)" % (metadata, arg) for metadata, arg in self.initializers.items()) + "\n       "
+
+        return """
+    struct Metadata {
+        WTF_MAKE_NONCOPYABLE(Metadata);
+
+    public:
+        %s
+        Metadata(const %s&%s)%s { }
+
+%s
+    };
+""" % (op.opcodeID(), op.capitalized_name(), " __op" if inits else "", inits or "", fields)
+
+    def accessor(self):
+        if self.empty():
+            return None
+
+        return """
+    Metadata& metadata(CodeBlock* codeBlock) const
+    {
+        return codeBlock->metadata<Metadata>(opcodeID, %s);
+    }
+""" % Metadata.field_name()
+
+    def field(self, prefix):
+        if self.empty():
+            return None
+
+        return "\n%sunsigned %s;" % (prefix, Metadata.field_name())
+
+    def load_from_stream(self, index, size):
+        if self.empty():
+            return None
+
+        return "%s(%s)" % (Metadata.field_name(), Fits.convert(size, "stream[%d]" % index, "unsigned"))
+
+    def create_emitter_local(self):
+        if self.empty():
+            return None
+
+        return "\n        auto %s = gen->addMetadataFor(opcodeID);" % self.emitter_local().name
+
+    def emitter_local_name(self):
+        return "__metadataID"
+
+    def emitter_local(self):
+        if _emitter_local[0] is None:
+            _emitter_local[0] = Argument(self.emitter_local_name(), "unsigned", -1)
+        return _emitter_local[0]
+
+    @staticmethod
+    def field_name():
+        return "m_metadataID"
