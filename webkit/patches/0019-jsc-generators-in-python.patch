+    @staticmethod
+    def forName(codeOrigin, name):
+        if name in labelMapping:
+            if not isinstance(labelMapping[name], LocalLabel):
+                raise Exception("Label name collision: %s" % name)
+        else:
+            if codeOrigin is None:
