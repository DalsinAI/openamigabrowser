+# The Motorola 68020-68060 back end (AmigaOS, GNU as, Motorola syntax).
+#
+# It runs the C loop's version of the interpreter (the C_LOOP setting stays
+# on, so JavaScriptCore keeps its C-interpreter plumbing: its own JavaScript
+# stack, slow paths called as plain C functions, no assembler), but as 68k
+# code instead of C.
+#
+# The interpreter is written for 64-bit registers; the 68k has eight 32-bit
+# data registers and seven address registers. So:
+#
+# - cfr lives in a5; it only ever holds a pointer.
+# - Every other interpreter register (t0-t12, sp, lr, csr0-csr10, ...) is a
+#   64-bit slot in a register file in memory, _jsc_m68k_vrf, big-endian: the
+#   high word at +0, the low word at +4. 32-bit and pointer operations use the
+#   low word and clear the high word when they write, as 32-bit operations do
+#   on 64-bit machines. sp is the C loop's JavaScript stack pointer, not a7;
+#   push and pop move pointer-sized slots on it, as the C loop does.
+# - ft0-ft5 are fp0-fp5 (fp7 is scratch). Double arithmetic uses the 68040's
+#   fdadd/fdsub/fdmul/fddiv/fdsqrt, which round to double whatever the FPCR
+#   says.
+# - d0-d7, a0, a1 are scratch inside each instruction. a2-a4 and a6 are not
+#   used, so C functions called from here keep them, as the ABI asks.
+#
+# One register file serves the whole program: JavaScript runs on one thread
+# here. CLoop::execute (LowLevelInterpreter.cpp) saves it on the way in and
+# restores it on the way out, so a nested entry from C (C -> JavaScript -> C
+# -> JavaScript) leaves the outer one's registers as they were, like the C
+# loop's local variables.
+
+import math
+import re
+
+from . import config
+from .assembler import Assembler
+from .astnodes import (RegisterID, FPRegisterID, Immediate, LabelReference, LocalLabelReference,
+                       Address, BaseIndex, AbsoluteAddress, Sequence, Instruction)
+from .instructions import isPowerOfTwo
+
+M68K_VRF = "_jsc_m68k_vrf"
+
+M68K_GPR_SLOTS = [
+    "t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8", "t9", "t10", "t11", "t12",
+    "sp", "lr", "pc", "zr",
+    "csr0", "csr1", "csr2", "csr3", "csr4", "csr5", "csr6", "csr7", "csr8", "csr9", "csr10",
+]
+
+# Interpreter registers that only ever hold pointers live in the address
+# registers C calls keep: cfr, PB (csr0), PC (t4) and metadataTable (csr3)
+# in the C loop's register assignment (LowLevelInterpreter.asm).
+M68K_PINNED = {"cfr": "a5", "csr0": "a3", "t4": "a2", "csr3": "a4"}
+
+# numberTag (csr1) and notCellMask (csr2) only ever hold these constants
+# (JSValue::NumberTag, JSValue::NotCellMask): reads become immediates and
+# writes are dropped.
+M68K_CONSTANT_REGISTERS = {"csr1": 0xfffe000000000000, "csr2": 0xfffe000000000002}
+
+M68K_VRF_SIZE = len(M68K_GPR_SLOTS) * 8
+M68K_VRF_SP = "%s+%d" % (M68K_VRF, M68K_GPR_SLOTS.index("sp") * 8 + 4)
+M68K_VRF_LR = "%s+%d" % (M68K_VRF, M68K_GPR_SLOTS.index("lr") * 8 + 4)
+M68K_VRF_LR_HI = "%s+%d" % (M68K_VRF, M68K_GPR_SLOTS.index("lr") * 8)
+
+# ft0-ft5 are fp0-fp5; fp7 is the back end's own scratch.
+M68K_FP_SCRATCH = "fp7"
+
+
+def emit(line):
+    config.asm.puts(line)
+
+
+def m68kHex(value):
+    return "0x%x" % (value & 0xffffffff)
+
+
+_labelCounter = [0]
+
+
+def m68kNewLabel():
+    _labelCounter[0] += 1
+    return "Lm68k%d" % _labelCounter[0]
+
+
+def _registerPinned(self):
+    return M68K_PINNED.get(self.name)
+
+
+def _registerSlot(self):
+    if self.name not in M68K_GPR_SLOTS:
+        raise Exception("Bad register %s for M68K at %s" % (self.name, self.codeOriginString()))
+    return M68K_GPR_SLOTS.index(self.name) * 8
+
+
+def _registerHi(self):
+    if self.m68kPinned():
+        raise Exception("No high word for %s" % self.name)
+    return "%s+%d" % (M68K_VRF, self.m68kSlot())
+
+
+def _registerLo(self):
+    if self.m68kPinned():
+        return self.m68kPinned()
+    return "%s+%d" % (M68K_VRF, self.m68kSlot() + 4)
+
+
+RegisterID.m68kPinned = _registerPinned
+RegisterID.m68kSlot = _registerSlot
+RegisterID.m68kHi = _registerHi
+RegisterID.m68kLo = _registerLo
+
+
+_FP_OPERANDS = {
+    "ft0": "fp0", "fa0": "fp0", "fr": "fp0",
+    "ft1": "fp1", "fa1": "fp1",
+    "ft2": "fp2", "fa2": "fp2",
+    "ft3": "fp3", "fa3": "fp3",
+    "ft4": "fp4",
+    "ft5": "fp5",
+}
+
+
+def _fpOperand(self):
+    if self.name not in _FP_OPERANDS:
+        raise Exception("Bad register %s for M68K at %s" % (self.name, self.codeOriginString()))
+    return _FP_OPERANDS[self.name]
+
+
+FPRegisterID.m68kOperand = _fpOperand
+
+
+def _immediateLo(self):
+    return "#%s" % m68kHex(self.value)
+
+
+def _immediateHi(self):
+    return "#%s" % m68kHex(self.value >> 32)
+
+
+Immediate.m68kLo = _immediateLo
+Immediate.m68kHi = _immediateHi
+
+
+def _labelSymbol(self):
+    return self.asmLabel()
+
+
+LabelReference.m68kSymbol = _labelSymbol
+LocalLabelReference.m68kSymbol = _labelSymbol
+
+
+def _isPinnedRegister(operand):
+    return isinstance(operand, RegisterID) and operand.m68kPinned()
+
+
+# The effective address of a memory operand, extra bytes on. Loads the base
+# (and index) into areg (and ireg) first when they are not already in
+# hardware registers.
+def m68kAddress(operand, extra=0, areg="a0", ireg="d7"):
+    if isinstance(operand, Address):
+        base = operand.base
+        offset = operand.offset.value + extra
+        if base.m68kPinned():
+            return "%d(%s)" % (offset, base.m68kPinned())
+        emit("move.l %s,%s" % (base.m68kLo(), areg))
+        return "%d(%s)" % (offset, areg)
+    elif isinstance(operand, BaseIndex):
+        base = operand.base
+        offset = operand.offset.value + extra
+        baseRegister = base.m68kPinned()
+        if not baseRegister:
+            emit("move.l %s,%s" % (base.m68kLo(), areg))
+            baseRegister = areg
+        index = operand.index.m68kPinned()
+        if not index:
+            emit("move.l %s,%s" % (operand.index.m68kLo(), ireg))
+            index = ireg
+        return "(%d,%s,%s.l*%d)" % (offset, baseRegister, index, operand.scaleValue())
+    elif isinstance(operand, AbsoluteAddress):
+        return "%s" % m68kHex(operand.address.value + extra)
+    else:
+        raise Exception("Not an address: %s at %s" % (operand.inspect(), operand.codeOriginString()))
+
+
+# Both words of a 64-bit memory operand, computing the base only once.
+def m68kAddressPair(operand, areg="a0", ireg="d7"):
+    hi = m68kAddress(operand, 0, areg, ireg)
+    if isinstance(operand, Address):
+        lo = re.sub(r"\A(-?\d+)", lambda m: "%d" % (int(m.group(1)) + 4), hi, count=1)
+    elif isinstance(operand, BaseIndex):
+        lo = re.sub(r"\A\((-?\d+),", lambda m: "(%d," % (int(m.group(1)) + 4), hi, count=1)
+    elif isinstance(operand, AbsoluteAddress):
+        lo = m68kHex(operand.address.value + 4)
+    else:
+        lo = None
+    return hi, lo
+
+
+# A 32-bit source operand as a string, emitting a load when it lives in
+# memory behind an address.
+def m68kSource32(operand, scratch="d1"):
+    if isinstance(operand, RegisterID):
+        if not operand.m68kPinned():
+            return operand.m68kLo()
+        emit("move.l %s,%s" % (operand.m68kPinned(), scratch))
+        return scratch
+    elif isinstance(operand, Immediate):
+        return operand.m68kLo()
+    elif isinstance(operand, (Address, BaseIndex, AbsoluteAddress)):
+        emit("move.l %s,%s" % (m68kAddress(operand, 0, "a1", "d6"), scratch))
+        return scratch
+    elif isinstance(operand, (LabelReference, LocalLabelReference)):
+        return "#%s" % operand.m68kSymbol()
+    else:
+        raise Exception("Bad 32-bit operand %s" % operand.inspect())
+
+
+# Loads a 64-bit operand into hi:lo data registers.
+def m68kLoad64(operand, hi, lo):
+    if isinstance(operand, RegisterID):
+        if operand.m68kPinned():
+            emit("move.l %s,%s" % (operand.m68kPinned(), lo))
+            emit("moveq #0,%s" % hi)
+        else:
+            emit("move.l %s,%s" % (operand.m68kHi(), hi))
+            emit("move.l %s,%s" % (operand.m68kLo(), lo))
+    elif isinstance(operand, Immediate):
+        emit("move.l %s,%s" % (operand.m68kHi(), hi))
+        emit("move.l %s,%s" % (operand.m68kLo(), lo))
+    elif isinstance(operand, (LabelReference, LocalLabelReference)):
+        emit("move.l #%s,%s" % (operand.m68kSymbol(), lo))
+        emit("moveq #0,%s" % hi)
+    elif isinstance(operand, (Address, BaseIndex, AbsoluteAddress)):
+        hiAddress, loAddress = m68kAddressPair(operand, "a1", "d6")
+        emit("move.l %s,%s" % (hiAddress, hi))
+        emit("move.l %s,%s" % (loAddress, lo))
+    else:
+        raise Exception("Bad 64-bit operand %s at %s" % (type(operand).__name__, operand.codeOriginString()))
+
+
+# Stores hi:lo into a 64-bit destination register.
+def m68kStore64(hi, lo, operand):
+    if not isinstance(operand, RegisterID):
+        hiAddress, loAddress = m68kAddressPair(operand)
+        emit("move.l %s,%s" % (hi, hiAddress))
+        emit("move.l %s,%s" % (lo, loAddress))
+        return
+    if operand.m68kPinned():
+        emit("move.l %s,%s" % (lo, operand.m68kPinned()))
+    else:
+        emit("move.l %s,%s" % (hi, operand.m68kHi()))
+        emit("move.l %s,%s" % (lo, operand.m68kLo()))
+
+
+# Stores a 32-bit result, zero-extended, into a destination register.
+def m68kStore32(value, operand):
+    if not isinstance(operand, RegisterID):
+        emit("move.l %s,%s" % (value, m68kAddress(operand)))
+        return
+    if operand.m68kPinned():
+        emit("move.l %s,%s" % (value, operand.m68kPinned()))
+    else:
+        emit("move.l %s,%s" % (value, operand.m68kLo()))
+        emit("clr.l %s" % operand.m68kHi())
+
+
+def m68kStore32Signed(value, operand):
+    if not isinstance(operand, RegisterID):
+        emit("move.l %s,%s" % (value, m68kAddress(operand)))
+        return
+    if operand.m68kPinned():
+        emit("move.l %s,%s" % (value, operand.m68kPinned()))
+    else:
+        emit("move.l %s,%s" % (value, operand.m68kLo()))
+        emit("smi d5")
+        emit("extb.l d5")
+        emit("move.l d5,%s" % operand.m68kHi())
+
+
+_JCC = {
+    "eq": "jeq", "neq": "jne",
+    "a": "jhi", "aeq": "jcc", "b": "jcs", "beq": "jls",
+    "gt": "jgt", "gteq": "jge", "lt": "jlt", "lteq": "jle",
+}
+
+_SCC = {
+    "eq": "seq", "neq": "sne",
+    "a": "shi", "aeq": "scc", "b": "scs", "beq": "sls",
+    "gt": "sgt", "gteq": "sge", "lt": "slt", "lteq": "sle",
+}
+
+
+def m68kJcc(condition):
+    if condition not in _JCC:
+        raise Exception("Bad condition %s" % condition)
+    return _JCC[condition]
+
+
+def m68kScc(condition):
+    if condition not in _SCC:
+        raise Exception("Bad condition %s" % condition)
+    return _SCC[condition]
+
+
+# Replaces reads of the constant registers with immediates and drops
+# writes to them.
+def _getModifiedListM68K(self):
+    result = []
+    for node in self.list:
+        if not isinstance(node, Instruction):
+            result.append(node)
+            continue
+        operands = node.operands
+        if node.opcode in ("move", "addq", "orq", "andq", "subq", "xorq"):
+            destinationIndex = len(operands) - 1
+        else:
+            destinationIndex = None
+        if destinationIndex is not None and isinstance(operands[destinationIndex], RegisterID) and \
+                operands[destinationIndex].name in M68K_CONSTANT_REGISTERS:
+            continue
+        newOperands = []
+        for operand in operands:
+            if isinstance(operand, RegisterID) and operand.name in M68K_CONSTANT_REGISTERS:
+                newOperands.append(Immediate(operand.codeOrigin, M68K_CONSTANT_REGISTERS[operand.name]))
+            else:
+                newOperands.append(operand)
+        result.append(Instruction(node.codeOrigin, node.opcode, newOperands, node.annotation))
+    return result
+
+
+Sequence.getModifiedListM68K = _getModifiedListM68K
+
+
+_KINDS = {"i": "int", "p": "ptr", "q": "quad", "b": "byte"}
+
+
+class _M68KInstruction:
+    """The M68K lowering, mixed into Instruction below."""
+
+    def m68kTarget(self, operand):
+        if isinstance(operand, (LabelReference, LocalLabelReference)):
+            return operand.m68kSymbol()
+        raise Exception("Bad branch target %s at %s" % (operand.inspect(), self.codeOriginString()))
+
+    def m68kOperands3(self):
+        """a, b, dst for three operands; dst, src, dst (as a, b, dst) for two."""
+        if len(self.operands) == 3:
+            return self.operands
+        return self.operands[1], self.operands[0], self.operands[1]
+
+    # dst = a op b (three operands) or dst = dst op src (two).
+    def m68kBinary32(self, opcode, signExtendResult=False):
+        a, b, dst = self.m68kOperands3()
+        emit("move.l %s,d0" % m68kSource32(a, "d0"))
+        emit("%s %s,d0" % (opcode, m68kSource32(b, "d1")))
+        if signExtendResult:
+            m68kStore32Signed("d0", dst)
+        else:
+            m68kStore32("d0", dst)
+
+    def m68kLogical64(self, opcode):
+        a, b, dst = self.m68kOperands3()
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        emit("%s d2,d0" % opcode)
+        emit("%s d3,d1" % opcode)
+        m68kStore64("d0", "d1", dst)
+
+    def m68kAdd64(self):
+        a, b, dst = self.m68kOperands3()
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        emit("add.l d3,d1")
+        emit("addx.l d2,d0")
+        m68kStore64("d0", "d1", dst)
+
+    def m68kSub64(self):
+        a, b, dst = self.m68kOperands3()
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        emit("sub.l d3,d1")
+        emit("subx.l d2,d0")
+        m68kStore64("d0", "d1", dst)
+
+    # 64 x 64 -> low 64 bits: lo*lo (full) + (hi*lo + lo*hi) << 32.
+    def m68kMul64(self):
+        a, b, dst = self.m68kOperands3()
+        if isinstance(b, Immediate) and isinstance(a, RegisterID):
+            a, b = b, a
+        if isinstance(a, Immediate) and a.value != 0 and isPowerOfTwo(abs(a.value)) and abs(a.value) < (1 << 31):
+            shift = int(math.log2(abs(a.value)))
+            m68kLoad64(b, "d0", "d1")
+            self.m68kShiftLeft64Constant(shift, "d0", "d1")
+            if a.value < 0:
+                emit("neg.l d1")
+                emit("negx.l d0")
+            m68kStore64("d0", "d1", dst)
+            return
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        emit("move.l d0,d4")
+        emit("muls.l d3,d4")          # a.hi * b.lo, low word
+        emit("move.l d2,d5")
+        emit("muls.l d1,d5")          # b.hi * a.lo, low word
+        emit("add.l d5,d4")
+        emit("mulu.l d3,d0:d1")       # a.lo * b.lo, 64 bits
+        emit("add.l d4,d0")
+        m68kStore64("d0", "d1", dst)
+
+    def m68kShiftLeft64Constant(self, shift, hi, lo):
+        shift &= 63
+        if shift == 0:
+            return
+        if shift >= 32:
+            emit("move.l %s,%s" % (lo, hi))
+            self.m68kShift32Constant("lsl.l", shift - 32, hi)
+            emit("moveq #0,%s" % lo)
+        else:
+            emit("move.l %s,d4" % lo)
+            self.m68kShift32Constant("lsl.l", shift, hi)
+            self.m68kShift32Constant("lsr.l", 32 - shift, "d4")
+            emit("or.l d4,%s" % hi)
+            self.m68kShift32Constant("lsl.l", shift, lo)
+
+    def m68kShift32Constant(self, opcode, shift, register):
+        while shift > 0:
+            step = 8 if shift > 8 else shift
+            emit("%s #%d,%s" % (opcode, step, register))
+            shift -= step
+
+    # 32-bit shifts and rotates; the count is taken mod 32.
+    def m68kShift32(self, opcode):
+        value, amount, dst = self.m68kOperands3()
+        emit("move.l %s,d0" % m68kSource32(value, "d0"))
+        if isinstance(amount, Immediate):
+            self.m68kShift32Constant(opcode, amount.value & 31, "d0")
+        else:
+            emit("move.l %s,d1" % m68kSource32(amount, "d1"))
+            emit("and.l #31,d1")
+            emit("%s d1,d0" % opcode)
+        m68kStore32("d0", dst)
+
+    # 64-bit shifts: kind is "left", "right" (arithmetic) or "uright".
+    def m68kShift64(self, kind):
+        value, amount, dst = self.m68kOperands3()
+        m68kLoad64(value, "d0", "d1")
+        if isinstance(amount, Immediate):
+            shift = amount.value & 63
+            if kind == "left":
+                self.m68kShiftLeft64Constant(shift, "d0", "d1")
+            elif kind in ("right", "uright"):
+                hiShift = "asr.l" if kind == "right" else "lsr.l"
+                if shift >= 32:
+                    emit("move.l d0,d1")
+                    self.m68kShift32Constant(hiShift, shift - 32, "d1")
+                    if kind == "right":
+                        emit("tst.l d0")
+                        emit("smi d0")
+                        emit("extb.l d0")
+                    else:
+                        emit("moveq #0,d0")
+                elif shift > 0:
+                    emit("move.l d0,d4")
+                    self.m68kShift32Constant("lsr.l", shift, "d1")
+                    self.m68kShift32Constant("lsl.l", 32 - shift, "d4")
+                    emit("or.l d4,d1")
+                    self.m68kShift32Constant(hiShift, shift, "d0")
+            m68kStore64("d0", "d1", dst)
+            return
+        done = m68kNewLabel()
+        big = m68kNewLabel()
+        emit("move.l %s,d2" % m68kSource32(amount, "d2"))
+        emit("and.l #63,d2")
+        emit("jeq %s" % done)
+        emit("cmp.l #32,d2")
+        emit("jge %s" % big)
+        emit("moveq #32,d3")
+        emit("sub.l d2,d3")
+        if kind == "left":
+            emit("move.l d1,d4")
+            emit("lsr.l d3,d4")
+            emit("lsl.l d2,d0")
+            emit("or.l d4,d0")
+            emit("lsl.l d2,d1")
+        else:
+            emit("move.l d0,d4")
+            emit("lsl.l d3,d4")
+            emit("lsr.l d2,d1")
+            emit("or.l d4,d1")
+            emit("%s d2,d0" % ("asr.l" if kind == "right" else "lsr.l"))
+        emit("jra %s" % done)
+        emit("%s:" % big)
+        emit("sub.l #32,d2")
+        if kind == "left":
+            emit("move.l d1,d0")
+            emit("lsl.l d2,d0")
+            emit("moveq #0,d1")
+        elif kind == "right":
+            emit("move.l d0,d1")
+            emit("asr.l d2,d1")
+            emit("tst.l d0")
+            emit("smi d0")
+            emit("extb.l d0")
+        elif kind == "uright":
+            emit("move.l d0,d1")
+            emit("lsr.l d2,d1")
+            emit("moveq #0,d0")
+        emit("%s:" % done)
+        m68kStore64("d0", "d1", dst)
+
+    # 64-bit rotates through two shifts.
+    def m68kRotate64(self, left):
+        value, amount, dst = self.m68kOperands3()
+        if not isinstance(amount, Immediate):
+            raise Exception("Variable 64-bit rotate not supported at %s" % self.codeOriginString())
+        shift = amount.value & 63
+        if not left:
+            shift = (64 - shift) & 63
+        m68kLoad64(value, "d0", "d1")
+        if shift >= 32:
+            emit("exg d0,d1")
+            shift -= 32
+        if shift > 0:
+            emit("move.l d0,d2")
+            emit("move.l d1,d3")
+            self.m68kShift32Constant("lsl.l", shift, "d0")
+            self.m68kShift32Constant("lsr.l", 32 - shift, "d3")
+            emit("or.l d3,d0")
+            self.m68kShift32Constant("lsl.l", shift, "d1")
+            self.m68kShift32Constant("lsr.l", 32 - shift, "d2")
+            emit("or.l d2,d1")
+        m68kStore64("d0", "d1", dst)
+
+    # Loads that widen into the destination register. signed is False, True
+    # or "quad" (sign-extended into all 64 bits).
+    def m68kLoad(self, size, signed):
+        source, dst = self.operands
+        address = m68kAddress(source)
+        if size == 1:
+            if signed:
+                emit("move.b %s,d0" % address)
+                emit("extb.l d0")
+            else:
+                emit("moveq #0,d0")
+                emit("move.b %s,d0" % address)
+        elif size == 2:
+            if signed:
+                emit("move.w %s,d0" % address)
+                emit("ext.l d0")
+            else:
+                emit("moveq #0,d0")
+                emit("move.w %s,d0" % address)
+        elif size == 4:
+            emit("move.l %s,d0" % address)
+        if signed == "quad":
+            m68kStore32Signed("d0", dst)
+        else:
+            m68kStore32("d0", dst)
+
+    def m68kStore(self, size):
+        value, destination = self.operands
+        suffix = {1: "b", 2: "w", 4: "l"}[size]
+        if isinstance(value, Immediate):
+            source = "#%s" % m68kHex(value.value)
+        elif isinstance(value, RegisterID):
+            if value.m68kPinned():
+                source = value.m68kPinned()
+            else:
+                emit("move.l %s,d0" % value.m68kLo())
+                source = "d0"
+        else:
+            raise Exception("Bad store value %s at %s" % (value.inspect(), self.codeOriginString()))
+        emit("move.%s %s,%s" % (suffix, source, m68kAddress(destination)))
+
+    # 32-bit compare of a against b: sets the flags for a - b.
+    def m68kCompare32(self, a, b, size="l"):
+        if size == "l":
+            emit("move.l %s,d0" % m68kSource32(a, "d0"))
+            emit("cmp.l %s,d0" % m68kSource32(b, "d1"))
+        else:
+            self.m68kByteOperand(a, "d0")
+            self.m68kByteOperand(b, "d1")
+            emit("cmp.b d1,d0")
+
+    def m68kByteOperand(self, operand, register):
+        if isinstance(operand, Immediate):
+            emit("move.b #%d,%s" % (operand.value & 0xff, register))
+        elif isinstance(operand, RegisterID):
+            if operand.m68kPinned():
+                emit("move.l %s,%s" % (operand.m68kPinned(), register))
+            else:
+                emit("move.b %s+%d,%s" % (M68K_VRF, operand.m68kSlot() + 7, register))
+        else:
+            emit("move.b %s,%s" % (m68kAddress(operand, 0, "a1", "d6"), register))
+
+    # 64-bit compare and branch to target when a <condition> b holds.
+    def m68kBranch64(self, condition, a, b, target):
+        m68kLoad64(a, "d0", "d1")
+        m68kLoad64(b, "d2", "d3")
+        skip = m68kNewLabel()
+        if condition == "eq":
+            emit("cmp.l d2,d0")
+            emit("jne %s" % skip)
+            emit("cmp.l d3,d1")
+            emit("jeq %s" % target)
+        elif condition == "neq":
+            emit("cmp.l d2,d0")
+            emit("jne %s" % target)
+            emit("cmp.l d3,d1")
+            emit("jne %s" % target)
+        else:
+            strict = {"a": "jhi", "aeq": "jhi", "b": "jcs", "beq": "jcs",
+                      "gt": "jgt", "gteq": "jgt", "lt": "jlt", "lteq": "jlt"}[condition]
+            opposite = {"a": "jcs", "aeq": "jcs", "b": "jhi", "beq": "jhi",
+                        "gt": "jlt", "gteq": "jlt", "lt": "jgt", "lteq": "jgt"}[condition]
+            low = {"a": "jhi", "aeq": "jcc", "b": "jcs", "beq": "jls",
+                   "gt": "jhi", "gteq": "jcc", "lt": "jcs", "lteq": "jls"}[condition]
+            emit("cmp.l d2,d0")
+            emit("%s %s" % (strict, target))
+            emit("%s %s" % (opposite, skip))
+            emit("cmp.l d3,d1")
+            emit("%s %s" % (low, target))
+        emit("%s:" % skip)
+
+    def m68kBranch(self, kind, condition):
+        a, b, target = self.operands
+        target = self.m68kTarget(target)
+        if kind in ("int", "ptr"):
+            self.m68kCompare32(a, b)
+            emit("%s %s" % (m68kJcc(condition), target))
+        elif kind == "byte":
+            self.m68kCompare32(a, b, "b")
+            emit("%s %s" % (m68kJcc(condition), target))
+        elif kind == "quad":
+            self.m68kBranch64(condition, a, b, target)
+
+    def m68kCompareSet(self, kind, condition):
+        a, b, dst = self.operands
+        if kind in ("int", "ptr"):
+            self.m68kCompare32(a, b)
+            emit("%s d0" % m68kScc(condition))
+        elif kind == "byte":
+            self.m68kCompare32(a, b, "b")
+            emit("%s d0" % m68kScc(condition))
+        elif kind == "quad":
+            yes = m68kNewLabel()
+            done = m68kNewLabel()
+            self.m68kBranch64(condition, a, b, yes)
+            emit("moveq #0,d0")
+            emit("jra %s" % done)
+            emit("%s:" % yes)
+            emit("moveq #1,d0")
+            emit("%s:" % done)
+            m68kStore32("d0", dst)
+            return
+        emit("and.l #1,d0")
+        m68kStore32("d0", dst)
+
+    # Sets the flags from value & mask (mask defaults to all ones).
+    def m68kTest(self, kind, value, mask):
+        if kind == "byte":
+            self.m68kByteOperand(value, "d0")
+            if mask is not None:
+                self.m68kByteOperand(mask, "d1")
+                emit("and.b d1,d0")
+            else:
+                emit("tst.b d0")
+        elif kind in ("int", "ptr"):
+            emit("move.l %s,d0" % m68kSource32(value, "d0"))
+            if mask is not None:
+                emit("and.l %s,d0" % m68kSource32(mask, "d1"))
+            else:
+                emit("tst.l d0")
+        elif kind == "quad":
+            m68kLoad64(value, "d0", "d1")
+            if mask is not None:
+                m68kLoad64(mask, "d2", "d3")
+                emit("and.l d2,d0")
+                emit("and.l d3,d1")
+            # N from the high word, Z from both.
+            emit("move.l d0,d4")
+            emit("or.l d1,d4")
+            emit("seq d4")
+            emit("tst.l d0")
+            emit("smi d5")
+
+    def m68kBranchTest(self, kind, condition):
+        if len(self.operands) == 3:
+            value, mask, target = self.operands
+        else:
+            value, target = self.operands
+            mask = None
+        target = self.m68kTarget(target)
+        self.m68kTest(kind, value, mask)
+        if kind == "quad":
+            if condition == "s":
+                emit("tst.b d5")
+                emit("jne %s" % target)
+            elif condition == "z":
+                emit("tst.b d4")
+                emit("jne %s" % target)
+            elif condition == "nz":
+                emit("tst.b d4")
+                emit("jeq %s" % target)
+        else:
+            emit("%s %s" % ({"s": "jmi", "z": "jeq", "nz": "jne"}[condition], target))
+
+    def m68kSetTest(self, kind, condition):
+        if len(self.operands) == 3:
+            value, mask, dst = self.operands
+        else:
+            value, dst = self.operands
+            mask = None
+        self.m68kTest(kind, value, mask)
+        if kind == "quad":
+            if condition == "s":
+                emit("move.b d5,d0")
+            elif condition == "z":
+                emit("move.b d4,d0")
+            elif condition == "nz":
+                emit("move.b d4,d0")
+                emit("not.b d0")
+        else:
+            emit("%s d0" % {"s": "smi", "z": "seq", "nz": "sne"}[condition])
+        emit("and.l #1,d0")
+        m68kStore32("d0", dst)
+
+    # Arithmetic, then branch on overflow, sign, zero or non-zero.
+    def m68kOpBranch(self, op, kind, condition):
+        if len(self.operands) == 4:
+            a, b, dst, target = self.operands
+        else:
+            a, b, dst, target = self.operands[1], self.operands[0], self.operands[1], self.operands[2]
+        target = self.m68kTarget(target)
+        if kind == "quad":
+            if not (op == "add" or op == "sub"):
+                raise Exception("64-bit %s with branch not supported" % op)
+            m68kLoad64(a, "d0", "d1")
+            m68kLoad64(b, "d2", "d3")
+            if op == "add":
+                emit("add.l d3,d1")
+                emit("addx.l d2,d0")
+            else:
+                emit("sub.l d3,d1")
+                emit("subx.l d2,d0")
+            emit("svs d6")
+            m68kStore64("d0", "d1", dst)
+            if condition == "o":
+                emit("tst.b d6")
+                emit("jne %s" % target)
+            elif condition == "s":
+                emit("tst.l d0")
+                emit("jmi %s" % target)
+            elif condition in ("z", "nz"):
+                emit("or.l d0,d1")
+                emit("%s %s" % ("jeq" if condition == "z" else "jne", target))
+            return
+        emit("move.l %s,d0" % m68kSource32(a, "d0"))
+        source = m68kSource32(b, "d1")
+        if op == "add":
+            emit("add.l %s,d0" % source)
+        elif op == "sub":
+            emit("sub.l %s,d0" % source)
+        elif op == "mul":
+            emit("muls.l %s,d0" % source)
+        elif op == "or":
+            emit("or.l %s,d0" % source)
+        # The store must not change the flags: move to a data register
+        # register keeps V and C clear, so save the condition first.
+        emit("%s d6" % {"o": "svs", "s": "smi", "z": "seq", "nz": "sne"}[condition])
+        m68kStore32("d0", dst)
+        emit("tst.b d6")
+        emit("jne %s" % target)
+
+    # Pointer-sized slots on the C loop's JavaScript stack.
+    def m68kPush(self):
+        emit("move.l %s,a1" % M68K_VRF_SP)
+        for operand in self.operands:
+            emit("move.l %s,-(a1)" % m68kSource32(operand, "d0"))
+        emit("move.l a1,%s" % M68K_VRF_SP)
+
+    def m68kPop(self):
+        for operand in self.operands:
+            emit("move.l %s,a1" % M68K_VRF_SP)
+            emit("move.l (a1)+,d0")
+            emit("move.l a1,%s" % M68K_VRF_SP)
+            m68kStore32Signed("d0", operand)
+
+    # Calls a C function with 32-bit arguments; UGPRPair results go to t0, t1.
+    def m68kCallC(self, function, arguments, results):
+        emit("move.l _jsc_m68k_cloop_sp_field,a0")
+        emit("move.l %s,(a0)" % M68K_VRF_SP)
+        for argument in reversed(arguments):
+            emit("move.l %s,-(sp)" % m68kSource32(argument, "d0"))
+        emit("jsr %s" % function.m68kSymbol())
+        if arguments:
+            emit("lea %d(sp),sp" % (len(arguments) * 4))
+        if results:
+            m68kStore32("d0", RegisterID.forName(self.codeOrigin, "t0"))
+            m68kStore32("d1", RegisterID.forName(self.codeOrigin, "t1"))
+
+    # Arithmetic is in extended precision, as GCC's own code here does; a
+    # float result is rounded to single through memory.
+    def m68kFP2(self, opcode, kind):
+        if len(self.operands) == 3:
+            a, b, dst = self.operands
+            if dst.m68kOperand() == b.m68kOperand() and dst.m68kOperand() != a.m68kOperand():
+                emit("fmove.x %s,%s" % (b.m68kOperand(), M68K_FP_SCRATCH))
+                b = None
+            if dst.m68kOperand() != a.m68kOperand():
+                emit("fmove.x %s,%s" % (a.m68kOperand(), dst.m68kOperand()))
+            emit("%s %s,%s" % (opcode, b.m68kOperand() if b is not None else M68K_FP_SCRATCH, dst.m68kOperand()))
+        else:
+            dst = self.operands[1]
+            emit("%s %s,%s" % (opcode, self.operands[0].m68kOperand(), dst.m68kOperand()))
+        if kind == "float":
+            self.m68kRoundToFloat(dst.m68kOperand())
+
+    def m68kRoundToFloat(self, register):
+        emit("fmove.s %s,-(sp)" % register)
+        emit("fmove.s (sp)+,%s" % register)
+
+    # Branch on an IEEE comparison of a with b.
+    def m68kFPBranch(self, condition, size):
+        a, b, target = self.operands
+        emit("fcmp.x %s,%s" % (b.m68kOperand(), a.m68kOperand()))
+        emit("%s %s" % (condition, self.m68kTarget(target)))
+
+    def m68kFPCompareSet(self, condition):
+        a, b, dst = self.operands
+        emit("fcmp.x %s,%s" % (b.m68kOperand(), a.m68kOperand()))
+        emit("%s d0" % condition)
+        emit("and.l #1,d0")
+        m68kStore32("d0", dst)
+
+    # Truncates fpN toward zero into d0 (fmove.l rounds with the FPCR mode).
+    def m68kTruncateToInt(self, source):
+        emit("fmove.l fpcr,d2")
+        emit("move.l d2,d3")
+        emit("and.l #0xffffffcf,d3")
+        emit("or.l #0x10,d3")
+        emit("fmove.l d3,fpcr")
+        emit("fmove.l %s,d0" % source)
+        emit("fmove.l d2,fpcr")
+
+    def lowerM68K(self):
+        opcode = self.opcode
+        operands = self.operands
+        handler = _M68K_HANDLERS.get(opcode)
+        if handler is not None:
+            handler(self)
+            return
+        m = re.fullmatch(r"b([ipqb])(eq|neq|a|aeq|b|beq|gt|gteq|lt|lteq)", opcode)
+        if m:
+            self.m68kBranch(_KINDS[m.group(1)], m.group(2))
+            return
+        m = re.fullmatch(r"c([ipqb])(eq|neq|a|aeq|b|beq|gt|gteq|lt|lteq)", opcode)
+        if m:
+            self.m68kCompareSet(_KINDS[m.group(1)], m.group(2))
+            return
+        m = re.fullmatch(r"bt([ipqb])(s|z|nz)", opcode)
+        if m:
+            self.m68kBranchTest(_KINDS[m.group(1)], m.group(2))
+            return
+        m = re.fullmatch(r"t([ipqb])(s|z|nz)", opcode)
+        if m:
+            self.m68kSetTest(_KINDS[m.group(1)], m.group(2))
+            return
+        m = re.fullmatch(r"b(add|sub|mul|or)([ipq])(o|s|z|nz)", opcode)
+        if m:
+            self.m68kOpBranch(m.group(1), {"i": "int", "p": "ptr", "q": "quad"}[m.group(2)], m.group(3))
+            return
+        self.lowerDefault()
+
+
+for _name, _value in list(vars(_M68KInstruction).items()):
+    if callable(_value) and not _name.startswith("__"):
+        setattr(Instruction, _name, _value)
+
+
+#
+# The opcodes with their own lowering, as the "when" arms of Ruby's
+# lowerM68K. The branch, compare and test families are matched by pattern
+# in lowerM68K after these.
+#
+
+_M68K_HANDLERS = {}
+
+
+def handles(*opcodes):
+    def register(fn):
+        for opcode in opcodes:
+            _M68K_HANDLERS[opcode] = fn
+        return fn
+    return register
+
+
+@handles("addi", "addp")
+def _(self):
+    self.m68kBinary32("add.l")
+
+
+@handles("addq")
+def _(self):
+    self.m68kAdd64()
+
+
+@handles("subi", "subp")
+def _(self):
+    self.m68kBinary32("sub.l")
+
+
+@handles("subq")
+def _(self):
+    self.m68kSub64()
+
+
+@handles("andi", "andp")
+def _(self):
+    self.m68kBinary32("and.l")
+
+
+@handles("andq")
+def _(self):
+    self.m68kLogical64("and.l")
+
+
+@handles("ori", "orp")
+def _(self):
+    self.m68kBinary32("or.l")
+
+
+@handles("orq")
+def _(self):
+    self.m68kLogical64("or.l")
+
+
+@handles("xori", "xorp")
+def _(self):
+    a, b, dst = self.m68kOperands3()
+    emit("move.l %s,d0" % m68kSource32(a, "d0"))
+    emit("move.l %s,d1" % m68kSource32(b, "d1"))
+    emit("eor.l d1,d0")
+    m68kStore32("d0", dst)
+
+
+@handles("xorq")
+def _(self):
+    a, b, dst = self.m68kOperands3()
+    m68kLoad64(a, "d0", "d1")
+    m68kLoad64(b, "d2", "d3")
+    emit("eor.l d2,d0")
+    emit("eor.l d3,d1")
+    m68kStore64("d0", "d1", dst)
+
+
+@handles("orh")
+def _(self):
+    # 16-bit or, into memory (profile bits) or a register.
+    source, dst = self.operands
+    value = "#%d" % (source.value & 0xffff) if isinstance(source, Immediate) else m68kSource32(source, "d1")
+    if isinstance(dst, RegisterID):
+        emit("move.l %s,d0" % dst.m68kLo())
+        emit("or.w %s,d0" % value)
+        emit("and.l #0xffff,d0")
+        m68kStore32("d0", dst)
+    else:
+        if not re.match(r"(#|d1)", value):
+            emit("move.l %s,d1" % value)
+        if value.startswith("#"):
+            emit("or.w %s,%s" % (value, m68kAddress(dst)))
+        if not value.startswith("#"):
+            emit("or.w d1,%s" % m68kAddress(dst))
+
+
