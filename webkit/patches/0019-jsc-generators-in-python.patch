+# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+# FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS
+# IN THE SOFTWARE.
+"""Reads BytecodeList.rb without Ruby.
+
+BytecodeList.rb is Ruby code, but only a small part of Ruby: calls of the
+DSL's commands (types, templates, begin_section, end_section, op, op_group,
+simd_op_group) with symbols, strings, numbers, true/false/nil, arrays,
+hashes (written key: value, also as trailing call arguments), type names,
+Template[Type] and Type.* (a pointer). This reader understands exactly that
+and stops with the file and line for anything else, so upstream's file is
+used as it is.
+"""
+
+import re
+
+_TOKEN = re.compile(r"""
+    (?P<space>[ \t\r]+)
+  | (?P<comment>\#[^\n]*)
+  | (?P<newline>\n)
+  | (?P<label>[A-Za-z_][A-Za-z0-9_]*\??:(?!:))
+  | (?P<symbol>:[A-Za-z_][A-Za-z0-9_]*\??)
+  | (?P<string>"(?:[^"\\]|\\.)*")
+  | (?P<number>-?[0-9]+)
+  | (?P<ident>[A-Za-z_][A-Za-z0-9_]*)
+  | (?P<punct>[\[\]{}(),.*])
+""", re.X)
+
+
+class Symbol(str):
+    """A Ruby symbol: a string that prints without its colon."""
+
+
+class ReaderError(Exception):
+    pass
+
+
+def tokenize(text, path):
+    tokens = []
+    pos = 0
+    line = 1
+    while pos < len(text):
+        m = _TOKEN.match(text, pos)
+        if not m:
+            raise ReaderError("%s:%d: cannot read %r" % (path, line, text[pos:pos + 20]))
+        kind = m.lastgroup
+        value = m.group(0)
+        if kind == "newline":
+            tokens.append(("newline", value, line))
+            line += 1
+        elif kind not in ("space", "comment"):
+            tokens.append((kind, value, line))
+        pos = m.end()
+    tokens.append(("eof", "", line))
+    return tokens
+
+
+class Reader:
+    def __init__(self, text, path, names):
+        self.tokens = tokenize(text, path)
+        self.path = path
+        self.index = 0
+        self.names = names  # identifier -> value (Types, Templates)
+
+    def peek(self):
+        return self.tokens[self.index]
+
+    def take(self):
+        token = self.tokens[self.index]
+        self.index += 1
+        return token
+
+    def error(self, message):
+        kind, value, line = self.peek()
+        raise ReaderError("%s:%d: %s (at %r)" % (self.path, line, message, value))
+
+    def expect(self, value):
+        if self.peek()[1] != value:
+            self.error("expected %r" % value)
+        return self.take()
+
+    def skipNewlines(self):
+        while self.peek()[0] == "newline":
+            self.take()
+
+    def statements(self):
+        """Yields (command, positional arguments, keyword arguments)."""
+        while True:
+            self.skipNewlines()
+            kind, value, line = self.peek()
+            if kind == "eof":
+                return
+            if kind != "ident":
+                self.error("expected a command")
+            self.take()
+            args, kwargs = self.arguments()
+            yield value, args, kwargs, line
+
+    def arguments(self):
+        args = []
+        kwargs = {}
+        if self.peek()[0] in ("newline", "eof"):
+            return args, kwargs
+        while True:
+            if self.peek()[0] == "label":
+                key = self.take()[1][:-1]
+                self.skipNewlines()
+                kwargs[Symbol(key)] = self.value()
+            else:
+                if kwargs:
+                    self.error("positional argument after key: value")
+                args.append(self.value())
+            if self.peek()[1] == ",":
+                self.take()
+                self.skipNewlines()
+                continue
+            if self.peek()[0] in ("newline", "eof"):
+                return args, kwargs
+            self.error("expected ',' or the end of the line")
+
+    def value(self):
+        kind, value, line = self.take()
+        if kind == "symbol":
+            result = Symbol(value[1:])
+        elif kind == "string":
+            result = re.sub(r"\\(.)", r"\1", value[1:-1])
+        elif kind == "number":
+            result = int(value)
+        elif kind == "ident":
+            if value == "true":
+                result = True
+            elif value == "false":
+                result = False
+            elif value == "nil":
+                result = None
+            elif value in self.names:
+                result = self.names[value]
+            else:
+                self.index -= 1
+                self.error("unknown name %r" % value)
+            while True:
+                if self.peek()[1] == "[" and hasattr(result, "__getitem__") and not isinstance(result, (str, list, dict)):
+                    self.take()
+                    items = self.sequence("]")
+                    result = result[tuple(items)]
+                elif self.peek()[1] == "." and self.tokens[self.index + 1][1] == "*":
+                    self.take()
+                    self.take()
+                    result = result.pointer()
+                else:
+                    break
+        elif value == "[":
+            result = self.sequence("]")
+        elif value == "{":
+            result = self.hash()
+        else:
+            self.index -= 1
+            self.error("unexpected token")
+        return result
+
+    def sequence(self, closing):
+        items = []
+        while True:
+            self.skipNewlines()
+            if self.peek()[1] == closing:
+                self.take()
+                return items
+            items.append(self.value())
+            self.skipNewlines()
+            if self.peek()[1] == ",":
+                self.take()
+            elif self.peek()[1] != closing:
+                self.error("expected ',' or %r" % closing)
+
+    def hash(self):
+        result = {}
+        while True:
+            self.skipNewlines()
+            if self.peek()[1] == "}":
+                self.take()
+                return result
+            if self.peek()[0] != "label":
+                self.error("expected key:")
+            key = Symbol(self.take()[1][:-1])
+            self.skipNewlines()
+            result[key] = self.value()
+            self.skipNewlines()
+            if self.peek()[1] == ",":
+                self.take()
+            elif self.peek()[1] != "}":
+                self.error("expected ',' or '}'")
