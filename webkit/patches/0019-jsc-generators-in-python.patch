+class Label(Node):
+    def __init__(self, codeOrigin, name, definedInFile=False):
+        super().__init__(codeOrigin)
+        self._name = name
+        self.definedInFile = definedInFile
+        self._extern = True
+        self._global = False
+        self._aligned = True
+        self.alignTo = False
+        self._export = False
+
+    def children(self):
