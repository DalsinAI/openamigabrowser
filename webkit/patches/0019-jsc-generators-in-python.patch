+# THE POSSIBILITY OF SUCH DAMAGE.
+
+# usage: generate_offset_extractor.py [-I<dir>...] asmFile settingFile outputFileName
+#            backends variants [--webkit-additions-path=<path>] [--depfile=<depfile>]
+
+import hashlib
+import os
+import re
+import shlex
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+sys.setrecursionlimit(100000)
+
+from asm import parseOptions  # noqa: E402
+from offlineasm import config  # noqa: E402
+from offlineasm.assembler import Output  # noqa: E402
+from offlineasm.backends import canonicalizeBackendNames, includeOnlyBackends, validBackends  # noqa: E402
+from offlineasm.offsets import (configurationIndicesForVariants, MissingMagicValuesException,  # noqa: E402
+                                OFFSET_HEADER_MAGIC_NUMBERS, OFFSET_MAGIC_NUMBERS, offsetsList, sizesList,
+                                constsList)
+from offlineasm.parser import IncludeFile, parse, parseHash  # noqa: E402
+from offlineasm.self_hash import selfHash  # noqa: E402
+from offlineasm.settings import computeSettingsCombinations, forSettings, emitCodeInConfiguration  # noqa: E402
+
+
+def main():
+    argv = sys.argv[1:]
+    IncludeFile.processIncludeOptions(argv)
+
+    config.options, argv = parseOptions(argv, {
+        "webkit-additions-path": "webkit_additions_path",
+        "depfile": "depfile",
+    })
+
+    inputFlnm = argv.pop(0)
+    settingsFlnm = argv.pop(0)
+    outputFlnm = argv.pop(0)
+    tempFlnm = os.path.join(
+        os.environ.get("TARGET_TEMP_DIR") or os.path.dirname(outputFlnm),
+        "%s.part" % os.path.basename(outputFlnm))
+
+    inputBackends = canonicalizeBackendNames([v for v in re.split(r"[,\s]+", argv.pop(0)) if v != ""])
+    includeOnlyBackends(inputBackends)
+
+    variants = [v for v in re.split(r"[,\s]+", argv.pop(0)) if v != ""]
+
+    try:
+        configurationList = configurationIndicesForVariants(settingsFlnm, variants)
+    except MissingMagicValuesException:
+        sys.stderr.write("OffsetExtractor: No magic values found. Skipping offsets extractor file generation.\n")
+        sys.exit(1)
+
+    def emitMagicNumber():
+        for number in OFFSET_MAGIC_NUMBERS:
+            config.output.puts("unsigned(%d)," % number)
+
+    configurationHash = hashlib.sha1(" ".join(str(i) for i in configurationList).encode()).hexdigest()
+    inputHash = "// OffsetExtractor input hash: %s %s %s %s" % (parseHash(inputFlnm, config.options), configurationHash, selfHash(), " ".join(validBackends()))
+
+    if os.path.exists(outputFlnm) and (not config.options.get("depfile") or os.path.exists(config.options["depfile"])):
+        with open(outputFlnm, "r") as inp:
+            firstLine = inp.readline()
+            if firstLine and firstLine.rstrip("\n") == inputHash:
+                # Nothing changed.
+                sys.exit(0)
+
+    sources = set()
+    ast = parse(inputFlnm, config.options, sources)
+    settingsCombinations = computeSettingsCombinations(ast)
+
+    if config.options.get("depfile"):
+        with open(config.options["depfile"], "w") as depfile:
+            depfile.write(shlex.quote(outputFlnm) + ": ")
+            depfile.write(" ".join(shlex.quote(s) for s in sorted(sources)) + "\n")
+
+    with open(tempFlnm, "w") as f:
+        outp = Output(f)
+        config.output = outp
+        outp.puts(inputHash)
+
+        for configIndex in configurationList:
+            def generate(concreteSettings, lowLevelAST, backend, configIndex=configIndex):
+                lowLevelAST = lowLevelAST.demacroify({})
+                offsets = offsetsList(lowLevelAST)
+                sizes = sizesList(lowLevelAST)
+                consts = constsList(lowLevelAST)
+
+                def emit(concreteSettings_, ast_, backend_):
+                    # Windows complains about signed integers being cast to unsigned but we just want the bits.
+                    for index, const in enumerate(consts):
+                        outp.puts("constexpr int64_t constValue%d = static_cast<int64_t>(%s);" % (index, const.value))
+                    outp.puts("static const int64_t offsetExtractorTable[] = {")
+                    for number in OFFSET_HEADER_MAGIC_NUMBERS:
+                        outp.puts("unsigned(%d)," % number)
+
+                    emitMagicNumber()
+                    outp.puts("%d," % configIndex)
+                    for offset in offsets:
+                        emitMagicNumber()
+                        outp.puts("OFFLINE_ASM_OFFSETOF(%s, %s)," % (offset.struct, offset.field))
+                    for sizeof in sizes:
+                        emitMagicNumber()
+                        outp.puts("sizeof(%s)," % sizeof.struct)
+                    for index, const in enumerate(consts):
+                        emitMagicNumber()
+                        outp.puts("constValue%d," % index)
+                    outp.puts("};")
+                emitCodeInConfiguration(concreteSettings, lowLevelAST, backend, emit)
+
+            forSettings(settingsCombinations[configIndex], ast, generate)
+
+        # (Ruby's "if not configurationList.size" never held, so no empty
+        # table is written here either.)
+    os.replace(tempFlnm, outputFlnm)
+
+
+if __name__ == "__main__":
+    main()
