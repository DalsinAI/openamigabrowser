+# THE POSSIBILITY OF SUCH DAMAGE.
+
+# Base utility types for the AST.
+#
+# Valid methods for Node:
+#
+# node.children() -> Returns a list of immediate children.
+#
+# node.descendants() -> Returns a list of all strict descendants (children
+#     and children of children, transitively).
+#
+# node.flatten() -> Returns a list containing the strict descendants and
+#     the node itself.
+#
+# node.filter(type) -> Returns a list containing those elements in
+#     node.flatten() that are of the given type (isinstance returns True).
+#
+# node.mapChildren(fn) -> Returns a new node with all children
+#     replaced according to the given function.
+#
+# Examples:
+#
+# uniq(node.filter(Setting)) -> Returns all of the settings that the AST's
+#     IfThenElse blocks depend on.
+#
+# uniq(node.filter(StructOffset)) -> Returns all of the structure offsets
+#     that the AST depends on.
+#
+# Nodes compare and hash by identity (as Ruby's do for uniq and as hash
+# keys); Immediate and StringLiteral also compare by value with ==, as in
+# Ruby.
+
+from . import config
+
+
+def uniq(nodes):
+    """Ruby's Array#uniq for nodes: first occurrence of each object."""
+    seen = set()
+    result = []
+    for node in nodes:
+        if id(node) not in seen:
+            seen.add(id(node))
+            result.append(node)
+    return result
+
+
+def rubyInspectString(value):
+    """Ruby's String#inspect, enough for messages."""
+    out = '"'
+    for c in value:
+        if c == '"' or c == '\\':
+            out += '\\' + c
+        elif c == '\n':
+            out += '\\n'
+        elif c == '\t':
+            out += '\\t'
+        elif c == '\r':
+            out += '\\r'
+        elif c == '#':
+            out += '#'
+        elif ord(c) < 0x20 or ord(c) == 0x7f:
+            out += '\\x%02X' % ord(c)
+        else:
+            out += c
+    return out + '"'
+
+
+class Node:
+    def __init__(self, codeOrigin):
+        self.codeOrigin = codeOrigin
+
+    def codeOriginString(self):
+        return str(self.codeOrigin)
+
+    def descendants(self):
+        return self.flatten()[1:]
+
+    def flatten(self):
+        # Pre-order, as Ruby's [self] + children.collect{|v| v.flatten}.flatten.
+        result = []
+        stack = [self]
+        while stack:
+            node = stack.pop()
+            result.append(node)
+            children = node.children()
+            for index in range(len(children) - 1, -1, -1):
+                stack.append(children[index])
+        return result
+
+    def filter(self, type):
+        return [v for v in self.flatten() if isinstance(v, type)]
+
+    def inspect(self):
+        return "#<%s %s>" % (type(self).__name__, self.dump() if hasattr(self, "dump") else "")
+
+    def __repr__(self):
+        return self.inspect()
+
+
+class NoChildren(Node):
+    def __init__(self, codeOrigin):
+        super().__init__(codeOrigin)
+
+    def children(self):
+        return []
+
+    def mapChildren(self, fn):
+        return self
+
+
+#
+# AST nodes.
+#
+
+class StructOffset(NoChildren):
+    _mapping = {}
+
+    def __init__(self, codeOrigin, struct, field):
+        super().__init__(codeOrigin)
+        self.struct = struct
+        self.field = field
+
+    @staticmethod
+    def forField(codeOrigin, struct, field):
+        key = (struct, field)
+        if key not in StructOffset._mapping:
+            StructOffset._mapping[key] = StructOffset(codeOrigin, struct, field)
+        return StructOffset._mapping[key]
+
+    def dump(self):
+        return "%s::%s" % (self.struct, self.field)
+
+    def sortKey(self):
+        return (self.struct, self.field)
+
+    def isAddress(self):
+        return False
+
+    def isLabel(self):
+        return False
+
+    def isImmediate(self):
+        return True
+
+    def isRegister(self):
+        return False
+
+
+class Sizeof(NoChildren):
+    _mapping = {}
+
+    def __init__(self, codeOrigin, struct):
+        super().__init__(codeOrigin)
+        self.struct = struct
+
+    @staticmethod
+    def forName(codeOrigin, struct):
+        if struct not in Sizeof._mapping:
+            Sizeof._mapping[struct] = Sizeof(codeOrigin, struct)
+        return Sizeof._mapping[struct]
+
+    def dump(self):
+        return "sizeof %s" % self.struct
+
+    def sortKey(self):
+        return self.struct
+
+    def isAddress(self):
+        return False
+
+    def isLabel(self):
+        return False
+
+    def isImmediate(self):
+        return True
+
+    def isRegister(self):
+        return False
+
+
+def isInteger(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+class Immediate(NoChildren):
+    def __init__(self, codeOrigin, value):
+        super().__init__(codeOrigin)
+        self.value = value
+        if not isInteger(value):
+            raise Exception("Bad immediate value %r at %s" % (value, self.codeOriginString()))
+
+    def dump(self):
+        return "%d" % self.value
+
+    def name(self):
+        return "0x%x" % self.value if self.value >= 0 else "-0x%x" % -self.value
+
+    def __eq__(self, other):
+        return isinstance(other, Immediate) and other.value == self.value
+
+    def __ne__(self, other):
+        return not self.__eq__(other)
+
