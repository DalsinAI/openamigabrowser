+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+import re
+
+from . import config
+
+
+class Output:
+    """A text file with Ruby's IO#puts and IO#print."""
+
+    def __init__(self, file):
+        self.file = file
+
+    def puts(self, *lines):
+        if not lines:
+            self.file.write("\n")
+        for line in lines:
+            line = "%s" % line
+            self.file.write(line if line.endswith("\n") else line + "\n")
+
+    def print(self, text):
+        self.file.write(text)
+
+    def write(self, text):
+        self.file.write(text)
+
+
+class Assembler:
+    def __init__(self, outp):
+        self.outp = outp
+        self.state = "cpp"
+        self.lastCodeOrigin = None
+        self.resetAsm()
+
+    def resetAsm(self):
+        self.comment_ = None
+        self.internalComment = None
+        self.annotation_ = None
+        self.codeOrigin_ = None
+        self.numLocalLabels = 0
+        self.numGlobalLabels = 0
+        self.deferredOSDarwinActions = []
+        self.deferredNextLabelActions = []
+        self.count = 0
+        self.debugAnnotationStr = None
+        self.lastDebugAnnotationStr = None
+
+        self.newlineSpacerState = "none"
+        self.lastlabel = ""
+
+    def enterAsm(self):
+        self.outp.puts("")
+        self.putStr("OFFLINE_ASM_BEGIN")
+
+        self.state = "asm"
+        if config.enableDebugAnnotations:
+            from .parser import SourceFile
+            SourceFile.outputDotFileList(self.outp)
+
+    def leaveAsm(self):
+        self.putsLastComment()
+        if len(self.deferredOSDarwinActions) != 0:
+            self.putStr("#if OS(DARWIN)")
+            for action in self.deferredNextLabelActions + self.deferredOSDarwinActions:
+                action()
+            self.putStr("#endif // OS(DARWIN)")
+        self.putStr("OFFLINE_ASM_END")
+        self.state = "cpp"
+
+    def deferOSDarwinAction(self, action):
+        self.deferredOSDarwinActions.append(action)
+
+    def deferNextLabelAction(self, action):
+        self.deferredNextLabelActions.append(action)
+
+    def newUID(self):
+        self.count += 1
+        return self.count
+
+    def inAsm(self, fn):
+        self.resetAsm()
+        self.enterAsm()
+        fn()
+        self.leaveAsm()
+
+    # Concatenates all the various components of the comment to dump.
+    def lastComment(self):
+        separator = " "
+        result = ""
+        if self.comment_ is not None:
+            result = "%s" % self.comment_
+        if self.annotation_ is not None and config.enableInstrAnnotations:
+            if result != "":
+                result += separator
+            result += "%s" % self.annotation_
+        if self.internalComment is not None:
+            if result != "":
+                result += separator
+            result += "%s" % self.internalComment
+        if config.enableCodeOriginComments and self.codeOrigin_ is not None and self.codeOrigin_ != self.lastCodeOrigin:
+            self.lastCodeOrigin = self.codeOrigin_
+            if result != "":
+                result += separator
+            result += "%s" % self.codeOrigin_
+        if result != "":
+            result = "// " + result
+
+        # Reset all the components that we've just sent to be dumped.
+        self.comment_ = None
+        self.annotation_ = None
+        self.codeOrigin_ = None
+        self.internalComment = None
+        return result
+
+    # Puts a C Statement in the output stream.
+    def putc(self, *line):
+        if self.state != "asm":
+            raise Exception("unhandled exception")
+        self.outp.puts(self.formatDump("    " + "".join(line), self.lastComment()))
+
+    def formatDump(self, dumpStr, comment, commentColumns=None):
+        if commentColumns is None:
+            commentColumns = config.preferredCommentStartColumn
+        if len(comment) > 0:
+            result = "%-*s %s" % (commentColumns, dumpStr, comment)
+        else:
+            result = dumpStr
+        if config.enableDebugAnnotations:
+            if self.debugAnnotationStr is not None and self.debugAnnotationStr != self.lastDebugAnnotationStr:
+                result = "%-*s%s" % (config.preferredDebugAnnotationColumns, self.debugAnnotationStr, result)
+            else:
+                result = "%-*s%s" % (config.preferredDebugAnnotationColumns, "", result)
+            self.lastDebugAnnotationStr = self.debugAnnotationStr
+            self.debugAnnotationStr = None
+        return result
+
+    # private method for internal use only.
+    def putAnnotation(self, text):
+        if self.state != "asm":
+            raise Exception("unhandled exception")
+        if config.enableInstrAnnotations:
+            self.outp.puts(text)
+            self.annotation_ = None
+
+    def putLocalAnnotation(self):
+        if self.annotation_ is not None:
+            self.putAnnotation("    // %s" % self.annotation_)
+
+    def putGlobalAnnotation(self):
+        self.putsNewlineSpacerIfAppropriate("annotation")
+        if self.annotation_ is not None:
+            self.putAnnotation("// %s" % self.annotation_)
+
+    def putsLastComment(self):
+        comment = self.lastComment()
+        if comment != "":
+            self.outp.puts(comment)
+
+    def putStr(self, s):
+        if config.enableDebugAnnotations:
+            self.outp.puts("%-*s%s" % (config.preferredDebugAnnotationColumns, "", s))
+        else:
+            self.outp.puts(s)
+
+    def puts(self, *line):
+        if self.state != "asm":
+            raise Exception("unhandled exception")
+        self.outp.puts(self.formatDump("    \"" + "".join(line) + " \\n\"", self.lastComment()))
+
+    def print(self, line):
+        if self.state != "asm":
+            raise Exception("unhandled exception")
+        self.outp.print("\"" + line + "\"")
+
+    def putsNewlineSpacerIfAppropriate(self, state):
+        if self.newlineSpacerState != state:
+            self.outp.puts("\n")
+            self.newlineSpacerState = state
+
+    def putsLabel(self, labelName, isGlobal, isExport, isAligned, alignTo):
+        if self.state != "asm":
+            raise Exception("unhandled exception")
+        for action in self.deferredNextLabelActions:
+            action()
+        self.deferredNextLabelActions = []
+        self.numGlobalLabels += 1
+        self.putsNewlineSpacerIfAppropriate("global")
+        self.internalComment = ("Global Label %d" % self.numGlobalLabels) if config.enableLabelCountComments else None
+        if isGlobal:
+            if isAligned:
+                if isExport:
+                    self.outp.puts(self.formatDump("OFFLINE_ASM_GLOBAL_EXPORT_LABEL(%s)" % labelName, self.lastComment()))
+                elif alignTo:
+                    self.outp.puts(self.formatDump("OFFLINE_ASM_ALIGNED_GLOBAL_LABEL(%s, %s)" % (labelName, alignTo), self.lastComment()))
+                else:
+                    self.outp.puts(self.formatDump("OFFLINE_ASM_GLOBAL_LABEL(%s)" % labelName, self.lastComment()))
+            else:
+                if isExport:
+                    self.outp.puts(self.formatDump("OFFLINE_ASM_UNALIGNED_GLOBAL_EXPORT_LABEL(%s)" % labelName, self.lastComment()))
+                else:
+                    self.outp.puts(self.formatDump("OFFLINE_ASM_UNALIGNED_GLOBAL_LABEL(%s)" % labelName, self.lastComment()))
+        elif labelName.startswith("llint_op_"):
+            self.outp.puts(self.formatDump("OFFLINE_ASM_OPCODE_LABEL(op_%s)" % labelName[len("llint_op_"):], self.lastComment()))
+        else:
+            if alignTo:
+                self.outp.puts(self.formatDump("OFFLINE_ASM_ALIGN_TRAP(%s)" % alignTo, self.lastComment()))
+            self.outp.puts(self.formatDump("OFFLINE_ASM_GLUE_LABEL(%s)" % labelName, self.lastComment()))
+        if config.emitELFDebugDirectives:
+            def directives():
+                self.putStr("    \".size %s , . - %s \\n\"" % (labelName, labelName))
+                self.putStr("    \".type %s , function \\n\"" % labelName)
+            self.deferNextLabelAction(directives)
+        self.newlineSpacerState = "none"  # After a global label, we can use another spacer.
+
+    def putsLocalLabel(self, labelName):
+        if self.state != "asm":
+            raise Exception("unhandled exception")
+        self.numLocalLabels += 1
+        self.outp.puts("\n")
+        self.internalComment = ("Local Label %d" % self.numLocalLabels) if config.enableLabelCountComments else None
+        self.outp.puts(self.formatDump("  OFFLINE_ASM_LOCAL_LABEL(%s)" % labelName, self.lastComment()))
+
+    @staticmethod
+    def externOrGlobalLabelReference(labelName):
+        return "\" LABEL_REFERENCE(%s) \"" % labelName
+
+    @staticmethod
+    def localLabelReference(labelName):
+        return "\" LOCAL_LABEL_STRING(%s) \"" % labelName
+
+    @staticmethod
+    def cLabelReference(labelName):
+        if labelName.startswith("llint_op_"):
+            return "op_%s" % labelName[len("llint_op_"):]  # strip opcodes of their llint_ prefix.
+        return "%s" % labelName
+
+    @staticmethod
+    def cLocalLabelReference(labelName):
+        return "%s" % labelName
+
+    def codeOrigin(self, text):
+        self.codeOrigin_ = text
+
+    def comment(self, text):
+        self.comment_ = text
+
+    def annotation(self, text):
+        self.annotation_ = text
+
+    def debugAnnotation(self, text):
+        self.debugAnnotationStr = text
