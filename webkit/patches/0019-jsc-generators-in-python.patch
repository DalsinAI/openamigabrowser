+    def lowerDefault(self):
+        opcode = self.opcode
+        if opcode == "localAnnotation":
+            config.asm.putLocalAnnotation()
+        elif opcode == "globalAnnotation":
+            config.asm.putGlobalAnnotation()
+        elif opcode == "emit":
+            s = ""
+            for operand in self.operands:
+                if isinstance(operand, LocalLabelReference):
+                    s += operand.asmLabel()
+                else:
+                    s += "%s" % operand.dump()
+            config.asm.puts("%s" % s)
+        elif opcode in ("tagCodePtr", "tagReturnAddress", "untagReturnAddress", "removeCodePtrTag", "untagArrayPtr", "removeArrayPtrTag"):
+            pass
+        else:
+            raise Exception("Unhandled opcode %s at %s" % (opcode, self.codeOriginString()))
