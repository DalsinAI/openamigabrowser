+class SourceFile:
+    _fileNames = []
+
+    @staticmethod
+    def outputDotFileList(outp):
+        for index, fileName in enumerate(SourceFile._fileNames):
+            config.asm.putStr("\".file %d \\\"%s\\\"\\n\"" % (index + 1, fileName))
+
+    def __init__(self, fileName):
+        self.name = fileName
+        self.basename = os.path.basename(fileName)
+        pathName = os.path.realpath(fileName)
+        if pathName in SourceFile._fileNames:
+            fileNumber = SourceFile._fileNames.index(pathName) + 1  # File numbers are 1 based
+        else:
+            SourceFile._fileNames.append(pathName)
+            fileNumber = len(SourceFile._fileNames)
+        self.fileNumber = fileNumber
