+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+from . import config
+from .astnodes import Setting, Label, Error, uniq
+from .backends import BACKENDS, WORKING_BACKENDS, isBackend, isValidBackend
+from . import transform  # noqa: F401  (adds resolveSettings and demacroify to the nodes)
+
+
+#
+# computeSettingsCombinations(ast) -> settingsCombiations
+#
+# Computes a list of settings maps, where a settings map constitutes
+# a configuration for the assembly code being generated. The map
+# contains key value pairs where keys are settings names (strings) and
+# the values are booleans (True for enabled, False for disabled).
+#
+
+def computeSettingsCombinations(ast):
+    settingsCombinations = []
+
+    def settingsCombinator(settingsCombinations, mapSoFar, remaining):
+        if not remaining:
+            settingsCombinations.append(mapSoFar)
+            return
+
+        newMap = dict(mapSoFar)
+        newMap[remaining[0]] = True
+        settingsCombinator(settingsCombinations, newMap, remaining[1:])
+
+        newMap = dict(mapSoFar)
+        newMap[remaining[0]] = False
+        settingsCombinator(settingsCombinations, newMap, remaining[1:])
+
+    nonBackendSettings = [v.name for v in uniq(ast.filter(Setting))]
+    nonBackendSettings = [setting for setting in nonBackendSettings if not isBackend(setting)]
+
+    allBackendsFalse = {}
+    for backend in BACKENDS:
+        allBackendsFalse[backend] = False
+
+    # This will create entries for invalid backends. That's fine. It's necessary
+    # because it ensures that generate_offsets_extractor (which knows about valid
+    # backends) has settings indices that are compatible with what asm will see
+    # (asm doesn't know about valid backends).
+    for backend in BACKENDS:
+        map = dict(allBackendsFalse)
+        map[backend] = True
+        # The M68K back end runs the C loop's version of the interpreter.
+        if backend == "M68K":
+            map["C_LOOP"] = True
+        settingsCombinator(settingsCombinations, map, nonBackendSettings)
+
+    return settingsCombinations
+
+
+#
+# forSettings(concreteSettings, ast, fn)
+#     fn(concreteSettings, lowLevelAST, backend)
+#
+# Determines if the settings combination is valid, and if so, calls
+# the function with the information you need to generate code.
+#
+
+def forSettings(concreteSettings, ast, fn):
+    # Check which architectures this combinator claims to support.
+    selectedBackend = None
+    for backend in BACKENDS:
+        if concreteSettings[backend]:
+            # The M68K back end runs the C loop's version of the interpreter,
+            # so C_LOOP is on with it.
+            if backend == "C_LOOP" and concreteSettings["M68K"]:
+                continue
+            if selectedBackend is not None:
+                raise Exception("unhandled exception")
+            selectedBackend = backend
+
+    if not isValidBackend(selectedBackend):
+        return
+
+    # Resolve the AST down to a low-level form (no macros or conditionals).
+    lowLevelAST = ast.resolveSettings(concreteSettings)
+
+    fn(concreteSettings, lowLevelAST, selectedBackend)
+
+
+#
+# forEachValidSettingsCombination(ast, fn)
+#     fn(concreteSettings, ast, backend, index)
+#
+# Executes the function for each valid settings combination in the
+# settings map. The ast passed into the function is resolved
+# (ast.resolve) against the settings.
+#
+
+def forEachValidSettingsCombination(ast, fn, settingsCombinations=None):
+    if settingsCombinations is None:
+        settingsCombinations = computeSettingsCombinations(ast)
+
+    for index, concreteSettings in enumerate(settingsCombinations):
+        forSettings(concreteSettings, ast,
+                    lambda concreteSettings_, lowLevelAST, backend: fn(concreteSettings, lowLevelAST, backend, index))
+
+
+#
+# cppSettingsTest(concreteSettings)
+#
+# Returns the C++ code used to test if we are in a configuration that
+# corresponds to the given concrete settings.
+#
+
+def cppSettingsTest(concreteSettings):
+    return "#if " + " && ".join(("" if value else "!") + "OFFLINE_ASM_" + name
+                                for name, value in concreteSettings.items())
+
+
+#
+# isASTErroneous(ast)
+#
+# Tests to see if the AST claims that there is an error - i.e. if the
+# user's code, after settings resolution, has Error nodes.
+#
+
+def isASTErroneous(ast):
+    return len(ast.demacroify({}).filter(Error)) != 0
+
+
+#
+# assertConfiguration(concreteSettings)
+#
+# Emits a check that asserts that we're using the given configuration.
+#
+
+def assertConfiguration(concreteSettings):
+    config.output.puts(cppSettingsTest(concreteSettings))
+    config.output.puts("#else")
+    config.output.puts("#error \"Configuration mismatch.\"")
+    config.output.puts("#endif")
+
+
+#
+# emitCodeInConfiguration(concreteSettings, ast, backend, fn)
+#     fn(concreteSettings, ast, backend)
+#
+# Emits all relevant guards to see if the configuration holds and
+# calls the function if the configuration is not erroneous.
+#
+
+def emitCodeInConfiguration(concreteSettings, ast, backend, fn):
+    Label.resetReferenced()
+    config.output.puts(cppSettingsTest(concreteSettings))
+
+    if isASTErroneous(ast):
+        config.output.puts("#error \"Invalid configuration. Error at: %s\"" % ast.filter(Error)[0].codeOrigin)
+    elif backend not in WORKING_BACKENDS:
+        config.output.puts("#error \"This backend is not supported yet.\"")
+    else:
+        fn(concreteSettings, ast, backend)
+
+    config.output.puts("#endif")
+
+
+#
+# emitCodeInAllConfigurations(ast, fn)
+#     fn(concreteSettings, ast, backend, index)
+#
+# Emits guard codes for all valid configurations, and calls the function
+# for those configurations that are valid and not erroneous.
+#
+
+def emitCodeInAllConfigurations(ast, fn):
+    def each(concreteSettings, lowLevelAST, backend, index):
+        config.output.puts(cppSettingsTest(concreteSettings))
+        fn(concreteSettings, lowLevelAST, backend, index)
+        config.output.puts("#endif")
+    forEachValidSettingsCombination(ast, each)
