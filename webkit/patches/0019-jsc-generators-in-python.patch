+            if not isinstance(labelMapping[name], Label):
+                raise Exception("Label name collision: %s" % name)
+        else:
+            labelMapping[name] = Label(codeOrigin, name, definedInFile)
+        if definedInFile:
+            labelMapping[name].clearExtern()
+        return labelMapping[name]
+
+    @staticmethod
+    def _declare(codeOrigin, name, setter, what="global"):
+        if name in labelMapping:
+            label = labelMapping[name]
+            if what == "global":
+                if label.isGlobal():
+                    raise Exception("Label: %s declared global multiple times" % name)
+            else:
+                if label.isAligned():
+                    raise Exception("Label: %s declared aligned multiple times" % name)
+            setter(label)
+        else:
+            newLabel = Label(codeOrigin, name)
+            setter(newLabel)
+            labelMapping[name] = newLabel
+
+    @staticmethod
+    def setAsGlobal(codeOrigin, name):
+        Label._declare(codeOrigin, name, lambda label: label.setGlobal())
+
+    @staticmethod
+    def setAsGlobalExport(codeOrigin, name):
+        Label._declare(codeOrigin, name, lambda label: label.setGlobalExport())
+
+    @staticmethod
+    def setAsUnalignedGlobal(codeOrigin, name):
+        Label._declare(codeOrigin, name, lambda label: label.setUnalignedGlobal())
+
+    @staticmethod
+    def setAsAligned(codeOrigin, name, alignTo):
+        Label._declare(codeOrigin, name, lambda label: label.setAligned(alignTo), "aligned")
+
+    @staticmethod
+    def setAsUnalignedGlobalExport(codeOrigin, name):
+        Label._declare(codeOrigin, name, lambda label: label.setUnalignedGlobalExport())
+
+    @staticmethod
+    def resetReferenced():
+        del referencedExternLabels[:]
+
+    @staticmethod
+    def forReferencedExtern(fn):
+        for label in referencedExternLabels:
+            fn("%s" % label.name)
+
+    def clearExtern(self):
+        self._extern = False
+
+    def isExtern(self):
+        return self._extern
+
+    def setGlobal(self):
+        self._global = True
+
+    def setGlobalExport(self):
+        self._global = True
+        self._export = True
+
+    def setUnalignedGlobal(self):
+        self._global = True
+        self._aligned = False
+
+    def setAligned(self, alignTo):
+        self._aligned = True
+        self.alignTo = alignTo
+        # You must use this from cpp for the alignment to work on all linkers
+        self._global = True
+
+    def setUnalignedGlobalExport(self):
+        self._global = True
+        self._aligned = False
+        self._export = True
+
+    def isGlobal(self):
+        return self._global
+
+    def isExport(self):
+        return self._export
+
+    def isAligned(self):
+        return self._aligned
