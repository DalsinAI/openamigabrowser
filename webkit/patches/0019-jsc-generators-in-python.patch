+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+# usage: generate_settings_extractor.py [-I<dir>...] asmFile outputFileName backends
+#            [--webkit-additions-path=<path>] [--depfile=<depfile>]
+
+import os
+import re
+import shlex
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+sys.setrecursionlimit(100000)
+
+from asm import parseOptions  # noqa: E402
+from offlineasm import config  # noqa: E402
+from offlineasm.assembler import Output  # noqa: E402
+from offlineasm.astnodes import Sequence, Setting  # noqa: E402
+from offlineasm.backends import canonicalizeBackendNames, includeOnlyBackends, validBackends  # noqa: E402
+from offlineasm.offsets import OFFSET_HEADER_MAGIC_NUMBERS  # noqa: E402
+from offlineasm.parser import IncludeFile, parse, parseHash  # noqa: E402
+from offlineasm.self_hash import selfHash  # noqa: E402
+from offlineasm.settings import computeSettingsCombinations, emitCodeInAllConfigurations  # noqa: E402
+
+
+def main():
+    argv = sys.argv[1:]
+    IncludeFile.processIncludeOptions(argv)
+
+    config.options, argv = parseOptions(argv, {
+        "webkit-additions-path": "webkit_additions_path",
+        "depfile": "depfile",
+    })
+
+    inputFlnm = argv.pop(0)
+    outputFlnm = argv.pop(0)
+    tempFlnm = os.path.join(
+        os.environ.get("TARGET_TEMP_DIR") or os.path.dirname(outputFlnm),
+        "%s.part" % os.path.basename(outputFlnm))
+
+    inputBackends = canonicalizeBackendNames([v for v in re.split(r"[,\s]+", argv.pop(0)) if v != ""])
+    includeOnlyBackends(inputBackends)
+
+    inputHash = "// SettingsExtractor input hash: %s %s %s" % (parseHash(inputFlnm, config.options), selfHash(), " ".join(validBackends()))
+
+    if os.path.exists(outputFlnm) and (not config.options.get("depfile") or os.path.exists(config.options["depfile"])):
+        with open(outputFlnm, "r") as inp:
+            firstLine = inp.readline()
+            if firstLine and firstLine.rstrip("\n") == inputHash:
+                # Nothing changed.
+                sys.exit(0)
+
+    sources = set()
+    originalAST = parse(inputFlnm, config.options, sources)
+    prunedAST = Sequence(originalAST.codeOrigin, originalAST.filter(Setting))
+
+    if config.options.get("depfile"):
+        with open(config.options["depfile"], "w") as depfile:
+            depfile.write(shlex.quote(outputFlnm) + ": ")
+            depfile.write(" ".join(shlex.quote(s) for s in sorted(sources)) + "\n")
+
+    with open(tempFlnm, "w") as f:
+        outp = Output(f)
+        config.output = outp
+        outp.puts(inputHash)
+
+        settingsCombinations = computeSettingsCombinations(prunedAST)
+        length = len(settingsCombinations) * (1 + len(OFFSET_HEADER_MAGIC_NUMBERS))
+
+        outp.puts("static const int64_t settingsExtractorTable[%d] = {" % length)
+
+        def each(settings, ast, backend, index):
+            for number in OFFSET_HEADER_MAGIC_NUMBERS:
+                config.output.puts("unsigned(%d)," % number)
+            outp.puts("%d," % index)
+        emitCodeInAllConfigurations(prunedAST, each)
+        outp.puts("};")
+    os.replace(tempFlnm, outputFlnm)
+
+
+if __name__ == "__main__":
+    main()
