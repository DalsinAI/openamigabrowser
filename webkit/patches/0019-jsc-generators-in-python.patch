+
+script = sys.argv[1] if len(sys.argv) > 1 else "(no script)"
+sys.stderr.write(
+    "error: this build has no Ruby, but a build step asked for it to run:\n"
+    "    %s\n"
+    "The Amiga build runs Python ports of WebKit's Ruby generators\n"
+    "(JavaScriptCore/offlineasm-py, JavaScriptCore/generator-py,\n"
+    "WTF/Scripts/GeneratePreferences.py). This one has no port yet.\n" % script)
