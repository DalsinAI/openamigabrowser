+class IfThenElse(Node):
+    def __init__(self, codeOrigin, predicate, thenCase):
+        super().__init__(codeOrigin)
+        self.predicate = predicate
+        self.thenCase = thenCase
+        self.elseCase = Skip(codeOrigin)
+
+    def children(self):
+        if self.elseCase is not None:
+            return [self.predicate, self.thenCase, self.elseCase]
+        return [self.predicate, self.thenCase]
+
+    def mapChildren(self, fn):
+        ifThenElse = IfThenElse(self.codeOrigin, fn(self.predicate), fn(self.thenCase))
+        ifThenElse.elseCase = fn(self.elseCase)
+        return ifThenElse
+
+    def dump(self):
+        return "if %s\n" % self.predicate.dump() + self.thenCase.dump() + "\nelse\n" + self.elseCase.dump() + "\nend"
+
+
+class Macro(Node):
+    def __init__(self, codeOrigin, name, variables, body):
+        super().__init__(codeOrigin)
+        self.name = name
+        self.variables = variables
+        self.body = body
+
+    def children(self):
+        return self.variables + [self.body]
+
+    def mapChildren(self, fn):
+        return Macro(self.codeOrigin, self.name, [fn(v) for v in self.variables], fn(self.body))
+
+    def dump(self):
+        return "macro %s(" % self.name + ", ".join(v.dump() for v in self.variables) + ")\n" + self.body.dump() + "\nend"
+
+
+class MacroCall(Node):
+    def __init__(self, codeOrigin, name, operands, annotation, originalName=None):
+        super().__init__(codeOrigin)
+        self.name = name
+        self.operands = operands
+        if self.operands is None:
+            raise Exception("unhandled exception")
+        for v in self.operands:
+            if v is None:
+                raise Exception("unhandled exception")
+        self.annotation = annotation
+        self._originalName = originalName
+
+    def originalName(self):
+        return self._originalName if self._originalName is not None else self.name
+
+    def children(self):
+        return self.operands
+
+    def mapChildren(self, fn):
+        return MacroCall(self.codeOrigin, self.name, [fn(v) for v in self.operands], self.annotation, self._originalName)
+
+    def dump(self):
+        return "\t%s(" % self.originalName() + ", ".join(v.dump() for v in self.operands) + ")"
