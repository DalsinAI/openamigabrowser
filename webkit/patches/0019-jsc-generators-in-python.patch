@@ -0,0 +1,1176 @@
+# Copyright (C) 2011-2020 Apple Inc. All rights reserved.
+# Copyright (C) 2026 AmigaChrome Team (Python port of JavaScriptCore/offlineasm/ast.rb).
+#
