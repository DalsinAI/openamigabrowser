+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+import Fits
+
+
+class Argument:
+    def __init__(self, name, type, index):
+        name = "%s" % name
+        self.optional = name[-1] == "?"
+        self.name = name[0:-1] if self.optional else name
+        self.type = type
+        self.index = index
+        self._capitalized_name = None
+
+    def field(self):
+        return "%s %s;" % (self.type, self.field_name())
+
+    def create_param(self):
+        return "%s %s" % (self.type, self.name)
+
+    def create_reference_param(self):
+        return "%s& %s" % (self.type, self.name)
+
+    def field_name(self):
+        return "m_%s" % self.name
+
+    def fits_check(self, size):
+        return Fits.check(size, self.name, self.type)
+
+    def assert_fits(self, size):
+        return "ASSERT((%s));" % self.fits_check(size)
+
+    def load_from_stream(self, index, size):
+        return "%s(%s)" % (self.field_name(), Fits.convert(size, "stream[%d]" % index, self.type))
+
+    def setter(self, traits):
+        return """    template<typename Functor>
+    void set%(cap)s(%(type)s value, Functor func)
+    {
+        if (isWide32())
+            set%(cap)s<OpcodeSize::Wide32>(value, func);
+        else if (isWide16())
+            set%(cap)s<OpcodeSize::Wide16>(value, func);
+        else
+            set%(cap)s<OpcodeSize::Narrow>(value, func);
+    }
+
+    template <OpcodeSize size, typename Functor>
+    void set%(cap)s(%(type)s value, Functor func)
+    {
+        if (!%(check)s)
+            value = func();
+        auto* stream = std::bit_cast<typename TypeBySize<size>::unsignedType*>(reinterpret_cast<uint8_t*>(this) + %(index)d * size + PaddingBySize<size>::value + OpcodeIDWidthBySize<%(traits)s, size>::opcodeIDSize);
+        *stream = %(convert)s;
+    }
+""" % {"cap": self.capitalized_name(), "type": self.type, "check": Fits.check("size", "value", self.type),
+       "index": self.index, "traits": traits, "convert": Fits.convert("size", "value", self.type)}
+
