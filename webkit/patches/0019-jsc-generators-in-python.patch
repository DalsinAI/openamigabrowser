+# THE POSSIBILITY OF SUCH DAMAGE.
+
+import functools
+import io
+
+from Assertion import assert_
+from Opcode import Opcode
+
+
+class Section:
+    def __init__(self, name, config):
+        self.name = name
+        self.config = config
+        self.opcodes = []
+        self.opcode_groups = []
+
+    def add_opcode(self, name, config):
+        self.opcodes.append(self.create_opcode(name, config))
+
+    def create_opcode(self, name, config):
+        return Opcode(self, name, config.get("extras"), config.get("args"), config.get("metadata"),
+                      config.get("metadata_initializers"), config.get("tmps"), config.get("checkpoints"))
+
+    def add_opcode_group(self, name, opcodes, config):
+        opcodes = [self.create_opcode(opcode, config) for opcode in opcodes]
+        self.opcode_groups.append((name, opcodes, config))
+        self.opcodes += opcodes
+
+    def sort(self):
+        # Ruby's Array#sort is not stable; this sort is, so opcodes that
+        # compare equal keep the order BytecodeList.rb gives them.
+        def compare(a, b):
+            if a.checkpoints is not None or b.checkpoints is not None:
+                if a.checkpoints is not None and a.metadata.empty():
+                    raise Exception("Bytecodes with checkpoints should have metadata: %s" % a.name())
+                if b.checkpoints is not None and b.metadata.empty():
+                    raise Exception("Bytecodes with checkpoints should have metadata: %s" % b.name())
+                return (0 if b.checkpoints is not None else -1) if a.checkpoints is not None else 1
+            # SIMD opcodes should always use higher bytecode ids since they are more rare.
+            elif "simd" in a.name().lower() or "simd" in b.name().lower():
+                return (0 if "simd" in b.name() else 1) if "simd" in a.name() else -1
+            else:
+                return (0 if b.metadata.empty() else 1) if a.metadata.empty() else -1
+        self.opcodes = sorted(self.opcodes, key=functools.cmp_to_key(compare))
+
+    def validate(self):
+        first_non_checkpoint = None
+        first_non_metadata = None
+        last_simd = None
+        # validate that opcodes are ordered as
+        # [opcodes_with_checkpoint] ++ [opcodes_with_metadata] ++ [non_simd_opcodes] ++ [simd_opcodes]
+        for opcode in self.opcodes:
+            if opcode.checkpoints is None:
+                first_non_checkpoint = first_non_checkpoint or opcode
+            elif first_non_checkpoint:
+                assert_("invalid order of bytecodes in section '%s': found opcode '%s' with checkpoints after '%s', which doesn't contain checkpoints" % (self.name, opcode.name(), first_non_checkpoint.name()), False)
+
+            if opcode.metadata.empty():
+                first_non_metadata = first_non_metadata or opcode
+            elif first_non_metadata:
+                assert_("invalid order of bytecodes in section '%s': found opcode '%s' with metadata after '%s', which doesn't contain metadata" % (self.name, opcode.name(), first_non_metadata.name()), False)
+
+            if "simd" in opcode.name().lower():
+                last_simd = opcode
+            elif last_simd:
+                assert_("invalid order of bytecodes in section '%s': found non-simd opcode '%s' after '%s'" % (self.name, opcode.name(), last_simd.name()), False)
+
+    def create_ids(self):
+        for opcode in self.opcodes:
+            opcode.create_id()
+
+    def is_wasm(self):
+        return self.name == "Wasm"
+
+    def header_helpers(self, num_opcodes):
+        out = io.StringIO()
+        config = self.config
+        if config.get("emit_in_h_file"):
+            out.write("#define FOR_EACH_%s_ID(macro) \\\n" % config["macro_name_component"])
+            for opcode in self.opcodes:
+                out.write("    macro(%s, %d) \\\n" % (opcode.name(), opcode.length()))
+            out.write("\n")
+
+            out.write("#define NUMBER_OF_%s_IDS %d\n" % (config["macro_name_component"], len(self.opcodes)))
+            out.write("#define MAX_LENGTH_OF_%s_IDS %d\n" % (config["macro_name_component"], max(opcode.length() for opcode in self.opcodes)))
+
+        if config.get("emit_in_structs_file"):
+            i = 0
+            out.write("static constexpr unsigned %sCheckpointCountTable[] = {\n" % config["macro_name_component"].lower())
+            while True:
+                if self.opcodes[i].checkpoints is None:
+                    out.write("};\n\n")
+                    out.write("#define NUMBER_OF_%s_WITH_CHECKPOINTS %d\n" % (config["macro_name_component"], i))
+                    break
+
+                out.write("    %d,\n" % len(self.opcodes[i].checkpoints))
+                i += 1
+            out.write("\n")
+
+            out.write("#define FOR_EACH_%s_METADATA_SIZE(macro) \\\n" % config["macro_name_component"])
+            i = 0
+            while True:
+                if self.opcodes[i].metadata.empty():
+                    out.write("\n")
+                    out.write("#define NUMBER_OF_%s_WITH_METADATA %d\n" % (config["macro_name_component"], i))
+                    break
+
+                out.write("    macro(sizeof(%s::Metadata))\\\n" % self.opcodes[i].capitalized_name())
+                i += 1
+            out.write("\n")
+
+            out.write("#define FOR_EACH_%s_METADATA_ALIGNMENT(macro) \\\n" % config["macro_name_component"])
+            i = 0
+            while True:
+                if self.opcodes[i].metadata.empty():
+                    out.write("\n")
+                    break
+
+                out.write("    macro(alignof(%s::Metadata))\\\n" % self.opcodes[i].capitalized_name())
+                i += 1
+
+        if config.get("emit_opcode_id_string_values_in_h_file"):
+            for opcode in self.opcodes:
+                out.write("#define %s_value_string \"%d\"\n" % (opcode.name(), opcode.id))
+            for opcode in self.opcodes:
+                out.write("#define %s_wide16_value_string \"%d\"\n" % (opcode.name(), num_opcodes + opcode.id))
+            for opcode in self.opcodes:
+                out.write("#define %s_wide32_value_string \"%d\"\n" % (opcode.name(), num_opcodes * 2 + opcode.id))
+        return out.getvalue()
+
+    def for_each_struct(self):
+        return "#define FOR_EACH_%s_STRUCT(macro) \\\n%s\n" % (
+            self.config["macro_name_component"],
+            "\n".join("    macro(%s) \\" % op.capitalized_name() for op in self.opcodes))
