+# (main.rb and Options.rb)
+
+import argparse
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from DSL import DSL  # noqa: E402
+
+OPTIONS = [
+    ("bytecodes_filename", "-b", "--bytecodes_h", "generate bytecodes macro .h FILE"),
+    ("bytecode_structs_filename", "-s", "--bytecode_structs_h", "generate bytecode structs .h FILE"),
+    ("init_asm_filename", "-a", "--init_bytecodes_asm", "generate ASM bytecodes init FILE"),
+    ("bytecode_indices_filename", "-i", "--bytecode_indices_h", "generate indices of bytecode structs .h FILE"),
+    ("wasm_json_filename", None, "--wasm_json", "Path to JavaScriptCore's wasm.json file"),
+    ("bytecode_dumper_filename", None, "--bytecode_dumper", "generate bytecode dumper FILE"),
+]
+
+
+def parse(argv):
+    parser = argparse.ArgumentParser(usage="%(prog)s [options] <bytecode-list-file>")
+    for key, short, long, desc in OPTIONS:
+        names = [n for n in (short, long) if n]
+        parser.add_argument(*names, dest=key, metavar="FILE", help=desc, required=True)
+    parser.add_argument("bytecode_list")
+    return vars(parser.parse_args(argv))
+
+
+def main():
+    options = parse(sys.argv[1:])
+    dsl = DSL()
+    # for some reason, lower case variables are not accessible until the next invocation of eval
+    # so we bind them here, before eval'ing the file
+    dsl.types(["bool", "int", "unsigned", "uintptr_t", "uint8_t"])
+    dsl.run(options)
+
+
+if __name__ == "__main__":
+    main()
