+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+# (Type.rb and Template.rb)
+
+
+class Type:
+    def __init__(self, name):
+        self.name = name
+
+    def pointer(self):
+        """Ruby's Type#* (written "Type.*" in BytecodeList.rb)."""
+        return Type("%s*" % self.name)
+
+    def __str__(self):
+        return "%s" % self.name
+
+
+class Template(Type):
+    def __getitem__(self, types):
+        if not isinstance(types, tuple):
+            types = (types,)
+        return Type("%s<%s>" % (self.name, ",".join(str(t) for t in types)))
