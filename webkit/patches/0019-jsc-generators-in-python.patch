+from . import config
+from .assembler import Assembler
+from .astnodes import Node, Label, LocalLabel, LabelReference, LocalLabelReference, Skip, Sequence
+
+# The Python port carries one back end, M68K (m68k.py). The other names stay
+# in the list so that settings indices match the C++ side's view of every
+# configuration; asking to lower any of them fails with "#error This backend
+# is not supported yet." in the generated header.
+
+BACKENDS = [
+    "X86_64",
+    "ARM64",
+    "ARM64E",
+    "RISCV64",
+    "M68K",
+    "C_LOOP",
+]
+
+WORKING_BACKENDS = [
+    "M68K",
+]
+
+_allBackends = {}
+_validBackends = {}
+for _backend in BACKENDS:
+    _validBackends[_backend] = True
+    _allBackends[_backend] = True
+
+
+def canonicalizeBackendNames(backendNames):
+    newBackendNames = []
+    for backendName in backendNames:
+        backendName = backendName.upper()
+        if backendName == "ARM64_32":
+            backendName = "ARM64"
+        if backendName not in newBackendNames:
+            newBackendNames.append(backendName)
+    return newBackendNames
+
+
+def includeOnlyBackends(list):
+    global _validBackends
+    newValidBackends = {}
+    for backend in list:
+        if _validBackends.get(backend):
+            newValidBackends[backend] = True
+    _validBackends = newValidBackends
+
+
+def isBackend(backend):
+    return _allBackends.get(backend, False)
+
+
+def isValidBackend(backend):
+    return _validBackends.get(backend, False)
+
+
+def validBackends():
+    return list(_validBackends.keys())
+
+
+class LoweringError(Exception):
+    def __init__(self, e, originString):
+        super().__init__("%s (due to %s)" % (e, originString))
+        self.originString = originString
+
+
+def _nodeLower(self, name):
+    try:
+        config.activeBackend = name
+        self.prepareToLower(name)
+        lowering = getattr(self, "lower" + name, None)
+        if lowering is None:
+            raise Exception("undefined method `lower%s' for %s" % (name, type(self).__name__))
+        lowering()
+    except LoweringError:
+        raise
+    except Exception as e:
+        raise LoweringError(e, self.codeOriginString()) from e
+
+
+Node.lower = _nodeLower
+
+
+def _labelLower(self, name):
+    if config.enableDebugAnnotations:
+        config.asm.debugAnnotation(self.codeOrigin.debugDirective())
+    config.asm.putsLabel(self.name[1:], self._global, self._export, self._aligned,
+                         self.alignTo.dump() if self.alignTo else self.alignTo)
+
+
+Label.lower = _labelLower
+
+
+def _localLabelString(self):
+    return "jsc_llint_%s_%s" % (self.name[1:], self.codeOrigin.labelStringExtension())
+
+
+def _localLabelLower(self, name):
+    config.asm.putsLocalLabel(self.labelString())
+
+
+LocalLabel.labelString = _localLabelString
+LocalLabel.lower = _localLabelLower
+
+
+def _labelReferenceAsmLabel(self):
+    # For historical reasons a LabelReference may reference a label which is neither
+    # extern nor global, in which case it should act as a LocalLabelReference.
+    # See https://bugs.webkit.org/show_bug.cgi?id=131205.
+    if self.isExternOrGlobal():
+        return Assembler.externOrGlobalLabelReference(self.name[1:])
+    return Assembler.localLabelReference(self.name[1:])
+
+
+def _labelReferenceCLabel(self):
+    return Assembler.cLabelReference(self.name[1:])
+
+
+LabelReference.asmLabel = _labelReferenceAsmLabel
+LabelReference.cLabel = _labelReferenceCLabel
+
+
+def _localLabelReferenceAsmLabel(self):
+    return Assembler.localLabelReference(self.label.labelString())
+
+
+def _localLabelReferenceCLabel(self):
+    return Assembler.cLocalLabelReference(self.label.labelString())
+
+
+LocalLabelReference.asmLabel = _localLabelReferenceAsmLabel
+LocalLabelReference.cLabel = _localLabelReferenceCLabel
+
+
+def _skipLower(self, name):
+    pass
+
+
+Skip.lower = _skipLower
+
+
+def _sequenceLower(self, name):
+    config.activeBackend = name
+    getModifiedList = getattr(self, "getModifiedList" + name, None)
+    lowering = getattr(self, "lower" + name, None)
+    if getModifiedList is not None:
+        for node in getModifiedList():
+            node.lower(name)
+    elif lowering is not None:
+        lowering()
+    else:
+        for node in self.list:
+            node.lower(name)
+
+
+Sequence.lower = _sequenceLower
+
+# The back ends add their lowering methods to the nodes.
+from . import m68k  # noqa: E402,F401
