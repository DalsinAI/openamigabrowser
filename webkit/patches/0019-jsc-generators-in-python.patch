+
+class CodeOrigin:
+    def __init__(self, sourceFile, lineNumber):
+        self.sourceFile = sourceFile
+        self.lineNumber = lineNumber
+
+    def fileName(self):
+        return self.sourceFile.name
+
+    def debugDirective(self):
+        return "\".loc %d %d\\n\"" % (self.sourceFile.fileNumber, self.lineNumber)
+
+    def __str__(self):
+        return "%s:%d" % (self.sourceFile.basename, self.lineNumber)
+
+    def labelStringExtension(self):
+        return "%s_%d" % (self.sourceFile.basename.replace(".", "_", 1), self.lineNumber)
+
+
+class IncludeFile:
+    includeDirs = []
+
+    def __init__(self, moduleName, defaultDir):
+        directory = None
+        for includePath in IncludeFile.includeDirs:
+            fileName = os.path.join(includePath, moduleName + ".asm")
+            if os.path.isfile(fileName):
+                directory = includePath
+        if directory is None:
+            directory = defaultDir
+        self.fileName = os.path.join(directory, moduleName + ".asm")
+
+    @staticmethod
+    def processIncludeOptions(argv):
+        """Takes the leading -I options off argv (a list), as Ruby's did with ARGV."""
+        while argv and argv[0].startswith("-I"):
+            path = argv.pop(0)[2:]
+            if not path:
+                path = argv.pop(0)
+            IncludeFile.includeDirs.append(path + "/")
+
+
+class Token:
+    def __init__(self, codeOrigin, string):
+        self.codeOrigin = codeOrigin
+        self.string = string
+
+    def __eq__(self, other):
+        if isinstance(other, Token):
+            return self.string == other.string
+        return self.string == other
+
+    def __ne__(self, other):
+        return not self.__eq__(other)
+
+    __hash__ = object.__hash__
+
+    def __str__(self):
+        return "%s at %s" % (rubyInspectString(self.string), self.codeOrigin)
+
+    def parseError(self, *comment):
+        if not comment:
+            raise Exception("Parse error: %s" % self)
+        raise Exception("Parse error: %s: %s" % (self, comment[0]))
+
+
+class Annotation:
+    def __init__(self, codeOrigin, type, string):
+        self.codeOrigin = codeOrigin
+        self.type = type
+        self.string = string
+
+
+def tokenMatches(token, regexp):
+    """Ruby's token =~ regexp: false for nil (past the end) and annotations."""
+    if not isinstance(token, Token):
+        return False
+    return regexp.search(token.string) is not None
+
+
+def tokenIs(token, string):
+    """Ruby's token == string."""
+    return isinstance(token, Token) and token.string == string
+
+
+#
+# The lexer. Takes a string and returns a list of tokens.
+#
+
+_LEX_ASM_COMMENT = re.compile(r"\#([^\n]*)")
+_LEX_BLOCK_COMMENT = re.compile(r"/\*(\*(?!/)|[^*])*\*/")
+_LEX_ANNOTATION = re.compile(r"// ?([^\n]*)")
+_LEX_NEWLINE = re.compile(r"\n")
+_LEX_IDENTIFIER = re.compile(r"[a-zA-Z%]([a-zA-Z0-9_.%]*)")
+_LEX_LOCAL_LABEL = re.compile(r"\.([a-zA-Z0-9_]*)")
+_LEX_LABEL = re.compile(r"_([a-zA-Z0-9_%]*)")
+_LEX_WHITESPACE = re.compile(r"([ \t]+)")
+_LEX_HEX = re.compile(r"0x([0-9a-fA-F]+)")
+_LEX_OCTAL = re.compile(r"0([0-7]+)")
+_LEX_DECIMAL = re.compile(r"([0-9]+)")
+_LEX_COLONCOLON = re.compile(r"::")
+_LEX_PUNCTUATION = re.compile(r"[:,\(\)\[\]=\+\-~\|&^*]")
+_LEX_STRING = re.compile(r"\".*\"")
+_LEX_QUESTION = re.compile(r"\?")
+
+
+def lex(str, file):
+    result = []
+    lineNumber = 1
+    annotation = None
+    annotationType = None
+    whitespaceFound = False
+    pos = 0
+    end = len(str)
+    while pos < end:
+        m = _LEX_ASM_COMMENT.match(str, pos)
+        if m:
+            # ASM style single line comment, ignore
+            pass
+        elif _LEX_BLOCK_COMMENT.match(str, pos):
+            # C-style block comment, ignore
+            m = _LEX_BLOCK_COMMENT.match(str, pos)
+            whitespaceFound = True
+            lineNumber += m.group(0).count("\n")
+            pos = m.end()
+            continue
+        elif _LEX_ANNOTATION.match(str, pos):
+            # annotation
+            m = _LEX_ANNOTATION.match(str, pos)
+            annotation = m.group(1)
+            annotationType = "local" if whitespaceFound else "global"
+        elif _LEX_NEWLINE.match(str, pos):
+            # We've found a '\n'.  Emit the last comment recorded if appropriate:
+            # We need to parse annotations regardless of whether the backend does
+            # anything with them or not. This is because the C++ backend may make
+            # use of this for its cloopDo debugging utility even if
+            # enableInstrAnnotations is not enabled.
+            m = _LEX_NEWLINE.match(str, pos)
+            if annotation is not None:
+                result.append(Annotation(CodeOrigin(file, lineNumber), annotationType, annotation))
+                annotation = None
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+            lineNumber += 1
+        elif _LEX_IDENTIFIER.match(str, pos):
+            m = _LEX_IDENTIFIER.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+        elif _LEX_LOCAL_LABEL.match(str, pos):
+            m = _LEX_LOCAL_LABEL.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+        elif _LEX_LABEL.match(str, pos):
+            m = _LEX_LABEL.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+        elif _LEX_WHITESPACE.match(str, pos):
+            # whitespace, ignore
+            m = _LEX_WHITESPACE.match(str, pos)
+            whitespaceFound = True
+            pos = m.end()
+            continue
+        elif _LEX_HEX.match(str, pos):
+            m = _LEX_HEX.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), str_(int(m.group(1), 16))))
+        elif _LEX_OCTAL.match(str, pos):
+            m = _LEX_OCTAL.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), str_(int(m.group(1), 8))))
+        elif _LEX_DECIMAL.match(str, pos):
+            m = _LEX_DECIMAL.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+        elif _LEX_COLONCOLON.match(str, pos):
+            m = _LEX_COLONCOLON.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+        elif _LEX_PUNCTUATION.match(str, pos):
+            m = _LEX_PUNCTUATION.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+        elif _LEX_STRING.match(str, pos):
+            m = _LEX_STRING.match(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+        elif _LEX_QUESTION.search(str, pos):
+            # Not anchored in Ruby either: everything up to the "?" goes.
+            m = _LEX_QUESTION.search(str, pos)
+            result.append(Token(CodeOrigin(file, lineNumber), m.group(0)))
+        else:
+            raise Exception("Lexer error at %s, unexpected sequence %s" % (CodeOrigin(file, lineNumber), rubyInspectString(str[pos:pos + 21])))
+        whitespaceFound = False
+        pos = m.end()
+    return result
+
+
+def str_(value):
+    return "%d" % value
+
+
+#
+# Token identification.
+#
+
+_KEYWORD_PATTERN = re.compile(r"\A((true)|(false)|(if)|(then)|(else)|(elsif)|(end)|(and)|(or)|(not)|(global)|(macro)|(const)|(constexpr)|(sizeof)|(error)|(include))\Z")
+_IDENTIFIER_PATTERN = re.compile(r"\A[a-zA-Z%]([a-zA-Z0-9_.%]*)\Z")
+_LABEL_PATTERN = re.compile(r"\A_([a-zA-Z0-9_%]*)\Z")
+_LOCAL_LABEL_PATTERN = re.compile(r"\A\.([a-zA-Z0-9_]*)\Z")
+_INTEGER_PATTERN = re.compile(r"\A[0-9]")
+_STRING_PATTERN = re.compile(r"\A\".*\"")
+
+
+def _asToken(token):
+    # The identification functions also take plain strings (label names).
+    if isinstance(token, str):
+        return Token(None, token)
+    return token
+
+
+def isRegister(token):
+    return tokenMatches(_asToken(token), REGISTER_PATTERN)
+
+
+def isInstruction(token):
+    token = _asToken(token)
+    return token is not None and token.string in INSTRUCTION_SET
+
+
+def isKeyword(token):
+    return tokenMatches(_asToken(token), _KEYWORD_PATTERN) or \
+        tokenMatches(_asToken(token), REGISTER_PATTERN) or \
+        isInstruction(token)
+
+
+def isIdentifier(token):
+    return tokenMatches(_asToken(token), _IDENTIFIER_PATTERN) and not isKeyword(token)
+
+
+def isLabel(token):
+    return tokenMatches(_asToken(token), _LABEL_PATTERN)
+
+
+def isLocalLabel(token):
+    return tokenMatches(_asToken(token), _LOCAL_LABEL_PATTERN)
+
+
+def isVariable(token):
+    return isIdentifier(token) or isRegister(token)
+
+
+def isInteger(token):
+    return tokenMatches(_asToken(token), _INTEGER_PATTERN)
+
+
+def isString(token):
+    return tokenMatches(_asToken(token), _STRING_PATTERN)
+
+
+#
+# The parser. Takes a list of tokens and returns an AST. Methods
+# other than parse(tokens) are not for public consumption.
+#
+
+_THEN_OR_NEWLINE = re.compile(r"\A((then)|(\n))\Z")
+_ELSE_END_ELSIF = re.compile(r"\A((else)|(end)|(elsif))\Z")
+_END = re.compile(r"\Aend\Z")
+_OPEN_PAREN = re.compile(r"\A\(\Z")
+
+
+class Parser:
+    def __init__(self, data, fileName, options, sources=None):
+        self.tokens = lex(data, fileName)
+        self.idx = 0
+        self.annotation = None
+        # FIXME: CMake does not currently set BUILT_PRODUCTS_DIR.
+        # https://bugs.webkit.org/show_bug.cgi?id=229340
+        self.buildProductsDirectory = os.environ.get("BUILT_PRODUCTS_DIR")
+        self.headersFolderPath = os.environ.get("WK_LIBRARY_HEADERS_FOLDER_PATH")
+        self.options = options
+        self.sources = sources
+
+    def tok(self, offset=0):
+        index = self.idx + offset
+        if 0 <= index < len(self.tokens):
+            return self.tokens[index]
+        return None
+
+    def parseError(self, *comment):
+        token = self.tok()
+        if token is not None:
+            token.parseError(*comment)
+        else:
+            if not comment:
+                raise Exception("Parse error at end of file")
+            raise Exception("Parse error at end of file: %s" % comment[0])
+
+    def consume(self, regexp):
+        if regexp is not None:
+            if not tokenMatches(self.tok(), regexp):
+                self.parseError()
+        else:
+            if self.idx != len(self.tokens):
+                self.parseError()
+        self.idx += 1
+
+    def skipNewLine(self):
+        while tokenIs(self.tok(), "\n"):
+            self.idx += 1
+
+    def parsePredicateAtom(self):
+        token = self.tok()
+        if tokenIs(token, "not"):
+            codeOrigin = token.codeOrigin
+            self.idx += 1
+            return Not(codeOrigin, self.parsePredicateAtom())
+        elif tokenIs(token, "("):
+            self.idx += 1
+            self.skipNewLine()
+            result = self.parsePredicate()
+            if not tokenIs(self.tok(), ")"):
+                self.parseError()
+            self.idx += 1
+            return result
+        elif tokenIs(token, "true"):
+            self.idx += 1
+            return TRUE
+        elif tokenIs(token, "false"):
+            self.idx += 1
+            return FALSE
+        elif isIdentifier(token):
+            result = Setting.forName(token.codeOrigin, token.string)
+            self.idx += 1
+            return result
+        else:
+            self.parseError()
+
+    def parsePredicateAnd(self):
+        result = self.parsePredicateAtom()
+        while tokenIs(self.tok(), "and"):
+            codeOrigin = self.tok().codeOrigin
+            self.idx += 1
+            self.skipNewLine()
+            right = self.parsePredicateAtom()
+            result = And(codeOrigin, result, right)
+        return result
+
+    def parsePredicate(self):
+        # some examples of precedence:
+        # not a and b -> (not a) and b
+        # a and b or c -> (a and b) or c
+        # a or b and c -> a or (b and c)
+
+        result = self.parsePredicateAnd()
+        while tokenIs(self.tok(), "or"):
+            codeOrigin = self.tok().codeOrigin
+            self.idx += 1
+            self.skipNewLine()
+            right = self.parsePredicateAnd()
+            result = Or(codeOrigin, result, right)
+        return result
+
+    def parseVariable(self):
+        token = self.tok()
+        if isRegister(token):
+            if tokenMatches(token, VEC_PATTERN):
+                result = VecRegisterID.forName(token.codeOrigin, token.string)
+            elif tokenMatches(token, FPR_PATTERN):
+                result = FPRegisterID.forName(token.codeOrigin, token.string)
+            else:
+                result = RegisterID.forName(token.codeOrigin, token.string)
+        elif isIdentifier(token):
+            result = Variable.forName(token.codeOrigin, token.string)
+        else:
+            self.parseError()
+        self.idx += 1
+        return result
+
+    def parseConstExpr(self):
+        if tokenIs(self.tok(), "constexpr"):
+            self.idx += 1
+            self.skipNewLine()
+            if tokenIs(self.tok(), "("):
+                codeOrigin, text = self.parseTextInParens()
+                text = "".join(text)
+            else:
+                codeOrigin, text = self.parseColonColon()
+                text = "::".join(text)
+            return ConstExpr.forName(codeOrigin, text)
+        else:
+            self.parseError()
+
+    def parseAddress(self, offset):
+        if not tokenIs(self.tok(), "["):
+            self.parseError()
+        codeOrigin = self.tok().codeOrigin
+
+        # Three possibilities:
+        # []       -> AbsoluteAddress
+        # [a]      -> Address
+        # [a,b]    -> BaseIndex with scale = 1
+        # [a,b,c]  -> BaseIndex
+
+        self.idx += 1
+        if tokenIs(self.tok(), "]"):
+            self.idx += 1
+            return AbsoluteAddress(codeOrigin, offset)
+        a = self.parseVariable()
+        if tokenIs(self.tok(), "]"):
+            result = Address(codeOrigin, a, offset)
+        else:
+            if not tokenIs(self.tok(), ","):
+                self.parseError()
+            self.idx += 1
+            b = self.parseVariable()
+            if tokenIs(self.tok(), "]"):
+                result = BaseIndex(codeOrigin, a, b, Immediate(codeOrigin, 1), offset)
+            else:
+                if not tokenIs(self.tok(), ","):
+                    self.parseError()
+                self.idx += 1
+                if self.tok() is not None and self.tok().string in ["1", "2", "4", "8"]:
+                    c = Immediate(codeOrigin, int(self.tok().string))
+                    self.idx += 1
+                elif tokenIs(self.tok(), "constexpr"):
+                    c = self.parseConstExpr()
+                else:
+                    c = self.parseVariable()
+                if not tokenIs(self.tok(), "]"):
+                    self.parseError()
+                result = BaseIndex(codeOrigin, a, b, c, offset)
+        self.idx += 1
+        return result
+
+    def parseColonColon(self):
+        self.skipNewLine()
+        codeOrigin = self.tok().codeOrigin
+        if not isIdentifier(self.tok()):
+            self.parseError()
+        names = [self.tok().string]
+        self.idx += 1
+        while tokenIs(self.tok(), "::"):
+            self.idx += 1
+            if not isIdentifier(self.tok()):
+                self.parseError()
+            names.append(self.tok().string)
+            self.idx += 1
+        if not names:
+            raise Exception("unhandled exception")
+        return codeOrigin, names
+
+    def parseTextInParens(self):
+        self.skipNewLine()
+        codeOrigin = self.tok().codeOrigin
+        if not tokenIs(self.tok(), "("):
+            raise Exception("unhandled exception")
+        self.idx += 1
+        # need at least one item
+        if tokenIs(self.tok(), ")"):
+            raise Exception("unhandled exception")
+        numEnclosedParens = 0
+        text = []
+        while not tokenIs(self.tok(), ")") or numEnclosedParens > 0:
+            if tokenIs(self.tok(), "("):
+                numEnclosedParens += 1
+            elif tokenIs(self.tok(), ")"):
+                numEnclosedParens -= 1
+
+            text.append(self.tok().string)
+            self.idx += 1
+        self.idx += 1
+        return codeOrigin, text
+
+    def parseExpressionAtom(self):
+        self.skipNewLine()
+        token = self.tok()
+        if tokenIs(token, "-"):
+            self.idx += 1
+            return NegImmediate(self.tokens[self.idx - 1].codeOrigin, self.parseExpressionAtom())
+        elif tokenIs(token, "~"):
+            self.idx += 1
+            return BitnotImmediate(self.tokens[self.idx - 1].codeOrigin, self.parseExpressionAtom())
+        elif tokenIs(token, "("):
+            originalIndex = self.idx
+            self.idx += 1
+            result = self.parseExpression()
+            if not tokenIs(self.tok(), ")"):
+                self.parseError("expected ')' to match %s" % self.tokens[originalIndex])
+            self.idx += 1
+            return result
+        elif isInteger(token):
+            result = Immediate(token.codeOrigin, int(token.string))
+            self.idx += 1
+            return result
+        elif isString(token):
+            result = StringLiteral(token.codeOrigin, token.string)
+            self.idx += 1
+            return result
+        elif isIdentifier(token):
+            codeOrigin, names = self.parseColonColon()
+            if len(names) > 1:
+                return StructOffset.forField(codeOrigin, "::".join(names[0:-1]), names[-1])
+            return Variable.forName(codeOrigin, names[0])
+        elif isRegister(token):
+            return self.parseVariable()
+        elif tokenIs(token, "sizeof"):
+            self.idx += 1
+            codeOrigin, names = self.parseColonColon()
+            return Sizeof.forName(codeOrigin, "::".join(names))
+        elif tokenIs(token, "constexpr"):
+            return self.parseConstExpr()
+        elif isLabel(token):
+            result = LabelReference(token.codeOrigin, Label.forName(token.codeOrigin, token.string))
+            self.idx += 1
+            return result
+        elif isLocalLabel(token):
+            result = LocalLabelReference(token.codeOrigin, LocalLabel.forName(token.codeOrigin, token.string))
+            self.idx += 1
+            return result
+        else:
+            self.parseError()
+
+    def parseExpressionMul(self):
+        self.skipNewLine()
+        result = self.parseExpressionAtom()
+        while tokenIs(self.tok(), "*"):
+            self.idx += 1
+            result = MulImmediates(self.tokens[self.idx - 1].codeOrigin, result, self.parseExpressionAtom())
+        return result
+
+    def couldBeExpression(self):
+        token = self.tok()
+        return tokenIs(token, "-") or tokenIs(token, "~") or tokenIs(token, "sizeof") or \
+            tokenIs(token, "constexpr") or isInteger(token) or isString(token) or \
+            isVariable(token) or isLabel(token) or tokenIs(token, "(")
+
+    def parseExpressionAdd(self):
+        self.skipNewLine()
+        result = self.parseExpressionMul()
+        while tokenIs(self.tok(), "+") or tokenIs(self.tok(), "-"):
+            if tokenIs(self.tok(), "+"):
+                self.idx += 1
+                result = AddImmediates(self.tokens[self.idx - 1].codeOrigin, result, self.parseExpressionMul())
+            else:
+                self.idx += 1
+                result = SubImmediates(self.tokens[self.idx - 1].codeOrigin, result, self.parseExpressionMul())
+        return result
+
+    def parseExpressionAnd(self):
+        self.skipNewLine()
+        result = self.parseExpressionAdd()
+        while tokenIs(self.tok(), "&"):
+            self.idx += 1
+            result = AndImmediates(self.tokens[self.idx - 1].codeOrigin, result, self.parseExpressionAdd())
+        return result
+
+    def parseExpression(self):
+        self.skipNewLine()
+        result = self.parseExpressionAnd()
+        while tokenIs(self.tok(), "|") or tokenIs(self.tok(), "^"):
+            if tokenIs(self.tok(), "|"):
+                self.idx += 1
+                result = OrImmediates(self.tokens[self.idx - 1].codeOrigin, result, self.parseExpressionAnd())
+            else:
+                self.idx += 1
+                result = XorImmediates(self.tokens[self.idx - 1].codeOrigin, result, self.parseExpressionAnd())
+        return result
+
+    def parseOperand(self, comment):
+        self.skipNewLine()
+        if self.couldBeExpression():
+            expr = self.parseExpression()
+            if tokenIs(self.tok(), "["):
+                return self.parseAddress(expr)
+            return expr
+        elif tokenIs(self.tok(), "["):
+            return self.parseAddress(Immediate(self.tok().codeOrigin, 0))
+        elif isLocalLabel(self.tok()):
+            result = LocalLabelReference(self.tok().codeOrigin, LocalLabel.forName(self.tok().codeOrigin, self.tok().string))
+            self.idx += 1
+            return result
+        else:
+            self.parseError(comment)
+
+    def parseMacroVariables(self):
+        self.skipNewLine()
+        self.consume(_OPEN_PAREN)
+        variables = []
+        while True:
+            self.skipNewLine()
+            if tokenIs(self.tok(), ")"):
+                self.idx += 1
+                break
+            elif isIdentifier(self.tok()):
+                variables.append(Variable.forName(self.tok().codeOrigin, self.tok().string))
+                self.idx += 1
+                self.skipNewLine()
+                if tokenIs(self.tok(), ")"):
+                    self.idx += 1
+                    break
+                elif tokenIs(self.tok(), ","):
+                    self.idx += 1
+                else:
+                    self.parseError()
+            else:
+                self.parseError()
+        return variables
+
+    def atEnd(self, final):
+        """(not final and @idx == @tokens.size) or (final and @tokens[@idx] =~ final)"""
+        if final is None:
+            return self.idx == len(self.tokens)
+        return tokenMatches(self.tok(), final)
+
+    def includeFileName(self, moduleName):
+        if self.options.get("webkit_additions_path"):
+            additionsDirectoryName = self.options["webkit_additions_path"]
+        else:
+            additionsDirectoryName = "%s%s/WebKitAdditions/" % (self.buildProductsDirectory or "", self.headersFolderPath or "")
+        fileName = IncludeFile(moduleName, additionsDirectoryName).fileName
+        if not os.path.exists(fileName):
+            fileName = IncludeFile(moduleName, os.path.dirname(self.tok().codeOrigin.fileName())).fileName
+        return fileName
+
+    def parseSequence(self, final, comment):
+        firstCodeOrigin = self.tok().codeOrigin
+        list = []
+        while True:
+            token = self.tok()
+            if isinstance(token, Annotation):
+                # This is the only place where we can encounter a global
+                # annotation, and hence need to be able to distinguish between
+                # them.
+                # globalAnnotations are the ones that start from column 0. All
+                # others are considered localAnnotations.  The only reason to
+                # distinguish between them is so that we can format the output
+                # nicely as one would expect.
+
+                codeOrigin = token.codeOrigin
+                annotationOpcode = "globalAnnotation" if token.type == "global" else "localAnnotation"
+                list.append(Instruction(codeOrigin, annotationOpcode, [], token.string))
+                self.annotation = None
+                self.idx += 2  # Consume the newline as well.
+            elif (self.idx == len(self.tokens) and final is None) or (final is not None and tokenMatches(token, final)):
+                break
+            elif tokenIs(token, "\n"):
+                # ignore
+                self.idx += 1
+            elif tokenIs(token, "const"):
+                self.idx += 1
+                if not isVariable(self.tok()):
+                    self.parseError()
+                variable = Variable.forName(self.tok().codeOrigin, self.tok().string)
+                self.idx += 1
+                if not tokenIs(self.tok(), "="):
+                    self.parseError()
+                self.idx += 1
+                value = self.parseOperand("while inside of const %s" % variable.name)
+                list.append(ConstDecl(self.tok().codeOrigin, variable, value))
+            elif tokenIs(token, "error"):
+                list.append(Error(token.codeOrigin))
+                self.idx += 1
+            elif tokenIs(token, "if"):
+                codeOrigin = token.codeOrigin
+                self.idx += 1
+                self.skipNewLine()
+                predicate = self.parsePredicate()
+                self.consume(_THEN_OR_NEWLINE)
+                self.skipNewLine()
+                ifThenElse = IfThenElse(codeOrigin, predicate, self.parseSequence(_ELSE_END_ELSIF, "while inside of \"if %s\"" % predicate.dump()))
+                list.append(ifThenElse)
+                while tokenIs(self.tok(), "elsif"):
+                    codeOrigin = self.tok().codeOrigin
+                    self.idx += 1
+                    self.skipNewLine()
+                    predicate = self.parsePredicate()
+                    self.consume(_THEN_OR_NEWLINE)
+                    self.skipNewLine()
+                    elseCase = IfThenElse(codeOrigin, predicate, self.parseSequence(_ELSE_END_ELSIF, "while inside of \"if %s\"" % predicate.dump()))
+                    ifThenElse.elseCase = elseCase
+                    ifThenElse = elseCase
+                if tokenIs(self.tok(), "else"):
+                    self.idx += 1
+                    ifThenElse.elseCase = self.parseSequence(_END, "while inside of else case for \"if %s\"" % predicate.dump())
+                    self.idx += 1
+                else:
+                    if not tokenIs(self.tok(), "end"):
+                        self.parseError()
+                    self.idx += 1
+            elif tokenIs(token, "macro"):
+                codeOrigin = token.codeOrigin
+                self.idx += 1
+                self.skipNewLine()
+                if not isIdentifier(self.tok()):
+                    self.parseError()
+                name = self.tok().string
+                self.idx += 1
+                variables = self.parseMacroVariables()
+                body = self.parseSequence(_END, "while inside of macro %s" % name)
+                self.idx += 1
+                list.append(Macro(codeOrigin, name, variables, body))
+            elif tokenIs(token, "global") or tokenIs(token, "globalexport") or tokenIs(token, "unalignedglobal") or tokenIs(token, "unalignedglobalexport"):
+                codeOrigin = token.codeOrigin
+                self.idx += 1
+                self.skipNewLine()
+                if not isLabel(self.tok()):
+                    self.parseError()
+                name = self.tok().string
+                self.idx += 1
+                {"global": Label.setAsGlobal,
+                 "globalexport": Label.setAsGlobalExport,
+                 "unalignedglobal": Label.setAsUnalignedGlobal,
+                 "unalignedglobalexport": Label.setAsUnalignedGlobalExport}[token.string](codeOrigin, name)
+            elif tokenIs(token, "aligned"):
+                codeOrigin = token.codeOrigin
+                self.idx += 1
+                self.skipNewLine()
+                if not isLabel(self.tok()):
+                    self.parseError()
+                name = self.tok().string
+                self.idx += 1
+                align = self.tok().string
+                # Ruby's "align !=~ /[0-9]+/" is always true: the alignment is
+                # always taken as a variable.
+                align = Variable.forName(codeOrigin, align)
+                self.idx += 1
+                Label.setAsAligned(codeOrigin, name, align)
+            elif isInstruction(token):
+                codeOrigin = token.codeOrigin
+                name = token.string
+                self.idx += 1
+                if self.atEnd(final):
+                    # Zero operand instruction, and it's the last one.
+                    list.append(Instruction(codeOrigin, name, [], self.annotation))
+                    self.annotation = None
+                    break
+                elif isinstance(self.tok(), Annotation):
+                    list.append(Instruction(codeOrigin, name, [], self.tok().string))
+                    self.annotation = None
+                    self.idx += 2  # Consume the newline as well.
+                elif tokenIs(self.tok(), "\n"):
+                    # Zero operand instruction.
+                    list.append(Instruction(codeOrigin, name, [], self.annotation))
+                    self.annotation = None
+                    self.idx += 1
+                else:
+                    # It's definitely an instruction, and it has at least one operand.
+                    operands = []
+                    endOfSequence = False
+                    while True:
+                        operands.append(self.parseOperand("while inside of instruction %s" % name))
+                        if self.atEnd(final):
+                            # The end of the instruction and of the sequence.
+                            endOfSequence = True
+                            break
+                        elif tokenIs(self.tok(), ","):
+                            # Has another operand.
+                            self.idx += 1
+                        elif isinstance(self.tok(), Annotation):
+                            self.annotation = self.tok().string
+                            self.idx += 2  # Consume the newline as well.
+                            break
+                        elif tokenIs(self.tok(), "\n"):
+                            # The end of the instruction.
+                            self.idx += 1
+                            break
+                        else:
+                            self.parseError("Expected a comma, newline, or %s after %s" % (final.pattern if final is not None else "", operands[-1].dump()))
+                    list.append(Instruction(codeOrigin, name, operands, self.annotation))
+                    self.annotation = None
+                    if endOfSequence:
+                        break
+
+            # Check for potential macro invocation:
+            elif isIdentifier(token):
+                codeOrigin = token.codeOrigin
+                name = token.string
+                self.idx += 1
+                if tokenIs(self.tok(), "("):
+                    # Macro invocation.
+                    self.idx += 1
+                    operands = []
+                    self.skipNewLine()
+                    if tokenIs(self.tok(), ")"):
+                        self.idx += 1
+                    else:
+                        while True:
+                            self.skipNewLine()
+                            if tokenIs(self.tok(), "macro"):
+                                # It's a macro lambda!
+                                codeOriginInner = self.tok().codeOrigin
+                                self.idx += 1
+                                variables = self.parseMacroVariables()
+                                body = self.parseSequence(_END, "while inside of anonymous macro passed as argument to %s" % name)
+                                self.idx += 1
+                                operands.append(Macro(codeOriginInner, None, variables, body))
+                            else:
+                                operands.append(self.parseOperand("while inside of macro call to %s" % name))
+                            self.skipNewLine()
+                            if tokenIs(self.tok(), ")"):
+                                self.idx += 1
+                                break
+                            elif tokenIs(self.tok(), ","):
+                                self.idx += 1
+                            else:
+                                self.parseError("Unexpected %s while parsing invocation of macro %s" % (rubyInspectString(self.tok().string), name))
+                    # Check if there's a trailing annotation after the macro invoke:
+                    if isinstance(self.tok(), Annotation):
+                        self.annotation = self.tok().string
+                        self.idx += 2  # Consume the newline as well.
+                    list.append(MacroCall(codeOrigin, name, operands, self.annotation))
+                    self.annotation = None
+                else:
+                    self.parseError("Expected \"(\" after %s" % name)
+            elif isLabel(token) or isLocalLabel(token):
+                codeOrigin = token.codeOrigin
+                name = token.string
+                self.idx += 1
+                if not tokenIs(self.tok(), ":"):
+                    self.parseError()
+                # It's a label.
+                if isLabel(name):
+                    list.append(Label.forName(codeOrigin, name, True))
+                else:
+                    list.append(LocalLabel.forName(codeOrigin, name))
+                self.idx += 1
+            elif tokenIs(token, "include"):
+                self.idx += 1
+                isOptional = False
+                if tokenIs(self.tok(), "?"):
+                    isOptional = True
+                    self.idx += 1
+                if not isIdentifier(self.tok()):
+                    self.parseError()
+                moduleName = self.tok().string
+                self.idx += 1
+                fileName = self.includeFileName(moduleName)
+                fileExists = os.path.exists(fileName)
+                if not fileExists and not isOptional:
+                    raise Exception("File not found: %s" % fileName)
+                if fileExists:
+                    list.append(parse(fileName, self.options, self.sources))
+            else:
+                self.parseError("Expecting terminal %s %s" % (final.pattern if final is not None else "", comment))
+        return Sequence(firstCodeOrigin, list)
+
+    def parseIncludes(self, final, comment, options):
+        fileList = []
+        fileList.append(self.tok().codeOrigin.fileName())
+        while True:
+            token = self.tok()
+            if (self.idx == len(self.tokens) and final is None) or (final is not None and tokenMatches(token, final)):
+                break
+            elif tokenIs(token, "include"):
+                self.idx += 1
+                isOptional = False
+                if tokenIs(self.tok(), "?"):
+                    isOptional = True
+                    self.idx += 1
+                if not isIdentifier(self.tok()):
+                    self.parseError()
+                moduleName = self.tok().string
+                self.idx += 1
+                fileName = self.includeFileName(moduleName)
+                fileExists = os.path.exists(fileName)
+                if not fileExists and not isOptional:
+                    raise Exception("File not found: %s" % fileName)
+                if fileExists:
+                    parser = Parser(readTextFile(fileName), SourceFile(fileName), options)
+                    fileList.append(parser.parseIncludes(None, "", options))
+            else:
+                self.idx += 1
+
+        return fileList
+
+
+def readTextFile(fileName):
+    with open(fileName, "rb") as f:
+        raw = f.read()
+
+    # https://commits.webkit.org/310937@main broke builds because the files contained non-ASCII characters. Let's forbid non-ASCII early so we don't hit problems downstream.
+    try:
+        data = raw.decode("ascii")
+    except UnicodeDecodeError:
+        raise Exception("%s contains non-ASCII characters" % fileName)
+
+    # On Windows, files may contain CRLF line endings (for example, git client might
+    # automatically replace \n with \r\n on Windows) which will fail our parsing.
+    # Thus, we'll just remove all \r from the data (keeping just the \n characters)
+    return data.replace("\r", "")
+
+
+def parseData(data, fileName, options, sources):
+    parser = Parser(data, SourceFile(fileName), options, sources)
+    return parser.parseSequence(None, "")
+
+
+def parse(fileName, options, sources=None):
+    if sources is not None:
+        sources.add(fileName)
+    return parseData(readTextFile(fileName), fileName, options, sources)
+
+
+def _flattenList(items, out):
+    for item in items:
+        if isinstance(item, list):
+            _flattenList(item, out)
+        else:
+            out.append(item)
+    return out
+
+
+def parseHash(fileName, options):
+    parser = Parser(readTextFile(fileName), SourceFile(fileName), options)
+    fileList = parser.parseIncludes(None, "", options)
+    return fileListHash(_flattenList(fileList, []))
