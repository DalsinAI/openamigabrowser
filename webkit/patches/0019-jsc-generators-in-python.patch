+
+# usage: GeneratePreferences.py --frontend <frontend> [--outputDir <output>]
+#            --template <file> [--template <file>...] <preferences> [<preferences>...]
+#
+# Templates are ERB templates whose code is Python (".pyerb", see
+# renderTemplate below); a template named X.pyerb writes X.
+
+import argparse
+import os
+import re
+import sys
+
+#
+# A YAML subset: what the preference files use. Block mappings nested by
+# indentation, plain, single- and double-quoted scalars, flow sequences
+# ([ a, b ]), comments and blank lines. Plain scalars resolve as Ruby's Psych
+# (YAML 1.1) resolves them: true/yes/on, false/no/off, null/~, integers and
+# floats; anything else is a string. Anything outside the subset (anchors,
+# tags, block scalars, flow mappings, block sequences) stops with the file
+# and line.
+#
+
+
+class YAMLSubsetError(Exception):
+    pass
+
+
+_BOOL_TRUE = re.compile(r"\A(yes|true|on)\Z", re.I)
+_BOOL_FALSE = re.compile(r"\A(no|false|off)\Z", re.I)
+_NULL = re.compile(r"\A(~|null|Null|NULL|)\Z")
+_INT = re.compile(r"\A[-+]?(0|[1-9][0-9_,]*)\Z")
+_HEX = re.compile(r"\A[-+]?0x[0-9a-fA-F_,]+\Z")
+_FLOAT = re.compile(r"\A[-+]?([0-9][0-9_,]*)?\.[0-9]*([eE][-+][0-9]+)?\Z")
+
+
+def yamlPlainScalar(text):
+    if _NULL.match(text):
+        return None
+    if _BOOL_TRUE.match(text):
+        return True
+    if _BOOL_FALSE.match(text):
+        return False
+    if _INT.match(text):
+        return int(text.replace("_", "").replace(",", ""))
+    if _HEX.match(text):
+        return int(text.replace("_", "").replace(",", ""), 16)
+    if _FLOAT.match(text) and text not in (".", "+.", "-."):
+        return float(text.replace("_", "").replace(",", ""))
+    return text
+
+
+def _yamlStripComment(text):
+    """Removes a " #" comment that is not inside quotes."""
+    quote = None
+    for index, c in enumerate(text):
+        if quote:
+            if c == quote:
+                quote = None
+        elif c in "\"'" and (index == 0 or text[index - 1] in " [,"):
+            quote = c
+        elif c == "#" and (index == 0 or text[index - 1] in " \t"):
+            return text[:index].rstrip()
+    return text.rstrip()
+
+
+def _yamlScalar(text, where):
+    text = text.strip()
+    if text.startswith('"'):
+        if not text.endswith('"') or len(text) < 2:
+            raise YAMLSubsetError("%s: unterminated string" % where)
+        body = text[1:-1]
+        escapes = {"n": "\n", "t": "\t", "\\": "\\", '"': '"', "/": "/", "0": "\0"}
+        return re.sub(r"\\(.)", lambda m: escapes.get(m.group(1), m.group(1)), body)
+    if text.startswith("'"):
+        if not text.endswith("'") or len(text) < 2:
+            raise YAMLSubsetError("%s: unterminated string" % where)
+        return text[1:-1].replace("''", "'")
+    if text[:1] in ("&", "*", "!", "|", ">", "{", "@", "`", "%"):
+        raise YAMLSubsetError("%s: %r is outside the YAML subset this script reads" % (where, text))
+    return yamlPlainScalar(text)
+
+
+def _yamlValue(text, where):
+    text = text.strip()
+    if text.startswith("["):
+        if not text.endswith("]"):
+            raise YAMLSubsetError("%s: unterminated flow sequence" % where)
+        inner = text[1:-1].strip()
+        if inner == "":
+            return []
+        return [_yamlScalar(item, where) for item in inner.split(",")]
+    return _yamlScalar(text, where)
+
+
+def _yamlQuoteClosed(text):
+    quote = text[0]
+    index = 1
+    while index < len(text):
+        c = text[index]
+        if quote == '"' and c == "\\":
+            index += 2
+            continue
+        if c == quote:
+            if quote == "'" and text[index + 1:index + 2] == "'":
+                index += 2
+                continue
+            return True
+        index += 1
+    return False
+
+
+def _yamlKey(text, where):
+    key = _yamlScalar(text, where)
+    return key if isinstance(key, str) else ("%s" % key if key is not None else "")
+
+
+def yamlLoadFile(path):
+    with open(path, encoding="utf-8") as f:
+        lines = f.read().split("\n")
+
+    root = {}
+    # Stack of (indent, mapping); a key with no value opens a nested mapping
+    # whose indent is that of its first line.
+    stack = [(-1, root)]
+    pendingKey = None  # (parent mapping, key, indent of the key)
+    number = 0
+    while number < len(lines):
+        raw = lines[number]
+        number += 1
+        where = "%s:%d" % (path, number)
+        if raw.strip() == "" or raw.lstrip().startswith("#"):
+            continue
+        if raw.strip() in ("---", "..."):
+            continue
+        if "\t" in raw[:len(raw) - len(raw.lstrip())]:
+            raise YAMLSubsetError("%s: tab in indentation" % where)
+        indent = len(raw) - len(raw.lstrip(" "))
+        text = _yamlStripComment(raw.strip())
+        if text.startswith("- ") or text == "-":
+            raise YAMLSubsetError("%s: block sequences are outside the YAML subset this script reads" % where)
+
+        if pendingKey is not None:
+            parent, key, keyIndent = pendingKey
+            pendingKey = None
+            if indent > keyIndent:
+                mapping = {}
+                parent[key] = mapping
+                stack.append((indent, mapping))
+            else:
+                parent[key] = None
+        while stack and indent < stack[-1][0]:
+            stack.pop()
+        if indent != stack[-1][0] and stack[-1][0] != -1:
+            raise YAMLSubsetError("%s: unexpected indentation" % where)
+        if stack[-1][0] == -1:
+            if indent != 0:
+                raise YAMLSubsetError("%s: unexpected indentation" % where)
+            stack[-1] = (0, root)
+        mapping = stack[-1][1]
+
+        match = re.match(r'\A("(?:[^"\\]|\\.)*"|\'(?:[^\']|\'\')*\'|[^:"\'][^:]*?)\s*:(\s+(.*))?\Z', text)
+        if not match:
+            # Keys may contain ":" when quoted only; plain keys stop at the first ": ".
+            match = re.match(r"\A(.*?):(\s+(.*))?\Z", text)
+        if not match:
+            raise YAMLSubsetError("%s: expected key: value" % where)
+        key = _yamlKey(match.group(1), where)
+        value = match.group(3)
+        # A quoted scalar may go on over the next lines (folded: a line
+        # break is a space, an empty line a newline).
+        while value and value[0] in "\"'" and not _yamlQuoteClosed(value):
+            if number >= len(lines):
+                raise YAMLSubsetError("%s: unterminated string" % where)
+            continuation = lines[number].strip()
+            lines[number] = ""
+            number += 1
+            if continuation == "":
+                value += "\n"
+            elif value.endswith("\n"):
+                value += continuation
+            else:
+                value += " " + continuation
+        # A plain scalar may go on over more indented lines (folded).
+        if value and value[0] not in "\"'[":
+            while number < len(lines):
+                nextLine = lines[number]
+                if nextLine.strip() == "":
+                    break
+                if len(nextLine) - len(nextLine.lstrip(" ")) <= indent:
+                    break
+                value += " " + _yamlStripComment(nextLine.strip())
+                lines[number] = ""
+                number += 1
+        if value is None or value == "":
+            pendingKey = (mapping, key, indent)
+        else:
+            mapping[key] = _yamlValue(value, where)
+    if pendingKey is not None:
+        parent, key, keyIndent = pendingKey
+        parent[key] = None
+    return root
+
+
+#
+# An ERB subset with Python code: what renderTemplate needs.
+#
+#   <%= expression %>   the value: None prints nothing, True and False print
+#                       true and false (as Ruby's to_s)
+#   <% statement %>     a Python statement. "for ...:", "if ...:", "while ...:"
+#                       open a block, "elif ...:" and "else:" continue it and
+#                       "end" closes it. Several lines of simple statements may
+#                       share one tag.
+#   <%# comment %>      nothing
+#   -%>                 also removes the newline after the tag
+#   <%-                 also removes the spaces before the tag on its line
+#
+# This is ERB's trim_mode "-", as the Ruby script used.
+#
+
+def rubyToS(value):
+    if value is None:
+        return ""
+    if value is True:
+        return "true"
+    if value is False:
+        return "false"
+    return "%s" % value
+
+
+_ERB_TAG = re.compile(r"<%(=|#|-)?(.*?)(-?)%>", re.S)
+
+
+def compileTemplate(text, filename):
+    code = []
+    level = 0
+    position = 0
+    pendingText = []
+
+    def emitText(s):
+        if s:
+            code.append("    " * level + "_out.append(%r)" % s)
+
+    while True:
+        match = _ERB_TAG.search(text, position)
+        if not match:
+            emitText(text[position:])
+            break
+        before = text[position:match.start()]
+        kind, body, trim = match.group(1), match.group(2), match.group(3)
+        if kind == "-":
+            # Drop the indentation before the tag when it starts its line.
+            lineStart = before.rfind("\n") + 1
+            if before[lineStart:].strip(" \t") == "":
+                before = before[:lineStart]
+        emitText(before)
+        position = match.end()
+        if trim == "-" and text.startswith("\n", position):
+            position += 1
+
+        if kind == "=":
+            code.append("    " * level + "_out.append(rubyToS(%s))" % body.strip())
+        elif kind == "#":
+            pass
+        else:
+            statements = [line for line in body.split("\n") if line.strip() != ""]
+            if len(statements) == 1:
+                statement = statements[0].strip()
+                if statement == "end":
+                    level -= 1
+                    if level < 0:
+                        raise SyntaxError("%s: \"end\" without a block" % filename)
+                elif re.match(r"(elif\b.*|else\s*):\Z", statement):
+                    code.append("    " * (level - 1) + statement)
+                elif statement.endswith(":"):
+                    code.append("    " * level + statement)
+                    level += 1
+                else:
+                    code.append("    " * level + statement)
+            else:
+                # A block of simple statements: dedent it as a whole.
+                indents = [len(line) - len(line.lstrip()) for line in statements]
+                common = min(indents)
+                joined = []
+                for line in statements:
+                    joined.append(line[common:])
+                # Continuation lines (more indented) stay as they are.
+                for line in joined:
+                    code.append("    " * level + line)
+    if level != 0:
+        raise SyntaxError("%s: a block is not closed with \"end\"" % filename)
+    source = "def _render(self):\n    _out = []\n" + "\n".join("    " + line for line in code) + "\n    return ''.join(_out)\n"
+    return compile(source, filename, "exec")
+
+
+def renderTemplateText(text, filename, context):
+    namespace = {"rubyToS": rubyToS}
+    exec(compileTemplate(text, filename), namespace)
+    return namespace["_render"](context)
+
+
+#
+# The preferences.
+#
+
+# The frontends a preference can carry a default value for, in the order they
+# have to be listed in. A preference is in all of them unless "excludeFrom" says
+# otherwise.
+FRONTENDS = ["WebKitLegacy", "WebKit", "WebCore"]
+
+
+def frontendsFor(opts):
+    excluded = opts.get("excludeFrom") or []
+    return [frontend for frontend in FRONTENDS if frontend not in excluded]
+
+
+KEYS = """
+  category comment condition defaultValue defaultsOverridable disableInLockdownMode
+  excludeFrom getter hidden humanReadableDescription humanReadableName
+  inspectorOverride jscOptionName mediaPlaybackRelated refinedType richJavaScript
+  sharedPreferenceForWebProcess status type webKitLegacyBinding webKitLegacyExposed
+  webKitLegacyPreferenceKey webcoreDeprecatedGlobalSettings
+  webcoreExcludeFromInternalSettings webcoreGetter webcoreImplementation webcoreName
+  webcoreOnChange
+""".split()
+
+
+def rubyInspect(value):
+    if value is None:
+        return "nil"
+    if value is True:
+        return "true"
+    if value is False:
+        return "false"
+    if isinstance(value, str):
+        return '"%s"' % value.replace("\\", "\\\\").replace('"', '\\"')
+    if isinstance(value, list):
+        return "[" + ", ".join(rubyInspect(v) for v in value) + "]"
+    if isinstance(value, dict):
+        return "{" + ", ".join("%s=>%s" % (rubyInspect(k), rubyInspect(v)) for k, v in value.items()) + "}"
+    return "%s" % value
+
+
+# "defaultValue" is the value shared by every frontend the preference is in,
+# either directly or as a map of build conditions ending in "default". A frontend
+# is listed under it only where its value differs.
+def defaultValueFor(opts, frontend):
+    # JSC feature-flag options carry no JavaScriptCore default of their own; their
+    # default is the WebKit default.
+    if frontend == "JavaScriptCore":
+        frontend = "WebKit"
+
+    specification = opts.get("defaultValue")
+    if not isinstance(specification, dict):
+        return {"default": specification}
+
+    if frontend in specification:
+        value = specification[frontend]
+    else:
+        value = {key: v for key, v in specification.items() if key not in FRONTENDS}
+    return value if isinstance(value, dict) else {"default": value}
+
+
+def validate(path, parsed):
+    failed = [False]
+
+    def reject(name, msg):
+        sys.stderr.write("error: %s: %s: %s\n" % (path, name, msg))
+        failed[0] = True
+
+    for name, opts in parsed.items():
+        for key in opts.keys():
+            if key not in KEYS:
+                reject(name, "\"%s\" is not a known key." % key)
+        if "webcoreDeprecatedGlobalSettings" in opts and opts["webcoreDeprecatedGlobalSettings"] is not True:
+            reject(name, "\"webcoreDeprecatedGlobalSettings\" is only ever true, so leave it out instead.")
+
+        excluded = opts.get("excludeFrom")
+        if excluded:
+            if not isinstance(excluded, list) or len(excluded) == 0 or any(e not in FRONTENDS for e in excluded):
+                reject(name, "\"excludeFrom\" must be a non-empty list of %s." % ", ".join(FRONTENDS))
+                continue
+            if excluded != [f for f in FRONTENDS if f in excluded]:
+                reject(name, "\"excludeFrom\" must be listed in the order %s." % ", ".join(FRONTENDS))
+            if excluded == FRONTENDS:
+                reject(name, "\"excludeFrom\" excludes every frontend, so the preference would not exist anywhere.")
+
+        if "webKitLegacyExposed" in opts and opts["webKitLegacyExposed"] is not False:
+            reject(name, "\"webKitLegacyExposed\" is only ever false, so leave it out instead.")
+        if opts.get("webKitLegacyExposed") is False and "WebKitLegacy" not in frontendsFor(opts):
+            reject(name, "\"webKitLegacyExposed\" says nothing when WebKitLegacy is excluded.")
+
+        specification = opts.get("defaultValue")
+        if specification is None:
+            reject(name, "\"defaultValue\" is required and cannot be empty.")
+            continue
+        if not isinstance(specification, dict):
+            continue
+
+        if "default" not in specification:
+            reject(name, "\"defaultValue\" needs a \"default\", the value the frontends share.")
+            continue
+
+        keys = list(specification.keys())
+        conditions = keys[0:keys.index("default")]
+        overrides = keys[keys.index("default") + 1:]
+        if any(key in FRONTENDS for key in conditions) or any(o not in FRONTENDS for o in overrides):
+            reject(name, "\"defaultValue\" must list build conditions before \"default\" and frontends after it.")
+            continue
+        if overrides != [f for f in FRONTENDS if f in overrides]:
+            reject(name, "\"defaultValue\" must list frontends in the order %s." % ", ".join(FRONTENDS))
+
+        base = {key: value for key, value in specification.items() if key not in FRONTENDS}
+        # An empty value would generate an empty DEFAULT_VALUE_FOR_ macro rather than
+        # fail here, so the derived sources would be what complains.
+        empty = {key: value for key, value in base.items() if value is None}
+        for key in empty:
+            reject(name, "\"defaultValue\" has no value for \"%s\"." % key)
+        if len(base) == 1 and not overrides and not empty:
+            reject(name, "\"defaultValue\" is only a \"default\", so it should be written as \"defaultValue: %s\"." % rubyToS(base["default"]))
+
+        for frontend in overrides:
+            if frontend not in frontendsFor(opts):
+                reject(name, "%s is excluded, so it cannot have a default value of its own." % frontend)
+            value = specification[frontend]
+            if isinstance(value, dict):
+                if any(key in FRONTENDS for key in value.keys()):
+                    reject(name, "%s must not list frontends under itself." % frontend)
+                if list(value.keys())[-1:] != ["default"]:
+                    reject(name, "%s's build conditions must end in \"default\"." % frontend)
+                if len(value) == 1 and value.get("default") is not None:
+                    reject(name, "%s is only a \"default\", so it should be written as \"%s: %s\"." % (frontend, frontend, rubyToS(value["default"])))
+            else:
+                value = {"default": value}
+            for key, leaf in value.items():
+                if leaf is None:
+                    reject(name, "%s has no value for \"%s\"." % (frontend, key))
+            if list(value.items()) == list(base.items()):
+                reject(name, "%s's value is the shared default, so it should be left out." % frontend)
+
+    if failed[0]:
+        sys.exit(1)
+
+
+def load(path):
+    try:
+        parsed = yamlLoadFile(path)
+    except YAMLSubsetError as e:
+        sys.stderr.write("error: Could not parse input file: %s\n" % e)
+        sys.exit(1)
+    if parsed:
+        previousName = None
+        for name in parsed.keys():
+            if previousName is not None and previousName > name:
+                sys.stderr.write("error: Input file %s is not sorted. First out of order name found is '%s'.\n" % (path, name))
+                sys.exit(1)
+            previousName = name
+        validate(path, parsed)
+    return parsed
+
+
+def capitalize(text):
+    """Ruby's String#capitalize."""
+    return text[:1].upper() + text[1:].lower()
+
+
+class Preference:
+    def __init__(self, name, opts, frontend):
+        self.name = name
+        self.opts = opts
+        self.type = opts.get("type")
+        self.refinedType = opts.get("refinedType")
+        self.status = opts.get("status")
+        self.category = opts.get("category") or "none"
+        self.defaultsOverridable = opts.get("defaultsOverridable") or False
+        self.humanReadableName = opts.get("humanReadableName") or ""
+        if not self.humanReadableName.startswith("WebKitAdditions"):
+            self.humanReadableName = '"' + self.humanReadableName + '"'
+        self.humanReadableDescription = opts.get("humanReadableDescription") or ""
+        if not self.humanReadableDescription.startswith("WebKitAdditions"):
+            self.humanReadableDescription = '"' + self.humanReadableDescription + '"'
+        self.getter = opts.get("getter")
+        self.webcoreDeprecatedGlobalSettings = opts.get("webcoreDeprecatedGlobalSettings") or False
+        self.webcoreName = opts.get("webcoreName")
+        self.condition = opts.get("condition")
+        self.hidden = opts.get("hidden") or False
+        self.defaultValues = defaultValueFor(opts, frontend)
+        self.exposed = not (frontend == "WebKitLegacy" and opts.get("webKitLegacyExposed") is False)
+        self.sharedPreferenceForWebProcess = opts.get("sharedPreferenceForWebProcess") or False
+        self.richJavaScript = opts.get("richJavaScript") or False
+        self.mediaPlaybackRelated = opts.get("mediaPlaybackRelated") or False
+        self.inspectorOverride = opts.get("inspectorOverride")
+        self.jscOptionName = opts.get("jscOptionName")
+
+    def nameLower(self):
+        name = self.name
+        if self.getter:
+            return self.getter
+        elif name.startswith("VP"):
+            return name[0:2].lower() + name[2:]
+        elif name.startswith(("CSS", "DOM", "DNS", "FTP", "ICE", "IPC", "PDF", "SVG", "XSS")):
+            return name[0:3].lower() + name[3:]
+        elif name.startswith("HTTP"):
+            return name[0:4].lower() + name[4:]
+        return name[0].lower() + name[1:]
+
+    def webcoreNameUpper(self):
+        if self.webcoreName:
+            return self.webcoreName[0].upper() + self.webcoreName[1:]
+        return self.name
+
+    def typeUpper(self):
+        if self.type == "uint32_t":
+            return "UInt32"
+        return capitalize(self.type)
+
+    def webFeatureStatus(self):
+        return "WebFeatureStatus" + capitalize(self.status)
+
+    def webFeatureCategory(self):
+        if self.category in ("css", "dom", "html"):
+            return "WebFeatureCategory" + self.category.upper()
+        return "WebFeatureCategory" + capitalize(self.category)
+
+    def apiStatus(self):
+        return "API::FeatureConstant<API::FeatureStatus::%s>{}" % capitalize(self.status)
+
+    def apiCategory(self):
+        if self.category in ("css", "dom", "html"):
+            return "API::FeatureCategory::" + self.category.upper()
+        return "API::FeatureCategory::" + capitalize(self.category)
+
+    def hasInspectorOverride(self):
+        return self.inspectorOverride is True
+
+    # A preference in WebCore is a WebCore::Settings member unless it is one of the
+    # globals declared by hand in DeprecatedGlobalSettings.h.
+    def boundToWebCoreSettings(self):
+        return "WebCore" in frontendsFor(self.opts) and not self.webcoreDeprecatedGlobalSettings
+
+    # WebKitLegacy specific helpers.
+
+    def preferenceKey(self):
+        if self.opts.get("webKitLegacyPreferenceKey"):
+            return self.opts["webKitLegacyPreferenceKey"]
+        return "WebKit%s" % self.name
+
+    def preferenceAccessor(self):
+        accessors = {"bool": "_boolValueForKey", "uint32_t": "_integerValueForKey",
+                     "double": "_floatValueForKey", "String": "_stringValueForKey"}
+        if self.type not in accessors:
+            raise Exception("Unknown type: %s" % self.type)
+        return accessors[self.type]
+
+    def downcast(self):
+        if self.refinedType:
+            return "static_cast<%s>(" % self.type
+        return None
+
+    def upcast(self):
+        if self.refinedType:
+            return "static_cast<%s>(" % self.refinedType
+        return None
+
+    def ephemeral(self):
+        return self.status in ("unstable", "internal", "testable")
+
+    def isDefaultsOverridable(self):
+        return self.defaultsOverridable
+
+    # FIXME: These names correspond to the "experimental features" and "internal
+    # debug features" designations used before the feature status taxonomy was
+    # introduced. They should be renamed to better reflect their semantic meanings.
+
+    # Features which should appear in UI presented to end users.
+    def experimental(self):
+        return self.status in ("developer", "testable", "preview", "stable")
+
+    # Features which should only be presented in WebKit development contexts.
+    def internal(self):
+        return self.status in ("unstable", "internal")
+
+    # Features which should be enabled while running tests
+    def testable(self):
+        return self.status in ("testable", "preview", "stable", "mature")
+
+
+class Preferences:
+    # Corresponds to WebFeatureCategory enum cases.
+    CATEGORIES = ["animation", "css", "dom", "extensions", "html", "javascript", "media", "networking", "privacy", "security"]
+
+    def __init__(self, preferenceFiles, frontend):
+        self.frontend = frontend
+
+        self.preferences = []
+        definingFileByName = {}
+        for file in preferenceFiles:
+            parsed = load(file)
+            for name in (parsed or {}).keys():
+                if name in definingFileByName:
+                    sys.stderr.write("error: %s: %s is already defined in %s.\n" % (file, name, definingFileByName[name]))
+                    sys.exit(1)
+                definingFileByName[name] = file
+            self.initializeParsedPreferences(parsed)
+
+        self.preferences.sort(key=lambda p: p.name if p.humanReadableName == "" else p.humanReadableName)
+        self.exposedPreferences = [p for p in self.preferences if p.exposed]
+        self.exposedFeatures = [p for p in self.exposedPreferences if p.type == "bool"]
+        self.sharedPreferencesForWebProcess = [p for p in self.exposedPreferences if p.sharedPreferenceForWebProcess]
+        self.inspectorOverridePreferences = [p for p in self.preferences if p.hasInspectorOverride()]
+
+        self.preferencesBoundToSetting = [p for p in self.preferences if p.boundToWebCoreSettings()]
+        self.preferencesBoundToDeprecatedGlobalSettings = [p for p in self.preferences if p.webcoreDeprecatedGlobalSettings]
+
+        self.jscOptions = sorted([p for p in self.preferences if p.jscOptionName], key=lambda p: p.jscOptionName)
+
+        self.warning = "THIS FILE WAS AUTOMATICALLY GENERATED, DO NOT EDIT."
+
+    def initializeParsedPreferences(self, parsedPreferences):
+        result = []
+        failed = [False]
+
+        def reject(msg):
+            sys.stderr.write("error: " + msg + "\n")
+            failed[0] = True
+
+        if parsedPreferences:
+            for name, options in parsedPreferences.items():
+                webcoreSettingOnly = not options.get("webcoreDeprecatedGlobalSettings") and frontendsFor(options) == ["WebCore"]
+                status = options.get("status")
+
+                if options.get("jscOptionName"):
+                    if not options.get("sharedPreferenceForWebProcess"):
+                        reject("Preference %s has jscOptionName, so it must set sharedPreferenceForWebProcess: true." % name)
+                    if "WebKit" not in frontendsFor(options):
+                        reject("Preference %s has jscOptionName, so it must not be excluded from WebKit." % name)
+                    if failed[0]:
+                        continue
+
+                if status in ("unstable", "internal", "developer", "testable", "preview", "stable"):
+                    if not options.get("humanReadableName"):
+                        reject("Preference %s has no humanReadableName, which is required." % name)
+                    if webcoreSettingOnly:
+                        reject("Preference %s is visible in client UI and has a default value bound to WebCore::Settings, so it must have default values for all frontends" % name)
+                    if failed[0]:
+                        continue
+                elif webcoreSettingOnly and self.frontend != "WebCore":
+                    continue
+
+                if status in ("developer", "testable", "preview", "stable"):
+                    if not options.get("category"):
+                        reject("Preference %s has no category, which is required." % name)
+                    if failed[0]:
+                        continue
+                    category = options["category"]
+                    if category not in Preferences.CATEGORIES:
+                        reject("Preference %s's category \"%s\" is not one of the known categories: %s" % (name, category, rubyInspect(Preferences.CATEGORIES)))
+                        continue
+
+                # The JavaScriptCore "frontend" is the set of preferences that back a
+                # JSC::Options feature flag, identified by jscOptionName; every other frontend
+                # selects on not being excluded from itself.
+                if self.frontend == "JavaScriptCore":
+                    includedInFrontend = options.get("jscOptionName") is not None
+                else:
+                    includedInFrontend = self.frontend in frontendsFor(options)
+                if includedInFrontend:
+                    preference = Preference(name, options, self.frontend)
+                    self.preferences.append(preference)
+                    result.append(preference)
+        if failed[0]:
+            sys.exit(1)
+        return result
+
+    def renderTemplate(self, templateFile, outputDirectory):
+        name = os.path.basename(templateFile)
+        if name.endswith(".pyerb"):
+            name = name[:-len(".pyerb")]
+        resultFile = os.path.join(outputDirectory, name)
+        tempResultFile = resultFile + ".tmp"
+
+        with open(templateFile) as f:
+            output = renderTemplateText(f.read(), templateFile, self)
+        with open(tempResultFile, "w") as f:
+            f.write(output)
+        with open(tempResultFile) as f:
+            newContents = f.read()
+        oldContents = None
+        if os.path.exists(resultFile):
+            with open(resultFile) as f:
+                oldContents = f.read()
+        if oldContents != newContents:
+            os.replace(tempResultFile, resultFile)
+        else:
+            os.remove(tempResultFile)
+            if os.path.getmtime(resultFile) < os.path.getmtime(templateFile):
+                os.utime(resultFile)
+
+    def constantize(self, value):
+        if value is True:
+            return "std::true_type{}"
+        if value is False:
+            return "std::false_type{}"
+        return value
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        usage="%(prog)s --frontend <frontend> [--outputDir <output>] --template <file> [--template <file>...] <preferences> [<preferences>...]")
+    parser.add_argument("--frontend", help="frontend to generate preferences for (WebKit, WebKitLegacy, WebCore, JavaScriptCore)")
+    parser.add_argument("--template", action="append", default=[], help="template to use for generation (may be specified multiple times)")
+    parser.add_argument("--outputDir", default=os.getcwd(), help="directory to generate file in (default: cwd)")
+    parser.add_argument("preferenceFiles", nargs="*")
+    options = parser.parse_args()
+
+    if not options.preferenceFiles:
+        parser.print_usage()
+        sys.exit(1)
+
+    os.makedirs(options.outputDir, exist_ok=True)
+
+    preferences = Preferences(options.preferenceFiles, options.frontend)
+
+    for template in options.template:
+        preferences.renderTemplate(template, options.outputDir)
+
+
+if __name__ == "__main__":
+    main()
