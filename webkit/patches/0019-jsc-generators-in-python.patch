+    def prepareToLower(self, backendName):
+        method = getattr(self, "recordMetaData" + backendName, None)
+        if method is not None:
+            method()
+        else:
+            self.recordMetaDataDefault()
+
+    def recordMetaDataDefault(self):
+        if config.enableCodeOriginComments:
+            config.asm.codeOrigin(self.codeOriginString())
+        if config.enableInstrAnnotations:
+            config.asm.annotation(self.annotation)
+        if config.enableDebugAnnotations:
+            config.asm.debugAnnotation(self.codeOrigin.debugDirective())
