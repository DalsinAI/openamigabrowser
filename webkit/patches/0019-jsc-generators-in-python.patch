+# THE POSSIBILITY OF SUCH DAMAGE.
+
+import re
+
+from .astnodes import (Node, TrueNode, FalseNode, Setting, And, Or, Not, IfThenElse, Sequence, Macro,
+                       MacroCall, Variable, StructOffset, Label, ConstExpr, Sizeof, LocalLabel, ConstDecl,
+                       Instruction, Immediate, LabelReference, AddImmediates, SubImmediates, MulImmediates,
+                       NegImmediate, OrImmediates, AndImmediates, XorImmediates, BitnotImmediate,
+                       StringLiteral, RegisterID, FPRegisterID, VecRegisterID, Address, BaseIndex,
+                       AbsoluteAddress, Error, LocalLabelReference, Skip, asNode)
+
+
+def method(*classes):
+    """Adds the function to the classes, as Ruby's reopened classes do."""
+    def decorate(fn):
+        for cls in classes:
+            setattr(cls, fn.__name__, fn)
+        return fn
+    return decorate
+
+
+#
+# node.resolveSettings(settings)
+#
+# Construct a new AST that does not have any IfThenElse nodes by
+# substituting concrete boolean values for each Setting.
+#
+
+@method(Node)
+def resolveSettings(self, settings):
+    return self.mapChildren(lambda child: child.resolveSettings(settings))
+
+
+@method(TrueNode, FalseNode)
+def resolveSettings(self, settings):
+    return self
+
+
+@method(Setting)
+def resolveSettings(self, settings):
+    return asNode(settings.get(self.name))
+
+
+@method(And)
+def resolveSettings(self, settings):
+    return asNode(self.left.resolveSettings(settings).value and self.right.resolveSettings(settings).value)
+
+
+@method(Or)
+def resolveSettings(self, settings):
+    return asNode(self.left.resolveSettings(settings).value or self.right.resolveSettings(settings).value)
+
+
+@method(Not)
+def resolveSettings(self, settings):
+    return asNode(not self.child.resolveSettings(settings).value)
+
+
+@method(IfThenElse)
+def resolveSettings(self, settings):
+    if self.predicate.resolveSettings(settings).value:
+        return self.thenCase.resolveSettings(settings)
+    return self.elseCase.resolveSettings(settings)
+
+
+@method(Sequence)
+def resolveSettings(self, settings):
+    newList = []
+    for item in self.list:
+        item = item.resolveSettings(settings)
+        if isinstance(item, Sequence):
+            newList.extend(item.list)
+        else:
+            newList.append(item)
+    return Sequence(self.codeOrigin, newList)
+
+
+#
+# node.demacroify(macros)
+# node.substitute(mapping)
+#
+# demacroify() constructs a new AST that does not have any Macro
+# nodes, while substitute() replaces Variable nodes with the given
+# nodes in the mapping.
+#
+
+@method(Node)
+def demacroify(self, macros):
+    return self.mapChildren(lambda child: child.demacroify(macros))
+
+
+@method(Node)
+def freshVariables(self, mapping):
+    return self.mapChildren(lambda child: child.freshVariables(mapping))
+
+
+@method(Node)
+def substitute(self, mapping):
+    return self.mapChildren(lambda child: child.substitute(mapping))
+
+
+@method(Node)
+def substituteLabels(self, mapping):
+    return self.mapChildren(lambda child: child.substituteLabels(mapping))
+
+
+_uniqueMacroVarID = [0]
+
+
+@method(Macro)
+def freshVariables(self, mapping=None):
+    myMapping = dict(mapping or {})
+    newVars = []
+    for var in self.variables:
+        _uniqueMacroVarID[0] += 1
+        newVar = Variable.forName(var.codeOrigin, "_var%d" % _uniqueMacroVarID[0], var.originalName())
+        newVars.append(newVar)
+        myMapping[var] = newVar
+    return Macro(self.codeOrigin, self.name, newVars, self.body.freshVariables(myMapping))
+
+
+@method(Macro)
+def substitute(self, mapping):
+    myMapping = {}
+    for key, value in mapping.items():
+        if not any(key is variable for variable in self.variables):
+            myMapping[key] = value
+    return self.mapChildren(lambda child: child.substitute(myMapping))
+
+
+@method(MacroCall)
+def freshVariables(self, mapping):
+    newName = Variable.forName(self.codeOrigin, self.name, self.originalName())
+    if mapping.get(newName) is not None:
+        newName = mapping[newName]
+    newOperands = [operand.freshVariables(mapping) for operand in self.operands]
+    return MacroCall(self.codeOrigin, newName.name, newOperands, self.annotation, self.originalName())
+
+
+CONCATENATION = re.compile(r"%([a-zA-Z0-9_]+)%")
+
+
+def _freshName(node, text, mapping):
+    def replace(match):
+        var = Variable.forName(node.codeOrigin, match.group(0)[1:-1])
+        if mapping.get(var) is not None:
+            return "%%%s%%" % mapping[var].name
+        return match.group(0)
+    return CONCATENATION.sub(replace, text)
+
+
+def _substitutedName(node, text, mapping):
+    def replace(match):
+        var = Variable.forName(node.codeOrigin, match.group(0)[1:-1])
+        if mapping.get(var) is not None:
+            return mapping[var].name
+        return match.group(0)
+    return CONCATENATION.sub(replace, text)
+
+
+@method(Variable)
+def freshVariables(self, mapping):
+    if CONCATENATION.search(self.name):
+        return Variable.forName(self.codeOrigin, _freshName(self, self.name, mapping))
+    elif mapping.get(self) is not None:
+        return mapping[self]
+    return self
+
+
+@method(Variable)
+def substitute(self, mapping):
+    if CONCATENATION.search(self.name):
+        return Variable.forName(self.codeOrigin, _substitutedName(self, self.name, mapping))
+    elif mapping.get(self) is not None:
+        return mapping[self]
+    return self
+
+
+@method(StructOffset)
+def freshVariables(self, mapping):
+    if CONCATENATION.search(self.dump()):
+        names = _freshName(self, self.dump(), mapping).split("::")
+        return StructOffset.forField(self.codeOrigin, "::".join(names[0:-1]), names[-1])
+    return self
+
+
+@method(StructOffset)
+def substitute(self, mapping):
+    if CONCATENATION.search(self.dump()):
+        names = _substitutedName(self, self.dump(), mapping).split("::")
+        return StructOffset.forField(self.codeOrigin, "::".join(names[0:-1]), names[-1])
+    return self
+
+
+@method(Label)
+def freshVariables(self, mapping):
+    if CONCATENATION.search(self.name) or isinstance(self.alignTo, Variable):
+        name = _freshName(self, self.name, mapping)
+        result = Label.forName(self.codeOrigin, name, self.definedInFile)
+        if self.isGlobal():
+            result.setGlobal()
+        if not self.isAligned():
+            result.setUnalignedGlobal()
+        if self.isAligned() and self.alignTo:
+            result.setAligned(self.alignTo.freshVariables(mapping))
+        if not self.isExtern():
+            result.clearExtern()
+        return result
+    return self
+
+
+@method(Label)
+def substitute(self, mapping):
+    if CONCATENATION.search(self.name) or isinstance(self.alignTo, Variable):
+        name = _substitutedName(self, self.name, mapping)
+        result = Label.forName(self.codeOrigin, name, self.definedInFile)
+        if self.isGlobal():
+            result.setGlobal()
+        if not self.isAligned():
+            result.setUnalignedGlobal()
+        if self.isAligned() and self.alignTo:
+            result.setAligned(self.alignTo.substitute(mapping))
+        if not self.isExtern():
+            result.clearExtern()
+        return result
+    return self
+
+
+@method(ConstExpr)
+def freshVariables(self, mapping):
+    if CONCATENATION.search(self.value):
+        return ConstExpr.forName(self.codeOrigin, _freshName(self, self.value, mapping))
+    return self
+
+
+@method(ConstExpr)
+def substitute(self, mapping):
+    if CONCATENATION.search(self.value):
+        return ConstExpr.forName(self.codeOrigin, _substitutedName(self, self.value, mapping))
+    return self
+
+
+@method(Sizeof)
+def freshVariables(self, mapping):
+    if CONCATENATION.search(self.struct):
+        return Sizeof.forName(self.codeOrigin, _freshName(self, self.struct, mapping))
+    return self
+
+
+@method(Sizeof)
+def substitute(self, mapping):
+    if CONCATENATION.search(self.struct):
+        return Sizeof.forName(self.codeOrigin, _substitutedName(self, self.struct, mapping))
+    return self
+
+
+@method(LocalLabel)
+def substituteLabels(self, mapping):
+    if mapping.get(self) is not None:
+        return mapping[self]
+    return self
+
+
+class MacroError(Exception):
+    pass
+
+
+@method(Sequence)
+def substitute(self, constants):
+    newList = []
+    myConstants = dict(constants)
+    for item in self.list:
+        if isinstance(item, ConstDecl):
+            myConstants[item.variable] = item.value.substitute(myConstants)
+        else:
+            newList.append(item.substitute(myConstants))
+    return Sequence(self.codeOrigin, newList)
+
+
+@method(Sequence)
+def renameLabels(self, comment):
+    mapping = {}
+
+    for item in self.list:
+        if isinstance(item, LocalLabel):
+            mapping[item] = LocalLabel.unique(self.codeOrigin, (comment + "_" if comment is not None else "") + item.cleanName())
+
+    return self.substituteLabels(mapping)
+
+
+_demacroifyStack = []
+
+
+def macroError(msg):
+    backtrace = ["%s in call to %s" % (macroCall.codeOrigin, macroCall.originalName()) for macroCall in reversed(_demacroifyStack)]
+    raise MacroError(msg + "".join("\n    from " + line for line in backtrace))
+
+
+@method(Sequence)
+def demacroify(self, macros):
+    myMacros = dict(macros)
+    # We do an initial pass looking for all macros in order to allow forward references
+    for item in self.list:
+        if isinstance(item, Macro):
+            myMacros[item.name] = item.freshVariables()
+    newList = []
+    for item in self.list:
+        if isinstance(item, Macro):
+            # Ignore. We already looked for macros above and they should not be part of the final output
+            pass
+        elif isinstance(item, MacroCall):
+            _demacroifyStack.append(item)
+            mapping = {}
+            myMyMacros = dict(myMacros)
+            macro = myMacros.get(item.name)
+            if macro is None:
+                macroError("Could not find macro %s" % item.originalName())
+            if len(item.operands) != len(macro.variables):
+                macroError("Argument count mismatch for call to %s (expected %d but got %d arguments for macro %s defined at %s)" % (
+                    item.originalName(), len(macro.variables), len(item.operands), item.originalName(), macro.codeOrigin))
+            for idx in range(len(item.operands)):
+                operand = item.operands[idx]
+                if isinstance(operand, Variable) and myMacros.get(operand.name) is not None:
+                    myMyMacros[macro.variables[idx].name] = myMacros[operand.name]
+                    mapping[macro.variables[idx]] = None
+                elif isinstance(operand, Macro):
+                    myMyMacros[macro.variables[idx].name] = operand.freshVariables()
+                    mapping[macro.variables[idx]] = None
+                else:
+                    myMyMacros[macro.variables[idx]] = None
+                    mapping[macro.variables[idx]] = operand
+            if item.annotation is not None:
+                newList.append(Instruction(item.codeOrigin, "localAnnotation", [], item.annotation))
+            newList.extend(macro.body.substitute(mapping).demacroify(myMyMacros).renameLabels(item.originalName()).list)
+
+            _demacroifyStack.pop()
+        else:
+            newList.append(item.demacroify(myMacros))
+    return Sequence(self.codeOrigin, newList).substitute({})
+
+
+#
+# node.resolveOffsets(offsets, sizes)
+#
+# Construct a new AST that has offset values instead of symbolic
+# offsets.
+#
+
+@method(Node)
+def resolveOffsets(self, constantsMap):
+    return self.mapChildren(lambda child: child.resolveOffsets(constantsMap))
+
+
+@method(StructOffset, Sizeof, ConstExpr)
+def resolveOffsets(self, constantsMap):
+    if constantsMap.get(self) is not None:
+        return Immediate(self.codeOrigin, constantsMap[self])
+    print("Could not find %s in %s" % (self.inspect(), [k.inspect() for k in constantsMap.keys()]))
+    print("sizes = %s" % constantsMap)
+    raise Exception("unhandled exception")
+
+
+#
+# node.fold
+#
+# Resolve constant references and compute arithmetic expressions.
+#
+
+@method(Node)
+def fold(self):
+    return self.mapChildren(lambda child: child.fold())
+
+
+@method(AddImmediates)
+def fold(self):
+    self.left = self.left.fold()
+    self.right = self.right.fold()
+
+    if isinstance(self.left, Immediate) and isinstance(self.right, LabelReference):
+        return self.right.plusOffset(self.left.value)
+    if isinstance(self.left, LabelReference) and isinstance(self.right, Immediate):
+        return self.left.plusOffset(self.right.value)
+
+    if not isinstance(self.left, Immediate):
+        return self
+    if not isinstance(self.right, Immediate):
+        return self
+    return Immediate(self.codeOrigin, self.left.value + self.right.value)
+
+
+@method(SubImmediates)
+def fold(self):
+    self.left = self.left.fold()
+    self.right = self.right.fold()
+
+    if isinstance(self.left, LabelReference) and isinstance(self.right, Immediate):
+        return self.left.plusOffset(-self.right.value)
+
+    if not isinstance(self.left, Immediate):
+        return self
+    if not isinstance(self.right, Immediate):
+        return self
+    return Immediate(self.codeOrigin, self.left.value - self.right.value)
+
+
+def _foldBinary(operation):
+    def fold(self):
+        self.left = self.left.fold()
+        self.right = self.right.fold()
+        if not isinstance(self.left, Immediate):
+            return self
+        if not isinstance(self.right, Immediate):
+            return self
+        return Immediate(self.codeOrigin, operation(self.left.value, self.right.value))
+    return fold
+
+
+MulImmediates.fold = _foldBinary(lambda a, b: a * b)
+OrImmediates.fold = _foldBinary(lambda a, b: a | b)
+AndImmediates.fold = _foldBinary(lambda a, b: a & b)
+XorImmediates.fold = _foldBinary(lambda a, b: a ^ b)
+
+
+@method(NegImmediate)
+def fold(self):
+    self.child = self.child.fold()
+    if not isinstance(self.child, Immediate):
+        return self
+    return Immediate(self.codeOrigin, -self.child.value)
+
+
+@method(BitnotImmediate)
+def fold(self):
+    self.child = self.child.fold()
+    if not isinstance(self.child, Immediate):
+        return self
+    return Immediate(self.codeOrigin, ~self.child.value)
+
+
+#
+# node.resolveAfterSettings(offsets, sizes)
+#
+# Compile assembly against a set of offsets.
+#
+
+@method(Node)
+def resolve(self, constantsMap):
+    return self.demacroify({}).resolveOffsets(constantsMap).fold()
+
+
+#
+# node.validate
+#
+# Checks that the node is ready for backend compilation.
+#
+
+@method(Node)
+def validate(self):
+    raise Exception("Unresolved '%s' at %s" % (self.dump(), self.codeOriginString()))
+
+
+@method(Node)
+def validateChildren(self):
+    for node in self.children():
+        node.validate()
+
+
+@method(Sequence)
+def validate(self):
+    self.validateChildren()
+
+    # Further verify that this list contains only instructions, labels, and skips.
+    for node in self.list:
+        if not (isinstance(node, Instruction) or isinstance(node, Label) or
+                isinstance(node, LocalLabel) or isinstance(node, Skip)):
+            raise Exception("Unexpected %s at %s" % (node.inspect(), node.codeOrigin))
+
+
+@method(Immediate, StringLiteral, RegisterID, FPRegisterID, VecRegisterID, Error, LocalLabel,
+        LabelReference, LocalLabelReference, Skip)
+def validate(self):
+    pass
+
+
+@method(Address, BaseIndex, AbsoluteAddress, Instruction)
+def validate(self):
+    self.validateChildren()
+
+
+@method(SubImmediates)
+def validate(self):
+    if not self.left.isImmediateOperand():
+        raise Exception("Invalid operand %s to immediate subtraction" % self.left.dump())
+    if not self.right.isImmediateOperand():
+        raise Exception("Invalid operand %s to immediate subtraction" % self.right.dump())
+
+
+@method(Label)
+def validate(self):
+    if "%" in self.name:
+        raise Exception("Unresolved substitution in Label %s at %s" % (self.name, self.codeOrigin))
