+
+#
+# MissingMagicValuesException
+#
+# Thrown when magic values are missing from the binary.
+#
+
+class MissingMagicValuesException(Exception):
+    pass
+
+
+#
+# offsetsList(ast)
+# sizesList(ast)
+# constsLists(ast)
+#
+# Returns a list of offsets, sizeofs, and consts used by the AST.
+#
+
+def offsetsList(ast):
+    return sorted(uniq(ast.filter(StructOffset)), key=lambda v: v.sortKey())
+
+
+def sizesList(ast):
+    return sorted(uniq(ast.filter(Sizeof)), key=lambda v: v.sortKey())
+
+
+def constsList(ast):
+    return sorted(uniq(ast.filter(ConstExpr)), key=lambda v: v.sortKey())
+
+
+def readInt(endianness, data):
+    number = int.from_bytes(bytes(data[0:8]), "little" if endianness == "little" else "big")
+    if number > 0x7fffffffffffffff:
+        number -= 1 << 64
+    return number
+
+
+def prepareMagic(endianness, numbers):
+    magicBytes = b""
+    for number in numbers:
+        magicBytes += number.to_bytes(8, "little" if endianness == "little" else "big")
+    return magicBytes
+
+
+def fileBytes(file):
+    with open(file, "rb") as inp:
+        return inp.read()
+
+
+def sliceByteArrays(byteArray, pattern):
+    # The magic patterns cannot overlap themselves, so this splits as Ruby's
+    # byte-by-byte scan did.
+    return byteArray.split(pattern)
+
+
+#
+# offsetsAndConfigurationIndex(file) ->
+#     [[offsets, index], ...]
+#
+# Parses the offsets from a file and returns a list of offsets and the
+# index of the configuration that is valid in this build target.
+#
+
+def offsetsAndConfigurationIndex(file):
+    data = fileBytes(file)
+    result = {}
+
+    for endianness in ["little", "big"]:
+        headerMagicBytes = prepareMagic(endianness, OFFSET_HEADER_MAGIC_NUMBERS)
+        magicBytes = prepareMagic(endianness, OFFSET_MAGIC_NUMBERS)
+
+        bigArray = sliceByteArrays(data, headerMagicBytes)
+        if not len(bigArray) <= 1:
+            for configArray in bigArray[1:]:
+                array = sliceByteArrays(configArray, magicBytes)
+                index = readInt(endianness, array[1])
+                offsets = []
+                for item in array[2:]:
+                    offsets.append(readInt(endianness, item))
+                result[index] = offsets
+
+    if not len(result) >= 1:
+        raise MissingMagicValuesException()
+
+    # result is {index1: offsets1, index2: offsets2} but we want to return
+    # [[offsets1, index1], [offsets2, index2]].
+    return [[offsets, index] for index, offsets in result.items()]
+
+
+#
+# offsetsAndConfigurationIndexForVariants(file, variants) ->
+#     [[offsets, index], ...]
+#
+# Parses the offsets from a file and all its variants and returns a list of
+# offsets and the index of the configuration that is valid in this build target.
+#
+
+def offsetsAndConfigurationIndexForVariants(file, variants):
+    results = []
+    for current_variant in variants:
+        suffix = ""
+        if current_variant != "normal":
+            suffix = "_" + current_variant
+        results.extend(offsetsAndConfigurationIndex(file + suffix))
+    return results
+
+
+#
+# configurationIndices(file) ->
+#     [index, ...]
+#
+# Parses the configurations from a file and returns a list of the indices of
+# the configurations that are valid in this build target.
+#
+
+def configurationIndices(file):
+    data = fileBytes(file)
+    result = []
+
+    for endianness in ["little", "big"]:
+        headerMagicBytes = prepareMagic(endianness, OFFSET_HEADER_MAGIC_NUMBERS)
+
+        bigArray = sliceByteArrays(data, headerMagicBytes)
+        if not len(bigArray) <= 1:
+            for configArray in bigArray[1:]:
+                result.append(readInt(endianness, configArray))
+
+    if not len(result) >= 1:
+        raise MissingMagicValuesException()
+
+    return result
+
+
+#
+# configurationIndicesForVariants(file, variants) ->
+#     [index, ...]
+#
+# Parses the configurations from a file and all its variants and returns a list
+# of the indices of the configurations that are valid in this build target.
+#
+
+def configurationIndicesForVariants(file, variants):
+    results = []
+    for current_variant in variants:
+        suffix = ""
+        if current_variant != "normal":
+            suffix = "_" + current_variant
+        results.extend(configurationIndices(file + suffix))
+    unique = []
+    for index in results:
+        if index not in unique:
+            unique.append(index)
+    return unique
+
+
+#
+# buildOffsetsMap(ast, extractedConstants) -> map
+#
+# Builds a mapping between StructOffset, Sizeof, and ConstExpr nodes and their values.
+#
+
+def buildOffsetsMap(ast, extractedConstants):
+    map = {}
+    astOffsetsList = offsetsList(ast)
+    astSizesList = sizesList(ast)
+    astConstsList = constsList(ast)
+
+    if len(astOffsetsList) + len(astSizesList) + len(astConstsList) != len(extractedConstants):
+        raise Exception("offlineasm: the offsets extractor has %d values but the code uses %d"
+                        % (len(extractedConstants), len(astOffsetsList) + len(astSizesList) + len(astConstsList)))
+    extractedConstants = list(extractedConstants)
+    for structOffset in astOffsetsList:
+        map[structOffset] = extractedConstants.pop(0)
+    for sizeof in astSizesList:
+        map[sizeof] = extractedConstants.pop(0)
+    for const in astConstsList:
+        map[const] = extractedConstants.pop(0)
+    return map
