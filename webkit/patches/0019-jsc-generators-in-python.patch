+# CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+# SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+# INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+import re
+
+from Argument import Argument
+from Metadata import Metadata
+
+
+def s(value):
+    """Ruby's "#{value}": nil interpolates as nothing."""
+    return "" if value is None else "%s" % value
+
+
+class Size:
+    Narrow = "OpcodeSize::Narrow"
+    Wide16 = "OpcodeSize::Wide16"
+    Wide32 = "OpcodeSize::Wide32"
+
+
+_id = [0]
+
+
+class Opcode:
+    @staticmethod
+    def next_id():
+        tid = _id[0]
+        _id[0] += 1
+        return tid
+
+    def __init__(self, section, name, extras, args, metadata, metadata_initializers, tmps, checkpoints):
+        self.section = section
+        self._name = "%s" % name
+        self.extras = extras or {}
+        self.metadata = Metadata(metadata, metadata_initializers)
+        self.args = None
+        if args is not None:
+            self.args = [Argument(arg_name, type, index) for index, (arg_name, type) in enumerate(args.items())]
+        self.tmps = tmps
+        self.checkpoints = None
+        if checkpoints is not None:
+            self.checkpoints = [checkpoint for checkpoint in checkpoints.keys()]
+        self.id = None
+
+    def create_id(self):
+        self.id = Opcode.next_id()
+
+    def print_args(self, fn):
+        if self.args is None:
+            return None
+        return "\n".join(fn(arg) for arg in self.args)
+
+    def print_members(self, prefix, fn):
+        if self.args is None:
+            return None
+        return "\n".join("%s%s" % (prefix, fn(arg)) for arg in self.args)
+
+    def capitalized_name(self):
+        parts = []
+        for part in [p for p in self.name().split("_")]:
+            part = part.capitalize()
+            if re.match(r"\d", part):
+                i = len(re.match(r"\d+", part).group(0))
+                part = part[0:i] + part[i:].capitalize()
+            parts.append(part)
+        return "".join(parts)
+
+    def typed_args(self):
+        if self.args is None:
+            return None
+        return ", ".join([""] + [arg.create_param() for arg in self.args])
+
+    def typed_reference_args(self):
+        if self.args is None:
+            return None
+        return ", ".join([""] + [arg.create_reference_param() for arg in self.args])
+
+    def untyped_args(self):
+        if self.args is None:
+            return None
+        return ", ".join([""] + [arg.name for arg in self.args])
+
+    def opcodeIDType(self):
+        return "WasmOpcodeID" if self.section.is_wasm() else "OpcodeID"
+
+    def wide16(self):
+        return "wasm_wide16" if self.section.is_wasm() else "op_wide16"
+
+    def wide32(self):
+        return "wasm_wide32" if self.section.is_wasm() else "op_wide32"
+
+    def traits(self):
+        return "WasmOpcodeTraits" if self.section.is_wasm() else "JSOpcodeTraits"
+
+    def type_prefix(self):
+        return "Wasm" if self.section.is_wasm() else "JS"
+
+    def map_fields_with_size(self, prefix, size, fn):
+        args = [Argument("opcodeID", self.opcodeIDType(), 0)]
+        if self.args:
+            args += list(self.args)
+        if not self.metadata.empty():
+            args.append(self.metadata.emitter_local())
+        return ["%s%s" % (prefix, fn(arg, size)) for arg in args]
+
+    def map_operands_with_size(self, prefix, size, fn):
+        args = []
+        if self.args:
+            args += list(self.args)
+        if not self.metadata.empty():
+            args.append(self.metadata.emitter_local())
+        return ["%s%s" % (prefix, fn(arg, size)) for arg in args]
+
+    def struct(self):
+        return """struct %s : public %sInstruction {
+    %s
+    %s
+    %s
+    %s
+
+
+%s
+%s
+%s
+%s%s
+%s
+};
+%s
+""" % (self.capitalized_name(), self.type_prefix(), self.opcodeID(), self.lengthValue(), s(self.temps()),
+            s(self.checkpointValues()), self.emitter(), self.dumper(), self.constructors(), s(self.setters()),
+            self.metadata_struct_and_accessor(), self.members(), s(self.checkpointSizeAssert()))
+
+    def opcodeID(self):
+        return "static constexpr %s opcodeID = %s;" % (self.opcodeIDType(), self.name())
+
+    def lengthValue(self):
+        return "static constexpr size_t length = %d;" % self.length()
+
+    def checkpointValues(self):
+        if self.checkpoints is None:
+            return None
+
+        return "\n".join(["enum Checkpoints : uint8_t {"] +
+                         ["        %s," % checkpoint for checkpoint in self.checkpoints] +
+                         ["        numberOfCheckpoints,", "    };"])
+
+    def checkpointSizeAssert(self):
+        if self.checkpoints is None:
+            return None
+
+        return "static_assert(%s::length + 1 > %s::numberOfCheckpoints, \"FullBytecodeLivess relies on the length of %s being greater than the number of checkpoints\");" % (
+            self.capitalized_name(), self.capitalized_name(), self.capitalized_name())
+
+    def temps(self):
+        if self.tmps is None:
+            return None
+
+        return "\n".join(["enum Tmps : uint8_t {"] + ["        %s," % tmp for tmp in self.tmps.keys()] + ["    };"])
+
+    def emitImpl(self):
+        operand_args = [arg.name for arg in (self.args or [])]
+        if not self.metadata.empty():
+            operand_args.append(self.metadata.emitter_local().name)
+        all_args = ["opcodeID"] + operand_args
+        return "            gen->template writeOpcode<__size>(%s);" % ", ".join(all_args)
+
+    def emitter(self):
+        op_wide16 = Argument(self.wide16(), self.opcodeIDType(), 0)
+        op_wide32 = Argument(self.wide32(), self.opcodeIDType(), 0)
+        metadata_param = "" if self.metadata.empty() else ", %s" % self.metadata.emitter_local().create_param()
+        metadata_arg = "" if self.metadata.empty() else ", %s" % self.metadata.emitter_local().name
+        typed_args = s(self.typed_args())
+        untyped_args = s(self.untyped_args())
+        withMetadata = ""
+        if not self.metadata.empty():
+            withMetadata = """
+    template<OpcodeSize __size, typename BytecodeGenerator, FitsAssertion shouldAssert = Assert>
+    static bool emit(BytecodeGenerator* gen%(typed_args)s)
+    {%(local)s
+        return emit<__size, BytecodeGenerator, shouldAssert>(gen%(untyped_args)s%(metadata_arg)s);
+    }
+
+    template<OpcodeSize __size, typename BytecodeGenerator>
+    static bool checkWithoutMetadataID(BytecodeGenerator* gen%(typed_args)s)
+    {
+        decltype(gen->addMetadataFor(opcodeID)) __metadataID { };
+        return checkImpl<__size, BytecodeGenerator>(gen%(untyped_args)s%(metadata_arg)s);
+    }
+""" % {"typed_args": typed_args, "untyped_args": untyped_args, "metadata_arg": metadata_arg,
+                "local": s(self.metadata.create_emitter_local())}
+        opcodeIDArgument = Argument("opcodeID", self.opcodeIDType(), 0)
+        return ("""    template<typename BytecodeGenerator>
+    static void emit(BytecodeGenerator* gen%(typed_args)s)
+    {
+        emitWithSmallestSizeRequirement<OpcodeSize::Narrow, BytecodeGenerator>(gen%(untyped_args)s);
+    }
+%(withMetadata)s
+    template<OpcodeSize __size, typename BytecodeGenerator, FitsAssertion shouldAssert = Assert, bool recordOpcode = true>
+    static bool emit(BytecodeGenerator* gen%(typed_args)s%(metadata_param)s)
+    {
+        bool didEmit = emitImpl<__size, recordOpcode, BytecodeGenerator>(gen%(untyped_args)s%(metadata_arg)s);
+        if (shouldAssert == Assert)
+            ASSERT(didEmit);
+        return didEmit;
+    }
+
+    template<OpcodeSize __size, typename BytecodeGenerator>
+    static void emitWithSmallestSizeRequirement(BytecodeGenerator* gen%(typed_args)s)
+    {
+        %(local)s
+        if (static_cast<unsigned>(__size) <= static_cast<unsigned>(OpcodeSize::Narrow)) {
+            if (emit<OpcodeSize::Narrow, BytecodeGenerator, NoAssert, true>(gen%(untyped_args)s%(metadata_arg)s))
+                return;
+        }
+        if (static_cast<unsigned>(__size) <= static_cast<unsigned>(OpcodeSize::Wide16)) {
+            if (emit<OpcodeSize::Wide16, BytecodeGenerator, NoAssert, true>(gen%(untyped_args)s%(metadata_arg)s))
+                return;
+        }
+        emit<OpcodeSize::Wide32, BytecodeGenerator, Assert, true>(gen%(untyped_args)s%(metadata_arg)s);
+    }
+
+private:
+    template<OpcodeSize __size, typename BytecodeGenerator>
+    static bool checkImpl(BytecodeGenerator* gen%(typed_reference_args)s%(metadata_param)s)
+    {
+        UNUSED_PARAM(gen);
+        return %(checks)s
+            && (__size == OpcodeSize::Narrow ? %(narrowCheck)s : %(wide16Check)s)
+            && (__size == OpcodeSize::Wide16 ? %(prefix16Check)s : true)
+            && (__size == OpcodeSize::Wide32 ? %(prefix32Check)s : true);
+    }
+
+    template<OpcodeSize __size, bool recordOpcode, typename BytecodeGenerator>
+    static bool emitImpl(BytecodeGenerator* gen%(typed_args)s%(metadata_param)s)
+    {
+        %(checkpoints)s
+        if (checkImpl<__size>(gen%(untyped_args)s%(metadata_arg)s)) {
+            if (recordOpcode)
+                gen->recordOpcode(opcodeID);
+%(emitImpl)s
+            return true;
+        }
+        return false;
+    }
+
+public:""" % {
+            "typed_args": typed_args, "untyped_args": untyped_args, "metadata_arg": metadata_arg,
+            "metadata_param": metadata_param, "withMetadata": withMetadata,
+            "local": s(self.metadata.create_emitter_local()),
+            "typed_reference_args": s(self.typed_reference_args()),
+            "checks": "\n            && ".join(self.map_fields_with_size("", "__size", lambda arg, size: arg.fits_check(size))),
+            "narrowCheck": opcodeIDArgument.fits_check(Size.Narrow),
+            "wide16Check": opcodeIDArgument.fits_check(Size.Wide16),
+            "prefix16Check": op_wide16.fits_check(Size.Narrow),
+            "prefix32Check": op_wide32.fits_check(Size.Narrow),
+            "checkpoints": "gen->setUsesCheckpoints();" if self.checkpoints is not None else "",
+            "emitImpl": self.emitImpl(),
+        })
+
+    def dumper(self):
+        printed = self.print_args(lambda arg: "        dumper->dumpOperand(\"%s\", %s, %s);" % (
+            arg.name, arg.field_name(), "true" if arg.index == 0 else "false"))
+        return """    void dump(BytecodeDumperBase<%(tp)sInstructionStream>* dumper, %(tp)sInstructionStream::Offset __location, int __sizeShiftAmount)
+    {
+        dumper->printLocationAndOp(__location, &"**%(name)s"[2 - __sizeShiftAmount]);
+%(args)s
+    }
+""" % {"tp": self.type_prefix(), "name": self._name, "args": s(printed)}
+
+    def constructors(self):
+        fields = (self.args or []) + ([] if self.metadata.empty() else [self.metadata])
+
+        def init(size):
+            if not fields:
+                return ""
+            return ": " + "\n        , ".join(arg.load_from_stream(i, size) for i, arg in enumerate(fields))
+
+        return """    %(cap)s(const uint8_t* stream)
+        %(narrow)s
+    {
+        ASSERT_UNUSED(stream, static_cast<%(idType)s>(std::bit_cast<const typename OpcodeIDWidthBySize<%(tp)sOpcodeTraits, OpcodeSize::Narrow>::opcodeType*>(stream)[-1]) == opcodeID);
+    }
+
+    %(cap)s(const uint16_t* stream)
+        %(wide16)s
+    {
+        ASSERT_UNUSED(stream, static_cast<%(idType)s>(std::bit_cast<const typename OpcodeIDWidthBySize<%(tp)sOpcodeTraits, OpcodeSize::Wide16>::opcodeType*>(stream)[-1]) == opcodeID);
+    }
+
+
+    %(cap)s(const uint32_t* stream)
+        %(wide32)s
+    {
+        ASSERT_UNUSED(stream, static_cast<%(idType)s>(std::bit_cast<const typename OpcodeIDWidthBySize<%(tp)sOpcodeTraits, OpcodeSize::Wide32>::opcodeType*>(stream)[-1]) == opcodeID);
+    }
+
+    static %(cap)s decode(const uint8_t* stream)
+    {
+        // A pointer is pointing to the first operand (opcode and prefix are not included).
+        if (*stream == %(w32)s)
+            return { std::bit_cast<const uint32_t*>(stream + /* prefix */ 1 + OpcodeIDWidthBySize<%(tp)sOpcodeTraits, OpcodeSize::Wide32>::opcodeIDSize) };
+        if (*stream == %(w16)s)
+            return { std::bit_cast<const uint16_t*>(stream + /* prefix */ 1 + OpcodeIDWidthBySize<%(tp)sOpcodeTraits, OpcodeSize::Wide16>::opcodeIDSize) };
+        return { stream + OpcodeIDWidthBySize<%(tp)sOpcodeTraits, OpcodeSize::Narrow>::opcodeIDSize };
+    }
+""" % {"cap": self.capitalized_name(), "narrow": init("OpcodeSize::Narrow"), "wide16": init("OpcodeSize::Wide16"),
+            "wide32": init("OpcodeSize::Wide32"), "idType": self.opcodeIDType(), "tp": self.type_prefix(),
+            "w32": self.wide32(), "w16": self.wide16()}
+
+    def setters(self):
+        return self.print_args(lambda a: a.setter(self.traits()))
+
+    def metadata_struct_and_accessor(self):
+        return s(self.metadata.struct(self)) + s(self.metadata.accessor())
+
+    def members(self):
+        return s(self.print_members("    ", lambda arg: arg.field())) + s(self.metadata.field("    "))
+
+    def set_entry_address(self, id):
+        return "setEntryAddress(%d, _%s)" % (id, self.full_name())
+
+    def set_entry_address_wide16(self, id):
+        return "setEntryAddressWide16(%d, _%s_wide16)" % (id, self.full_name())
+
+    def set_entry_address_wide32(self, id):
+        return "setEntryAddressWide32(%d, _%s_wide32)" % (id, self.full_name())
+
+    def struct_indices(self):
+        out = []
+        if self.args is not None:
+            out += [arg.field_name() for arg in self.args]
+        if not self.metadata.empty():
+            out.append(Metadata.field_name())
+        return ["const unsigned %s_%s_index = %d;" % (self.capitalized_name(), name, index) for index, name in enumerate(out)]
+
+    def full_name(self):
+        return "%s%s%s" % (s(self.section.config.get("asm_prefix")), s(self.section.config.get("op_prefix")), self._name)
+
+    def name(self):
+        return "%s%s" % (s(self.section.config.get("op_prefix")), self._name)
+
+    def unprefixed_name(self):
+        return self._name
+
+    def length(self):
+        return (0 if self.args is None else len(self.args)) + (0 if self.metadata.empty() else 1)
+
+    @staticmethod
+    def dump_bytecode(name, opcode_traits, opcodes):
+        type_prefix = "JS" if opcode_traits == "JSOpcodeTraits" else ("Wasm" if opcode_traits == "WasmOpcodeTraits" else "Error%s" % opcode_traits)
+        cases = "\n".join("""    case %s:
+        __instruction->as<%s>().dump(dumper, __location, __instruction->sizeShiftAmount());
+        break;""" % (op.name(), op.capitalized_name()) for op in opcodes)
+        return """void dump%(name)s(BytecodeDumperBase<%(tp)sInstructionStream>* dumper, %(tp)sInstructionStream::Offset __location, const %(tp)sInstruction* __instruction)
+{
+    switch (__instruction->opcodeID()) {
+%(cases)s
+    default:
+        ASSERT_NOT_REACHED();
+    }
+}""" % {"name": name, "tp": type_prefix, "cases": cases}
