@@ -0,0 +1,273 @@
+# Copyright (C) 2011-2022 Apple Inc. All rights reserved.
+# Copyright (C) 2026 AmigaChrome Team (Python port of JavaScriptCore/offlineasm/asm.rb).
+#
+# Redistribution and use in source and binary forms, with or without
