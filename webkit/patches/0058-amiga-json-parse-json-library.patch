+// json.library's block and error (libraries/json.h): a header, then 8-byte
+// nodes in document order, then the pool of strings (UTF-8) and number texts.
+struct JSONLibraryDoc {
+    uint32_t magic, size, nodes, nodeOffset, poolOffset, poolSize, flags, reserved;
+};
+struct JSONLibraryNode {
+    uint32_t head, data;
+};
+struct JSONLibraryError {
+    int32_t code;
+    uint32_t offset, line, column;
+};
+
+enum : uint32_t { NodeNull = 1, NodeFalse, NodeTrue, NodeInt, NodeNumber, NodeString, NodeArray, NodeObject };
+enum : int32_t {
+    ErrorNoMemory = 1, ErrorSyntax, ErrorEOF, ErrorControl, ErrorEscape, ErrorUTF8, ErrorNumber, ErrorDepth,
+    ErrorTooBig, ErrorTrailing
+};
+constexpr uint32_t parseLatin1 = 4; // JSONF_LATIN1
+
+ALWAYS_INLINE uint32_t nodeType(const JSONLibraryNode& node) { return node.head >> 28; }
+ALWAYS_INLINE uint32_t nodeField(const JSONLibraryNode& node) { return node.head & 0x0FFFFFFFu; }
+
+#if defined(OB_JSON_LIBRARY_HOST)
+
+bool openJSONLibrary() { return true; }
+
+const JSONLibraryDoc* libraryParse(const uint8_t* text, uint32_t length, uint32_t flags, JSONLibraryError* error)
+{
+    return static_cast<const JSONLibraryDoc*>(obJSONHostParse(text, length, flags, error));
+}
+
+void libraryFree(const JSONLibraryDoc* doc)
+{
+    obJSONHostFree(const_cast<JSONLibraryDoc*>(doc));
+}
+
+#else
+
+#ifdef __HAVE_68881__
+#define OB_JSON_FP_CLOBBER "fp0", "fp1",
+#else
+#define OB_JSON_FP_CLOBBER
+#endif
+
+void* s_jsonBase;
+std::once_flag s_jsonOnce;
+
+// exec.library's OpenLibrary and CloseLibrary, and json.library's JSONParse
+// and JSONFreeDoc, called in their registers (no Amiga headers here, as this
+// file is built with JavaScriptCore's own).
+void* execOpenLibrary(const char* name, uint32_t version)
+{
+    register uint32_t d0 __asm("d0") = version;
+    register uint32_t d1 __asm("d1") = 0;
+    register uint32_t a0 __asm("a0") = 0;
+    register uint32_t a1 __asm("a1") = reinterpret_cast<uint32_t>(name);
+    register void* a6 __asm("a6") = *reinterpret_cast<void* volatile*>(4);
+    __asm__ __volatile__("jsr -552(%/a6)"
+        : "+r"(d0), "+r"(d1), "+r"(a0), "+r"(a1)
+        : "r"(a6)
+        : OB_JSON_FP_CLOBBER "cc", "memory");
+    return reinterpret_cast<void*>(d0);
+}
+
+void execCloseLibrary(void* base)
+{
+    register uint32_t d0 __asm("d0") = 0;
+    register uint32_t d1 __asm("d1") = 0;
+    register uint32_t a0 __asm("a0") = 0;
+    register uint32_t a1 __asm("a1") = reinterpret_cast<uint32_t>(base);
+    register void* a6 __asm("a6") = *reinterpret_cast<void* volatile*>(4);
+    __asm__ __volatile__("jsr -414(%/a6)"
+        : "+r"(d0), "+r"(d1), "+r"(a0), "+r"(a1)
+        : "r"(a6)
+        : OB_JSON_FP_CLOBBER "cc", "memory");
+}
+
+void closeJSONLibrary()
+{
+    if (void* base = s_jsonBase) {
+        s_jsonBase = nullptr;
+        execCloseLibrary(base);
+    }
+}
+
+// LIBS:json.library, or the one in the program's drawer when it is not
+// installed. Opened once, for every thread, and closed at exit.
+bool openJSONLibrary()
+{
+    std::call_once(s_jsonOnce, [] {
+        void* base = execOpenLibrary("json.library", 1);
+        if (!base)
+            base = execOpenLibrary("PROGDIR:Libs/json.library", 1);
+        s_jsonBase = base;
+        if (base)
+            atexit(closeJSONLibrary);
+    });
+    return s_jsonBase;
+}
+
+const JSONLibraryDoc* libraryParse(const uint8_t* text, uint32_t length, uint32_t flags, JSONLibraryError* error)
+{
+    register uint32_t d0 __asm("d0") = length;
+    register uint32_t d1 __asm("d1") = flags;
+    register uint32_t a0 __asm("a0") = reinterpret_cast<uint32_t>(text);
+    register uint32_t a1 __asm("a1") = reinterpret_cast<uint32_t>(error);
+    register void* a6 __asm("a6") = s_jsonBase;
+    __asm__ __volatile__("jsr -42(%/a6)"
+        : "+r"(d0), "+r"(d1), "+r"(a0), "+r"(a1)
+        : "r"(a6)
+        : OB_JSON_FP_CLOBBER "cc", "memory");
+    return reinterpret_cast<const JSONLibraryDoc*>(d0);
+}
+
+void libraryFree(const JSONLibraryDoc* doc)
+{
+    register uint32_t d0 __asm("d0") = 0;
+    register uint32_t d1 __asm("d1") = 0;
+    register uint32_t a0 __asm("a0") = reinterpret_cast<uint32_t>(doc);
+    register uint32_t a1 __asm("a1") = 0;
+    register void* a6 __asm("a6") = s_jsonBase;
+    __asm__ __volatile__("jsr -48(%/a6)"
+        : "+r"(d0), "+r"(d1), "+r"(a0), "+r"(a1)
+        : "r"(a6)
+        : OB_JSON_FP_CLOBBER "cc", "memory");
+}
