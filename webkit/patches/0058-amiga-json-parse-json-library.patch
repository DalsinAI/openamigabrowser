+ALWAYS_INLINE bool isASCIIBytes(const uint8_t* bytes, uint32_t length)
+{
+    uint8_t all = 0;
+    for (uint32_t i = 0; i < length; ++i)
+        all |= bytes[i];
+    return !(all & 0x80);
+}
+
+// The pool's strings are UTF-8 the library has checked. An unpaired
+// surrogate escape comes out as U+FFFD, so a string holding U+FFFD gives a
+// null String here and is read again from the source text.
+String poolStringToString(const uint8_t* bytes, uint32_t length)
+{
+    auto next = [&](uint32_t& i) -> char32_t {
+        uint8_t c = bytes[i++];
+        if (c < 0x80)
+            return c;
+        if (c < 0xE0) {
+            char32_t r = ((c & 0x1F) << 6) | (bytes[i] & 0x3F);
+            i += 1;
+            return r;
+        }
+        if (c < 0xF0) {
+            char32_t r = ((c & 0x0F) << 12) | ((bytes[i] & 0x3F) << 6) | (bytes[i + 1] & 0x3F);
+            i += 2;
+            return r;
+        }
+        char32_t r = ((c & 0x07) << 18) | ((bytes[i] & 0x3F) << 12) | ((bytes[i + 1] & 0x3F) << 6) | (bytes[i + 2] & 0x3F);
+        i += 3;
+        return r;
+    };
+
+    unsigned units = 0;
+    char32_t all = 0;
+    for (uint32_t i = 0; i < length;) {
+        char32_t c = next(i);
+        if (c == 0xFFFD)
+            return { };
+        all |= c;
+        units += c > 0xFFFF ? 2 : 1;
+    }
+    if (all < 0x100) {
+        std::span<Latin1Character> out;
+        String result = String::createUninitialized(units, out);
+        unsigned o = 0;
+        for (uint32_t i = 0; i < length;)
+            out[o++] = static_cast<Latin1Character>(next(i));
+        return result;
+    }
+    std::span<char16_t> out;
+    String result = String::createUninitialized(units, out);
+    unsigned o = 0;
+    for (uint32_t i = 0; i < length;) {
+        char32_t c = next(i);
+        if (c > 0xFFFF) {
+            out[o++] = U16_LEAD(c);
+            out[o++] = U16_TRAIL(c);
+        } else
+            out[o++] = static_cast<char16_t>(c);
+    }
+    return result;
+}
+
+// A 16-bit source as UTF-8 for the library. An unpaired surrogate becomes
+// U+FFFD (inside a string it is read again from the source; anywhere else it
+// is a syntax error either way), and so does a byte order mark at the start,
+// which JSON.parse does not skip but the library would.
+bool sourceToUTF8(std::span<const char16_t> source, Vector<uint8_t>& out)
+{
+    uint64_t size = 0;
+    for (size_t i = 0; i < source.size(); ++i) {
+        char16_t c = source[i];
+        if (c < 0x80)
+            size += 1;
+        else if (c < 0x800)
+            size += 2;
+        else if (U16_IS_LEAD(c) && i + 1 < source.size() && U16_IS_TRAIL(source[i + 1])) {
+            size += 4;
+            ++i;
+        } else
+            size += 3;
+    }
+    if (size > 0x7FFFFFFFu || !out.tryReserveCapacity(size))
+        return false;
+    out.grow(size);
+    uint8_t* p = out.mutableSpan().data();
+    for (size_t i = 0; i < source.size(); ++i) {
+        char32_t c = source[i];
+        if (c < 0x80) {
+            *p++ = c;
+            continue;
+        }
+        if (c < 0x800) {
+            *p++ = 0xC0 | (c >> 6);
+            *p++ = 0x80 | (c & 0x3F);
+            continue;
+        }
+        if (U16_IS_SURROGATE(c) || (!i && c == 0xFEFF)) {
+            if (U16_IS_LEAD(c) && i + 1 < source.size() && U16_IS_TRAIL(source[i + 1]))
+                c = U16_GET_SUPPLEMENTARY(c, source[++i]);
+            else
+                c = 0xFFFD;
+        }
+        if (c > 0xFFFF) {
+            *p++ = 0xF0 | (c >> 18);
+            *p++ = 0x80 | ((c >> 12) & 0x3F);
+        } else
+            *p++ = 0xE0 | (c >> 12);
+        *p++ = 0x80 | ((c >> 6) & 0x3F);
+        *p++ = 0x80 | (c & 0x3F);
+    }
+    return true;
+}
+
+// The library's byte offset as an index into a 16-bit source.
+unsigned sourceIndex(std::span<const char16_t> source, uint32_t offset)
+{
+    uint32_t bytes = 0;
+    size_t i = 0;
+    while (i < source.size() && bytes < offset) {
+        char16_t c = source[i++];
+        if (c < 0x80)
+            bytes += 1;
+        else if (c < 0x800)
+            bytes += 2;
+        else if (U16_IS_LEAD(c) && i < source.size() && U16_IS_TRAIL(source[i])) {
+            bytes += 4;
+            ++i;
+        } else
+            bytes += 3;
+    }
+    return i;
+}
+
+unsigned sourceIndex(std::span<const Latin1Character> source, uint32_t offset)
+{
+    return std::min<size_t>(offset, source.size());
+}
+
+template<typename CharType>
+String errorPlace(std::span<const CharType> source, unsigned index)
+{
+    unsigned line = 1;
+    unsigned column = 1;
+    for (unsigned i = 0; i < index && i < source.size(); ++i) {
+        if (source[i] == '\n') {
+            ++line;
+            column = 1;
+        } else
+            ++column;
+    }
+    return makeString(" at line "_s, line, ", column "_s, column);
+}
+
+template<typename CharType>
+String syntaxErrorMessage(std::span<const CharType> source, const JSONLibraryError& error, unsigned index)
+{
+    String what;
+    switch (error.code) {
+    case ErrorSyntax:
+        if (index < source.size())
+            what = makeString("Unexpected token '"_s, static_cast<char16_t>(source[index]), "'"_s);
+        else
+            what = "Unexpected EOF"_s;
+        break;
+    case ErrorEOF:
+        what = "Unexpected EOF"_s;
+        break;
+    case ErrorControl:
+        what = "Unescaped control character in string"_s;
+        break;
+    case ErrorEscape:
+        what = "Invalid escape in string"_s;
+        break;
+    case ErrorNumber:
+        what = "Invalid number"_s;
+        break;
+    case ErrorTrailing:
+        what = "Unexpected content at end of JSON literal"_s;
+        break;
+    default:
+        what = "Unable to parse JSON string"_s;
+        break;
+    }
+    return makeString("JSON Parse error: "_s, what, errorPlace(source, index));
+}
+
+template<typename CharType>
+class BlockBuilder {
+    WTF_MAKE_NONCOPYABLE(BlockBuilder);
+    WTF_FORBID_HEAP_ALLOCATION;
+public:
+    BlockBuilder(JSGlobalObject* globalObject, std::span<const CharType> source, const JSONLibraryDoc* doc, JSONRanges* ranges)
+        : m_globalObject(globalObject)
+        , m_vm(globalObject->vm())
+        , m_cache(m_vm.jsonCache())
+        , m_source(source)
+        , m_nodes(std::bit_cast<const JSONLibraryNode*>(std::bit_cast<const uint8_t*>(doc) + doc->nodeOffset))
+        , m_pool(std::bit_cast<const uint8_t*>(doc) + doc->poolOffset)
+        , m_ranges(ranges)
+    {
+    }
+
+    JSValue build();
+
+private:
+    JSValue makePrimitive(uint32_t index);
+    JSValue makeStringValue(uint32_t index);
+    Identifier makeIdentifier(uint32_t index);
+    JSArray* materializeArray(MarkedArgumentBuffer& elements, unsigned base);
+
+    // Objects made from JSON mostly share their shapes. When the object's
+    // Structure already has the transition that adds this key, take it
+    // without putDirect's lookups, as LiteralParser's fast path does: an
+    // ASCII key is compared with the Structure's single transition and
+    // looked up in the JSONCache's transitions before any Identifier is
+    // made. A key the object has already (a duplicate) has no such
+    // transition and goes to putDirect.
+    ALWAYS_INLINE bool putWithTransition(JSObject* object, Structure* structure, Structure* newStructure, JSValue value)
+    {
+        PropertyOffset offset = newStructure->transitionOffset();
+        if (offset >= firstOutOfLineOffset && structure->outOfLineCapacity() != newStructure->outOfLineCapacity())
+            return false;
+        validateOffset(offset);
+        object->putDirectWithoutBarrier(offset, value);
+        object->setStructureIDDirectly(newStructure->id());
+        m_vm.writeBarrier(object);
+        return true;
+    }
+    ALWAYS_INLINE bool putThroughCachedTransition(JSObject* object, std::span<const Latin1Character> name, JSValue value)
+    {
+        Structure* structure = object->structure();
+        if (structure->isDictionary())
+            return false;
+        Structure* newStructure = structure->trySingleTransition();
+        if (newStructure && newStructure->transitionKind() == TransitionKind::PropertyAddition
+            && !newStructure->transitionPropertyAttributes() && WTF::equal(newStructure->transitionPropertyName(), name))
+            return putWithTransition(object, structure, newStructure, value);
+        if (!newStructure) {
+            if ((newStructure = m_cache.getTransition(structure, name)))
+                return putWithTransition(object, structure, newStructure, value);
+        }
+        return false;
+    }
+    ALWAYS_INLINE bool putThroughExistingTransition(JSObject* object, const Identifier& key, std::span<const Latin1Character> asciiName, JSValue value)
+    {
+        Structure* structure = object->structure();
+        if (structure->isDictionary())
+            return false;
+        PropertyOffset offset = 0;
+        Structure* newStructure = Structure::addPropertyTransitionToExistingStructure(structure, key.impl(), 0, offset);
+        if (!newStructure)
+            return false;
+        if (asciiName.data() && !structure->hasBeenDictionary() && newStructure->transitionKind() == TransitionKind::PropertyAddition && !newStructure->transitionPropertyAttributes())
+            m_cache.addTransition(structure, newStructure, asciiName);
+        return putWithTransition(object, structure, newStructure, value);
+    }
+
+    // An object's key waiting for its value: an ASCII key stays in the pool
+    // until then; any other is made at once (it may need the source cursor).
+    struct PendingKey {
+        uint32_t node;
+        Identifier identifier;
+    };
+    PendingKey makePendingKey(uint32_t index)
+    {
+        const JSONLibraryNode& node = m_nodes[index];
+        if (isASCIIBytes(m_pool + nodeField(node), node.data) && !m_ranges)
+            return { index, Identifier() };
+        return { index, makeIdentifier(index) };
+    }
+
+    // The source cursor: where node `index` starts in the source text, for
+    // the reviver's source ranges and for strings read again from the source.
+    // Nodes are in document order, so the cursor only moves forward.
+    static ALWAYS_INLINE bool isSeparator(CharType c)
+    {
+        return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == ',' || c == ':' || c == ']' || c == '}';
+    }
+    void skipToken()
+    {
+        CharType c = m_source[m_cursor];
+        if (c == '"') {
+            ++m_cursor;
+            while (m_source[m_cursor] != '"')
+                m_cursor += m_source[m_cursor] == '\\' ? 2 : 1;
+            ++m_cursor;
+        } else if (c == '{' || c == '[')
+            ++m_cursor;
+        else if (c == 't' || c == 'n')
+            m_cursor += 4;
+        else if (c == 'f')
+            m_cursor += 5;
+        else {
+            while (m_cursor < m_source.size() && (isASCIIDigit(c = m_source[m_cursor]) || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E'))
+                ++m_cursor;
+        }
+    }
+    unsigned cursorTo(uint32_t index)
+    {
+        if (m_tokenNode == index)
+            return m_tokenStart;
+        while (m_cursorNode < index) {
+            while (isSeparator(m_source[m_cursor]))
+                ++m_cursor;
+            skipToken();
+            ++m_cursorNode;
+        }
+        while (m_cursor < m_source.size() && isSeparator(m_source[m_cursor]))
+            ++m_cursor;
+        m_tokenNode = index;
+        m_tokenStart = m_cursor;
+        return m_cursor;
+    }
+    // Past the token of the node the cursor is at.
+    unsigned tokenEnd()
+    {
+        skipToken();
+        ++m_cursorNode;
+        return m_cursor;
+    }
+    // Past the ] or } that closes the container whose last child the cursor passed.
+    unsigned closeContainer()
+    {
+        while (m_source[m_cursor] != ']' && m_source[m_cursor] != '}')
+            ++m_cursor;
+        return ++m_cursor;
+    }
+    String stringFromSource(uint32_t index);
+
+    JSGlobalObject* m_globalObject;
+    VM& m_vm;
+    JSONCache& m_cache;
+    std::span<const CharType> m_source;
+    const JSONLibraryNode* m_nodes;
+    const uint8_t* m_pool;
+    JSONRanges* m_ranges;
+    unsigned m_cursor { 0 };
+    uint32_t m_cursorNode { 0 };
+    uint32_t m_tokenNode { 0xFFFFFFFFu };
+    unsigned m_tokenStart { 0 };
+};
+
+// A string exactly as its source spells it: escapes give their code units,
+// so unpaired surrogates stay as they are.
+template<typename CharType>
+String BlockBuilder<CharType>::stringFromSource(uint32_t index)
+{
+    unsigned i = cursorTo(index) + 1;
+    StringBuilder builder;
+    while (true) {
+        CharType c = m_source[i++];
+        if (c == '"')
+            break;
+        if (c != '\\') {
+            builder.append(static_cast<char16_t>(c));
+            continue;
+        }
+        CharType e = m_source[i++];
+        switch (e) {
+        case 'b': builder.append('\b'); break;
+        case 'f': builder.append('\f'); break;
+        case 'n': builder.append('\n'); break;
+        case 'r': builder.append('\r'); break;
+        case 't': builder.append('\t'); break;
+        case 'u': {
+            char16_t unit = (toASCIIHexValue(m_source[i]) << 12) | (toASCIIHexValue(m_source[i + 1]) << 8)
+                | (toASCIIHexValue(m_source[i + 2]) << 4) | toASCIIHexValue(m_source[i + 3]);
+            i += 4;
+            builder.append(unit);
+            break;
+        }
+        default:
+            builder.append(static_cast<char16_t>(e));
+            break;
+        }
+    }
+    return builder.toString();
+}
+
+template<typename CharType>
+Identifier BlockBuilder<CharType>::makeIdentifier(uint32_t index)
+{
+    const JSONLibraryNode& node = m_nodes[index];
+    const uint8_t* bytes = m_pool + nodeField(node);
+    if (isASCIIBytes(bytes, node.data))
+        return Identifier::fromString(m_vm, m_cache.makeIdentifier(m_vm, std::span<const Latin1Character> { bytes, node.data }));
+    String string = poolStringToString(bytes, node.data);
+    if (string.isNull())
+        string = stringFromSource(index);
+    return Identifier::fromString(m_vm, string);
+}
+
+template<typename CharType>
+JSValue BlockBuilder<CharType>::makeStringValue(uint32_t index)
+{
+    const JSONLibraryNode& node = m_nodes[index];
+    const uint8_t* bytes = m_pool + nodeField(node);
+    if (isASCIIBytes(bytes, node.data))
+        return m_cache.makeJSString(m_vm, std::span<const Latin1Character> { bytes, node.data });
+    String string = poolStringToString(bytes, node.data);
+    if (string.isNull())
+        string = stringFromSource(index);
+    return jsString(m_vm, WTF::move(string));
+}
+
+template<typename CharType>
+JSValue BlockBuilder<CharType>::makePrimitive(uint32_t index)
+{
+    const JSONLibraryNode& node = m_nodes[index];
+    switch (nodeType(node)) {
+    case NodeNull:
+        return jsNull();
+    case NodeFalse:
+        return jsBoolean(false);
+    case NodeTrue:
+        return jsBoolean(true);
+    case NodeInt:
+        return jsNumber(static_cast<int32_t>(node.data));
+    case NodeNumber: {
+        size_t parsedLength;
+        return jsNumber(parseDouble(std::span<const Latin1Character> { m_pool + nodeField(node), node.data }, parsedLength));
+    }
+    default:
+        return makeStringValue(index);
+    }
+}
+
+// As LiteralParser's: one allocation of the right shape from the elements.
+template<typename CharType>
+JSArray* BlockBuilder<CharType>::materializeArray(MarkedArgumentBuffer& elements, unsigned base)
+{
+    VM& vm = m_vm;
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    unsigned length = elements.size() - base;
+    JSValue* values = elements.begin() + base;
+
+    IndexingType indexingType = ArrayWithInt32;
+    for (unsigned i = 0; i < length; ++i) {
+        JSValue value = values[i];
+        if (value.isInt32())
+            continue;
+        if (value.isDouble()) {
+            indexingType = ArrayWithDouble;
+            continue;
+        }
+        indexingType = ArrayWithContiguous;
+        break;
+    }
+
+    {
+        ObjectInitializationScope initializationScope(vm);
+        Structure* structure = m_globalObject->arrayStructureForIndexingTypeDuringAllocation(indexingType);
+        if (JSArray* array = JSArray::tryCreateUninitializedRestricted(initializationScope, structure, length)) [[likely]] {
+            IndexingType shape = array->indexingType() & IndexingShapeMask;
+            if (shape == DoubleShape) {
+                double* data = array->butterfly()->contiguousDouble().data();
+                for (unsigned i = 0; i < length; ++i)
+                    data[i] = values[i].asNumber();
+            } else if (shape == Int32Shape)
+                memcpy(std::bit_cast<JSValue*>(array->butterfly()->contiguous().data()), values, length * sizeof(JSValue));
+            else if (shape == ContiguousShape) {
+                gcSafeMemcpy(std::bit_cast<JSValue*>(array->butterfly()->contiguous().data()), values, length * sizeof(JSValue));
+                vm.writeBarrier(array);
+            } else {
+                for (unsigned i = 0; i < length; ++i)
+                    array->initializeIndex(initializationScope, i, values[i]);
+            }
+            return array;
+        }
+    }
+
+    JSArray* array = constructEmptyArray(m_globalObject, nullptr);
+    RETURN_IF_EXCEPTION(scope, nullptr);
+    for (unsigned i = 0; i < length; ++i) {
+        array->putDirectIndex(m_globalObject, i, values[i]);
+        RETURN_IF_EXCEPTION(scope, nullptr);
+    }
+    return array;
+}
+
+// One loop over the nodes, never a recursion: a container's children follow
+// it, an object's as key, value, key, value.
+template<typename CharType>
+JSValue BlockBuilder<CharType>::build()
+{
+    VM& vm = m_vm;
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    struct Frame {
+        uint32_t remaining;
+        unsigned elementBase;
+        bool isObject;
+    };
+    Vector<Frame, 16> frames;
+    MarkedArgumentBuffer objects;
+    MarkedArgumentBuffer elements;
+    Vector<PendingKey, 16> keys;
+    JSONCache::ParsingScope parsingScope(m_cache);
+    Vector<JSONRanges::Entry, 8> rangesStack;
+
+    uint32_t index = 0;
+    JSValue value;
+    JSONRanges::Entry valueRange;
+
+    while (true) {
+        const JSONLibraryNode& node = m_nodes[index];
+        uint32_t type = nodeType(node);
+        unsigned start = m_ranges ? cursorTo(index) : 0;
+
+        if (type == NodeArray || type == NodeObject) {
+            bool isObject = type == NodeObject;
+            uint32_t count = nodeField(node);
+            JSObject* object = nullptr;
+            if (isObject)
+                object = constructEmptyObject(m_globalObject);
+            if (m_ranges)
+                tokenEnd();
+            ++index;
+            if (!count) {
+                if (isObject)
+                    value = object;
+                else {
+                    value = constructEmptyArray(m_globalObject, nullptr);
+                    RETURN_IF_EXCEPTION(scope, { });
+                }
+                if (m_ranges) {
+                    valueRange = { m_ranges->record(value), WTF::Range<unsigned> { start, closeContainer() }, { } };
+                    if (isObject)
+                        valueRange.properties = JSONRanges::Object { };
+                    else
+                        valueRange.properties = JSONRanges::Array { };
+                }
+            } else {
+                frames.append({ count, static_cast<unsigned>(elements.size()), isObject });
+                if (isObject)
+                    objects.appendWithCrashOnOverflow(object);
+                if (m_ranges) {
+                    if (isObject)
+                        rangesStack.append({ m_ranges->record(object), WTF::Range<unsigned> { start }, JSONRanges::Object { } });
+                    else
+                        rangesStack.append({ JSValue(), WTF::Range<unsigned> { start }, JSONRanges::Array { } });
+                }
+                if (isObject)
+                    keys.append(makePendingKey(index++));
+                continue;
+            }
+        } else {
+            value = makePrimitive(index);
+            RETURN_IF_EXCEPTION(scope, { });
+            if (m_ranges)
+                valueRange = { m_ranges->record(value), WTF::Range<unsigned> { start, tokenEnd() }, { } };
+            ++index;
+        }
+
+        // The value goes to its container; finish each container it completes.
+        while (true) {
+            if (frames.isEmpty()) {
+                if (m_ranges)
+                    m_ranges->setRoot(WTF::move(valueRange));
+                return value;
+            }
+            Frame& frame = frames.last();
+            if (frame.isObject) {
+                JSObject* object = asObject(objects.last());
+                PendingKey pending = keys.takeLast();
+                Identifier& key = pending.identifier;
+                std::span<const Latin1Character> asciiName;
+                if (key.isNull()) {
+                    const JSONLibraryNode& keyNode = m_nodes[pending.node];
+                    asciiName = { m_pool + nodeField(keyNode), keyNode.data };
+                    if (putThroughCachedTransition(object, asciiName, value))
+                        goto stored;
+                    key = Identifier::fromString(vm, m_cache.makeIdentifier(vm, asciiName));
+                }
+                if (std::optional<uint32_t> propertyIndex = parseIndex(key)) {
+                    object->putDirectIndex(m_globalObject, propertyIndex.value(), value);
+                    RETURN_IF_EXCEPTION(scope, { });
+                } else if (!putThroughExistingTransition(object, key, asciiName, value))
+                    object->putDirect(vm, key, value);
+                if (m_ranges)
+                    std::get<JSONRanges::Object>(rangesStack.last().properties).set(key.impl(), WTF::move(valueRange));
+            stored:;
+            } else {
+                elements.appendWithCrashOnOverflow(value);
+                if (m_ranges)
+                    std::get<JSONRanges::Array>(rangesStack.last().properties).append(WTF::move(valueRange));
+            }
+            if (--frame.remaining) {
+                if (frame.isObject)
+                    keys.append(makePendingKey(index++));
+                break;
+            }
+            if (frame.isObject)
+                value = objects.takeLast();
+            else {
+                value = materializeArray(elements, frame.elementBase);
+                RETURN_IF_EXCEPTION(scope, { });
+                elements.shrink(frame.elementBase);
+            }
+            frames.removeLast();
+            if (m_ranges) {
+                valueRange = rangesStack.takeLast();
+                if (!valueRange.value)
+                    valueRange.value = m_ranges->record(value);
+                valueRange.range = { valueRange.range.begin(), closeContainer() };
+            }
+        }
+    }
+}
+
+template<typename CharType>
+JSValue parseWithLibrary(JSGlobalObject* globalObject, std::span<const CharType> source, JSONRanges* ranges, String& errorMessage, JSONLibraryParseMode mode)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    static const uint8_t empty = 0;
+    JSONLibraryError error { };
+    const JSONLibraryDoc* doc;
+    if constexpr (sizeof(CharType) == 1)
+        doc = libraryParse(source.empty() ? &empty : source.data(), source.size(), parseLatin1, &error);
+    else {
+        Vector<uint8_t> utf8;
+        if (!sourceToUTF8(source, utf8)) {
+            throwOutOfMemoryError(globalObject, scope);
+            return { };
+        }
+        doc = libraryParse(utf8.isEmpty() ? &empty : utf8.span().data(), utf8.size(), 0, &error);
+    }
+
+    if (!doc) {
+        unsigned index = sourceIndex(source, error.offset);
+        switch (error.code) {
+        case ErrorDepth:
+            // Deeper than json.library's 1024 levels: the RangeError
+            // LiteralParser gives when a reviver's parse nests too deep.
+            throwStackOverflowError(globalObject, scope);
+            return { };
+        case ErrorNoMemory:
+        case ErrorTooBig:
+            throwOutOfMemoryError(globalObject, scope);
+            return { };
+        default:
+            errorMessage = syntaxErrorMessage(source, error, index);
+            return { };
+        }
+    }
+    DocHolder holder(doc);
+
+    if (mode == JSONLibraryParseMode::PrimitiveValue) {
+        uint32_t type = nodeType(*std::bit_cast<const JSONLibraryNode*>(std::bit_cast<const uint8_t*>(doc) + doc->nodeOffset));
+        if (type == NodeArray || type == NodeObject) {
+            JSONLibraryError unexpected { ErrorSyntax, 0, 1, 1 };
+            errorMessage = syntaxErrorMessage(source, unexpected, 0);
+            return { };
+        }
+    }
+
+    BlockBuilder<CharType> builder(globalObject, source, doc, ranges);
+    RELEASE_AND_RETURN(scope, builder.build());
+}
+
+} // namespace
+
+JSValue jsonLibraryParse(JSGlobalObject* globalObject, StringView json, JSONRanges* ranges, String& errorMessage, JSONLibraryParseMode mode)
+{
+    VM& vm = globalObject->vm();
+    auto scope = DECLARE_THROW_SCOPE(vm);
+
+    if (!openJSONLibrary()) [[unlikely]] {
+        throwException(globalObject, scope, createError(globalObject, "JSON.parse needs json.library version 1 or newer in LIBS:"_s));
+        return { };
+    }
+
+    if (json.is8Bit())
+        RELEASE_AND_RETURN(scope, parseWithLibrary(globalObject, json.span8(), ranges, errorMessage, mode));
+    RELEASE_AND_RETURN(scope, parseWithLibrary(globalObject, json.span16(), ranges, errorMessage, mode));
+}
+
