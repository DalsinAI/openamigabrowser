+// JSON.parse through json.library (OpenJSON) on the Team's 68k targets.
+// The library checks the text and parses it into one flat block of nodes in
+// document order; this file makes the JavaScript values from the block, with
+// ECMAScript's JSON.parse semantics: "__proto__" is a plain own property,
+// the last of equal keys wins (in the first one's place), numbers are
+// correctly rounded doubles (integers that fit 32 bits come as integers),
+// unpaired surrogates are kept, and syntax errors say where they are. With a
+// reviver it also records each value's source text for the reviver's context
+// argument (JSONRanges), as LiteralParser does. LiteralParser itself is not
+// built on these targets.
+
+#include "config.h"
+#include "LiteralParser.h"
+
+#if USE(OB_JSON_LIBRARY)
+
+#include "GCMemoryOperations.h"
+#include "JSArray.h"
+#include "JSCInlines.h"
+#include "JSONCacheInlines.h"
+#include "ObjectConstructor.h"
+#include <mutex>
+#include <stdlib.h>
+#include <unicode/utf16.h>
+#include <wtf/ASCIICType.h>
+#include <wtf/Range.h>
+#include <wtf/FastFloat.h>
+#include <wtf/text/MakeString.h>
+#include <wtf/text/StringBuilder.h>
+
+#if defined(OB_JSON_LIBRARY_HOST)
+// The host test build links json.library's own core (src/jsonlib/json_core.cpp
+// in openamigabrowser) through these two.
+extern "C" void* obJSONHostParse(const unsigned char* text, unsigned length, unsigned flags, void* error);
+extern "C" void obJSONHostFree(void* doc);
+#endif
