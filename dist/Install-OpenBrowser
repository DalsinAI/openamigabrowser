; $VER: Install-OpenBrowser 0.8.2 (23.10.2026)
; OpenBrowser's Installer script (SYS:System/Installer). Run it from its icon
; beside the OpenBrowser drawer; from a Shell, "Execute Install" in the drawer
; does the same without questions. Nothing is deleted: a file it would
; replace is renamed, and the closing message says how to undo.
; MIT, Copyright (c) 2026 AmigaChrome Team.

(set #version "0.8.2 test (23.10.2026)")
(set @app-name "OpenBrowser")
(set #stamp "20261023b")
(set #backup (cat "LIBS:WebBrowser/WebBrowserEngine.before-" #stamp))
; the drawer as unpacked is about 87 MB: the one engine (WebBrowserEngine,
; which webbrowser.library runs), its fonts and the Unicode data
(set #need 95000000)

(if (< (/ (getversion) 65536) 47)
    (abort "OpenBrowser needs AmigaOS 3.2 or later. This Amiga has an older version."))
(if (or (= (database "fpu") "NOFPU")
        (not (or (= (database "cpu") "68040") (= (database "cpu") "68060"))))
    (abort "OpenBrowser needs a 68040 or 68060 with its FPU (not an LC or EC CPU)."))
(if (not (exists "OpenBrowser/Libs/WebBrowser/WebBrowserEngine"))
    (abort "Start Install-OpenBrowser from its icon, beside the OpenBrowser drawer it came with."))

(welcome
    (cat "This installs OpenBrowser " #version ": a WebKit web browser for "
         "AmigaOS 3.2, with its 68k JavaScript JIT."))

; Where the drawer goes. Not System: by default: the drawer is large, and a
; full System: stops the Amiga saving its settings.
(set #where
    (if (exists "Work:" (noreq)) "Work:" "SYS:Utilities"))
(set #where
    (askdir
        (prompt "Where should the OpenBrowser drawer go? It needs about 90 MB.")
        (help (cat "The drawer holds the browser and everything it uses. It can go on any "
                   "disk with room; Work: or another data partition is best. Putting it on "
                   "System: (SYS:) can fill that disk."))
        (default #where)))
(set #dest (tackon #where "OpenBrowser"))
(if (< (getdiskspace #where) #need)
    (abort (cat #where " has " (/ (getdiskspace #where) 1048576) " MB free, and OpenBrowser needs about "
                (/ #need 1048576) " MB. Choose another place, or make room, and run the Installer again.")))

; The extras: libraries other programs can use. Not needed by the browser.
(set #extras
    (askoptions
        (prompt "Also install these? OpenBrowser does not need them.")
        (help (cat "javascript.library runs JavaScript for any program; it puts about 38 MB "
                   "in LIBS:JavaScript. JS runs a script from the Shell."))
        (choices "javascript.library and JS (about 38 MB in LIBS:)")
        (default 0)))

; 1. The drawer and its icon. Over an older version's drawer: its engines
;    are renamed .before-<stamp> first (kept, not overwritten); 0.8.0 and
;    0.8.1 test had OpenBrowser.engine beside the launcher as well, which
;    the launcher no longer runs.
(set #renamed-drawer "")
(set #old-engine (tackon #dest "OpenBrowser.engine"))
(if (and (exists #old-engine) (not (exists (cat #old-engine ".before-" #stamp))))
    (
        (if (= 0 (rename #old-engine (cat #old-engine ".before-" #stamp)))
            (abort (cat "Could not rename " #old-engine ". Nothing was changed.")))
        (set #renamed-drawer (cat #renamed-drawer " OpenBrowser.engine"))))
; the older drawer's WebBrowserEngine, unless it is this one (run again)
(set #old-engine (tackon #dest "Libs/WebBrowser/WebBrowserEngine"))
(if (and (exists #old-engine)
         (<> (getsize #old-engine) (getsize "OpenBrowser/Libs/WebBrowser/WebBrowserEngine"))
         (not (exists (cat #old-engine ".before-" #stamp))))
    (
        (if (= 0 (rename #old-engine (cat #old-engine ".before-" #stamp)))
            (abort (cat "Could not rename " #old-engine ". Nothing was changed.")))
        (set #renamed-drawer (cat #renamed-drawer " Libs/WebBrowser/WebBrowserEngine"))))
(copyfiles
    (prompt "Copying the OpenBrowser drawer")
    (help @copyfiles-help)
    (source "OpenBrowser")
    (dest #dest)
    (all))
(if (exists "OpenBrowser.info")
    (copyfiles (source "OpenBrowser.info") (dest #where) (nogauge)))

; 2. https: OpenTLS 1.2 or newer and OpenCrypto 2.1 or newer, and the
;    certificates. An older library is renamed .before-20261023b (kept), then
;    the one in the drawer goes in; a newer one is left as it is.
(if (< (getversion "LIBS:opentls.library") 65538)
    (
        (if (exists "LIBS:opentls.library")
            (if (= 0 (rename "LIBS:opentls.library" "LIBS:opentls.library.before-20261023b"))
                (abort "Could not rename the old LIBS:opentls.library. Nothing else was changed in LIBS:.")))
        (copyfiles (source "OpenBrowser/Libs/opentls.library") (dest "LIBS:") (nogauge))))
(if (< (getversion "LIBS:opencrypto.library") 131073)
    (
        (if (exists "LIBS:opencrypto.library")
            (if (= 0 (rename "LIBS:opencrypto.library" "LIBS:opencrypto.library.before-20261023b"))
                (abort "Could not rename the old LIBS:opencrypto.library.")))
        (copyfiles (source "OpenBrowser/Libs/opencrypto.library") (dest "LIBS:") (nogauge))))
(if (not (exists "S:OpenTLS/ca-bundle.pem"))
    (
        (makedir "S:OpenTLS")
        (copyfiles (source "OpenBrowser/S/OpenTLS") (dest "S:OpenTLS") (all) (nogauge))))

; openfont.library 1.4 or newer: the engine draws and shapes all its text
; with it. An older one is renamed .before-20261023 (kept).
(if (< (getversion "LIBS:openfont.library") 65540)
    (
        (if (exists "LIBS:openfont.library")
            (if (= 0 (rename "LIBS:openfont.library" "LIBS:openfont.library.before-20261023"))
                (abort "Could not rename the old LIBS:openfont.library.")))
        (copyfiles (source "OpenBrowser/Libs/openfont.library") (dest "LIBS:") (nogauge))))

; json.library: JSON for the browser and any other program (23 KB); the
; engine's JSON.parse parses through it
(copylib (source "OpenBrowser/Libs/json.library") (dest "LIBS:") (nogauge)
    (prompt "Installing json.library") (help @copylib-help) (confirm "expert"))

; 3. The Unicode data, for every program that reads it, when System: has room
;    (it keeps 20 MB free); the engine in the drawer carries its own copy as
;    well (Libs/WebBrowser/Unicode, which it reads when LOCALE:Unicode has
;    none). One of another size is renamed icudt78b.dat.before-<stamp>.
(set #icu "LOCALE:Unicode/icudt78b.dat")
(set #icunew "OpenBrowser/Libs/WebBrowser/Unicode/icudt78b.dat")
(if (and (exists #icu) (<> (getsize #icu) (getsize #icunew)))
    (if (exists (cat #icu ".before-" #stamp))
        (abort (cat "LOCALE:Unicode has both icudt78b.dat and icudt78b.dat.before-" #stamp
                    ". Move one of them away and run the Installer again."))
        (if (= 0 (rename #icu (cat #icu ".before-" #stamp)))
            (abort "Could not rename LOCALE:Unicode/icudt78b.dat."))))
(if (and (not (exists #icu))
         (> (getdiskspace "LOCALE:") 25000000))
    (
        (makedir "LOCALE:Unicode")
        (copyfiles (source "OpenBrowser/Libs/WebBrowser/Unicode") (dest "LOCALE:Unicode") (all) (nogauge))))

; 4. One engine: WebBrowserEngine stays in the drawer, off System:.
;    webbrowser.library runs LIBS:WebBrowser/WebBrowserEngine when there is
;    one, otherwise the drawer's Libs/WebBrowser/WebBrowserEngine (for the
;    OpenBrowser in the drawer). An older LIBS:WebBrowser/WebBrowserEngine,
;    the engine or the two-line script that 0.8.0 and 0.8.1 test wrote
;    there, is renamed WebBrowserEngine.before-<stamp> (kept); nothing new
;    is written in LIBS:WebBrowser.
(set #enginefile "LIBS:WebBrowser/WebBrowserEngine")
(set #renamed 0)
(if (exists #enginefile)
    (if (exists #backup)
        (abort (cat "LIBS:WebBrowser has both WebBrowserEngine and " (fileonly #backup)
                    ". Move one of them away and run the Installer again."))
        (
            (if (= 0 (rename #enginefile #backup
                        (prompt "Keeping the old LIBS:WebBrowser/WebBrowserEngine as " (fileonly #backup))
                        (help "OpenBrowser now runs the engine in its drawer. Renaming it back undoes the change.")))
                (abort "Could not rename LIBS:WebBrowser/WebBrowserEngine. Nothing else was changed in LIBS:WebBrowser."))
            (set #renamed 1))))

; 5. The extras
(if (bitand #extras 1)
    (
        (copyfiles (source "Extras/Libs/javascript.library") (dest "LIBS:") (nogauge))
        (makedir "LIBS:JavaScript")
        (copyfiles (source "Extras/Libs/JavaScript") (dest "LIBS:JavaScript") (all))
        ; a browser engine that takes JavaScriptCore from JavaScriptEngine
        ; looks in LIBS:JavaScript first: its own image goes there, so the
        ; engine and javascript.library use one file
        (if (exists "OpenBrowser/Libs/JavaScript/JavaScriptEngine")
            (copyfiles (source "OpenBrowser/Libs/JavaScript/JavaScriptEngine") (dest "LIBS:JavaScript") (nogauge)))
        ; JavaScriptEngine reads ICU's data from LOCALE:Unicode, or else
        ; from its own drawer
        (if (not (exists "LOCALE:Unicode/icudt78b.dat"))
            (
                (makedir "LIBS:JavaScript/Unicode")
                (copyfiles (source "OpenBrowser/Libs/WebBrowser/Unicode") (dest "LIBS:JavaScript/Unicode") (all) (nogauge))))
        (copyfiles (source "Extras/C/JS") (dest "C:") (nogauge))))

(if (not (exists "LIBS:bsdsocket.library"))
    (message (cat "There is no bsdsocket.library: OpenBrowser needs a network. "
                  "On AmigaChrome turn networking on for this instance in Cradle; "
                  "otherwise install OpenSocket (OpenUp) or another TCP/IP stack.")))

(set @default-dest #dest)
(exit
    (cat "OpenBrowser is in " #dest ". Reboot, then double-click OpenBrowser there.\n\n"
         "To undo: "
         (if (<> #renamed-drawer "")
             (cat "an older OpenBrowser was in that drawer; its" #renamed-drawer " is kept there as .before-" #stamp ", to rename back")
             "delete that drawer")
         (if (or #renamed (exists #backup)) (cat "; rename " #backup " back to WebBrowserEngine") "")
         ". What the Installer added to LIBS:, S: and LOCALE: is listed in the Installer's log in that drawer (Install-OpenBrowser.log from the icon; read it before deleting the drawer).")
    (quiet))
